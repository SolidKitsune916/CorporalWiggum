{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017M5QnG8whRa6fgS7mkoU8S","type":"tool_result","content":"     1→import { useState, useEffect } from 'react';\n     2→import { useWebSocket } from '@/hooks/useWebSocket';\n     3→import { LoopStatus } from './LoopStatus';\n     4→import { TaskList } from './TaskList';\n     5→import { LogViewer } from './LogViewer';\n     6→import { ContextMeter } from './ContextMeter';\n     7→import { GitHistory } from './GitHistory';\n     8→import { LoopControls } from './LoopControls';\n     9→import { SetupWizard } from './setup/SetupWizard';\n    10→import { OnboardingWizard } from './setup/OnboardingWizard';\n    11→import { PlanGenerator } from './PlanGenerator';\n    12→import { PRDGenerator } from './PRDGenerator';\n    13→import { ExistingDocsViewer } from './ExistingDocsViewer';\n    14→import { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';\n    15→import { Badge } from '@/components/ui/badge';\n    16→import {\n    17→  LayoutDashboard,\n    18→  Settings,\n    19→  Terminal,\n    20→  Wifi,\n    21→  WifiOff,\n    22→  Wand2,\n    23→  FileText,\n    24→  ListTodo,\n    25→  Github,\n    26→} from 'lucide-react';\n    27→\n    28→export function Dashboard() {\n    29→  const {\n    30→    connected,\n    31→    loopStatus,\n    32→    tasks,\n    33→    gitStatus,\n    34→    logs,\n    35→    projectConfig,\n    36→    enabledAgents,\n    37→    planStatus,\n    38→    planOutput,\n    39→    planComplete,\n    40→    planError,\n    41→    prdStatus,\n    42→    prdOutput,\n    43→    prdComplete,\n    44→    prdError,\n    45→    projectScan,\n    46→    scanLoading,\n    47→    projectInfo,\n    48→    availableAgents,\n    49→    cursorRules,\n    50→    agentsLoading,\n    51→    rulesLoading,\n    52→    selectedDocPaths,\n    53→    previewDoc,\n    54→    isLoadingPreview,\n    55→    claudeMdFiles,\n    56→    claudeMdContent,\n    57→    claudeMdLoading,\n    