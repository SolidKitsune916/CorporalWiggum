age extends WSMessage {\n  type: 'launcher:instance:stopped';\n  payload: {\n    projectId: string;\n  };\n}\n\nexport interface LauncherInstanceCrashedMessage extends WSMessage {\n  type: 'launcher:instance:crashed';\n  payload: {\n    projectId: string;\n    error: string;\n  };\n}\n\nexport interface LauncherDiscoverResultMessage extends WSMessage {\n  type: 'launcher:discover:result';\n  payload: DiscoveredProject[];\n}\n\nexport interface LauncherErrorMessage extends WSMessage {\n  type: 'launcher:error';\n  payload: {\n    error: string;\n  };\n}\n","numLines":758,"startLine":1,"totalLines":758}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FPjiRBsFhVBwaCvkHRfgGj","type":"tool_result","content":"     1→import express from 'express';\n     2→import { createServer } from 'http';\n     3→import { WebSocketServer, WebSocket } from 'ws';\n     4→import cors from 'cors';\n     5→import path from 'path';\n     6→import { fileURLToPath } from 'url';\n     7→import fs from 'fs/promises';\n     8→import { FileWatcher } from './fileWatcher.js';\n     9→import { LoopController } from './loopController.js';\n    10→import { ProjectConfigManager } from './projectConfig.js';\n    11→import { PlanGenerator } from './planGenerator.js';\n    12→import { PRDGenerator } from './prdGenerator.js';\n    13→import { ProjectScanner } from './projectScanner.js';\n    14→import { detectProjectRoot, formatProjectInfo, type ProjectRootResult } from './projectRootDetector.js';\n    15→import { checkAllDependencies } from './dependencyChecker.js';\n    16→import { ProjectRegistry } from './projectRegistry.js';\n    17→import { InstanceSpawner } from './instanceSpawner.js';\n    18→import { ProjectDiscovery } from './projectDiscovery.js';\n    19→\n    20→const __filename = fileURLToPath(import.meta.url);\n    21→const __dirname = path.dirname(__filename);\n    22→\n    23→// Detect project root (async initialization)\n    24→const RALPH_DEFAULT_PATH = path.resolve(__dirname, '../..');\n    25→\n    26→// Initialize project detection and return paths\n    27→async function initializeProjectPaths(): Promise<ProjectRootResult> {\n    28→  // Allow explicit override via environment\n    29→  if (process.env.PROJECT_PATH) {\n    30→    return {\n    31→      targetProjectPath: process.env.PROJECT_PATH,\n    32→      ralphPath: RALPH_DEFAULT_PATH,\n    33→      mode: 'embedded',\n    34→      detectionReason: 'Explicitly set via PROJECT_PATH environment variable',\n    35→    };\n    36→  }\n    37→  return detectProjectRoot(RALPH_DEFAULT_PATH);\n    38→}\n    39→\n    40→// Start server after initialization\n    41→async function startServer() {\n    42→  const projectRoot = await initializeProjectPaths();\n    43→  const TARGET_PROJECT_PATH = projectRoot.targetProjectPath;\n    44→  const RALPH_PATH = projectRoot.ralphPath;\n    45→\n    46→  console.log('\\n' + formatProjectInfo(projectRoot) + '\\n');\n    47→\n    48→  const app = express();\n    49→  const server = createServer(app);\n    50→  const wss = new WebSocketServer({ server, path: '/ws' });\n    51→\n    52→  app.use(cors());\n    53→  app.use(express.json());\n    54→\n    55→  // Initialize services with appropriate paths\n    56→  const projectConfig = new ProjectConfigManager(TARGET_PROJECT_PATH, RALPH_PATH);\n    57→  const fileWatcher = new FileWatcher(TARGET_PROJECT_PATH);\n    58→  const loopController = new LoopController(TARGET_PROJECT_PATH, RALPH_PATH);\n    59→  const planGenerator = new PlanGenerator(TARGET_PROJECT_PATH, RALPH_PATH);\n    60→  const prdGenerator = new PRDGenerator(TARGET_PROJECT_PATH, RALPH_PATH);\n    61→  const projectScanner = new ProjectScanner(TARGET_PROJECT_PATH);\n    62→\n    63→  // Initialize launcher services\n    64→  const projectRegistry = new ProjectRegistry();\n    65→  const instanceSpawner = new InstanceSpawner(RALPH_PATH);\n    66→  const projectDiscovery = new ProjectDiscovery();\n    67→\n    68→  // Track connected clients\n    69→  const clients = new Set<WebSocket>();\n    70→\n    71→  // Broadcast to all connected clients\n    72→  function broadcast(message: object) {\n    73→    const data = JSON.stringify(message);\n    74→    clients.forEach((client) => {\n    75→      if (client.readyState === WebSocket.OPEN) {\n    76→        client.send(data);\n    77→      }\n    78→    });\n    79→  }\n    80→\n    81→  // WebSocket connection handler\n    82→  wss.on('connection', (ws) => {\n    83→    clients.add(ws);\n    84→    console.log('Client connected. Total clients:', clients.size);\n    85→\n    86→    // Send initial state\n    87→    ws.send(JSON.stringify({ type: 'loop:status', payload: loopController.getStatus() }));\n    88→    ws.send(JSON.stringify({ type: 'tasks:update', payload: fileWatcher.getTasks() }));\n    89→    ws.send(JSON.stringify({ type: 'git:update', payload: fileWatcher.getGitStatus() }));\n    90→    ws.send(JSON.stringify({ type: 'config:update', payload: projectConfig.getConfig() }));\n    91→    ws.send(JSON.stringify({ type: 'project:info', payload: projectRoot }));\n    92→\n    93→    // Handle messages from client\n    94→    ws.on('message', async (data) => {\n    95→      try {\n    96→        const message = JSON.parse(data.toString());\n    97→\n    98→        switch (message.type) {\n    99→          case 'loop:start':\n   100→            loopController.start(message.payload);\n   101→            break;\n   102→          case 'loop:stop':\n   103→            loopController.stop();\n   104→            break;\n   105→          case 'config:read':\n   106→            const content = await projectConfig.readFile(message.payload.file);\n   107→            ws.send(JSON.stringify({ type: 'config:content', payload: { file: message.payload.file, content } }));\n   108→            break;\n   109→          case 'config:write':\n   110→            await projectConfig.writeFile(message.payload.file, message.payload.content);\n   111→            ws.send(JSON.stringify({ type: 'config:saved', payload: { file: message.payload.file } }));\n   112→            // Refresh config if PRD.md or AUDIENCE_JTBD.md was written\n   113→            if (message.payload.file === 'PRD.md' || message.payload.file === 'AUDIENCE_JTBD.md') {\n   114→              const updatedConfig = await projectConfig.refresh();\n   115→              broadcast({ type: 'config:update', payload: updatedConfig });\n   116→            }\n   117→            break;\n   118→          case 'config:refresh':\n   119→            try {\n   120→              const updatedConfig = await projectConfig.refresh();\n   121→              broadcast({ type: 'config:update', payload: updatedConfig });\n   122→              ws.send(JSON.stringify({ type: 'config:refreshed' }));\n   123→            } catch (err) {\n   124→              ws.send(JSON.stringify({ type: 'config:error', payload: { error: 'Failed to refresh config' } }));\n   125→            }\n   126→            break;\n   127→          case 'agents:toggle':\n   128→            await projectConfig.toggleAgent(message.payload.agentId, message.payload.enabled);\n   129→            const enabledAgents = projectConfig.getEnabledAgents();\n   130→            broadcast({ type: 'agents:update', payload: { enabledAgents } });\n   131→            break;\n   132→          case 'plan:generate':\n   133→            try {\n   134→              // Read PRD context if requested\n   135→              let prdContext = '';\n   136→              if (message.payload.usePrdContext) {\n   137→                try {\n   138→                  const prdContent = await projectConfig.readFile('PRD.md');\n   139→                  const audienceContent = await projectConfig.readFile('AUDIENCE_JTBD.md');\n   140→                  prdContext = `\n   141→## Context: PRD.md\n   142→${prdContent}\n   143→\n   144→## Context: AUDIENCE_JTBD.md\n   145→${audienceContent}\n   146→`;\n   147→                } catch (err) {\n   148→                  console.warn('Could not read PRD files:', err);\n   149→                }\n   150→              }\n   151→              await planGenerator.generatePlan({ ...message.payload, prdContext });\n   152→            } catch (err) {\n   153→              console.error('Error generating plan:', err);\n   154→              ws.send(JSON.stringify({ \n   155→                type: 'plan:error', \n   156→                payload: { error: err instanceof Error ? err.message : 'Failed to start plan generation' } \n   157→              }));\n   158→            }\n   159→            break;\n   160→          case 'plan:cancel':\n   161→            planGenerator.cancel();\n   162→            break;\n   163→          case 'prd:generate':\n   164→            prdGenerator.generatePRD(message.payload);\n   165→            break;\n   166→          case 'prd:cancel':\n   167→            prdGenerator.cancel();\n   168→            break;\n   169→          case 'project:scan':\n   170→            const scanResult = await projectScanner.scan();\n   171→            ws.send(JSON.stringify({ type: 'project:scan-result', payload: scanResult }));\n   172→            break;\n   173→          case 'project:info':\n   174→            ws.send(JSON.stringify({ type: 'project:info', payload: projectRoot }));\n   175→            break;\n   176→          case 'agents:list':\n   177→            const agents = await projectConfig.listAvailableAgents();\n   178→            ws.send(JSON.stringify({ type: 'agents:list-result', payload: agents }));\n   179→            break;\n   180→          case 'rules:list':\n   181→            const rules = await projectConfig.listCursorRulesDetailed();\n   182→            ws.send(JSON.stringify({ type: 'rules:list-result', payload: rules }));\n   183→            break;\n   184→          case 'rules:toggle':\n   185→            const updatedRules = await projectConfig.toggleCursorRule(message.payload.ruleId, message.payload.enabled);\n   186→            broadcast({ type: 'rules:update', payload: updatedRules });\n   187→            break;\n   188→          case 'docs:read':\n   189→            try {\n   190→              const docPath = message.payload.docPath;\n   191→              // Validate path to prevent directory traversal\n   192→              const normalizedPath = path.normalize(docPath);\n   193→              if (normalizedPath.startsWith('..') || path.isAbsolute(normalizedPath)) {\n   194→                ws.send(JSON.stringify({ type: 'docs:error', payload: { error: 'Invalid path' } }));\n   195→                break;\n   196→              }\n   197→              const fullPath = path.join(TARGET_PROJECT_PATH, normalizedPath);\n   198→              const docContent = await fs.readFile(fullPath, 'utf-8');\n   199→              ws.send(JSON.stringify({ type: 'docs:content', payload: { path: docPath, content: docContent } }));\n   200→            } catch (err) {\n   201→              ws.send(JSON.stringify({ type: 'docs:error', payload: { error: 'Failed to read document' } }));\n   202→            }\n   203→            break;\n   204→          case 'claude:list':\n   205→            try {\n   206→              const claudeFiles = await projectConfig.listClaudeMdFiles();\n   207→              ws.send(JSON.stringify({ type: 'claude:list-result', payload: claudeFiles }));\n   208→            } catch (err) {\n   209→              ws.send(JSON.stringify({ type: 'claude:error', payload: { error: 'Failed to list CLAUDE.md files' } }));\n   210→            }\n   211→            break;\n   212→          case 'claude:read':\n   213→            try {\n   214→              const claudeContent = await projectConfig.readClaudeMdFile(message.payload.path);\n   215→              ws.send(JSON.stringify({ type: 'claude:content', payload: { path: message.payload.path, content: claudeContent } }));\n   216→            } catch (err) {\n   217→              ws.send(JSON.stringify({ type: 'claude:error', payload: { error: 'Failed to read CLAUDE.md' } }));\n   218→            }\n   219→            break;\n   220→          case 'claude:apply':\n   221→            try {\n   222→              await projectConfig.applyRalphClaudeMd();\n   223→              ws.send(JSON.stringify({ type: 'claude:applied' }));\n   224→              // Refresh and broadcast config update\n   225→              const updatedConfig = await projectConfig.refresh();\n   226→              broadcast({ type: 'config:update', payload: updatedConfig });\n   227→            } catch (err) {\n   228→              ws.send(JSON.stringify({ type: 'claude:error', payload: { error: 'Failed to apply CLAUDE.md' } }));\n   229→            }\n   230→            break;\n   231→          case 'dependencies:check':\n   232→            try {\n   233→              const depResults = await checkAllDependencies();\n   234→              ws.send(JSON.stringify({ type: 'dependencies:result', payload: depResults }));\n   235→            } catch (err) {\n   236→              ws.send(JSON.stringify({ type: 'dependencies:error', payload: { error: 'Failed to check dependencies' } }));\n   237→            }\n   238→            break;\n   239→          case 'agents:list-repo':\n   240→            try {\n   241→              const repoAgents = await projectConfig.listRepoAgents();\n   242→              ws.send(JSON.stringify({ type: 'agents:repo-result', payload: repoAgents }));\n   243→            } catch (err) {\n   244→              ws.send(JSON.stringify({ type: 'agents:error', payload: { error: 'Failed to list repo agents' } }));\n   245→            }\n   246→            break;\n   247→          case 'agents:install-global':\n   248→            try {\n   249→              await projectConfig.installAgentGlobal(message.payload.agentId);\n   250→              ws.send(JSON.stringify({ type: 'agents:installed', payload: { agentId: message.payload.agentId, scope: 'global' } }));\n   251→              // Send updated repo agents list\n   252→              const updatedRepoAgents = await projectConfig.listRepoAgents();\n   253→              ws.send(JSON.stringify({ type: 'agents:repo-result', payload: updatedRepoAgents }));\n   254→            } catch (err) {\n   255→              ws.send(JSON.stringify({ type: 'agents:error', payload: { error: `Failed to install agent globally: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n   256→            }\n   257→            break;\n   258→          case 'agents:install-project':\n   259→            try {\n   260→              await projectConfig.installAgentProject(message.payload.agentId);\n   261→              ws.send(JSON.stringify({ type: 'agents:installed', payload: { agentId: message.payload.agentId, scope: 'project' } }));\n   262→              // Send updated repo agents list\n   263→              const updatedRepoAgentsAfterProject = await projectConfig.listRepoAgents();\n   264→              ws.send(JSON.stringify({ type: 'agents:repo-result', payload: updatedRepoAgentsAfterProject }));\n   265→            } catch (err) {\n   266→              ws.send(JSON.stringify({ type: 'agents:error', payload: { error: `Failed to install agent to project: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n   267→            }\n   268→            break;\n   269→          case 'agents:install-all-global':\n   270→            try {\n   271→              await projectConfig.installAllAgentsGlobal();\n   272→              ws.send(JSON.stringify({ type: 'agents:installed', payload: { agentId: 'all', scope: 'global' } }));\n   273→              // Send updated repo agents list\n   274→              const updatedRepoAgentsAll = await projectConfig.listRepoAgents();\n   275→              ws.send(JSON.stringify({ type: 'agents:repo-result', payload: updatedRepoAgentsAll }));\n   276→            } catch (err) {\n   277→              ws.send(JSON.stringify({ type: 'agents:error', payload: { error: `Failed to install all agents: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n   278→            }\n   279→            break;\n   280→\n   281→          // ============================================\n   282→          // Launcher WebSocket Handlers\n   283→          // ============================================\n   284→          case 'launcher:projects:list':\n   285→            try {\n   286→              const projects = await projectRegistry.listProjects();\n   287→              ws.send(JSON.stringify({ type: 'launcher:projects:list', payload: projects }));\n   288→            } catch (err) {\n   289→              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to list projects: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n   290→            }\n   291→            break;\n   292→\n   293→          case 'launcher:projects:add':\n   294→            try {\n   295→              const newProject = await projectRegistry.addProject(message.payload.path);\n   296→              ws.send(JSON.stringify({ type: 'launcher:project:added', payload: newProject }));\n   297→              // Broadcast updated list to all clients\n   298→              const updatedProjects = await projectRegistry.listProjects();\n   299→              broadcast({ type: 'launcher:projects:list', payload: updatedProjects });\n   300→            } catch (err) {\n   301→              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to add project: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n   302→            }\n   303→            break;\n   304→\n   305→          case 'launcher:projects:remove':\n   306→            try {\n   307→              // Stop instance if running\n   308→              if (instanceSpawner.isRunning(message.payload.projectId)) {\n   309→                await instanceSpawner.stopInstance(message.payload.projectId);\n   310→              }\n   311→              await projectRegistry.removeProject(message.payload.projectId);\n   312→              ws.send(JSON.stringify({ type: 'launcher:project:removed', payload: { projectId: message.payload.projectId } }));\n   313→              // Broadcast updated list to all clients\n   314→              const projectsAfterRemove = await projectRegistry.listProjects();\n   315→              broadcast({ type: 'launcher:projects:list', payload: projectsAfterRemove });\n   316→            } catch (err) {\n   317→              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to remove project: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n   318→            }\n   319→            break;\n   320→\n   321→          case 'launcher:instance:spawn':\n   322→            try {\n   323→              const project = await projectRegistry.getProject(message.payload.projectId);\n   324→              if (!project) {\n   325→                throw new Error('Project not found');\n   326→              }\n   327→              const instance = await instanceSpawner.spawnInstance(project.id, project.path);\n   328→              await projectRegistry.updateLastOpened(project.id);\n   329→              ws.send(JSON.stringify({ type: 'launcher:instance:spawned', payload: instance }));\n   330→              // Broadcast updated instances list to all clients\n   331→              const instances = instanceSpawner.listInstances();\n   332→              broadcast({ type: 'launcher:instances:list', payload: instances });\n   333→            } catch (err) {\n   334→              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to spawn instance: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n   335→            }\n   336→            break;\n   337→\n   338→          case 'launcher:instance:stop':\n   339→            try {\n   340→              await instanceSpawner.stopInstance(message.payload.projectId);\n   341→              ws.send(JSON.stringify({ type: 'launcher:instance:stopped', payload: { projectId: message.payload.projectId } }));\n   342→              // Broadcast updated instances list to all clients\n   343→              const instancesAfterStop = instanceSpawner.listInstances();\n   344→              broadcast({ type: 'launcher:instances:list', payload: instancesAfterStop });\n   345→            } catch (err) {\n   346→              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to stop instance: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n   347→            }\n   348→            break;\n   349→\n   350→          case 'launcher:instances:list':\n   351→            try {\n   352→              const runningInstances = instanceSpawner.listInstances();\n   353→              ws.send(JSON.stringify({ type: 'launcher:instances:list', payload: runningInstances }));\n   354→            } catch (err) {\n   355→              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to list instances: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n   356→            }\n   357→            break;\n   358→\n   359→          case 'launcher:discover':\n   360→            try {\n   361→              // Update discovery with current registered projects\n   362→              const registeredProjects = await projectRegistry.listProjects();\n   363→              projectDiscovery.updateRegistered(registeredProjects);\n   364→              const discoveredProjects = await projectDiscovery.discover();\n   365→              ws.send(JSON.stringify({ type: 'launcher:discover:result', payload: discoveredProjects }));\n   366→            } catch (err) {\n   367→              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to discover projects: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n   368→            }\n   369→            break;\n   370→        }\n   371→      } catch (err) {\n   372→        console.error('Error handling message:', err);\n   373→      }\n   374→    });\n   375→\n   376→    ws.on('close', () => {\n   377→      clients.delete(ws);\n   378→      console.log('Client disconnected. Total clients:', clients.size);\n   379→    });\n   380→  });\n   381→\n   382→  // File watcher events\n   383→  fileWatcher.on('tasks', (tasks) => {\n   384→    broadcast({ type: 'tasks:update', payload: tasks });\n   385→  });\n   386→\n   387→  fileWatcher.on('log', (entry) => {\n   388→    broadcast({ type: 'loop:log', payload: entry });\n   389→  });\n   390→\n   391→  fileWatcher.on('git', (status) => {\n   392→    broadcast({ type: 'git:update', payload: status });\n   393→  });\n   394→\n   395→  // File watcher config refresh events (when PRD.md or AUDIENCE_JTBD.md change)\n   396→  fileWatcher.on('config:refresh', async () => {\n   397→    try {\n   398→      const updatedConfig = await projectConfig.refresh();\n   399→      broadcast({ type: 'config:update', payload: updatedConfig });\n   400→    } catch (err) {\n   401→      console.error('Error refreshing config:', err);\n   402→    }\n   403→  });\n   404→\n   405→  // Loop controller events\n   406→  loopController.on('status', (status) => {\n   407→    broadcast({ type: 'loop:status', payload: status });\n   408→  });\n   409→\n   410→  loopController.on('log', (entry) => {\n   411→    broadcast({ type: 'loop:log', payload: entry });\n   412→  });\n   413→\n   414→  // Plan generator events\n   415→  planGenerator.on('status', (status) => {\n   416→    broadcast({ type: 'plan:status', payload: status });\n   417→  });\n   418→\n   419→  planGenerator.on('output', (text) => {\n   420→    broadcast({ type: 'plan:output', payload: { text } });\n   421→  });\n   422→\n   423→  planGenerator.on('log', (text) => {\n   424→    broadcast({ type: 'plan:log', payload: { text } });\n   425→  });\n   426→\n   427→  planGenerator.on('complete', (result) => {\n   428→    broadcast({ type: 'plan:complete', payload: result });\n   429→  });\n   430→\n   431→  planGenerator.on('error', (error) => {\n   432→    broadcast({ type: 'plan:error', payload: { error } });\n   433→  });\n   434→\n   435→  planGenerator.on('cancelled', () => {\n   436→    broadcast({ type: 'plan:error', payload: { error: 'Plan generation cancelled' } });\n   437→  });\n   438→\n   439→  // PRD generator events\n   440→  prdGenerator.on('status', (status) => {\n   441→    broadcast({ type: 'prd:status', payload: status });\n   442→  });\n   443→\n   444→  prdGenerator.on('output', (text) => {\n   445→    broadcast({ type: 'prd:output', payload: { text } });\n   446→  });\n   447→\n   448→  prdGenerator.on('log', (text) => {\n   449→    broadcast({ type: 'prd:log', payload: { text } });\n   450→  });\n   451→\n   452→  prdGenerator.on('complete', (result) => {\n   453→    broadcast({ type: 'prd:complete', payload: result });\n   454→  });\n   455→\n   456→  prdGenerator.on('error', (error) => {\n   457→    broadcast({ type: 'prd:error', payload: { error } });\n   458→  });\n   459→\n   460→  prdGenerator.on('cancelled', () => {\n   461→    broadcast({ type: 'prd:error', payload: { error: 'PRD generation cancelled' } });\n   462→  });\n   463→\n   464→  // Instance spawner events\n   465→  instanceSpawner.on('stopped', (data: { projectId: string }) => {\n   466→    broadcast({ type: 'launcher:instance:stopped', payload: data });\n   467→    const instances = instanceSpawner.listInstances();\n   468→    broadcast({ type: 'launcher:instances:list', payload: instances });\n   469→  });\n   470→\n   471→  instanceSpawner.on('crashed', (data: { projectId: string; error: string }) => {\n   472→    broadcast({ type: 'launcher:instance:crashed', payload: data });\n   473→    const instances = instanceSpawner.listInstances();\n   474→    broadcast({ type: 'launcher:instances:list', payload: instances });\n   475→  });\n   476→\n   477→  // REST API endpoints\n   478→  app.get('/api/status', (req, res) => {\n   479→    res.json({\n   480→      loop: loopController.getStatus(),\n   481→      tasks: fileWatcher.getTasks(),\n   482→      git: fileWatcher.getGitStatus(),\n   483→      config: projectConfig.getConfig(),\n   484→    });\n   485→  });\n   486→\n   487→  // New endpoint to get project info\n   488→  app.get('/api/project-info', (req, res) => {\n   489→    res.json(projectRoot);\n   490→  });\n   491→\n   492→  app.get('/api/config/:file', async (req, res) => {\n   493→    try {\n   494→      const content = await projectConfig.readFile(req.params.file);\n   495→      res.json({ content });\n   496→    } catch (err) {\n   497→      res.status(404).json({ error: 'File not found' });\n   498→    }\n   499→  });\n   500→\n   501→  app.post('/api/config/:file', async (req, res) => {\n   502→    try {\n   503→      await projectConfig.writeFile(req.params.file, req.body.content);\n   504→      res.json({ success: true });\n   505→    } catch (err) {\n   506→      res.status(500).json({ error: 'Failed to save file' });\n   507→    }\n   508→  });\n   509→\n   510→  app.post('/api/loop/start', (req, res) => {\n   511→    loopController.start(req.body);\n   512→    res.json({ success: true });\n   513→  });\n   514→\n   515→  app.post('/api/loop/stop', (req, res) => {\n   516→    loopController.stop();\n   517→    res.json({ success: true });\n   518→  });\n   519→\n   520→  // Start file watchers\n   521→  fileWatcher.start();\n   522→\n   523→  // Start server\n   524→  const PORT = process.env.PORT || 3001;\n   525→  server.listen(PORT, () => {\n   526→    console.log(`Ralph Dashboard server running on port ${PORT}`);\n   527→    console.log(`Target project: ${TARGET_PROJECT_PATH}`);\n   528→    if (projectRoot.mode === 'embedded') {\n   529→      console.log(`Ralph directory: ${RALPH_PATH}`);\n   530→    }\n   531→  });\n   532→\n   533→  // Cleanup on exit\n   534→  process.on('SIGINT', async () => {\n   535→    console.log('Shutting down...');\n   536→    fileWatcher.stop();\n   537→    loopController.stop();\n   538→    // Stop all spawned instances\n   539→    await instanceSpawner.stopAll();\n   540→    server.close();\n   541→    process.exit(0);\n   542→  });\n   543→}\n   544→\n   545→// Start the server\n   546→startServer().catch((err) => {\n   547→  console.error('Failed to start server:', err);\n   548→  process.exit(1);\n   549→});\n   550→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01G7tMEzuWthUnpC57X8uxGU","session_id":"2114ed30-b19e-4096-a327-936d9cd9d573","uuid":"cb27cddc-9f01-47d4-a3d4-69e4f1412b73","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\xsams\\RalphWiggumV3\\RalphWiggumV2\\dashboard\\server\\index.ts","content":"import express from 'express';\nimport { createServer } from 'http';\nimport { WebSocketServer, WebSocket } from 'ws';\nimport cors from 'cors';\nimport path from 'path';\nimport { fileURLToPath } from 'url';\nimport fs from 'fs/promises';\nimport { FileWatcher } from './fileWatcher.js';\nimport { LoopController } from './loopController.js';\nimport { ProjectConfigManager } from './projectConfig.js';\nimport { PlanGenerator } from './planGenerator.js';\nimport { PRDGenerator } from './prdGenerator.js';\nimport { ProjectScanner } from './projectScanner.js';\nimport { detectProjectRoot, formatProjectInfo, type ProjectRootResult } from './projectRootDetector.js';\nimport { checkAllDependencies } from './dependencyChecker.js';\nimport { ProjectRegistry } from './projectRegistry.js';\nimport { InstanceSpawner } from './instanceSpawner.js';\nimport { ProjectDiscovery } from './projectDiscovery.js';\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\n\n// Detect project root (async initialization)\nconst RALPH_DEFAULT_PATH = path.resolve(__dirname, '../..');\n\n// Initialize project detection and return paths\nasync function initializeProjectPaths(): Promise<ProjectRootResult> {\n  // Allow explicit override via environment\n  if (process.env.PROJECT_PATH) {\n    return {\n      targetProjectPath: process.env.PROJECT_PATH,\n      ralphPath: RALPH_DEFAULT_PATH,\n      mode: 'embedded',\n      detectionReason: 'Explicitly set via PROJECT_PATH environment variable',\n    };\n  }\n  return detectProjectRoot(RALPH_DEFAULT_PATH);\n}\n\n// Start server after initialization\nasync function startServer() {\n  const projectRoot = await initializeProjectPaths();\n  const TARGET_PROJECT_PATH = projectRoot.targetProjectPath;\n  const RALPH_PATH = projectRoot.ralphPath;\n\n  console.log('\\n' + formatProjectInfo(projectRoot) + '\\n');\n\n  const app = express();\n  const server = createServer(app);\n  const wss = new WebSocketServer({ server, path: '/ws' });\n\n  app.use(cors());\n  app.use(express.json());\n\n  // Initialize services with appropriate paths\n  const projectConfig = new ProjectConfigManager(TARGET_PROJECT_PATH, RALPH_PATH);\n  const fileWatcher = new FileWatcher(TARGET_PROJECT_PATH);\n  const loopController = new LoopController(TARGET_PROJECT_PATH, RALPH_PATH);\n  const planGenerator = new PlanGenerator(TARGET_PROJECT_PATH, RALPH_PATH);\n  const prdGenerator = new PRDGenerator(TARGET_PROJECT_PATH, RALPH_PATH);\n  const projectScanner = new ProjectScanner(TARGET_PROJECT_PATH);\n\n  // Initialize launcher services\n  const projectRegistry = new ProjectRegistry();\n  const instanceSpawner = new InstanceSpawner(RALPH_PATH);\n  const projectDiscovery = new ProjectDiscovery();\n\n  // Track connected clients\n  const clients = new Set<WebSocket>();\n\n  // Broadcast to all connected clients\n  function broadcast(message: object) {\n    const data = JSON.stringify(message);\n    clients.forEach((client) => {\n      if (client.readyState === WebSocket.OPEN) {\n        client.send(data);\n      }\n    });\n  }\n\n  // WebSocket connection handler\n  wss.on('connection', (ws) => {\n    clients.add(ws);\n    console.log('Client connected. Total clients:', clients.size);\n\n    // Send initial state\n    ws.send(JSON.stringify({ type: 'loop:status', payload: loopController.getStatus() }));\n    ws.send(JSON.stringify({ type: 'tasks:update', payload: fileWatcher.getTasks() }));\n    ws.send(JSON.stringify({ type: 'git:update', payload: fileWatcher.getGitStatus() }));\n    ws.send(JSON.stringify({ type: 'config:update', payload: projectConfig.getConfig() }));\n    ws.send(JSON.stringify({ type: 'project:info', payload: projectRoot }));\n\n    // Handle messages from client\n    ws.on('message', async (data) => {\n      try {\n        const message = JSON.parse(data.toString());\n\n        switch (message.type) {\n          case 'loop:start':\n            loopController.start(message.payload);\n            break;\n          case 'loop:stop':\n            loopController.stop();\n            break;\n          case 'config:read':\n            const content = await projectConfig.readFile(message.payload.file);\n            ws.send(JSON.stringify({ type: 'config:content', payload: { file: message.payload.file, content } }));\n            break;\n          case 'config:write':\n            await projectConfig.writeFile(message.payload.file, message.payload.content);\n            ws.send(JSON.stringify({ type: 'config:saved', payload: { file: message.payload.file } }));\n            // Refresh config if PRD.md or AUDIENCE_JTBD.md was written\n            if (message.payload.file === 'PRD.md' || message.payload.file === 'AUDIENCE_JTBD.md') {\n              const updatedConfig = await projectConfig.refresh();\n              broadcast({ type: 'config:update', payload: updatedConfig });\n            }\n            break;\n          case 'config:refresh':\n            try {\n              const updatedConfig = await projectConfig.refresh();\n              broadcast({ type: 'config:update', payload: updatedConfig });\n              ws.send(JSON.stringify({ type: 'config:refreshed' }));\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'config:error', payload: { error: 'Failed to refresh config' } }));\n            }\n            break;\n          case 'agents:toggle':\n            await projectConfig.toggleAgent(message.payload.agentId, message.payload.enabled);\n            const enabledAgents = projectConfig.getEnabledAgents();\n            broadcast({ type: 'agents:update', payload: { enabledAgents } });\n            break;\n          case 'plan:generate':\n            try {\n              // Read PRD context if requested\n              let prdContext = '';\n              if (message.payload.usePrdContext) {\n                try {\n                  const prdContent = await projectConfig.readFile('PRD.md');\n                  const audienceContent = await projectConfig.readFile('AUDIENCE_JTBD.md');\n                  prdContext = `\n## Context: PRD.md\n${prdContent}\n\n## Context: AUDIENCE_JTBD.md\n${audienceContent}\n`;\n                } catch (err) {\n                  console.warn('Could not read PRD files:', err);\n                }\n              }\n              await planGenerator.generatePlan({ ...message.payload, prdContext });\n            } catch (err) {\n              console.error('Error generating plan:', err);\n              ws.send(JSON.stringify({ \n                type: 'plan:error', \n                payload: { error: err instanceof Error ? err.message : 'Failed to start plan generation' } \n              }));\n            }\n            break;\n          case 'plan:cancel':\n            planGenerator.cancel();\n            break;\n          case 'prd:generate':\n            prdGenerator.generatePRD(message.payload);\n            break;\n          case 'prd:cancel':\n            prdGenerator.cancel();\n            break;\n          case 'project:scan':\n            const scanResult = await projectScanner.scan();\n            ws.send(JSON.stringify({ type: 'project:scan-result', payload: scanResult }));\n            break;\n          case 'project:info':\n            ws.send(JSON.stringify({ type: 'project:info', payload: projectRoot }));\n            break;\n          case 'agents:list':\n            const agents = await projectConfig.listAvailableAgents();\n            ws.send(JSON.stringify({ type: 'agents:list-result', payload: agents }));\n            break;\n          case 'rules:list':\n            const rules = await projectConfig.listCursorRulesDetailed();\n            ws.send(JSON.stringify({ type: 'rules:list-result', payload: rules }));\n            break;\n          case 'rules:toggle':\n            const updatedRules = await projectConfig.toggleCursorRule(message.payload.ruleId, message.payload.enabled);\n            broadcast({ type: 'rules:update', payload: updatedRules });\n            break;\n          case 'docs:read':\n            try {\n              const docPath = message.payload.docPath;\n              // Validate path to prevent directory traversal\n              const normalizedPath = path.normalize(docPath);\n              if (normalizedPath.startsWith('..') || path.isAbsolute(normalizedPath)) {\n                ws.send(JSON.stringify({ type: 'docs:error', payload: { error: 'Invalid path' } }));\n                break;\n              }\n              const fullPath = path.join(TARGET_PROJECT_PATH, normalizedPath);\n              const docContent = await fs.readFile(fullPath, 'utf-8');\n              ws.send(JSON.stringify({ type: 'docs:content', payload: { path: docPath, content: docContent } }));\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'docs:error', payload: { error: 'Failed to read document' } }));\n            }\n            break;\n          case 'claude:list':\n            try {\n              const claudeFiles = await projectConfig.listClaudeMdFiles();\n              ws.send(JSON.stringify({ type: 'claude:list-result', payload: claudeFiles }));\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'claude:error', payload: { error: 'Failed to list CLAUDE.md files' } }));\n            }\n            break;\n          case 'claude:read':\n            try {\n              const claudeContent = await projectConfig.readClaudeMdFile(message.payload.path);\n              ws.send(JSON.stringify({ type: 'claude:content', payload: { path: message.payload.path, content: claudeContent } }));\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'claude:error', payload: { error: 'Failed to read CLAUDE.md' } }));\n            }\n            break;\n          case 'claude:apply':\n            try {\n              await projectConfig.applyRalphClaudeMd();\n              ws.send(JSON.stringify({ type: 'claude:applied' }));\n              // Refresh and broadcast config update\n              const updatedConfig = await projectConfig.refresh();\n              broadcast({ type: 'config:update', payload: updatedConfig });\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'claude:error', payload: { error: 'Failed to apply CLAUDE.md' } }));\n            }\n            break;\n          case 'dependencies:check':\n            try {\n              const depResults = await checkAllDependencies();\n              ws.send(JSON.stringify({ type: 'dependencies:result', payload: depResults }));\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'dependencies:error', payload: { error: 'Failed to check dependencies' } }));\n            }\n            break;\n          case 'agents:list-repo':\n            try {\n              const repoAgents = await projectConfig.listRepoAgents();\n              ws.send(JSON.stringify({ type: 'agents:repo-result', payload: repoAgents }));\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'agents:error', payload: { error: 'Failed to list repo agents' } }));\n            }\n            break;\n          case 'agents:install-global':\n            try {\n              await projectConfig.installAgentGlobal(message.payload.agentId);\n              ws.send(JSON.stringify({ type: 'agents:installed', payload: { agentId: message.payload.agentId, scope: 'global' } }));\n              // Send updated repo agents list\n              const updatedRepoAgents = await projectConfig.listRepoAgents();\n              ws.send(JSON.stringify({ type: 'agents:repo-result', payload: updatedRepoAgents }));\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'agents:error', payload: { error: `Failed to install agent globally: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n            }\n            break;\n          case 'agents:install-project':\n            try {\n              await projectConfig.installAgentProject(message.payload.agentId);\n              ws.send(JSON.stringify({ type: 'agents:installed', payload: { agentId: message.payload.agentId, scope: 'project' } }));\n              // Send updated repo agents list\n              const updatedRepoAgentsAfterProject = await projectConfig.listRepoAgents();\n              ws.send(JSON.stringify({ type: 'agents:repo-result', payload: updatedRepoAgentsAfterProject }));\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'agents:error', payload: { error: `Failed to install agent to project: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n            }\n            break;\n          case 'agents:install-all-global':\n            try {\n              await projectConfig.installAllAgentsGlobal();\n              ws.send(JSON.stringify({ type: 'agents:installed', payload: { agentId: 'all', scope: 'global' } }));\n              // Send updated repo agents list\n              const updatedRepoAgentsAll = await projectConfig.listRepoAgents();\n              ws.send(JSON.stringify({ type: 'agents:repo-result', payload: updatedRepoAgentsAll }));\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'agents:error', payload: { error: `Failed to install all agents: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n            }\n            break;\n\n          // ============================================\n          // Launcher WebSocket Handlers\n          // ============================================\n          case 'launcher:projects:list':\n            try {\n              const projects = await projectRegistry.listProjects();\n              ws.send(JSON.stringify({ type: 'launcher:projects:list', payload: projects }));\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to list projects: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n            }\n            break;\n\n          case 'launcher:projects:add':\n            try {\n              const newProject = await projectRegistry.addProject(message.payload.path);\n              ws.send(JSON.stringify({ type: 'launcher:project:added', payload: newProject }));\n              // Broadcast updated list to all clients\n              const updatedProjects = await projectRegistry.listProjects();\n              broadcast({ type: 'launcher:projects:list', payload: updatedProjects });\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to add project: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n            }\n            break;\n\n          case 'launcher:projects:remove':\n            try {\n              // Stop instance if running\n              if (instanceSpawner.isRunning(message.payload.projectId)) {\n                await instanceSpawner.stopInstance(message.payload.projectId);\n              }\n              await projectRegistry.removeProject(message.payload.projectId);\n              ws.send(JSON.stringify({ type: 'launcher:project:removed', payload: { projectId: message.payload.projectId } }));\n              // Broadcast updated list to all clients\n              const projectsAfterRemove = await projectRegistry.listProjects();\n              broadcast({ type: 'launcher:projects:list', payload: projectsAfterRemove });\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to remove project: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n            }\n            break;\n\n          case 'launcher:instance:spawn':\n            try {\n              const project = await projectRegistry.getProject(message.payload.projectId);\n              if (!project) {\n                throw new Error('Project not found');\n              }\n              const instance = await instanceSpawner.spawnInstance(project.id, project.path);\n              await projectRegistry.updateLastOpened(project.id);\n              ws.send(JSON.stringify({ type: 'launcher:instance:spawned', payload: instance }));\n              // Broadcast updated instances list to all clients\n              const instances = instanceSpawner.listInstances();\n              broadcast({ type: 'launcher:instances:list', payload: instances });\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to spawn instance: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n            }\n            break;\n\n          case 'launcher:instance:stop':\n            try {\n              await instanceSpawner.stopInstance(message.payload.projectId);\n              ws.send(JSON.stringify({ type: 'launcher:instance:stopped', payload: { projectId: message.payload.projectId } }));\n              // Broadcast updated instances list to all clients\n              const instancesAfterStop = instanceSpawner.listInstances();\n              broadcast({ type: 'launcher:instances:list', payload: instancesAfterStop });\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to stop instance: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n            }\n            break;\n\n          case 'launcher:instances:list':\n            try {\n              const runningInstances = instanceSpawner.listInstances();\n              ws.send(JSON.stringify({ type: 'launcher:instances:list', payload: runningInstances }));\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to list instances: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n            }\n            break;\n\n          case 'launcher:discover':\n            try {\n              // Update discovery with current registered projects\n              const registeredProjects = await projectRegistry.listProjects();\n              projectDiscovery.updateRegistered(registeredProjects);\n              const discoveredProjects = await projectDiscovery.discover();\n              ws.send(JSON.stringify({ type: 'launcher:discover:result', payload: discoveredProjects }));\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to discover projects: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n            }\n            break;\n        }\n      } catch (err) {\n        console.error('Error handling message:', err);\n      }\n    });\n\n    ws.on('close', () => {\n      clients.delete(ws);\n      console.log('Client disconnected. Total clients:', clients.size);\n    });\n  });\n\n  // File watcher events\n  fileWatcher.on('tasks', (tasks) => {\n    broadcast({ type: 'tasks:update', payload: tasks });\n  });\n\n  fileWatcher.on('log', (entry) => {\n    broadcast({ type: 'loop:log', payload: entry });\n  });\n\n  fileWatcher.on('git', (status) => {\n    broadcast({ type: 'git:update', payload: status });\n  });\n\n  // File watcher config refresh events (when PRD.md or AUDIENCE_JTBD.md change)\n  fileWatcher.on('config:refresh', async () => {\n    try {\n      const updatedConfig = await projectConfig.refresh();\n      broadcast({ type: 'config:update', payload: updatedConfig });\n    } catch (err) {\n      console.error('Error refreshing config:', err);\n    }\n  });\n\n  // Loop controller events\n  loopController.on('status', (status) => {\n    broadcast({ type: 'loop:status', payload: status });\n  });\n\n  loopController.on('log', (entry) => {\n    broadcast({ type: 'loop:log', payload: entry });\n  });\n\n  // Plan generator events\n  planGenerator.on('status', (status) => {\n    broadcast({ type: 'plan:status', payload: status });\n  });\n\n  planGenerator.on('output', (text) => {\n    broadcast({ type: 'plan:output', payload: { text } });\n  });\n\n  planGenerator.on('log', (text) => {\n    broadcast({ type: 'plan:log', payload: { text } });\n  });\n\n  planGenerator.on('complete', (result) => {\n    broadcast({ type: 'plan:complete', payload: result });\n  });\n\n  planGenerator.on('error', (error) => {\n    broadcast({ type: 'plan:error', payload: { error } });\n  });\n\n  planGenerator.on('cancelled', () => {\n    broadcast({ type: 'plan:error', payload: { error: 'Plan generation cancelled' } });\n  });\n\n  // PRD generator events\n  prdGenerator.on('status', (status) => {\n    broadcast({ type: 'prd:status', payload: status });\n  });\n\n  prdGenerator.on('output', (text) => {\n    broadcast({ type: 'prd:output', payload: { text } });\n  });\n\n  prdGenerator.on('log', (text) => {\n    broadcast({ type: 'prd:log', payload: { text } });\n  });\n\n  prdGenerator.on('complete', (result) => {\n    broadcast({ type: 'prd:complete', payload: result });\n  });\n\n  prdGenerator.on('error', (error) => {\n    broadcast({ type: 'prd:error', payload: { error } });\n  });\n\n  prdGenerator.on('cancelled', () => {\n    broadcast({ type: 'prd:error', payload: { error: 'PRD generation cancelled' } });\n  });\n\n  // Instance spawner events\n  instanceSpawner.on('stopped', (data: { projectId: string }) => {\n    broadcast({ type: 'launcher:instance:stopped', payload: data });\n    const instances = instanceSpawner.listInstances();\n    broadcast({ type: 'launcher:instances:list', payload: instances });\n  });\n\n  instanceSpawner.on('crashed', (data: { projectId: string; error: string }) => {\n    broadcast({ type: 'launcher:instance:crashed', payload: data });\n    const instances = instanceSpawner.listInstances();\n    broadcast({ type: 'launcher:instances:list', payload: instances });\n  });\n\n  // REST API endpoints\n  app.get('/api/status', (req, res) => {\n    res.json({\n      loop: loopController.getStatus(),\n      tasks: fileWatcher.getTasks(),\n      git: fileWatcher.getGitStatus(),\n      config: projectConfig.getConfig(),\n    });\n  });\n\n  // New endpoint to get project info\n  app.get('/api/project-info', (req, res) => {\n    res.json(projectRoot);\n  });\n\n  app.get('/api/config/:file', async (req, res) => {\n    try {\n      const content = await projectConfig.readFile(req.params.file);\n      res.json({ content });\n    } catch (err) {\n      res.status(404).json({ error: 'File not found' });\n    }\n  });\n\n  app.post('/api/config/:file', async (req, res) => {\n    try {\n      await projectConfig.writeFile(req.params.file, req.body.content);\n      res.json({ success: true });\n    } catch (err) {\n      res.status(500).json({ error: 'Failed to save file' });\n    }\n  });\n\n  app.post('/api/loop/start', (req, res) => {\n    loopController.start(req.body);\n    res.json({ success: true });\n  });\n\n  app.post('/api/loop/stop', (req, res) => {\n    loopController.stop();\n    res.json({ success: true });\n  });\n\n  // Start file watchers\n  fileWatcher.start();\n\n  // Start server\n  const PORT = process.env.PORT || 3001;\n  server.listen(PORT, () => {\n    console.log(`Ralph Dashboard server running on port ${PORT}`);\n    console.log(`Target project: ${TARGET_PROJECT_PATH}`);\n    if (projectRoot.mode === 'embedded') {\n      console.log(`Ralph directory: ${RALPH_PATH}`);\n    }\n  });\n\n  // Cleanup on exit\n  process.on('SIGINT', async () => {\n    console.log('Shutting down...');\n    fileWatcher.stop();\n    loopController.stop();\n    // Stop all spawned instances\n    await instanceSpawner.stopAll();\n    server.close();\n    process.exit(0);\n  });\n}\n\n// Start the server\nstartServer().catch((err) => {\n  console.error('Failed to start server:', err);\n  process.exit(1);\n});\n","numLines":550,"startLine":1,"totalLines":550}}}
