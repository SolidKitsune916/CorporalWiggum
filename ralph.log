{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011zudhTXGwU5TcsYMarrHkb","type":"tool_result","content":"     1→import { useState, useEffect } from 'react';\n     2→import { Card, CardContent, CardHeader, CardTitle, CardDescription } from '@/components/ui/card';\n     3→import { Button } from '@/components/ui/button';\n     4→import { Input } from '@/components/ui/input';\n     5→import { Label } from '@/components/ui/label';\n     6→import { Badge } from '@/components/ui/badge';\n     7→import { ScrollArea } from '@/components/ui/scroll-area';\n     8→import { Progress } from '@/components/ui/progress';\n     9→import type { ProjectScan, ProjectInfo, WorkflowMode } from '@/types';\n    10→import {\n    11→  Search,\n    12→  Check,\n    13→  ChevronRight,\n    14→  Folder,\n    15→  FileText,\n    16→  Package,\n    17→  Code,\n    18→  Terminal,\n    19→  Loader2,\n    20→  AlertCircle,\n    21→  Sparkles,\n    22→  FileCode,\n    23→  Settings,\n    24→  ExternalLink,\n    25→  Zap,\n    26→  Rocket,\n    27→} from 'lucide-react';\n    28→\n    29→interface OnboardingWizardProps {\n    30→  projectScan: ProjectScan | null;\n    31→  projectInfo: ProjectInfo | null;\n    32→  scanLoading: boolean;\n    33→  workflowMode: WorkflowMode;\n    34→  onWorkflowModeChange: (mode: WorkflowMode) => void;\n    35→  onScanProject: () => void;\n    36→  onSaveAgentsMd: (content: string) => void;\n    37→  onComplete: () => void;\n    38→  onSkip: () => void;\n    39→}\n    40→\n    41→type WizardStep = 'welcome' | 'mode' | 'scanning' | 'results' | 'configure' | 'docs' | 'complete';\n    42→\n    43→export function OnboardingWizard({\n    44→  projectScan,\n    45→  projectInfo,\n    46→  scanLoading,\n    47→  workflowMode,\n    48→  onWorkflowModeChange,\n    49→  onScanProject,\n    50→  onSaveAgentsMd,\n    51→  onComplete,\n    52→  onSkip,\n    53→}: OnboardingWizardProps) {\n    54→  const [step, setStep] = useState<WizardStep>('welcome');\n    55→  const [commands, setCommands] = useState({\n    56→    build: '',\n    57→    dev: '',\n    58→    test: '',\n    59→    lint: '',\n    60→    typecheck: '',\n    61→  });\n    62→\n    63→  // Update commands when scan results come in\n    64→  useEffect(() => {\n    65→    if (projectScan?.detectedCommands) {\n    66→      setCommands({\n    67→        build: projectScan.detectedCommands.build || '',\n    68→        dev: projectScan.detectedCommands.dev || '',\n    69→        test: projectScan.detectedCommands.test || '',\n    70→        lint: projectScan.detectedCommands.lint || '',\n    71→        typecheck: projectScan.detectedCommands.typecheck || '',\n    72→      });\n    73→    }\n    74→  }, [projectScan]);\n    75→\n    76→  // Handle scan completion\n    77→  useEffect(() => {\n    78→    if (step === 'scanning' && projectScan && !scanLoading) {\n    79→      setStep('results');\n    80→    }\n    81→  }, [step, projectScan, scanLoading]);\n    82→\n    83→  const handleStartScan = () => {\n    84→    // Go to mode selection first\n    85→    setStep('mode');\n    86→  };\n    87→\n    88→  const handleModeSelected = () => {\n    89→    setStep('scanning');\n    90→    onScanProject();\n    91→  };\n    92→\n    93→  const generateAgentsMd = () => {\n    94→    const pm = projectScan?.packageManager || 'npm';\n    95→    const framework = projectScan?.framework || 'Unknown';\n    96→    const language = projectScan?.language || 'unknown';\n    97→\n    98→    return `## Build & Run\n    99→\n   100→Succinct rules for how to BUILD the project:\n   101→\n   102→- Build: \\`${commands.build || `${pm} run build`}\\`\n   103→- Run: \\`${commands.dev || `${pm} run start`}\\`\n   104→- Dev server: \\`${commands.dev || `${pm} run dev`}\\`\n   105→\n   106→## Validation\n   107→\n   108→Run these after implementing to get immediate feedback:\n   109→\n   110→- Tests: \\`${commands.test || `${pm} test`}\\`\n   111→- Typecheck: \\`${commands.typecheck || 'npx tsc --noEmit'}\\`\n   112→- Lint: \\`${commands.lint || `${pm} run lint`}\\`\n   113→\n   114→## Operational Notes\n   115→\n   116→Project: ${projectScan?.projectName || 'Unknown'}\n   117→Framework: ${framework}\n   118→Language: ${language}\n   119→\n   120→### Codebase Patterns\n   121→\n   122→[Ralph will add learnings here as patterns are discovered]\n   123→\n   124→## Operational Learnings\n   125→\n   126→[Ralph will add learnings here about how to run/build the project]\n   127→`;\n   128→  };\n   129→\n   130→  const handleSaveConfig = () => {\n   131→    const content = generateAgentsMd();\n   132→    onSaveAgentsMd(content);\n   133→    setStep('docs');\n   134→  };\n   135→\n   136→  const handleFinish = () => {\n   137→    onComplete();\n   138→  };\n   139→\n   140→  const getStepProgress = () => {\n   141→    const steps: WizardStep[] = ['welcome', 'mode', 'scanning', 'results', 'configure', 'docs', 'complete'];\n   142→    const currentIndex = steps.indexOf(step);\n   143→    return ((currentIndex + 1) / steps.length) * 100;\n   144→  };\n   145→\n   146→  return (\n   147→    <div className=\"min-h-screen bg-background flex items-center justify-center p-6\">\n   148→      <div className=\"w-full max-w-2xl\">\n   149→        {/* Progress bar */}\n   150→        <div className=\"mb-8\">\n   151→          <Progress value={getStepProgress()} className=\"h-2\" />\n   152→        </div>\n   153→\n   154→        {/* Welcome Step */}\n   155→        {step === 'welcome' && (\n   156→          <Card className=\"text-center\">\n   157→            <CardHeader className=\"pb-4\">\n   158→              <div className=\"mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-primary/10\">\n   159→                <Sparkles className=\"h-8 w-8 text-primary\" />\n   160→              </div>\n   161→              <CardTitle className=\"text-2xl\">Welcome to <span className=\"text-primary\">WIGGUM</span></CardTitle>\n   162→              <CardDescription className=\"text-base\">\n   163→                Let's set up your project for autonomous AI-powered development.\n   164→              </CardDescription>\n   165→            </CardHeader>\n   166→            <CardContent className=\"space-y-6\">\n   167→              {/* Show embedded mode info */}\n   168→              {projectInfo && projectInfo.mode === 'embedded' && (\n   169→                <div className=\"p-4 rounded-lg bg-green-500/10 border border-green-500/20 text-left\">\n   170→                  <div className=\"flex items-start gap-3\">\n   171→                    <ExternalLink className=\"h-5 w-5 text-green-600 mt-0.5\" />\n   172→                    <div>\n   173→                      <p className=\"font-medium text-green-700\">Embedded Mode Detected</p>\n   174→                      <p className=\"text-sm text-green-600/80 mt-1\">\n   175→                        WIGGUM will analyze your parent project:\n   176→                      </p>\n   177→                      <code className=\"text-xs bg-green-500/10 px-2 py-1 rounded mt-2 block truncate\">\n   178→                        {projectInfo.targetProjectPath}\n   179→                      </code>\n   180→                    </div>\n   181→                  </div>\n   182→                </div>\n   183→              )}\n   184→              <div className=\"text-left space-y-4 bg-muted/50 rounded-lg p-4\">\n   185→                <div className=\"flex items-start gap-3\">\n   186→                  <Search className=\"h-5 w-5 text-muted-foreground mt-0.5\" />\n   187→                  <div>\n   188→                    <p className=\"font-medium\">Scan your project</p>\n   189→                    <p className=\"text-sm text-muted-foreground\">\n   190→                      Detect framework, language, and build commands\n   191→                    </p>\n   192→                  </div>\n   193→                </div>\n   194→                <div className=\"flex items-start gap-3\">\n   195→                  <Settings className=\"h-5 w-5 text-muted-foreground mt-0.5\" />\n   196→                  <div>\n   197→                    <p className=\"font-medium\">Configure AGENTS.md</p>\n   198→                    <p className=\"text-sm text-muted-foreground\">\n   199→                      Set up commands for WIGGUM to use\n   200→                    </p>\n   201→                  </div>\n   202→                </div>\n   203→                <div className=\"flex items-start gap-3\">\n   204→                  <FileText className=\"h-5 w-5 text-muted-foreground mt-0.5\" />\n   205→                  <div>\n   206→                    <p className=\"font-medium\">Import documentation</p>\n   207→                    <p className=\"text-sm text-muted-foreground\">\n   208→                      Consolidate existing docs into WIGGUM's structure\n   209→                    </p>\n   210→                  </div>\n   211→                </div>\n   212→              </div>\n   213→\n   214→              <div className=\"flex gap-3 justify-center\">\n   215→                <Button onClick={handleStartScan} size=\"lg\" className=\"gap-2\">\n   216→                  <Search className=\"h-4 w-4\" />\n   217→                  Scan My Project\n   218→                </Button>\n   219→                <Button variant=\"ghost\" onClick={onSkip}>\n   220→                  Skip Setup\n   221→                </Button>\n   222→              </div>\n   223→            </CardContent>\n   224→          </Card>\n   225→        )}\n   226→\n   227→        {/* Mode Selection Step */}\n   228→        {step === 'mode' && (\n   229→          <Card>\n   230→            <CardHeader className=\"text-center\">\n   231→              <CardTitle>Choose Your Workflow</CardTitle>\n   232→              <CardDescription>\n   233→                Select how you want to define and track tasks for Ralph\n   234→              </CardDescription>\n   235→            </CardHeader>\n   236→            <CardContent className=\"space-y-6\">\n   237→              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n   238→                {/* Simple Mode Card */}\n   239→                <button\n   240→                  onClick={() => onWorkflowModeChange('simple')}\n   241→                  className={`text-left p-5 rounded-lg border-2 transition-all ${\n   242→                    workflowMode === 'simple'\n   243→                      ? 'border-primary bg-primary/5 shadow-md'\n   244→                      : 'border-border hover:border-muted-foreground'\n   245→                  }`}\n   246→                >\n   247→                  <div className=\"flex items-center gap-3 mb-3\">\n   248→                    <div className={`p-2 rounded-lg ${\n   249→                      workflowMode === 'simple' ? 'bg-primary/10' : 'bg-muted'\n   250→                    }`}>\n   251→                      <Zap className={`h-5 w-5 ${\n   252→                        workflowMode === 'simple' ? 'text-primary' : 'text-muted-foreground'\n   253→                      }`} />\n   254→                    </div>\n   255→                    <div>\n   256→                      <h3 className=\"font-semibold\">Simple Mode</h3>\n   257→                      <span className=\"text-xs text-green-500 font-medium\">Recommended</span>\n   258→                    </div>\n   259→                  </div>\n   260→                  <p className=\"text-sm text-muted-foreground mb-3\">\n   261→                    Uses <code className=\"px-1 py-0.5 bg-muted rounded text-xs\">prd.json</code> with user stories\n   262→                  </p>\n   263→                  <ul className=\"space-y-1.5 text-sm text-muted-foreground\">\n   264→                    <li className=\"flex items-center gap-2\">\n   265→                      <Check className=\"h-3.5 w-3.5 text-green-500\" />\n   266→                      Quick setup - start building immediately\n   267→                    </li>\n   268→                    <li className=\"flex items-center gap-2\">\n   269→                      <Check className=\"h-3.5 w-3.5 text-green-500\" />\n   270→                      Best for MVPs and feature development\n   271→                    </li>\n   272→                    <li className=\"flex items-center gap-2\">\n   273→                      <Check className=\"h-3.5 w-3.5 text-green-500\" />\n   274→                      Learnings logged to progress.txt\n   275→                    </li>\n   276→                  </ul>\n   277→                </button>\n   278→\n   279→                {/* Advanced Mode Card */}\n   280→                <button\n   281→                  onClick={() => onWorkflowModeChange('advanced')}\n   282→                  className={`text-left p-5 rounded-lg border-2 transition-all ${\n   283→                    workflowMode === 'advanced'\n   284→                      ? 'border-primary bg-primary/5 shadow-md'\n   285→                      : 'border-border hover:border-muted-foreground'\n   286→                  }`}\n   287→                >\n   288→                  <div className=\"flex items-center gap-3 mb-3\">\n   289→                    <div className={`p-2 rounded-lg ${\n   290→                      workflowMode === 'advanced' ? 'bg-primary/10' : 'bg-muted'\n   291→                    }`}>\n   292→                      <Rocket className={`h-5 w-5 ${\n   293→                        workflowMode === 'advanced' ? 'text-primary' : 'text-muted-foreground'\n   294→                      }`} />\n   295→                    </div>\n   296→                    <div>\n   297→                      <h3 className=\"font-semibold\">Advanced Mode</h3>\n   298→                      <span className=\"text-xs text-muted-foreground font-medium\">Full Planning</span>\n   299→                    </div>\n   300→                  </div>\n   301→                  <p className=\"text-sm text-muted-foreground mb-3\">\n   302→                    Uses <code className=\"px-1 py-0.5 bg-muted rounded text-xs\">IMPLEMENTATION_PLAN.md</code> and specs\n   303→                  </p>\n   304→                  <ul className=\"space-y-1.5 text-sm text-muted-foreground\">\n   305→                    <li className=\"flex items-center gap-2\">\n   306→                      <Check className=\"h-3.5 w-3.5 text-blue-500\" />\n   307→                      Full planning workflow with PRD\n   308→                    </li>\n   309→                    <li className=\"flex items-center gap-2\">\n   310→                      <Check className=\"h-3.5 w-3.5 text-blue-500\" />\n   311→                      Best for complex systems\n   312→                    </li>\n   313→                    <li className=\"flex items-center gap-2\">\n   314→                      <Check className=\"h-3.5 w-3.5 text-blue-500\" />\n   315→                      Specs-driven development\n   316→                    </li>\n   317→                  </ul>\n   318→                </button>\n   319→              </div>\n   320→\n   321→              <p className=\"text-xs text-center text-muted-foreground\">\n   322→                You can switch between modes anytime from the dashboard header.\n   323→              </p>\n   324→\n   325→              <div className=\"flex justify-center gap-3 pt-4\">\n   326→                <Button variant=\"outline\" onClick={() => setStep('welcome')}>\n   327→                  Back\n   328→                </Button>\n   329→                <Button onClick={handleModeSelected} className=\"gap-2\">\n   330→                  Continue\n   331→                  <ChevronRight className=\"h-4 w-4\" />\n   332→                </Button>\n   333→              </div>\n   334→            </CardContent>\n   335→          </Card>\n   336→        )}\n   337→\n   338→        {/* Scanning Step */}\n   339→        {step === 'scanning' && (\n   340→          <Card className=\"text-center\">\n   341→            <CardHeader>\n   342→              <div className=\"mx-auto mb-4\">\n   343→                <Loader2 className=\"h-12 w-12 animate-spin text-primary\" />\n   344→              </div>\n   345→              <CardTitle>Scanning Your Project</CardTitle>\n   346→              <CardDescription>\n   347→                Analyzing codebase, detecting frameworks, and finding documentation...\n   348→              </CardDescription>\n   349→            </CardHeader>\n   350→            <CardContent>\n   351→              <div className=\"space-y-2 text-sm text-muted-foreground\">\n   352→                <p>Checking package.json...</p>\n   353→                <p>Detecting build tools...</p>\n   354→                <p>Finding existing documentation...</p>\n   355→              </div>\n   356→            </CardContent>\n   357→          </Card>\n   358→        )}\n   359→\n   360→        {/* Results Step */}\n   361→        {step === 'results' && projectScan && (\n   362→          <Card>\n   363→            <CardHeader>\n   364→              <div className=\"flex items-center gap-2\">\n   365→                <Check className=\"h-5 w-5 text-green-500\" />\n   366→                <CardTitle>Project Analysis Complete</CardTitle>\n   367→              </div>\n   368→              <CardDescription>\n   369→                Here's what we found in your project.\n   370→              </CardDescription>\n   371→            </CardHeader>\n   372→            <CardContent className=\"space-y-6\">\n   373→              {/* Project Path Info */}\n   374→              {projectInfo && projectInfo.mode === 'embedded' && (\n   375→                <div className=\"p-3 rounded-lg bg-green-500/10 border border-green-500/20\">\n   376→                  <div className=\"flex items-center gap-2 text-green-700\">\n   377→                    <ExternalLink className=\"h-4 w-4\" />\n   378→                    <span className=\"text-sm font-medium\">Analyzing parent project</span>\n   379→                  </div>\n   380→                  <code className=\"text-xs text-green-600/80 mt-1 block truncate\">\n   381→                    {projectInfo.targetProjectPath}\n   382→                  </code>\n   383→                </div>\n   384→              )}\n   385→\n   386→              {/* Detected Info */}\n   387→              <div className=\"space-y-3\">\n   388→                <h3 className=\"font-semibold flex items-center gap-2\">\n   389→                  <Code className=\"h-4 w-4\" />\n   390→                  Detected Configuration\n   391→                </h3>\n   392→                <div className=\"grid grid-cols-2 gap-3\">\n   393→                  <div className=\"flex items-center gap-2 p-3 rounded-lg bg-muted/50\">\n   394→                    <Package className=\"h-4 w-4 text-muted-foreground\" />\n   395→                    <div>\n   396→                      <p className=\"text-xs text-muted-foreground\">Framework</p>\n   397→                      <p className=\"font-medium\">{projectScan.framework || 'Not detected'}</p>\n   398→                    </div>\n   399→                  </div>\n   400→                  <div className=\"flex items-center gap-2 p-3 rounded-lg bg-muted/50\">\n   401→                    <FileCode className=\"h-4 w-4 text-muted-foreground\" />\n   402→                    <div>\n   403→                      <p className=\"text-xs text-muted-foreground\">Language</p>\n   404→                      <p className=\"font-medium capitalize\">{projectScan.language}</p>\n   405→                    </div>\n   406→                  </div>\n   407→                  <div className=\"flex items-center gap-2 p-3 rounded-lg bg-muted/50\">\n   408→                    <Terminal className=\"h-4 w-4 text-muted-foreground\" />\n   409→                    <div>\n   410→                      <p className=\"text-xs text-muted-foreground\">Package Manager</p>\n   411→                      <p className=\"font-medium\">{projectScan.packageManager || 'None'}</p>\n   412→                    </div>\n   413→                  </div>\n   414→                  <div className=\"flex items-center gap-2 p-3 rounded-lg bg-muted/50\">\n   415→                    <Folder className=\"h-4 w-4 text-muted-foreground\" />\n   416→                    <div>\n   417→                      <p className=\"text-xs text-muted-foreground\">Project</p>\n   418→                      <p className=\"font-medium truncate\">{projectScan.projectName}</p>\n   419→                    </div>\n   420→                  </div>\n   421→                </div>\n   422→              </div>\n   423→\n   424→              {/* Detected Subprojects (Monorepo) */}\n   425→              {projectScan.isMonorepo && projectScan.subprojects.length > 0 && (\n   426→                <div className=\"space-y-3\">\n   427→                  <h3 className=\"font-semibold flex items-center gap-2\">\n   428→                    <Folder className=\"h-4 w-4\" />\n   429→                    Detected Subprojects ({projectScan.subprojects.length})\n   430→                  </h3>\n   431→                  <div className=\"space-y-2\">\n   432→                    {projectScan.subprojects.map((sub) => (\n   433→                      <div\n   434→                        key={sub.path}\n   435→                        className=\"flex items-center gap-2 p-2 rounded-lg bg-muted/50\"\n   436→                      >\n   437→                        <Badge variant=\"outline\" className=\"capitalize\">\n   438→                          {sub.language}\n   439→                        </Badge>\n   440→                        <span className=\"font-medium\">{sub.name}</span>\n   441→                        <span className=\"text-xs text-muted-foreground\">/{sub.path}</span>\n   442→                        {sub.framework && (\n   443→                          <Badge variant=\"secondary\">{sub.framework}</Badge>\n   444→                        )}\n   445→                        {sub.packageManager && (\n   446→                          <span className=\"text-xs text-muted-foreground ml-auto\">\n   447→                            {sub.packageManager}\n   448→                          </span>\n   449→                        )}\n   450→                      </div>\n   451→                    ))}\n   452→                  </div>\n   453→                </div>\n   454→              )}\n   455→\n   456→              {/* Detected Commands */}\n   457→              {Object.values(projectScan.detectedCommands).some(Boolean) && (\n   458→                <div className=\"space-y-3\">\n   459→                  <h3 className=\"font-semibold flex items-center gap-2\">\n   460→                    <Terminal className=\"h-4 w-4\" />\n   461→                    Detected Commands\n   462→                  </h3>\n   463→                  <div className=\"space-y-2\">\n   464→                    {Object.entries(projectScan.detectedCommands).map(\n   465→                      ([key, value]) =>\n   466→                        value && (\n   467→                          <div key={key} className=\"flex items-center gap-2\">\n   468→                            <Badge variant=\"outline\" className=\"w-20 justify-center\">\n   469→                              {key}\n   470→                            </Badge>\n   471→                            <code className=\"text-sm bg-muted px-2 py-1 rounded flex-1\">\n   472→                              {value}\n   473→                            </code>\n   474→                          </div>\n   475→                        )\n   476→                    )}\n   477→                  </div>\n   478→                </div>\n   479→              )}\n   480→\n   481→              {/* Existing Docs */}\n   482→              {projectScan.existingDocs.length > 0 && (\n   483→                <div className=\"space-y-3\">\n   484→                  <h3 className=\"font-semibold flex items-center gap-2\">\n   485→                    <FileText className=\"h-4 w-4\" />\n   486→                    Existing Documentation\n   487→                  </h3>\n   488→                  <div className=\"space-y-2\">\n   489→                    {projectScan.existingDocs.slice(0, 5).map((doc) => (\n   490→                      <div\n   491→                        key={doc.path}\n   492→                        className=\"flex items-center justify-between p-2 rounded-lg bg-muted/50\"\n   493→                      >\n   494→                        <span className=\"text-sm\">{doc.path}</span>\n   495→                        <span className=\"text-xs text-muted-foreground\">\n   496→                          {(doc.size / 1024).toFixed(1)} KB\n   497→                        </span>\n   498→                      </div>\n   499→                    ))}\n   500→                  </div>\n   501→                </div>\n   502→              )}\n   503→\n   504→              {/* Ralph Config Status */}\n   505→              <div className=\"space-y-3\">\n   506→                <h3 className=\"font-semibold flex items-center gap-2\">\n   507→                  <Settings className=\"h-4 w-4\" />\n   508→                  Ralph Configuration Status\n   509→                </h3>\n   510→                <div className=\"flex flex-wrap gap-2\">\n   511→                  {Object.entries(projectScan.hasRalphConfig).map(([key, exists]) => (\n   512→                    <Badge key={key} variant={exists ? 'default' : 'secondary'}>\n   513→                      {exists ? <Check className=\"h-3 w-3 mr-1\" /> : null}\n   514→                      {key.replace(/([A-Z])/g, ' $1').trim()}\n   515→                    </Badge>\n   516→                  ))}\n   517→                </div>\n   518→              </div>\n   519→\n   520→              <div className=\"flex justify-end gap-3 pt-4\">\n   521→                <Button variant=\"outline\" onClick={() => setStep('welcome')}>\n   522→                  Back\n   523→                </Button>\n   524→                <Button onClick={() => setStep('configure')} className=\"gap-2\">\n   525→                  Continue to Configuration\n   526→                  <ChevronRight className=\"h-4 w-4\" />\n   527→                </Button>\n   528→              </div>\n   529→            </CardContent>\n   530→          </Card>\n   531→        )}\n   532→\n   533→        {/* Configure Step */}\n   534→        {step === 'configure' && projectScan && (\n   535→          <Card>\n   536→            <CardHeader>\n   537→              <CardTitle className=\"flex items-center gap-2\">\n   538→                <Settings className=\"h-5 w-5\" />\n   539→                Configure AGENTS.md\n   540→              </CardTitle>\n   541→              <CardDescription>\n   542→                Review and adjust the commands Ralph will use for your project.\n   543→              </CardDescription>\n   544→            </CardHeader>\n   545→            <CardContent className=\"space-y-6\">\n   546→              <div className=\"space-y-4\">\n   547→                <div className=\"space-y-2\">\n   548→                  <Label htmlFor=\"build\">Build Command</Label>\n   549→                  <Input\n   550→                    id=\"build\"\n   551→                    value={commands.build}\n   552→                    onChange={(e) => setCommands({ ...commands, build: e.target.value })}\n   553→                    placeholder={`${projectScan.packageManager || 'npm'} run build`}\n   554→                  />\n   555→                </div>\n   556→                <div className=\"space-y-2\">\n   557→                  <Label htmlFor=\"dev\">Dev Server Command</Label>\n   558→                  <Input\n   559→                    id=\"dev\"\n   560→                    value={commands.dev}\n   561→                    onChange={(e) => setCommands({ ...commands, dev: e.target.value })}\n   562→                    placeholder={`${projectScan.packageManager || 'npm'} run dev`}\n   563→                  />\n   564→                </div>\n   565→                <div className=\"space-y-2\">\n   566→                  <Label htmlFor=\"test\">Test Command</Label>\n   567→                  <Input\n   568→                    id=\"test\"\n   569→                    value={commands.test}\n   570→                    onChange={(e) => setCommands({ ...commands, test: e.target.value })}\n   571→                    placeholder={`${projectScan.packageManager || 'npm'} test`}\n   572→                  />\n   573→                </div>\n   574→                <div className=\"space-y-2\">\n   575→                  <Label htmlFor=\"lint\">Lint Command</Label>\n   576→                  <Input\n   577→                    id=\"lint\"\n   578→                    value={commands.lint}\n   579→                    onChange={(e) => setCommands({ ...commands, lint: e.target.value })}\n   580→                    placeholder={`${projectScan.packageManager || 'npm'} run lint`}\n   581→                  />\n   582→                </div>\n   583→                <div className=\"space-y-2\">\n   584→                  <Label htmlFor=\"typecheck\">Type Check Command</Label>\n   585→                  <Input\n   586→                    id=\"typecheck\"\n   587→                    value={commands.typecheck}\n   588→                    onChange={(e) => setCommands({ ...commands, typecheck: e.target.value })}\n   589→                    placeholder=\"npx tsc --noEmit\"\n   590→                  />\n   591→                </div>\n   592→              </div>\n   593→\n   594→              {/* Preview */}\n   595→              <div className=\"space-y-2\">\n   596→                <Label>Preview</Label>\n   597→                <ScrollArea className=\"h-48 rounded-lg border bg-muted/30\">\n   598→                  <pre className=\"p-4 text-xs font-mono whitespace-pre-wrap\">\n   599→                    {generateAgentsMd()}\n   600→                  </pre>\n   601→                </ScrollArea>\n   602→              </div>\n   603→\n   604→              <div className=\"flex justify-end gap-3 pt-4\">\n   605→                <Button variant=\"outline\" onClick={() => setStep('results')}>\n   606→                  Back\n   607→                </Button>\n   608→                <Button onClick={handleSaveConfig} className=\"gap-2\">\n   609→                  Save Configuration\n   610→                  <ChevronRight className=\"h-4 w-4\" />\n   611→                </Button>\n   612→              </div>\n   613→            </CardContent>\n   614→          </Card>\n   615→        )}\n   616→\n   617→        {/* Docs Step */}\n   618→        {step === 'docs' && projectScan && (\n   619→          <Card>\n   620→            <CardHeader>\n   621→              <CardTitle className=\"flex items-center gap-2\">\n   622→                <FileText className=\"h-5 w-5\" />\n   623→                Documentation Setup\n   624→              </CardTitle>\n   625→              <CardDescription>\n   626→                Choose how to set up your project documentation.\n   627→              </CardDescription>\n   628→            </CardHeader>\n   629→            <CardContent className=\"space-y-6\">\n   630→              {projectScan.existingDocs.length > 0 ? (\n   631→                <div className=\"space-y-4\">\n   632→                  <div className=\"p-4 rounded-lg bg-muted/50\">\n   633→                    <p className=\"font-medium mb-2\">Found {projectScan.existingDocs.length} existing docs</p>\n   634→                    <p className=\"text-sm text-muted-foreground\">\n   635→                      You can use the PRD Generator in the dashboard to create standardized\n   636→                      documentation from your existing files.\n   637→                    </p>\n   638→                  </div>\n   639→                </div>\n   640→              ) : (\n   641→                <div className=\"p-4 rounded-lg bg-muted/50 text-center\">\n   642→                  <AlertCircle className=\"h-8 w-8 text-muted-foreground mx-auto mb-2\" />\n   643→                  <p className=\"font-medium\">No existing documentation found</p>\n   644→                  <p className=\"text-sm text-muted-foreground\">\n   645→                    Use the PRD Generator in the dashboard to create PRD.md and AUDIENCE_JTBD.md\n   646→                  </p>\n   647→                </div>\n   648→              )}\n   649→\n   650→              <div className=\"space-y-3\">\n   651→                <p className=\"text-sm font-medium\">Next Steps:</p>\n   652→                <div className=\"space-y-2 text-sm text-muted-foreground\">\n   653→                  <p className=\"flex items-center gap-2\">\n   654→                    <Check className=\"h-4 w-4 text-green-500\" />\n   655→                    AGENTS.md has been configured\n   656→                  </p>\n   657→                  <p className=\"flex items-center gap-2\">\n   658→                    <ChevronRight className=\"h-4 w-4\" />\n   659→                    Use Generate tab to create PRD & Audience docs\n   660→                  </p>\n   661→                  <p className=\"flex items-center gap-2\">\n   662→                    <ChevronRight className=\"h-4 w-4\" />\n   663→                    Run <code className=\"bg-muted px-1 rounded\">./loop.sh plan</code> to generate implementation plan\n   664→                  </p>\n   665→                </div>\n   666→              </div>\n   667→\n   668→              <div className=\"flex justify-end gap-3 pt-4\">\n   669→                <Button variant=\"outline\" onClick={() => setStep('configure')}>\n   670→                  Back\n   671→                </Button>\n   672→                <Button onClick={handleFinish} className=\"gap-2\">\n   673→                  Complete Setup\n   674→                  <Check className=\"h-4 w-4\" />\n   675→                </Button>\n   676→              </div>\n   677→            </CardContent>\n   678→          </Card>\n   679→        )}\n   680→      </div>\n   681→    </div>\n   682→  );\n   683→}\n   684→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"6f0bf378-6db9-4f0d-94d4-53d6793fc6db","uuid":"6c3d5a3c-60df-4508-9beb-e7bf775ff663","tool_use_result":{"type":"text","file":{"filePath":"/Users/samueledwards/RalphWiggumV3/dashboard/src/components/setup/OnboardingWizard.tsx","content":"import { useState, useEffect } from 'react';\nimport { Card, CardContent, CardHeader, CardTitle, CardDescription } from '@/components/ui/card';\nimport { Button } from '@/components/ui/button';\nimport { Input } from '@/components/ui/input';\nimport { Label } from '@/components/ui/label';\nimport { Badge } from '@/components/ui/badge';\nimport { ScrollArea } from '@/components/ui/scroll-area';\nimport { Progress } from '@/components/ui/progress';\nimport type { ProjectScan, ProjectInfo, WorkflowMode } from '@/types';\nimport {\n  Search,\n  Check,\n  ChevronRight,\n  Folder,\n  FileText,\n  Package,\n  Code,\n  Terminal,\n  Loader2,\n  AlertCircle,\n  Sparkles,\n  FileCode,\n  Settings,\n  ExternalLink,\n  Zap,\n  Rocket,\n} from 'lucide-react';\n\ninterface OnboardingWizardProps {\n  projectScan: ProjectScan | null;\n  projectInfo: ProjectInfo | null;\n  scanLoading: boolean;\n  workflowMode: WorkflowMode;\n  onWorkflowModeChange: (mode: WorkflowMode) => void;\n  onScanProject: () => void;\n  onSaveAgentsMd: (content: string) => void;\n  onComplete: () => void;\n  onSkip: () => void;\n}\n\ntype WizardStep = 'welcome' | 'mode' | 'scanning' | 'results' | 'configure' | 'docs' | 'complete';\n\nexport function OnboardingWizard({\n  projectScan,\n  projectInfo,\n  scanLoading,\n  workflowMode,\n  onWorkflowModeChange,\n  onScanProject,\n  onSaveAgentsMd,\n  onComplete,\n  onSkip,\n}: OnboardingWizardProps) {\n  const [step, setStep] = useState<WizardStep>('welcome');\n  const [commands, setCommands] = useState({\n    build: '',\n    dev: '',\n    test: '',\n    lint: '',\n    typecheck: '',\n  });\n\n  // Update commands when scan results come in\n  useEffect(() => {\n    if (projectScan?.detectedCommands) {\n      setCommands({\n        build: projectScan.detectedCommands.build || '',\n        dev: projectScan.detectedCommands.dev || '',\n        test: projectScan.detectedCommands.test || '',\n        lint: projectScan.detectedCommands.lint || '',\n        typecheck: projectScan.detectedCommands.typecheck || '',\n      });\n    }\n  }, [projectScan]);\n\n  // Handle scan completion\n  useEffect(() => {\n    if (step === 'scanning' && projectScan && !scanLoading) {\n      setStep('results');\n    }\n  }, [step, projectScan, scanLoading]);\n\n  const handleStartScan = () => {\n    // Go to mode selection first\n    setStep('mode');\n  };\n\n  const handleModeSelected = () => {\n    setStep('scanning');\n    onScanProject();\n  };\n\n  const generateAgentsMd = () => {\n    const pm = projectScan?.packageManager || 'npm';\n    const framework = projectScan?.framework || 'Unknown';\n    const language = projectScan?.language || 'unknown';\n\n    return `## Build & Run\n\nSuccinct rules for how to BUILD the project:\n\n- Build: \\`${commands.build || `${pm} run build`}\\`\n- Run: \\`${commands.dev || `${pm} run start`}\\`\n- Dev server: \\`${commands.dev || `${pm} run dev`}\\`\n\n## Validation\n\nRun these after implementing to get immediate feedback:\n\n- Tests: \\`${commands.test || `${pm} test`}\\`\n- Typecheck: \\`${commands.typecheck || 'npx tsc --noEmit'}\\`\n- Lint: \\`${commands.lint || `${pm} run lint`}\\`\n\n## Operational Notes\n\nProject: ${projectScan?.projectName || 'Unknown'}\nFramework: ${framework}\nLanguage: ${language}\n\n### Codebase Patterns\n\n[Ralph will add learnings here as patterns are discovered]\n\n## Operational Learnings\n\n[Ralph will add learnings here about how to run/build the project]\n`;\n  };\n\n  const handleSaveConfig = () => {\n    const content = generateAgentsMd();\n    onSaveAgentsMd(content);\n    setStep('docs');\n  };\n\n  const handleFinish = () => {\n    onComplete();\n  };\n\n  const getStepProgress = () => {\n    const steps: WizardStep[] = ['welcome', 'mode', 'scanning', 'results', 'configure', 'docs', 'complete'];\n    const currentIndex = steps.indexOf(step);\n    return ((currentIndex + 1) / steps.length) * 100;\n  };\n\n  return (\n    <div className=\"min-h-screen bg-background flex items-center justify-center p-6\">\n      <div className=\"w-full max-w-2xl\">\n        {/* Progress bar */}\n        <div className=\"mb-8\">\n          <Progress value={getStepProgress()} className=\"h-2\" />\n        </div>\n\n        {/* Welcome Step */}\n        {step === 'welcome' && (\n          <Card className=\"text-center\">\n            <CardHeader className=\"pb-4\">\n              <div className=\"mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-primary/10\">\n                <Sparkles className=\"h-8 w-8 text-primary\" />\n              </div>\n              <CardTitle className=\"text-2xl\">Welcome to <span className=\"text-primary\">WIGGUM</span></CardTitle>\n              <CardDescription className=\"text-base\">\n                Let's set up your project for autonomous AI-powered development.\n              </CardDescription>\n            </CardHeader>\n            <CardContent className=\"space-y-6\">\n              {/* Show embedded mode info */}\n              {projectInfo && projectInfo.mode === 'embedded' && (\n                <div className=\"p-4 rounded-lg bg-green-500/10 border border-green-500/20 text-left\">\n                  <div className=\"flex items-start gap-3\">\n                    <ExternalLink className=\"h-5 w-5 text-green-600 mt-0.5\" />\n                    <div>\n                      <p className=\"font-medium text-green-700\">Embedded Mode Detected</p>\n                      <p className=\"text-sm text-green-600/80 mt-1\">\n                        WIGGUM will analyze your parent project:\n                      </p>\n                      <code className=\"text-xs bg-green-500/10 px-2 py-1 rounded mt-2 block truncate\">\n                        {projectInfo.targetProjectPath}\n                      </code>\n                    </div>\n                  </div>\n                </div>\n              )}\n              <div className=\"text-left space-y-4 bg-muted/50 rounded-lg p-4\">\n                <div className=\"flex items-start gap-3\">\n                  <Search className=\"h-5 w-5 text-muted-foreground mt-0.5\" />\n                  <div>\n                    <p className=\"font-medium\">Scan your project</p>\n                    <p className=\"text-sm text-muted-foreground\">\n                      Detect framework, language, and build commands\n                    </p>\n                  </div>\n                </div>\n                <div className=\"flex items-start gap-3\">\n                  <Settings className=\"h-5 w-5 text-muted-foreground mt-0.5\" />\n                  <div>\n                    <p className=\"font-medium\">Configure AGENTS.md</p>\n                    <p className=\"text-sm text-muted-foreground\">\n                      Set up commands for WIGGUM to use\n                    </p>\n                  </div>\n                </div>\n                <div className=\"flex items-start gap-3\">\n                  <FileText className=\"h-5 w-5 text-muted-foreground mt-0.5\" />\n                  <div>\n                    <p className=\"font-medium\">Import documentation</p>\n                    <p className=\"text-sm text-muted-foreground\">\n                      Consolidate existing docs into WIGGUM's structure\n                    </p>\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"flex gap-3 justify-center\">\n                <Button onClick={handleStartScan} size=\"lg\" className=\"gap-2\">\n                  <Search className=\"h-4 w-4\" />\n                  Scan My Project\n                </Button>\n                <Button variant=\"ghost\" onClick={onSkip}>\n                  Skip Setup\n                </Button>\n              </div>\n            </CardContent>\n          </Card>\n        )}\n\n        {/* Mode Selection Step */}\n        {step === 'mode' && (\n          <Card>\n            <CardHeader className=\"text-center\">\n              <CardTitle>Choose Your Workflow</CardTitle>\n              <CardDescription>\n                Select how you want to define and track tasks for Ralph\n              </CardDescription>\n            </CardHeader>\n            <CardContent className=\"space-y-6\">\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                {/* Simple Mode Card */}\n                <button\n                  onClick={() => onWorkflowModeChange('simple')}\n                  className={`text-left p-5 rounded-lg border-2 transition-all ${\n                    workflowMode === 'simple'\n                      ? 'border-primary bg-primary/5 shadow-md'\n                      : 'border-border hover:border-muted-foreground'\n                  }`}\n                >\n                  <div className=\"flex items-center gap-3 mb-3\">\n                    <div className={`p-2 rounded-lg ${\n                      workflowMode === 'simple' ? 'bg-primary/10' : 'bg-muted'\n                    }`}>\n                      <Zap className={`h-5 w-5 ${\n                        workflowMode === 'simple' ? 'text-primary' : 'text-muted-foreground'\n                      }`} />\n                    </div>\n                    <div>\n                      <h3 className=\"font-semibold\">Simple Mode</h3>\n                      <span className=\"text-xs text-green-500 font-medium\">Recommended</span>\n                    </div>\n                  </div>\n                  <p className=\"text-sm text-muted-foreground mb-3\">\n                    Uses <code className=\"px-1 py-0.5 bg-muted rounded text-xs\">prd.json</code> with user stories\n                  </p>\n                  <ul className=\"space-y-1.5 text-sm text-muted-foreground\">\n                    <li className=\"flex items-center gap-2\">\n                      <Check className=\"h-3.5 w-3.5 text-green-500\" />\n                      Quick setup - start building immediately\n                    </li>\n                    <li className=\"flex items-center gap-2\">\n                      <Check className=\"h-3.5 w-3.5 text-green-500\" />\n                      Best for MVPs and feature development\n                    </li>\n                    <li className=\"flex items-center gap-2\">\n                      <Check className=\"h-3.5 w-3.5 text-green-500\" />\n                      Learnings logged to progress.txt\n                    </li>\n                  </ul>\n                </button>\n\n                {/* Advanced Mode Card */}\n                <button\n                  onClick={() => onWorkflowModeChange('advanced')}\n                  className={`text-left p-5 rounded-lg border-2 transition-all ${\n                    workflowMode === 'advanced'\n                      ? 'border-primary bg-primary/5 shadow-md'\n                      : 'border-border hover:border-muted-foreground'\n                  }`}\n                >\n                  <div className=\"flex items-center gap-3 mb-3\">\n                    <div className={`p-2 rounded-lg ${\n                      workflowMode === 'advanced' ? 'bg-primary/10' : 'bg-muted'\n                    }`}>\n                      <Rocket className={`h-5 w-5 ${\n                        workflowMode === 'advanced' ? 'text-primary' : 'text-muted-foreground'\n                      }`} />\n                    </div>\n                    <div>\n                      <h3 className=\"font-semibold\">Advanced Mode</h3>\n                      <span className=\"text-xs text-muted-foreground font-medium\">Full Planning</span>\n                    </div>\n                  </div>\n                  <p className=\"text-sm text-muted-foreground mb-3\">\n                    Uses <code className=\"px-1 py-0.5 bg-muted rounded text-xs\">IMPLEMENTATION_PLAN.md</code> and specs\n                  </p>\n                  <ul className=\"space-y-1.5 text-sm text-muted-foreground\">\n                    <li className=\"flex items-center gap-2\">\n                      <Check className=\"h-3.5 w-3.5 text-blue-500\" />\n                      Full planning workflow with PRD\n                    </li>\n                    <li className=\"flex items-center gap-2\">\n                      <Check className=\"h-3.5 w-3.5 text-blue-500\" />\n                      Best for complex systems\n                    </li>\n                    <li className=\"flex items-center gap-2\">\n                      <Check className=\"h-3.5 w-3.5 text-blue-500\" />\n                      Specs-driven development\n                    </li>\n                  </ul>\n                </button>\n              </div>\n\n              <p className=\"text-xs text-center text-muted-foreground\">\n                You can switch between modes anytime from the dashboard header.\n              </p>\n\n              <div className=\"flex justify-center gap-3 pt-4\">\n                <Button variant=\"outline\" onClick={() => setStep('welcome')}>\n                  Back\n                </Button>\n                <Button onClick={handleModeSelected} className=\"gap-2\">\n                  Continue\n                  <ChevronRight className=\"h-4 w-4\" />\n                </Button>\n              </div>\n            </CardContent>\n          </Card>\n        )}\n\n        {/* Scanning Step */}\n        {step === 'scanning' && (\n          <Card className=\"text-center\">\n            <CardHeader>\n              <div className=\"mx-auto mb-4\">\n                <Loader2 className=\"h-12 w-12 animate-spin text-primary\" />\n              </div>\n              <CardTitle>Scanning Your Project</CardTitle>\n              <CardDescription>\n                Analyzing codebase, detecting frameworks, and finding documentation...\n              </CardDescription>\n            </CardHeader>\n            <CardContent>\n              <div className=\"space-y-2 text-sm text-muted-foreground\">\n                <p>Checking package.json...</p>\n                <p>Detecting build tools...</p>\n                <p>Finding existing documentation...</p>\n              </div>\n            </CardContent>\n          </Card>\n        )}\n\n        {/* Results Step */}\n        {step === 'results' && projectScan && (\n          <Card>\n            <CardHeader>\n              <div className=\"flex items-center gap-2\">\n                <Check className=\"h-5 w-5 text-green-500\" />\n                <CardTitle>Project Analysis Complete</CardTitle>\n              </div>\n              <CardDescription>\n                Here's what we found in your project.\n              </CardDescription>\n            </CardHeader>\n            <CardContent className=\"space-y-6\">\n              {/* Project Path Info */}\n              {projectInfo && projectInfo.mode === 'embedded' && (\n                <div className=\"p-3 rounded-lg bg-green-500/10 border border-green-500/20\">\n                  <div className=\"flex items-center gap-2 text-green-700\">\n                    <ExternalLink className=\"h-4 w-4\" />\n                    <span className=\"text-sm font-medium\">Analyzing parent project</span>\n                  </div>\n                  <code className=\"text-xs text-green-600/80 mt-1 block truncate\">\n                    {projectInfo.targetProjectPath}\n                  </code>\n                </div>\n              )}\n\n              {/* Detected Info */}\n              <div className=\"space-y-3\">\n                <h3 className=\"font-semibold flex items-center gap-2\">\n                  <Code className=\"h-4 w-4\" />\n                  Detected Configuration\n                </h3>\n                <div className=\"grid grid-cols-2 gap-3\">\n                  <div className=\"flex items-center gap-2 p-3 rounded-lg bg-muted/50\">\n                    <Package className=\"h-4 w-4 text-muted-foreground\" />\n                    <div>\n                      <p className=\"text-xs text-muted-foreground\">Framework</p>\n                      <p className=\"font-medium\">{projectScan.framework || 'Not detected'}</p>\n                    </div>\n                  </div>\n                  <div className=\"flex items-center gap-2 p-3 rounded-lg bg-muted/50\">\n                    <FileCode className=\"h-4 w-4 text-muted-foreground\" />\n                    <div>\n                      <p className=\"text-xs text-muted-foreground\">Language</p>\n                      <p className=\"font-medium capitalize\">{projectScan.language}</p>\n                    </div>\n                  </div>\n                  <div className=\"flex items-center gap-2 p-3 rounded-lg bg-muted/50\">\n                    <Terminal className=\"h-4 w-4 text-muted-foreground\" />\n                    <div>\n                      <p className=\"text-xs text-muted-foreground\">Package Manager</p>\n                      <p className=\"font-medium\">{projectScan.packageManager || 'None'}</p>\n                    </div>\n                  </div>\n                  <div className=\"flex items-center gap-2 p-3 rounded-lg bg-muted/50\">\n                    <Folder className=\"h-4 w-4 text-muted-foreground\" />\n                    <div>\n                      <p className=\"text-xs text-muted-foreground\">Project</p>\n                      <p className=\"font-medium truncate\">{projectScan.projectName}</p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              {/* Detected Subprojects (Monorepo) */}\n              {projectScan.isMonorepo && projectScan.subprojects.length > 0 && (\n                <div className=\"space-y-3\">\n                  <h3 className=\"font-semibold flex items-center gap-2\">\n                    <Folder className=\"h-4 w-4\" />\n                    Detected Subprojects ({projectScan.subprojects.length})\n                  </h3>\n                  <div className=\"space-y-2\">\n                    {projectScan.subprojects.map((sub) => (\n                      <div\n                        key={sub.path}\n                        className=\"flex items-center gap-2 p-2 rounded-lg bg-muted/50\"\n                      >\n                        <Badge variant=\"outline\" className=\"capitalize\">\n                          {sub.language}\n                        </Badge>\n                        <span className=\"font-medium\">{sub.name}</span>\n                        <span className=\"text-xs text-muted-foreground\">/{sub.path}</span>\n                        {sub.framework && (\n                          <Badge variant=\"secondary\">{sub.framework}</Badge>\n                        )}\n                        {sub.packageManager && (\n                          <span className=\"text-xs text-muted-foreground ml-auto\">\n                            {sub.packageManager}\n                          </span>\n                        )}\n                      </div>\n                    ))}\n                  </div>\n                </div>\n              )}\n\n              {/* Detected Commands */}\n              {Object.values(projectScan.detectedCommands).some(Boolean) && (\n                <div className=\"space-y-3\">\n                  <h3 className=\"font-semibold flex items-center gap-2\">\n                    <Terminal className=\"h-4 w-4\" />\n                    Detected Commands\n                  </h3>\n                  <div className=\"space-y-2\">\n                    {Object.entries(projectScan.detectedCommands).map(\n                      ([key, value]) =>\n                        value && (\n                          <div key={key} className=\"flex items-center gap-2\">\n                            <Badge variant=\"outline\" className=\"w-20 justify-center\">\n                              {key}\n                            </Badge>\n                            <code className=\"text-sm bg-muted px-2 py-1 rounded flex-1\">\n                              {value}\n                            </code>\n                          </div>\n                        )\n                    )}\n                  </div>\n                </div>\n              )}\n\n              {/* Existing Docs */}\n              {projectScan.existingDocs.length > 0 && (\n                <div className=\"space-y-3\">\n                  <h3 className=\"font-semibold flex items-center gap-2\">\n                    <FileText className=\"h-4 w-4\" />\n                    Existing Documentation\n                  </h3>\n                  <div className=\"space-y-2\">\n                    {projectScan.existingDocs.slice(0, 5).map((doc) => (\n                      <div\n                        key={doc.path}\n                        className=\"flex items-center justify-between p-2 rounded-lg bg-muted/50\"\n                      >\n                        <span className=\"text-sm\">{doc.path}</span>\n                        <span className=\"text-xs text-muted-foreground\">\n                          {(doc.size / 1024).toFixed(1)} KB\n                        </span>\n                      </div>\n                    ))}\n                  </div>\n                </div>\n              )}\n\n              {/* Ralph Config Status */}\n              <div className=\"space-y-3\">\n                <h3 className=\"font-semibold flex items-center gap-2\">\n                  <Settings className=\"h-4 w-4\" />\n                  Ralph Configuration Status\n                </h3>\n                <div className=\"flex flex-wrap gap-2\">\n                  {Object.entries(projectScan.hasRalphConfig).map(([key, exists]) => (\n                    <Badge key={key} variant={exists ? 'default' : 'secondary'}>\n                      {exists ? <Check className=\"h-3 w-3 mr-1\" /> : null}\n                      {key.replace(/([A-Z])/g, ' $1').trim()}\n                    </Badge>\n                  ))}\n                </div>\n              </div>\n\n              <div className=\"flex justify-end gap-3 pt-4\">\n                <Button variant=\"outline\" onClick={() => setStep('welcome')}>\n                  Back\n                </Button>\n                <Button onClick={() => setStep('configure')} className=\"gap-2\">\n                  Continue to Configuration\n                  <ChevronRight className=\"h-4 w-4\" />\n                </Button>\n              </div>\n            </CardContent>\n          </Card>\n        )}\n\n        {/* Configure Step */}\n        {step === 'configure' && projectScan && (\n          <Card>\n            <CardHeader>\n              <CardTitle className=\"flex items-center gap-2\">\n                <Settings className=\"h-5 w-5\" />\n                Configure AGENTS.md\n              </CardTitle>\n              <CardDescription>\n                Review and adjust the commands Ralph will use for your project.\n              </CardDescription>\n            </CardHeader>\n            <CardContent className=\"space-y-6\">\n              <div className=\"space-y-4\">\n                <div className=\"space-y-2\">\n                  <Label htmlFor=\"build\">Build Command</Label>\n                  <Input\n                    id=\"build\"\n                    value={commands.build}\n                    onChange={(e) => setCommands({ ...commands, build: e.target.value })}\n                    placeholder={`${projectScan.packageManager || 'npm'} run build`}\n                  />\n                </div>\n                <div className=\"space-y-2\">\n                  <Label htmlFor=\"dev\">Dev Server Command</Label>\n                  <Input\n                    id=\"dev\"\n                    value={commands.dev}\n                    onChange={(e) => setCommands({ ...commands, dev: e.target.value })}\n                    placeholder={`${projectScan.packageManager || 'npm'} run dev`}\n                  />\n                </div>\n                <div className=\"space-y-2\">\n                  <Label htmlFor=\"test\">Test Command</Label>\n                  <Input\n                    id=\"test\"\n                    value={commands.test}\n                    onChange={(e) => setCommands({ ...commands, test: e.target.value })}\n                    placeholder={`${projectScan.packageManager || 'npm'} test`}\n                  />\n                </div>\n                <div className=\"space-y-2\">\n                  <Label htmlFor=\"lint\">Lint Command</Label>\n                  <Input\n                    id=\"lint\"\n                    value={commands.lint}\n                    onChange={(e) => setCommands({ ...commands, lint: e.target.value })}\n                    placeholder={`${projectScan.packageManager || 'npm'} run lint`}\n                  />\n                </div>\n                <div className=\"space-y-2\">\n                  <Label htmlFor=\"typecheck\">Type Check Command</Label>\n                  <Input\n                    id=\"typecheck\"\n                    value={commands.typecheck}\n                    onChange={(e) => setCommands({ ...commands, typecheck: e.target.value })}\n                    placeholder=\"npx tsc --noEmit\"\n                  />\n                </div>\n              </div>\n\n              {/* Preview */}\n              <div className=\"space-y-2\">\n                <Label>Preview</Label>\n                <ScrollArea className=\"h-48 rounded-lg border bg-muted/30\">\n                  <pre className=\"p-4 text-xs font-mono whitespace-pre-wrap\">\n                    {generateAgentsMd()}\n                  </pre>\n                </ScrollArea>\n              </div>\n\n              <div className=\"flex justify-end gap-3 pt-4\">\n                <Button variant=\"outline\" onClick={() => setStep('results')}>\n                  Back\n                </Button>\n                <Button onClick={handleSaveConfig} className=\"gap-2\">\n                  Save Configuration\n                  <ChevronRight className=\"h-4 w-4\" />\n                </Button>\n              </div>\n            </CardContent>\n          </Card>\n        )}\n\n        {/* Docs Step */}\n        {step === 'docs' && projectScan && (\n          <Card>\n            <CardHeader>\n              <CardTitle className=\"flex items-center gap-2\">\n                <FileText className=\"h-5 w-5\" />\n                Documentation Setup\n              </CardTitle>\n              <CardDescription>\n                Choose how to set up your project documentation.\n              </CardDescription>\n            </CardHeader>\n            <CardContent className=\"space-y-6\">\n              {projectScan.existingDocs.length > 0 ? (\n                <div className=\"space-y-4\">\n                  <div className=\"p-4 rounded-lg bg-muted/50\">\n                    <p className=\"font-medium mb-2\">Found {projectScan.existingDocs.length} existing docs</p>\n                    <p className=\"text-sm text-muted-foreground\">\n                      You can use the PRD Generator in the dashboard to create standardized\n                      documentation from your existing files.\n                    </p>\n                  </div>\n                </div>\n              ) : (\n                <div className=\"p-4 rounded-lg bg-muted/50 text-center\">\n                  <AlertCircle className=\"h-8 w-8 text-muted-foreground mx-auto mb-2\" />\n                  <p className=\"font-medium\">No existing documentation found</p>\n                  <p className=\"text-sm text-muted-foreground\">\n                    Use the PRD Generator in the dashboard to create PRD.md and AUDIENCE_JTBD.md\n                  </p>\n                </div>\n              )}\n\n              <div className=\"space-y-3\">\n                <p className=\"text-sm font-medium\">Next Steps:</p>\n                <div className=\"space-y-2 text-sm text-muted-foreground\">\n                  <p className=\"flex items-center gap-2\">\n                    <Check className=\"h-4 w-4 text-green-500\" />\n                    AGENTS.md has been configured\n                  </p>\n                  <p className=\"flex items-center gap-2\">\n                    <ChevronRight className=\"h-4 w-4\" />\n                    Use Generate tab to create PRD & Audience docs\n                  </p>\n                  <p className=\"flex items-center gap-2\">\n                    <ChevronRight className=\"h-4 w-4\" />\n                    Run <code className=\"bg-muted px-1 rounded\">./loop.sh plan</code> to generate implementation plan\n                  </p>\n                </div>\n              </div>\n\n              <div className=\"flex justify-end gap-3 pt-4\">\n                <Button variant=\"outline\" onClick={() => setStep('configure')}>\n                  Back\n                </Button>\n                <Button onClick={handleFinish} className=\"gap-2\">\n                  Complete Setup\n                  <Check className=\"h-4 w-4\" />\n                </Button>\n              </div>\n            </CardContent>\n          </Card>\n        )}\n      </div>\n    </div>\n  );\n}\n","numLines":684,"startLine":1,"totalLines":684}}}
