{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012qhgsc1GTkZLTgw5tp43yb","type":"tool_result","content":"     1→/**\n     2→ * Notification Service for WIGGUM\n     3→ *\n     4→ * Central event dispatcher for sending notifications to various channels.\n     5→ * Supports Slack, Discord, and generic webhooks.\n     6→ */\n     7→\n     8→import { EventEmitter } from 'events';\n     9→import { logger } from '../lib/logger.js';\n    10→import { slackNotifier } from './slackNotifier.js';\n    11→import { discordNotifier } from './discordNotifier.js';\n    12→import { webhookManager } from './webhookManager.js';\n    13→\n    14→export type NotificationEvent =\n    15→  | 'loop:started'\n    16→  | 'loop:completed'\n    17→  | 'loop:error'\n    18→  | 'loop:iteration'\n    19→  | 'review:completed'\n    20→  | 'plan:generated'\n    21→  | 'prd:generated';\n    22→\n    23→export interface NotificationPayload {\n    24→  event: NotificationEvent;\n    25→  title: string;\n    26→  message: string;\n    27→  severity?: 'info' | 'success' | 'warning' | 'error';\n    28→  metadata?: Record<string, unknown>;\n    29→  timestamp?: Date;\n    30→}\n    31→\n    32→export interface NotificationConfig {\n    33→  slack: {\n    34→    enabled: boolean;\n    35→    webhookUrl?: string;\n    36→    events: NotificationEvent[];\n    37→  };\n    38→  discord: {\n    39→    enabled: boolean;\n    40→    webhookUrl?: string;\n    41→    events: NotificationEvent[];\n    42→  };\n    43→  webhooks: {\n    44→    enabled: boolean;\n    45→    events: NotificationEvent[];\n    46→  };\n    47→}\n    48→\n    49→class NotificationService extends EventEmitter {\n    50→  private config: NotificationConfig = {\n    51→    slack: {\n    52→      enabled: false,\n    53→      events: ['loop:started', 'loop:completed', 'loop:error'],\n    54→    },\n    55→    discord: {\n    56→      enabled: false,\n    57→      events: ['loop:started', 'loop:completed', 'loop:error'],\n    58→    },\n    59→    webhooks: {\n    60→      enabled: false,\n    61→      events: ['loop:started', 'loop:completed', 'loop:error'],\n    62→    },\n    63→  };\n    64→\n    65→  /**\n    66→   * Configure notification channels\n    67→   */\n    68→  configure(config: Partial<NotificationConfig>): void {\n    69→    if (config.slack) {\n    70→      this.config.slack = { ...this.config.slack, ...config.slack };\n    71→      if (config.slack.webhookUrl) {\n    72→        slackNotifier.setWebhookUrl(config.slack.webhookUrl);\n    73→      }\n    74→    }\n    75→    if (config.discord) {\n    76→      this.config.discord = { ...this.config.discord, ...config.discord };\n    77→      if (config.discord.webhookUrl) {\n    78→        discordNotifier.setWebhookUrl(config.discord.webhookUrl);\n    79→      }\n    80→    }\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01AURu4EeWd9PJfyAYPJeo32","session_id":"e963dfad-ac1f-43fb-a8da-b2590f97a0fb","uuid":"4c246b78-2c88-43a2-bbfd-d41cf07660c7","tool_use_result":{"type":"text","file":{"filePath":"/Users/samueledwards/RalphWiggumV3/dashboard/server/integrations/notificationService.ts","content":"/**\n * Notification Service for WIGGUM\n *\n * Central event dispatcher for sending notifications to various channels.\n * Supports Slack, Discord, and generic webhooks.\n */\n\nimport { EventEmitter } from 'events';\nimport { logger } from '../lib/logger.js';\nimport { slackNotifier } from './slackNotifier.js';\nimport { discordNotifier } from './discordNotifier.js';\nimport { webhookManager } from './webhookManager.js';\n\nexport type NotificationEvent =\n  | 'loop:started'\n  | 'loop:completed'\n  | 'loop:error'\n  | 'loop:iteration'\n  | 'review:completed'\n  | 'plan:generated'\n  | 'prd:generated';\n\nexport interface NotificationPayload {\n  event: NotificationEvent;\n  title: string;\n  message: string;\n  severity?: 'info' | 'success' | 'warning' | 'error';\n  metadata?: Record<string, unknown>;\n  timestamp?: Date;\n}\n\nexport interface NotificationConfig {\n  slack: {\n    enabled: boolean;\n    webhookUrl?: string;\n    events: NotificationEvent[];\n  };\n  discord: {\n    enabled: boolean;\n    webhookUrl?: string;\n    events: NotificationEvent[];\n  };\n  webhooks: {\n    enabled: boolean;\n    events: NotificationEvent[];\n  };\n}\n\nclass NotificationService extends EventEmitter {\n  private config: NotificationConfig = {\n    slack: {\n      enabled: false,\n      events: ['loop:started', 'loop:completed', 'loop:error'],\n    },\n    discord: {\n      enabled: false,\n      events: ['loop:started', 'loop:completed', 'loop:error'],\n    },\n    webhooks: {\n      enabled: false,\n      events: ['loop:started', 'loop:completed', 'loop:error'],\n    },\n  };\n\n  /**\n   * Configure notification channels\n   */\n  configure(config: Partial<NotificationConfig>): void {\n    if (config.slack) {\n      this.config.slack = { ...this.config.slack, ...config.slack };\n      if (config.slack.webhookUrl) {\n        slackNotifier.setWebhookUrl(config.slack.webhookUrl);\n      }\n    }\n    if (config.discord) {\n      this.config.discord = { ...this.config.discord, ...config.discord };\n      if (config.discord.webhookUrl) {\n        discordNotifier.setWebhookUrl(config.discord.webhookUrl);\n      }\n    }","numLines":80,"startLine":1,"totalLines":214}}}
