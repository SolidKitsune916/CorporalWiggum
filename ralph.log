ng;\n   798→  };\n   799→}\n   800→\n   801→export interface LauncherSpawnInstanceCommand {\n   802→  type: 'launcher:instance:spawn';\n   803→  payload: {\n   804→    projectId: string;\n   805→  };\n   806→}\n   807→\n   808→export interface LauncherStopInstanceCommand {\n   809→  type: 'launcher:instance:stop';\n   810→  payload: {\n   811→    projectId: string;\n   812→  };\n   813→}\n   814→\n   815→export interface LauncherListInstancesCommand {\n   816→  type: 'launcher:instances:list';\n   817→}\n   818→\n   819→export interface LauncherDiscoverCommand {\n   820→  type: 'launcher:discover';\n   821→}\n   822→\n   823→export interface LauncherInitProjectCommand {\n   824→  type: 'launcher:project:init';\n   825→  payload: {\n   826→    projectId: string;\n   827→    templates?: string[];  // Optional: specific templates to create (defaults to all)\n   828→  };\n   829→}\n   830→\n   831→// Result of project initialization\n   832→export interface ProjectInitResult {\n   833→  projectId: string;\n   834→  created: string[];  // List of files created\n   835→  skipped: string[];  // List of files that already existed\n   836→}\n   837→\n   838→export interface LauncherInitResultMessage extends WSMessage {\n   839→  type: 'launcher:project:init:result';\n   840→  payload: ProjectInitResult;\n   841→}\n   842→\n   843→export interface LauncherInitErrorMessage extends WSMessage {\n   844→  type: 'launcher:project:init:error';\n   845→  payload: {\n   846→    projectId: string;\n   847→    error: string;\n   848→  };\n   849→}\n   850→\n   851→// Launcher WebSocket Server Messages\n   852→export interface LauncherProjectsListMessage extends WSMessage {\n   853→  type: 'launcher:projects:list';\n   854→  payload: LauncherProject[];\n   855→}\n   856→\n   857→export interface LauncherProjectAddedMessage extends WSMessage {\n   858→  type: 'launcher:project:added';\n   859→  payload: LauncherProject;\n   860→}\n   861→\n   862→export interface LauncherProjectRemovedMe