oggleAgentCommand {\n   399→  type: 'agents:toggle';\n   400→  payload: {\n   401→    agentId: string;\n   402→    enabled: boolean;\n   403→  };\n   404→}\n   405→\n   406→export interface GeneratePlanCommand {\n   407→  type: 'plan:generate';\n   408→  payload: {\n   409→    goal: string;\n   410→    mode: 'plan' | 'plan-slc' | 'plan-work';\n   411→    workScope?: string;\n   412→    usePrdContext?: boolean;  // Include PRD.md and AUDIENCE_JTBD.md as context\n   413→  };\n   414→}\n   415→\n   416→export interface CancelPlanCommand {\n   417→  type: 'plan:cancel';\n   418→}\n   419→\n   420→export interface ClearPlanOutputCommand {\n   421→  type: 'plan:clear';\n   422→}\n   423→\n   424→export interface GeneratePRDCommand {\n   425→  type: 'prd:generate';\n   426→  payload: {\n   427→    productName: string;\n   428→    problemStatement: string;\n   429→    targetAudience: string;\n   430→    keyCapabilities: string[];\n   431→    contextDocs?: string[];  // Optional array of doc paths to include as context\n   432→    docsOnly?: boolean;      // If true, generate PRD from docs only without form fields\n   433→  };\n   434→}\n   435→\n   436→export interface CancelPRDCommand {\n   437→  type: 'prd:cancel';\n   438→}\n   439→\n   440→// Document reading command\n   441→export interface ReadDocCommand {\n   442→  type: 'docs:read';\n   443→  payload: {\n   444→    docPath: string;\n   445→  };\n   446→}\n   447→\n   448→// Project info (from project root detector)\n   449→export interface ProjectInfo {\n   450→  targetProjectPath: string;\n   451→  ralphPath: string;\n   452→  mode: 'embedded' | 'standalone';\n   453→  detectionReason: string;\n   454→}\n   455→\n   456→export interface ProjectInfoMessage extends WSMessage {\n   457→  type: 'project:info';\n   458→  payload: ProjectInfo;\n   459→}\n   460→\n   461→// Subproject detected within a monorepo/multi-project structure\n   462→export interface SubProject {\n   463→  name: string;\n   464→  path: string;\n   465→  language: 'typescript' | 'javascript' | 'go' | 'python' | 'unknown';\n   466→  framework: string | null;\n   467→  packageManager: 'npm' | 'yarn' | 'pnpm' | 'bun' | null;\n   468→}\n   469→\n   470→// Discovered markdown document for PRD context selection\n   471→export interface DiscoveredDoc {\n   472→  path: string;           // Relative path from project root\n   473→  name: string;           // File basename\n   474→  size: number;           // File size in bytes\n   475→  directory: string;      // Parent directory (for grouping in UI)\n   476→}\n   477→\n   478→// Project scanning types\n   479→export interface ProjectScan {\n   480→  projectName: string;\n   481→  projectPath: string;\n   482→  scanMode: 'embedded' | 'standalone';\n   483→  packageManager: 'npm' | 'yarn' | 'pnpm' | 'bun' | null;\n   484→  framework: string | null;\n   485→  language: 'typescript' | 'javascript' | 'python' | 'go' | 'mixed' | 'unknown';\n   486→  detectedCommands: {\n   487→    build?: string;\n   488→    dev?: string;\n   489→    test?: string;\n   490→    lint?: string;\n   491→    typecheck?: string;\n   492→  };\n   493→  existingDocs: Array<{\n   494→    path: string;\n   495→    name: string;\n   496→    size: number;\n   497→  }>;\n   498→  // All discovered markdown files for PRD context selection\n   499→  allMarkdownFiles: DiscoveredDoc[];\n   500→  hasRalphConfig: {\n   501→    agentsMd: boolean;\n   502→    claudeMd: boolean;\n   503→    implementationPlan: boolean;\n   504→    loopSh: boolean;\n   505→    specsDir: boolean;\n   506→    cursorRules: boolean;\n   507→  };\n   508→  hasRalphSubdirectory: boolean;\n   509→  structure: Array<{\n   510→    path: string;\n   511→    type: 'dir' | 'file';\n   512→  }>;\n   513→  subprojects: SubProject[];\n   514→  isMonorepo: boolean;\n   515→}\n   516→\n   517→export interface ProjectScanMessage extends WSMessage {\n   518→  type: 'project:scan-result';\n   519→  payload: ProjectScan;\n   520→}\n   521→\n   522→