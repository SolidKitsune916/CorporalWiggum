{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T8zrviFaZijjv5kRj5esDa","type":"tool_result","content":"     1→/**\n     2→ * Health Monitor - Monitors session health and process liveness\n     3→ *\n     4→ * Responsibilities:\n     5→ * - Detect orphaned sessions (process died unexpectedly)\n     6→ * - Clean up stale sessions\n     7→ * - Emit events for UI notification\n     8→ * - Perform periodic health checks\n     9→ */\n    10→\n    11→import { EventEmitter } from 'events';\n    12→import { getSessionRepository, type ActiveSession } from './database/repositories/SessionRepository.js';\n    13→import { getExecutionHistoryRepository } from './database/repositories/ExecutionHistoryRepository.js';\n    14→import { DatabaseBackup } from './database/backup.js';\n    15→\n    16→// Heartbeat timeout - if no heartbeat in this time, session is stale\n    17→const HEARTBEAT_TIMEOUT_MS = 30000; // 30 seconds\n    18→\n    19→// Check interval\n    20→const CHECK_INTERVAL_MS = 10000; // 10 seconds\n    21→\n    22→export interface HealthMonitorEvents {\n    23→  'session:orphaned': (session: ActiveSession) => void;\n    24→  'session:recovered': (session: ActiveSession) => void;\n    25→  'health:check': (stats: HealthStats) => void;\n    26→}\n    27→\n    28→export interface HealthStats {\n    29→  activeSessions: number;\n    30→  staleSessions: number;\n    31→  totalMemoryMB: number;\n    32→  uptime: number;\n    33→  lastCheck: Date;\n    34→}\n    35→\n    36→export class HealthMonitor extends EventEmitter {\n    37→  private checkInterval: NodeJS.Timeout | null = null;\n    38→  private startTime: Date;\n    39→  private running = false;\n    40→\n    41→  constructor() {\n    42→    super();\n    43→    this.startTime = new Date();\n    44→  }\n    45→\n    46→  /**\n    47→   * Start the health monitor\n    48→   */\n    49→  start(): void {\n    50→    if (this.running) {\n    51→      return;\n    52→    }\n    53→\n    54→    this.running = true;\n    55→    console.log('[HealthMonitor] Starting health monitor...');\n    56→\n    57→    // Perform initial check\n    58→    this.performCheck();\n    59→\n    60→    // Start periodic checks\n    61→    this.checkInterval = setInterval(() => {\n    62→      this.performCheck();\n    63→    }, CHECK_INTERVAL_MS);\n    64→\n    65→    // Perform daily backup on startup if needed\n    66→    DatabaseBackup.performDailyBackupIfNeeded();\n    67→  }\n    68→\n    69→  /**\n    70→   * Stop the health monitor\n    71→   */\n    72→  stop(): void {\n    73→    if (this.checkInterval) {\n    74→      clearInterval(this.checkInterval);\n    75→      this.checkInterval = null;\n    76→    }\n    77→    this.running = false;\n    78→    console.log('[HealthMonitor] Stopped health monitor');\n    79→  }\n    80→\n    81→  /**\n    82→   * Perform a health check\n    83→   */\n    84→  private performCheck(): void {\n    85→    try {\n    86→      const sessionRepo = getSessionRepository();\n    87→\n    88→      // Get active sessions\n    89→      const activeSessions = sessionRepo.getActiveSessions();\n    90→\n    91→      // Check each session for liveness\n    92→      for (const session of activeSessions) {\n    93→        this.checkSessionHealth(session);\n    94→      }\n    95→\n    96→      // Clean up any remaining stale sessions\n    97→      const staleSessions = sessionRepo.cleanupStaleSessions(HEARTBEAT_TIMEOUT_MS);\n    98→      for (const stale of staleSessions) {\n    99→        this.handleOrphanedSession(stale);\n   100→      }\n   101→\n   102→      // Emit health stats\n   103→      const stats: HealthStats = {\n   104→        activeSessions: activeSessions.length - staleSessions.length,\n   105→        staleSessions: staleSessions.length,\n   106→        totalMemoryMB: Math.round(process.memoryUsage().heapUsed / 1024 / 1024),\n   107→        uptime: Date.now() - this.startTime.getTime(),\n   108→        lastCheck: new Date(),\n   109→      };\n   110→\n   111→      this.emit('health:check', stats);\n   112→    } catch (error) {\n   113→      console.error('[HealthMonitor] Error during health check:', error);\n   114→    }\n   115→  }\n   116→\n   117→  /**\n   118→   * Check if a specific session is healthy\n   119→   */\n   120→  private checkSessionHealth(session: ActiveSession): void {\n   121→    // Check if process is still alive\n   122→    if (!this.isProcessAlive(session.pid)) {\n   123→      console.log(`[HealthMonitor] Process ${session.pid} for session ${session.id} is not alive`);\n   124→      this.handleOrphanedSession(session);\n   125→      return;\n   126→    }\n   127→\n   128→    // Check heartbeat freshness\n   129→    const lastHeartbeat = new Date(session.lastHeartbeat);\n   130→    const now = new Date();\n   131→    const ageMs = now.getTime() - lastHeartbeat.getTime();\n   132→\n   133→    if (ageMs > HEARTBEAT_TIMEOUT_MS) {\n   134→      console.log(\n   135→        `[HealthMonitor] Session ${session.id} heartbeat stale (${Math.round(ageMs / 1000)}s old)`\n   136→      );\n   137→      // Don't immediately mark as orphaned - the process might still be running\n   138→      // The cleanupStaleSessions call will handle this\n   139→    }\n   140→  }\n   141→\n   142→  /**\n   143→   * Handle an orphaned session\n   144→   */\n   145→  private handleOrphanedSession(session: ActiveSession): void {\n   146→    console.log(`[HealthMonitor] Handling orphaned session: ${session.id}`);\n   147→\n   148→    const sessionRepo = getSessionRepository();\n   149→    const historyRepo = getExecutionHistoryRepository();\n   150→\n   151→    // Mark session as crashed\n   152→    sessionRepo.markSessionCrashed(session.id);\n   153→\n   154→    // Record in execution history\n   155→    historyRepo.recordExecution({\n   156→      projectId: session.projectId,\n   157→      sessionId: session.id,\n   158→      mode: session.mode,\n   159→      iteration: session.currentIteration,\n   160→      startedAt: session.startedAt,\n   161→      endedAt: new Date().toISOString(),\n   162→      success: false,\n   163→      exitReason: 'orphaned',\n   164→      tokensInput: session.tokensInputTotal,\n   165→      tokensOutput: session.tokensOutputTotal,\n   166→      costUsd: session.costSpent,\n   167→      errorMessage: 'Process died unexpectedly or heartbeat timeout',\n   168→    });\n   169→\n   170→    // Emit event for UI notification\n   171→    this.emit('session:orphaned', session);\n   172→  }\n   173→\n   174→  /**\n   175→   * Check if a process is alive by sending signal 0\n   176→   */\n   177→  private isProcessAlive(pid: number): boolean {\n   178→    try {\n   179→      process.kill(pid, 0);\n   180→      return true;\n   181→    } catch {\n   182→      return false;\n   183→    }\n   184→  }\n   185→\n   186→  /**\n   187→   * Recover a session on server startup\n   188→   * Returns the session if it can be recovered, null otherwise\n   189→   */\n   190→  async recoverSession(projectPath: string): Promise<ActiveSession | null> {\n   191→    const sessionRepo = getSessionRepository();\n   192→\n   193→    // Find active session for this project\n   194→    // We need to find by project path, but we store by project ID\n   195→    // This would require joining with projects table or storing path in session\n   196→    // For now, let's check all active sessions\n   197→    const activeSessions = sessionRepo.getActiveSessions();\n   198→\n   199→    for (const session of activeSessions) {\n   200→      // Check if process is still alive\n   201→      if (this.isProcessAlive(session.pid)) {\n   202→        console.log(`[HealthMonitor] Recovered session ${session.id} (PID: ${session.pid})`);\n   203→        this.emit('session:recovered', session);\n   204→        return session;\n   205→      } else {\n   206→        // Process is dead, mark as crashed\n   207→        this.handleOrphanedSession(session);\n   208→      }\n   209→    }\n   210→\n   211→    return null;\n   212→  }\n   213→\n   214→  /**\n   215→   * Get current health stats\n   216→   */\n   217→  getStats(): HealthStats {\n   218→    const sessionRepo = getSessionRepository();\n   219→    const activeSessions = sessionRepo.getActiveSessions();\n   220→\n   221→    return {\n   222→      activeSessions: activeSessions.length,\n   223→      staleSessions: 0,\n   224→      totalMemoryMB: Math.round(process.memoryUsage().heapUsed / 1024 / 1024),\n   225→      uptime: Date.now() - this.startTime.getTime(),\n   226→      lastCheck: new Date(),\n   227→    };\n   228→  }\n   229→}\n   230→\n   231→// Singleton instance\n   232→let healthMonitorInstance: HealthMonitor | null = null;\n   233→\n   234→export function getHealthMonitor(): HealthMonitor {\n   235→  if (!healthMonitorInstance) {\n   236→    healthMonitorInstance = new HealthMonitor();\n   237→  }\n   238→  return healthMonitorInstance;\n   239→}\n   240→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"130e55cd-d481-4dd7-b33f-e0bdbfb691b6","uuid":"fa70aab3-a305-41b9-b6c5-5f9090c56642","tool_use_result":{"type":"text","file":{"filePath":"/Users/samueledwards/RalphWiggumV3/dashboard/server/healthMonitor.ts","content":"/**\n * Health Monitor - Monitors session health and process liveness\n *\n * Responsibilities:\n * - Detect orphaned sessions (process died unexpectedly)\n * - Clean up stale sessions\n * - Emit events for UI notification\n * - Perform periodic health checks\n */\n\nimport { EventEmitter } from 'events';\nimport { getSessionRepository, type ActiveSession } from './database/repositories/SessionRepository.js';\nimport { getExecutionHistoryRepository } from './database/repositories/ExecutionHistoryRepository.js';\nimport { DatabaseBackup } from './database/backup.js';\n\n// Heartbeat timeout - if no heartbeat in this time, session is stale\nconst HEARTBEAT_TIMEOUT_MS = 30000; // 30 seconds\n\n// Check interval\nconst CHECK_INTERVAL_MS = 10000; // 10 seconds\n\nexport interface HealthMonitorEvents {\n  'session:orphaned': (session: ActiveSession) => void;\n  'session:recovered': (session: ActiveSession) => void;\n  'health:check': (stats: HealthStats) => void;\n}\n\nexport interface HealthStats {\n  activeSessions: number;\n  staleSessions: number;\n  totalMemoryMB: number;\n  uptime: number;\n  lastCheck: Date;\n}\n\nexport class HealthMonitor extends EventEmitter {\n  private checkInterval: NodeJS.Timeout | null = null;\n  private startTime: Date;\n  private running = false;\n\n  constructor() {\n    super();\n    this.startTime = new Date();\n  }\n\n  /**\n   * Start the health monitor\n   */\n  start(): void {\n    if (this.running) {\n      return;\n    }\n\n    this.running = true;\n    console.log('[HealthMonitor] Starting health monitor...');\n\n    // Perform initial check\n    this.performCheck();\n\n    // Start periodic checks\n    this.checkInterval = setInterval(() => {\n      this.performCheck();\n    }, CHECK_INTERVAL_MS);\n\n    // Perform daily backup on startup if needed\n    DatabaseBackup.performDailyBackupIfNeeded();\n  }\n\n  /**\n   * Stop the health monitor\n   */\n  stop(): void {\n    if (this.checkInterval) {\n      clearInterval(this.checkInterval);\n      this.checkInterval = null;\n    }\n    this.running = false;\n    console.log('[HealthMonitor] Stopped health monitor');\n  }\n\n  /**\n   * Perform a health check\n   */\n  private performCheck(): void {\n    try {\n      const sessionRepo = getSessionRepository();\n\n      // Get active sessions\n      const activeSessions = sessionRepo.getActiveSessions();\n\n      // Check each session for liveness\n      for (const session of activeSessions) {\n        this.checkSessionHealth(session);\n      }\n\n      // Clean up any remaining stale sessions\n      const staleSessions = sessionRepo.cleanupStaleSessions(HEARTBEAT_TIMEOUT_MS);\n      for (const stale of staleSessions) {\n        this.handleOrphanedSession(stale);\n      }\n\n      // Emit health stats\n      const stats: HealthStats = {\n        activeSessions: activeSessions.length - staleSessions.length,\n        staleSessions: staleSessions.length,\n        totalMemoryMB: Math.round(process.memoryUsage().heapUsed / 1024 / 1024),\n        uptime: Date.now() - this.startTime.getTime(),\n        lastCheck: new Date(),\n      };\n\n      this.emit('health:check', stats);\n    } catch (error) {\n      console.error('[HealthMonitor] Error during health check:', error);\n    }\n  }\n\n  /**\n   * Check if a specific session is healthy\n   */\n  private checkSessionHealth(session: ActiveSession): void {\n    // Check if process is still alive\n    if (!this.isProcessAlive(session.pid)) {\n      console.log(`[HealthMonitor] Process ${session.pid} for session ${session.id} is not alive`);\n      this.handleOrphanedSession(session);\n      return;\n    }\n\n    // Check heartbeat freshness\n    const lastHeartbeat = new Date(session.lastHeartbeat);\n    const now = new Date();\n    const ageMs = now.getTime() - lastHeartbeat.getTime();\n\n    if (ageMs > HEARTBEAT_TIMEOUT_MS) {\n      console.log(\n        `[HealthMonitor] Session ${session.id} heartbeat stale (${Math.round(ageMs / 1000)}s old)`\n      );\n      // Don't immediately mark as orphaned - the process might still be running\n      // The cleanupStaleSessions call will handle this\n    }\n  }\n\n  /**\n   * Handle an orphaned session\n   */\n  private handleOrphanedSession(session: ActiveSession): void {\n    console.log(`[HealthMonitor] Handling orphaned session: ${session.id}`);\n\n    const sessionRepo = getSessionRepository();\n    const historyRepo = getExecutionHistoryRepository();\n\n    // Mark session as crashed\n    sessionRepo.markSessionCrashed(session.id);\n\n    // Record in execution history\n    historyRepo.recordExecution({\n      projectId: session.projectId,\n      sessionId: session.id,\n      mode: session.mode,\n      iteration: session.currentIteration,\n      startedAt: session.startedAt,\n      endedAt: new Date().toISOString(),\n      success: false,\n      exitReason: 'orphaned',\n      tokensInput: session.tokensInputTotal,\n      tokensOutput: session.tokensOutputTotal,\n      costUsd: session.costSpent,\n      errorMessage: 'Process died unexpectedly or heartbeat timeout',\n    });\n\n    // Emit event for UI notification\n    this.emit('session:orphaned', session);\n  }\n\n  /**\n   * Check if a process is alive by sending signal 0\n   */\n  private isProcessAlive(pid: number): boolean {\n    try {\n      process.kill(pid, 0);\n      return true;\n    } catch {\n      return false;\n    }\n  }\n\n  /**\n   * Recover a session on server startup\n   * Returns the session if it can be recovered, null otherwise\n   */\n  async recoverSession(projectPath: string): Promise<ActiveSession | null> {\n    const sessionRepo = getSessionRepository();\n\n    // Find active session for this project\n    // We need to find by project path, but we store by project ID\n    // This would require joining with projects table or storing path in session\n    // For now, let's check all active sessions\n    const activeSessions = sessionRepo.getActiveSessions();\n\n    for (const session of activeSessions) {\n      // Check if process is still alive\n      if (this.isProcessAlive(session.pid)) {\n        console.log(`[HealthMonitor] Recovered session ${session.id} (PID: ${session.pid})`);\n        this.emit('session:recovered', session);\n        return session;\n      } else {\n        // Process is dead, mark as crashed\n        this.handleOrphanedSession(session);\n      }\n    }\n\n    return null;\n  }\n\n  /**\n   * Get current health stats\n   */\n  getStats(): HealthStats {\n    const sessionRepo = getSessionRepository();\n    const activeSessions = sessionRepo.getActiveSessions();\n\n    return {\n      activeSessions: activeSessions.length,\n      staleSessions: 0,\n      totalMemoryMB: Math.round(process.memoryUsage().heapUsed / 1024 / 1024),\n      uptime: Date.now() - this.startTime.getTime(),\n      lastCheck: new Date(),\n    };\n  }\n}\n\n// Singleton instance\nlet healthMonitorInstance: HealthMonitor | null = null;\n\nexport function getHealthMonitor(): HealthMonitor {\n  if (!healthMonitorInstance) {\n    healthMonitorInstance = new HealthMonitor();\n  }\n  return healthMonitorInstance;\n}\n","numLines":240,"startLine":1,"totalLines":240}}}
