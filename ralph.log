  166→\n   167→    const ws = new WebSocket(url);\n   168→\n   169→    ws.onopen = () => {\n   170→      if (!isCleaningUpRef.current) {\n   171→        setConnected(true);\n   172→        if (reconnectTimeoutRef.current) {\n   173→          clearTimeout(reconnectTimeoutRef.current);\n   174→          reconnectTimeoutRef.current = null;\n   175→        }\n   176→      }\n   177→    };\n   178→\n   179→    ws.onclose = () => {\n   180→      if (!isCleaningUpRef.current) {\n   181→        setConnected(false);\n   182→        // Attempt to reconnect after 2 seconds\n   183→        reconnectTimeoutRef.current = setTimeout(() => {\n   184→          if (!isCleaningUpRef.current) {\n   185→            connect();\n   186→          }\n   187→        }, 2000);\n   188→      }\n   189→    };\n   190→\n   191→    ws.onerror = (error) => {\n   192→      // Only log errors if not cleaning up (React StrictMode causes intentional errors)\n   193→      if (!isCleaningUpRef.current && ws.readyState !== WebSocket.CLOSING && ws.readyState !== WebSocket.CLOSED) {\n   194→        console.error('WebSocket error:', error);\n   195→      }\n   196→      if (!isCleaningUpRef.current) {\n   197→        ws.close();\n   198→      }\n   199→    };\n   200→\n   201→    ws.onmessage = (event) => {\n   202→      try {\n   203→        const message: ServerMessage = JSON.parse(event.data);\n   204→\n   205→        switch (message.type) {\n   206→          case 'loop:status':\n   207→            setLoopStatus(message.payload);\n   208→            break;\n   209→          case 'loop:log':\n   210→            setLogs((prev) => [...prev.slice(-500), message.payload]); // Keep last 500 logs\n   211→            break;\n   212→          case 'tasks:update':\n   213→            setTasks(message.payload);\n   214→            break;\n   215→          case 'git:update':\n   216→            setGitStatus(message.payload);\n   217→            break;\n   218→          case 'config:update':\n   219→            setProjectConfig(message.payload);\n   220→            if (message.payload.enabledAgents) {\n   221→              setEnabledAgents(message.payload.enabledAgents);\n   222→            }\n   223→            break;\n   224→          case 'config:saved':\n   225→            // File was saved successfully - could track this for UI feedback\n   226→            console.log('File saved:', message.payload.file);\n   227→            break;\n   228→          case 'agents:update':\n   229→            setEnabledAgents(message.payload.enabledAgents);\n   230→            break;\n   231→          // Plan generation messages\n   232→          case 'plan:status':\n   233→            setPlanStatus(message.payload);\n   234→            if (message.payload.generating) {\n   235→              // Clear previous results when starting new generation\n   236→              setPlanOutput('');\n   237→              setPlanComplete(null);\n   238→              setPlanError(null);\n   239→            }\n   240→            break;\n   241→          case 'plan:output':\n   242→            setPlanOutput((prev) => prev + message.payload.text);\n   243→            break;\n   244→          case 'plan:log':\n   245→            // Could add to a separate log stream if needed\n   246→            break;\n   247→          case 'plan:complete':\n   248→            setPlanComplete(message.payload);\n   249→            break;\n   250→          case 'plan:error':\n   251→            setPlanError(message.payload.error);\n   252→            break;\n   253→          // PRD generation messages\n   254→          case 'prd:status':\n   255→            setPrdStatus(message.payload);\n   256→            if (message.payload.generating) {\n   257→              // Clear previous results when starting new generation\n   258→              setPrdOutput('');\n   259→              setPrdComplete(null);\n   260→              setPrdError(null);\n   261→            }\n   262→            break;\n   263→          case 'prd:output':\n   264→            setPrdOutput((prev) => prev + message.payload.text);\n   265→            break;\n   266→          case 'prd:complete':\n   267→            setPrdComplete(message.payload);\n   268→            break;\n   269→          case 'prd:error':\n   270→            setPrdError(message.payload.error);\n   271→            break;\n   272→          // Project scanning messages\n   273→          case 'project:scan-result':\n   274→            setProjectScan(message.payload);\n   275→            setScanLoading(false);\n   276→            break;\n   277→          case 'project:info':\n   278→            setProjectInfo(message.payload);\n   279→            break;\n   280→          // Agent and rules messages\n   281→          case 'agents:list-result':\n   282→            setAvailableAgents(message.payload);\n   283→            setAgentsLoading(false);\n   284→            break;\n   285→          case 'rules:list-result':\n   286→          case 'rules:update':\n   287→            setCursorRules(message.payload);\n   288→            setRulesLoading(false);\n   289→            break;\n   290→          // Document preview messages\n   291→          case 'docs:content':\n   292→            setPreviewDoc({\n   293→              path: message.payload.path,\n   294→              content: message.payload.content,\n   295→            });\n   296→            setIsLoadingPreview(false);\n   297→            break;\n   298→          case 'docs:error':\n   299→            console.error('Doc read error:', message.payload.error);\n   300→            setIsLoadingPreview(false);\n   301→            break;\n   302→          // CLAUDE.md messages\n   303→          case 'claude:list-result':\n   304→            setClaudeMdFiles(message.payload);\n   305→            setClaudeMdLoading(false);\n   306→            break;\n   307→          case 'claude:content':\n   308→            setClaudeMdContent({\n   309→              path: message.payload.path,\n   310→              content: message.payload.content,\n   311→            });\n   312→            setClaudeMdLoading(false);\n   313→            break;\n   314→          case 'claude:applied':\n   315→            setClaudeMdApplying(false);\n   316→            break;\n   317→          case 'claude:error':\n   318→            console.error('CLAUDE.md error:', message.payload.error);\n   319→            setClaudeMdLoading(false);\n   320→            setClaudeMdApplying(false);\n   321→            break;\n   322→          // Dependency check messages\n   323→          case 'dependencies:result':\n   324→            setDependencyStatus(message.payload);\n   325→            setDependencyLoading(false);\n   326→            break;\n   327→          case 'dependencies:error':\n   328→            console.error('Dependency check error:', message.payload.error);\n   329→            setDependencyLoading(false);\n   330→            break;\n   331→          // Config file preview messages (for ExistingDocsViewer)\n   332→          case 'config:content':\n   333→            setConfigPreviewDoc({\n   334→              file: message.payload.file,\n   335→              content: message.payload.content,\n   336→            });\n   337→            setConfigPreviewLoading(false);\n   338→            break;\n   339→        }\n   340→      } catch {\n   341→        console.error('Failed to parse WebSocket message');\n   342→      }\n   343→    };\n   344→\n   345→    wsRef.current = ws;\n   346→  }, [url]);\n   347→\n   348→  useEffect(() => {\n   349→    isCleaningUpRef.current = false;\n   350→    connect();\n   351→\n   352→    return () => {\n   353→      isCleaningUpRef.current = true;\n   354→      if (reconnectTimeoutRef.current) {\n   355→        clearTimeout(reconnectTimeoutRef.current);\n   356→        reconnectTimeoutRef.current = null;\n   357→      }\n   358→      if (wsRef.current) {\n   359→        // Remove event listeners to prevent errors during cleanup\n   360→        wsRef.current.onerror = null;\n   361→        wsRef.current.onclose = null;\n   362→        wsRef.current.close();\n   363→        wsRef.current = null;\n   364→      }\n   365→    };\n   366→  }, [connect]);\n   367→\n   368→  const sendCommand = useCallback((command: ClientCommand) => {\n   369→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   370→      wsRef.current.send(JSON.stringify(command));\n   371→    }\n   372→  }, []);\n   373→\n   374→  const clearLogs = useCallback(() => {\n   375→    setLogs([]);\n   376→  }, []);\n   377→\n   378→  const clearPlanOutput = useCallback(() => {\n   379→    setPlanOutput('');\n   380→    setPlanComplete(null);\n   381→    setPlanError(null);\n   382→  }, []);\n   383→\n   384→  const clearPrdOutput = useCallback(() => {\n   385→    setPrdOutput('');\n   386→    setPrdComplete(null);\n   387→    setPrdError(null);\n   388→  }, []);\n   389→\n   390→  const scanProject = useCallback(() => {\n   391→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   392→      setScanLoading(true);\n   393→      wsRef.current.send(JSON.stringify({ type: 'project:scan' }));\n   394→    }\n   395→  }, []);\n   396→\n   397→  const listAgents = useCallback(() => {\n   398→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   399→      setAgentsLoading(true);\n   400→      wsRef.current.send(JSON.stringify({ type: 'agents:list' }));\n   401→    }\n   402→  }, []);\n   403→\n   404→  const listRules = useCallback(() => {\n   405→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   406→      setRulesLoading(true);\n   407→      wsRef.current.send(JSON.stringify({ type: 'rules:list' }));\n   408→    }\n   409→  }, []);\n   410→\n   411→  const readDoc = useCallback((docPath: string) => {\n   412→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   413→      setIsLoadingPreview(true);\n   414→      setPreviewDoc(null);\n   415→      wsRef.current.send(JSON.stringify({ type: 'docs:read', payload: { docPath } }));\n   416→    }\n   417→  }, []);\n   418→