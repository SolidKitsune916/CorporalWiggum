{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0169Bn3nAgpmWLAcqPj9UhKZ","type":"tool_result","content":"     1→/**\n     2→ * Database Backup Service\n     3→ *\n     4→ * Provides backup and restore functionality for the SQLite database.\n     5→ * Supports automatic daily backups and manual backup/restore operations.\n     6→ */\n     7→\n     8→import path from 'path';\n     9→import fs from 'fs';\n    10→import { RalphDatabase } from './index.js';\n    11→\n    12→const BACKUP_DIR = path.join(RalphDatabase.getRalphDir(), 'backups');\n    13→const MAX_BACKUPS = 7; // Keep last 7 days by default\n    14→\n    15→export interface BackupInfo {\n    16→  filename: string;\n    17→  path: string;\n    18→  createdAt: Date;\n    19→  size: number;\n    20→}\n    21→\n    22→export class DatabaseBackup {\n    23→  private static lastBackupDate: string | null = null;\n    24→\n    25→  /**\n    26→   * Create a backup of the database\n    27→   */\n    28→  static async createBackup(description?: string): Promise<BackupInfo> {\n    29→    // Ensure backup directory exists\n    30→    fs.mkdirSync(BACKUP_DIR, { recursive: true });\n    31→\n    32→    const timestamp = new Date().toISOString().replace(/[:.]/g, '-');\n    33→    const filename = `ralph-backup-${timestamp}.db`;\n    34→    const backupPath = path.join(BACKUP_DIR, filename);\n    35→\n    36→    const db = RalphDatabase.getInstance();\n    37→\n    38→    // Use SQLite backup API (returns a Promise)\n    39→    await db.backup(backupPath);\n    40→\n    41→    // Record backup in the database\n    42→    const now = new Date().toISOString();\n    43→    this.lastBackupDate = now.split('T')[0];\n    44→\n    45→    console.log(`[Backup] Created backup: ${filename}`);\n    46→\n    47→    // Clean old backups\n    48→    this.cleanOldBackups();\n    49→\n    50→    const stats = fs.statSync(backupPath);\n    51→    return {\n    52→      filename,\n    53→      path: backupPath,\n    54→      createdAt: new Date(),\n    55→      size: stats.size,\n    56→    };\n    57→  }\n    58→\n    59→  /**\n    60→   * Restore from a backup file\n    61→   */\n    62→  static restoreFromBackup(backupPath: string): void {\n    63→    // Verify backup exists\n    64→    if (!fs.existsSync(backupPath)) {\n    65→      throw new Error(`Backup file not found: ${backupPath}`);\n    66→    }\n    67→\n    68→    const mainDbPath = RalphDatabase.getDatabasePath();\n    69→\n    70→    // Close current connection\n    71→    RalphDatabase.close();\n    72→\n    73→    // Create a pre-restore backup just in case\n    74→    const preRestoreBackup = `${mainDbPath}.pre-restore`;\n    75→    if (fs.existsSync(mainDbPath)) {\n    76→      fs.copyFileSync(mainDbPath, preRestoreBackup);\n    77→    }\n    78→\n    79→    try {\n    80→      // Copy backup to main location\n    81→      fs.copyFileSync(backupPath, mainDbPath);\n    82→\n    83→      // Also copy WAL and SHM files if they exist\n    84→      const walPath = `${backupPath}-wal`;\n    85→      const shmPath = `${backupPath}-shm`;\n    86→      if (fs.existsSync(walPath)) {\n    87→        fs.copyFileSync(walPath, `${mainDbPath}-wal`);\n    88→      }\n    89→      if (fs.existsSync(shmPath)) {\n    90→        fs.copyFileSync(shmPath, `${mainDbPath}-shm`);\n    91→      }\n    92→\n    93→      // Reconnect to verify\n    94→      RalphDatabase.getInstance();\n    95→\n    96→      console.log(`[Backup] Restored from: ${backupPath}`);\n    97→\n    98→      // Remove pre-restore backup on success\n    99→      if (fs.existsSync(preRestoreBackup)) {\n   100→        fs.unlinkSync(preRestoreBackup);\n   101→      }\n   102→    } catch (error) {\n   103→      // Restore failed - try to recover from pre-restore backup\n   104→      if (fs.existsSync(preRestoreBackup)) {\n   105→        fs.copyFileSync(preRestoreBackup, mainDbPath);\n   106→        fs.unlinkSync(preRestoreBackup);\n   107→        RalphDatabase.getInstance();\n   108→      }\n   109→      throw error;\n   110→    }\n   111→  }\n   112→\n   113→  /**\n   114→   * List available backups\n   115→   */\n   116→  static listBackups(): BackupInfo[] {\n   117→    if (!fs.existsSync(BACKUP_DIR)) {\n   118→      return [];\n   119→    }\n   120→\n   121→    const files = fs.readdirSync(BACKUP_DIR);\n   122→    const backups: BackupInfo[] = [];\n   123→\n   124→    for (const file of files) {\n   125→      if (file.startsWith('ralph-backup-') && file.endsWith('.db')) {\n   126→        const filePath = path.join(BACKUP_DIR, file);\n   127→        const stats = fs.statSync(filePath);\n   128→        backups.push({\n   129→          filename: file,\n   130→          path: filePath,\n   131→          createdAt: stats.mtime,\n   132→          size: stats.size,\n   133→        });\n   134→      }\n   135→    }\n   136→\n   137→    // Sort by date, newest first\n   138→    backups.sort((a, b) => b.createdAt.getTime() - a.createdAt.getTime());\n   139→\n   140→    return backups;\n   141→  }\n   142→\n   143→  /**\n   144→   * Delete a backup file\n   145→   */\n   146→  static deleteBackup(backupPath: string): boolean {\n   147→    if (!fs.existsSync(backupPath)) {\n   148→      return false;\n   149→    }\n   150→\n   151→    // Don't allow deleting non-backup files\n   152→    if (!backupPath.includes(BACKUP_DIR)) {\n   153→      throw new Error('Can only delete files in backup directory');\n   154→    }\n   155→\n   156→    fs.unlinkSync(backupPath);\n   157→    return true;\n   158→  }\n   159→\n   160→  /**\n   161→   * Clean old backups, keeping only the most recent MAX_BACKUPS\n   162→   */\n   163→  static cleanOldBackups(maxBackups: number = MAX_BACKUPS): number {\n   164→    const backups = this.listBackups();\n   165→\n   166→    if (backups.length <= maxBackups) {\n   167→      return 0;\n   168→    }\n   169→\n   170→    // Delete oldest backups\n   171→    const toDelete = backups.slice(maxBackups);\n   172→    let deleted = 0;\n   173→\n   174→    for (const backup of toDelete) {\n   175→      try {\n   176→        fs.unlinkSync(backup.path);\n   177→        deleted++;\n   178→        console.log(`[Backup] Deleted old backup: ${backup.filename}`);\n   179→      } catch (error) {\n   180→        console.error(`[Backup] Failed to delete ${backup.filename}:`, error);\n   181→      }\n   182→    }\n   183→\n   184→    return deleted;\n   185→  }\n   186→\n   187→  /**\n   188→   * Perform automatic daily backup if one hasn't been done today\n   189→   */\n   190→  static async performDailyBackupIfNeeded(): Promise<BackupInfo | null> {\n   191→    const today = new Date().toISOString().split('T')[0];\n   192→\n   193→    if (this.lastBackupDate === today) {\n   194→      return null; // Already backed up today\n   195→    }\n   196→\n   197→    // Check if we have a backup from today\n   198→    const backups = this.listBackups();\n   199→    const todayBackup = backups.find(b => {\n   200→      return b.createdAt.toISOString().split('T')[0] === today;\n   201→    });\n   202→\n   203→    if (todayBackup) {\n   204→      this.lastBackupDate = today;\n   205→      return null; // Already have today's backup\n   206→    }\n   207→\n   208→    // Create daily backup\n   209→    return this.createBackup('Automatic daily backup');\n   210→  }\n   211→\n   212→  /**\n   213→   * Get backup directory path\n   214→   */\n   215→  static getBackupDir(): string {\n   216→    return BACKUP_DIR;\n   217→  }\n   218→\n   219→  /**\n   220→   * Get total backup size\n   221→   */\n   222→  static getTotalBackupSize(): number {\n   223→    const backups = this.listBackups();\n   224→    return backups.reduce((total, b) => total + b.size, 0);\n   225→  }\n   226→}\n   227→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"6f0bf378-6db9-4f0d-94d4-53d6793fc6db","uuid":"5dafe59a-8fd1-4e90-a6c8-bb14cdd90b85","tool_use_result":{"type":"text","file":{"filePath":"/Users/samueledwards/RalphWiggumV3/dashboard/server/database/backup.ts","content":"/**\n * Database Backup Service\n *\n * Provides backup and restore functionality for the SQLite database.\n * Supports automatic daily backups and manual backup/restore operations.\n */\n\nimport path from 'path';\nimport fs from 'fs';\nimport { RalphDatabase } from './index.js';\n\nconst BACKUP_DIR = path.join(RalphDatabase.getRalphDir(), 'backups');\nconst MAX_BACKUPS = 7; // Keep last 7 days by default\n\nexport interface BackupInfo {\n  filename: string;\n  path: string;\n  createdAt: Date;\n  size: number;\n}\n\nexport class DatabaseBackup {\n  private static lastBackupDate: string | null = null;\n\n  /**\n   * Create a backup of the database\n   */\n  static async createBackup(description?: string): Promise<BackupInfo> {\n    // Ensure backup directory exists\n    fs.mkdirSync(BACKUP_DIR, { recursive: true });\n\n    const timestamp = new Date().toISOString().replace(/[:.]/g, '-');\n    const filename = `ralph-backup-${timestamp}.db`;\n    const backupPath = path.join(BACKUP_DIR, filename);\n\n    const db = RalphDatabase.getInstance();\n\n    // Use SQLite backup API (returns a Promise)\n    await db.backup(backupPath);\n\n    // Record backup in the database\n    const now = new Date().toISOString();\n    this.lastBackupDate = now.split('T')[0];\n\n    console.log(`[Backup] Created backup: ${filename}`);\n\n    // Clean old backups\n    this.cleanOldBackups();\n\n    const stats = fs.statSync(backupPath);\n    return {\n      filename,\n      path: backupPath,\n      createdAt: new Date(),\n      size: stats.size,\n    };\n  }\n\n  /**\n   * Restore from a backup file\n   */\n  static restoreFromBackup(backupPath: string): void {\n    // Verify backup exists\n    if (!fs.existsSync(backupPath)) {\n      throw new Error(`Backup file not found: ${backupPath}`);\n    }\n\n    const mainDbPath = RalphDatabase.getDatabasePath();\n\n    // Close current connection\n    RalphDatabase.close();\n\n    // Create a pre-restore backup just in case\n    const preRestoreBackup = `${mainDbPath}.pre-restore`;\n    if (fs.existsSync(mainDbPath)) {\n      fs.copyFileSync(mainDbPath, preRestoreBackup);\n    }\n\n    try {\n      // Copy backup to main location\n      fs.copyFileSync(backupPath, mainDbPath);\n\n      // Also copy WAL and SHM files if they exist\n      const walPath = `${backupPath}-wal`;\n      const shmPath = `${backupPath}-shm`;\n      if (fs.existsSync(walPath)) {\n        fs.copyFileSync(walPath, `${mainDbPath}-wal`);\n      }\n      if (fs.existsSync(shmPath)) {\n        fs.copyFileSync(shmPath, `${mainDbPath}-shm`);\n      }\n\n      // Reconnect to verify\n      RalphDatabase.getInstance();\n\n      console.log(`[Backup] Restored from: ${backupPath}`);\n\n      // Remove pre-restore backup on success\n      if (fs.existsSync(preRestoreBackup)) {\n        fs.unlinkSync(preRestoreBackup);\n      }\n    } catch (error) {\n      // Restore failed - try to recover from pre-restore backup\n      if (fs.existsSync(preRestoreBackup)) {\n        fs.copyFileSync(preRestoreBackup, mainDbPath);\n        fs.unlinkSync(preRestoreBackup);\n        RalphDatabase.getInstance();\n      }\n      throw error;\n    }\n  }\n\n  /**\n   * List available backups\n   */\n  static listBackups(): BackupInfo[] {\n    if (!fs.existsSync(BACKUP_DIR)) {\n      return [];\n    }\n\n    const files = fs.readdirSync(BACKUP_DIR);\n    const backups: BackupInfo[] = [];\n\n    for (const file of files) {\n      if (file.startsWith('ralph-backup-') && file.endsWith('.db')) {\n        const filePath = path.join(BACKUP_DIR, file);\n        const stats = fs.statSync(filePath);\n        backups.push({\n          filename: file,\n          path: filePath,\n          createdAt: stats.mtime,\n          size: stats.size,\n        });\n      }\n    }\n\n    // Sort by date, newest first\n    backups.sort((a, b) => b.createdAt.getTime() - a.createdAt.getTime());\n\n    return backups;\n  }\n\n  /**\n   * Delete a backup file\n   */\n  static deleteBackup(backupPath: string): boolean {\n    if (!fs.existsSync(backupPath)) {\n      return false;\n    }\n\n    // Don't allow deleting non-backup files\n    if (!backupPath.includes(BACKUP_DIR)) {\n      throw new Error('Can only delete files in backup directory');\n    }\n\n    fs.unlinkSync(backupPath);\n    return true;\n  }\n\n  /**\n   * Clean old backups, keeping only the most recent MAX_BACKUPS\n   */\n  static cleanOldBackups(maxBackups: number = MAX_BACKUPS): number {\n    const backups = this.listBackups();\n\n    if (backups.length <= maxBackups) {\n      return 0;\n    }\n\n    // Delete oldest backups\n    const toDelete = backups.slice(maxBackups);\n    let deleted = 0;\n\n    for (const backup of toDelete) {\n      try {\n        fs.unlinkSync(backup.path);\n        deleted++;\n        console.log(`[Backup] Deleted old backup: ${backup.filename}`);\n      } catch (error) {\n        console.error(`[Backup] Failed to delete ${backup.filename}:`, error);\n      }\n    }\n\n    return deleted;\n  }\n\n  /**\n   * Perform automatic daily backup if one hasn't been done today\n   */\n  static async performDailyBackupIfNeeded(): Promise<BackupInfo | null> {\n    const today = new Date().toISOString().split('T')[0];\n\n    if (this.lastBackupDate === today) {\n      return null; // Already backed up today\n    }\n\n    // Check if we have a backup from today\n    const backups = this.listBackups();\n    const todayBackup = backups.find(b => {\n      return b.createdAt.toISOString().split('T')[0] === today;\n    });\n\n    if (todayBackup) {\n      this.lastBackupDate = today;\n      return null; // Already have today's backup\n    }\n\n    // Create daily backup\n    return this.createBackup('Automatic daily backup');\n  }\n\n  /**\n   * Get backup directory path\n   */\n  static getBackupDir(): string {\n    return BACKUP_DIR;\n  }\n\n  /**\n   * Get total backup size\n   */\n  static getTotalBackupSize(): number {\n    const backups = this.listBackups();\n    return backups.reduce((total, b) => total + b.size, 0);\n  }\n}\n","numLines":227,"startLine":1,"totalLines":227}}}
