{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QrLNNpSbCuVFBJLRKjFEV9","type":"tool_result","content":"     1→import express from 'express';\n     2→import { createServer } from 'http';\n     3→import { WebSocketServer, WebSocket } from 'ws';\n     4→import cors from 'cors';\n     5→import path from 'path';\n     6→import { fileURLToPath } from 'url';\n     7→import fs from 'fs/promises';\n     8→import { FileWatcher } from './fileWatcher.js';\n     9→import { LoopController } from './loopController.js';\n    10→import { ProjectConfigManager } from './projectConfig.js';\n    11→import { PlanGenerator } from './planGenerator.js';\n    12→import { PRDGenerator } from './prdGenerator.js';\n    13→import { ProjectScanner } from './projectScanner.js';\n    14→import { detectProjectRoot, formatProjectInfo, type ProjectRootResult } from './projectRootDetector.js';\n    15→import { checkAllDependencies } from './dependencyChecker.js';\n    16→import { ProjectRegistry } from './projectRegistry.js';\n    17→import { InstanceSpawner } from './instanceSpawner.js';\n    18→import { ProjectDiscovery } from './projectDiscovery.js';\n    19→import { ReviewRunner } from './reviewRunner.js';\n    20→import { ReviewGenerator } from './reviewGenerator.js';\n    21→import { TemplateManager, type TemplateName } from './templateManager.js';\n    22→import { RalphDatabase } from './database/index.js';\n    23→import { getSessionRepository } from './database/repositories/SessionRepository.js';\n    24→import { getHealthMonitor } from './healthMonitor.js';\n    25→import { logger } from './lib/logger.js';\n    26→import { metrics, METRICS } from './lib/metrics.js';\n    27→import { sendAlert } from './lib/alerts.js';\n    28→import { initSentry, captureError, flush as flushSentry } from './lib/sentry.js';\n    29→\n    30→const __filename = fileURLToPath(import.meta.url);\n    31→const __dirname = path.dirname(__filename);\n    32→\n    33→// Detect project root (async initialization)\n    34→const RALPH_DEFAULT_PATH = path.resolve(__dirname, '../..');\n    35→\n    36→// Browse directory helper - returns directory entries with metadata\n    37→interface BrowseEntry {\n    38→  name: string;\n    39→  path: string;\n    40→  isDirectory: boolean;\n    41→  isGitRepo: boolean;\n    42→  isRalphReady: boolean;\n    43→}\n    44→\n    45→async function browseDirectory(dirPath: string): Promise<BrowseEntry[]> {\n    46→  const entries: BrowseEntry[] = [];\n    47→\n    48→  try {\n    49→    const items = await fs.readdir(dirPath, { withFileTypes: true });\n    50→\n    51→    for (const item of items) {\n    52→      // Skip hidden files/folders (starting with .)\n    53→      if (item.name.startsWith('.')) continue;\n    54→\n    55→      // Only include directories (Task 88: Filter to show only directories)\n    56→      if (!item.isDirectory()) continue;\n    57→\n    58→      const fullPath = path.join(dirPath, item.name);\n    59→\n    60→      // Check if it's a git repo\n    61→      let isGitRepo = false;\n    62→      try {\n    63→        await fs.access(path.join(fullPath, '.git'));\n    64→        isGitRepo = true;\n    65→      } catch {\n    66→        // Not a git repo\n    67→      }\n    68→\n    69→      // Check if it's Ralph-ready (has AGENTS.md and/or CLAUDE.md)\n    70→      let isRalphReady = false;\n    71→      try {\n    72→        const [hasAgents, hasClaude] = await Promise.all([\n    73→          fs.access(path.join(fullPath, 'AGENTS.md')).then(() => true).catch(() => false),\n    74→          fs.access(path.join(fullPath, 'CLAUDE.md')).then(() => true).catch(() => false),\n    75→        ]);\n    76→        isRalphReady = hasAgents || hasClaude;\n    77→      } catch {\n    78→        // Error checking, not Ralph-ready\n    79→      }\n    80→\n    81→      entries.push({\n    82→        name: item.name,\n    83→        path: fullPath,\n    84→        isDirectory: true,\n    85→        isGitRepo,\n    86→        isRalphReady,\n    87→      });\n    88→    }\n    89→\n    90→    // Sort: Ralph-ready first, then git repos, then alphabetically\n    91→    entries.sort((a, b) => {\n    92→      if (a.isRalphReady !== b.isRalphReady) return a.isRalphReady ? -1 : 1;\n    93→      if (a.isGitRepo !== b.isGitRepo) return a.isGitRepo ? -1 : 1;\n    94→      return a.name.localeCompare(b.name);\n    95→    });\n    96→\n    97→  } catch (err) {\n    98→    logger.error(`Error reading directory ${dirPath}`, { error: err instanceof Error ? err.message : 'Unknown error' });\n    99→    throw err;\n   100→  }\n   101→\n   102→  return entries;\n   103→}\n   104→\n   105→// Initialize project detection and return paths\n   106→async function initializeProjectPaths(): Promise<ProjectRootResult> {\n   107→  // Allow explicit override via environment\n   108→  if (process.env.PROJECT_PATH) {\n   109→    return {\n   110→      targetProjectPath: process.env.PROJECT_PATH,\n   111→      ralphPath: RALPH_DEFAULT_PATH,\n   112→      mode: 'embedded',\n   113→      detectionReason: 'Explicitly set via PROJECT_PATH environment variable',\n   114→    };\n   115→  }\n   116→  return detectProjectRoot(RALPH_DEFAULT_PATH);\n   117→}\n   118→\n   119→// Start server after initialization\n   120→async function startServer() {\n   121→  // Initialize Sentry early\n   122→  initSentry();\n   123→\n   124→  const projectRoot = await initializeProjectPaths();\n   125→  const TARGET_PROJECT_PATH = projectRoot.targetProjectPath;\n   126→  const RALPH_PATH = projectRoot.ralphPath;\n   127→\n   128→  logger.info('Project paths initialized', { projectRoot: formatProjectInfo(projectRoot) });\n   129→\n   130→  // Initialize SQLite database\n   131→  logger.info('Initializing database...');\n   132→  RalphDatabase.getInstance();\n   133→  logger.info('Database initialized', { path: RalphDatabase.getDatabasePath() });\n   134→\n   135→  const app = express();\n   136→  const server = createServer(app);\n   137→  const wss = new WebSocketServer({ server, path: '/ws' });\n   138→\n   139→  app.use(cors());\n   140→  app.use(express.json());\n   141→\n   142→  // Initialize services with appropriate paths\n   143→  const projectConfig = new ProjectConfigManager(TARGET_PROJECT_PATH, RALPH_PATH);\n   144→  const fileWatcher = new FileWatcher(TARGET_PROJECT_PATH);\n   145→  const loopController = new LoopController(TARGET_PROJECT_PATH, RALPH_PATH);\n   146→  const planGenerator = new PlanGenerator(TARGET_PROJECT_PATH, RALPH_PATH);\n   147→  const prdGenerator = new PRDGenerator(TARGET_PROJECT_PATH, RALPH_PATH);\n   148→  const projectScanner = new ProjectScanner(TARGET_PROJECT_PATH);\n   149→\n   150→  // Initialize launcher services\n   151→  const projectRegistry = new ProjectRegistry();\n   152→  const instanceSpawner = new InstanceSpawner(RALPH_PATH);\n   153→  const projectDiscovery = new ProjectDiscovery();\n   154→  const templateManager = new TemplateManager();\n   155→\n   156→  // Initialize review runner (LLM-as-Judge - Feature Set 13)\n   157→  const reviewRunner = new ReviewRunner(TARGET_PROJECT_PATH);\n   158→\n   159→  // Initialize review generator (Code vs Docs analysis - Feature Set 14)\n   160→  const reviewGenerator = new ReviewGenerator(TARGET_PROJECT_PATH, RALPH_PATH);\n   161→\n   162→  // Initialize health monitor for session management\n   163→  const healthMonitor = getHealthMonitor();\n   164→  healthMonitor.start();\n   165→\n   166→  // Track connected clients\n   167→  const clients = new Set<WebSocket>();\n   168→\n   169→  // Broadcast to all connected clients\n   170→  function broadcast(message: object) {\n   171→    const data = JSON.stringify(message);\n   172→    clients.forEach((client) => {\n   173→      if (client.readyState === WebSocket.OPEN) {\n   174→        client.send(data);\n   175→      }\n   176→    });\n   177→  }\n   178→\n   179→  // WebSocket connection handler\n   180→  wss.on('connection', (ws) => {\n   181→    clients.add(ws);\n   182→    metrics.setGauge(METRICS.WS_CONNECTIONS_ACTIVE, clients.size);\n   183→    logger.info('Client connected', { totalClients: clients.size });\n   184→\n   185→    // Send initial state\n   186→    ws.send(JSON.stringify({ type: 'loop:status', payload: loopController.getStatus() }));\n   187→    ws.send(JSON.stringify({ type: 'tasks:update', payload: fileWatcher.getTasks() }));\n   188→    ws.send(JSON.stringify({ type: 'git:update', payload: fileWatcher.getGitStatus() }));\n   189→    ws.send(JSON.stringify({ type: 'config:update', payload: projectConfig.getConfig() }));\n   190→    ws.send(JSON.stringify({ type: 'project:info', payload: projectRoot }));\n   191→\n   192→    // Handle messages from client\n   193→    ws.on('message', async (data) => {\n   194→      const messageStart = Date.now();\n   195→      metrics.incCounter(METRICS.WS_MESSAGES_TOTAL);\n   196→\n   197→      try {\n   198→        const message = JSON.parse(data.toString());\n   199→        logger.debug('WebSocket message received', { type: message.type });\n   200→\n   201→        switch (message.type) {\n   202→          case 'loop:start':\n   203→            loopController.start(message.payload);\n   204→            break;\n   205→          case 'loop:stop':\n   206→            loopController.stop();\n   207→            break;\n   208→          case 'session:current':\n   209→            // Return current active session for browser refresh resilience\n   210→            try {\n   211→              const sessionRepo = getSessionRepository();\n   212→              const activeSessions = sessionRepo.getActiveSessions();\n   213→              // Find session for current project path\n   214→              const projectId = message.payload?.projectId;\n   215→              let currentSession = null;\n   216→\n   217→              if (projectId) {\n   218→                currentSession = sessionRepo.getActiveSessionForProject(projectId);\n   219→              } else if (activeSessions.length > 0) {\n   220→                // Return the most recent active session\n   221→                currentSession = activeSessions[0];\n   222→              }\n   223→\n   224→              if (currentSession) {\n   225→                // Check if the process is still alive\n   226→                try {\n   227→                  process.kill(currentSession.pid, 0);\n   228→                  // Process alive - recover the session\n   229→                  loopController.recoverSession(currentSession);\n   230→                  ws.send(JSON.stringify({\n   231→                    type: 'session:recovered',\n   232→                    payload: {\n   233→                      sessionId: currentSession.id,\n   234→                      status: loopController.getStatus(),\n   235→                    }\n   236→                  }));\n   237→                } catch {\n   238→                  // Process is dead - mark as crashed\n   239→                  sessionRepo.markSessionCrashed(currentSession.id);\n   240→                  ws.send(JSON.stringify({\n   241→                    type: 'session:none',\n   242→                    payload: { reason: 'process_dead' }\n   243→                  }));\n   244→                }\n   245→              } else {\n   246→                ws.send(JSON.stringify({\n   247→                  type: 'session:none',\n   248→                  payload: { reason: 'no_active_session' }\n   249→                }));\n   250→              }\n   251→            } catch (err) {\n   252→              ws.send(JSON.stringify({\n   253→                type: 'session:error',\n   254→                payload: { error: `Failed to recover session: ${err instanceof Error ? err.message : 'Unknown error'}` }\n   255→              }));\n   256→            }\n   257→            break;\n   258→          case 'config:read':\n   259→            const content = await projectConfig.readFile(message.payload.file);\n   260→            ws.send(JSON.stringify({ type: 'config:content', payload: { file: message.payload.file, content } }));\n   261→            break;\n   262→          case 'config:write':\n   263→            await projectConfig.writeFile(message.payload.file, message.payload.content);\n   264→            ws.send(JSON.stringify({ type: 'config:saved', payload: { file: message.payload.file } }));\n   265→            // Refresh config if PRD.md or AUDIENCE_JTBD.md was written\n   266→            if (message.payload.file === 'PRD.md' || message.payload.file === 'AUDIENCE_JTBD.md') {\n   267→              const updatedConfig = await projectConfig.refresh();\n   268→              broadcast({ type: 'config:update', payload: updatedConfig });\n   269→            }\n   270→            break;\n   271→          case 'config:refresh':\n   272→            try {\n   273→              const updatedConfig = await projectConfig.refresh();\n   274→              broadcast({ type: 'config:update', payload: updatedConfig });\n   275→              ws.send(JSON.stringify({ type: 'config:refreshed' }));\n   276→            } catch (err) {\n   277→              ws.send(JSON.stringify({ type: 'config:error', payload: { error: 'Failed to refresh config' } }));\n   278→            }\n   279→            break;\n   280→          case 'agents:toggle':\n   281→            await projectConfig.toggleAgent(message.payload.agentId, message.payload.enabled);\n   282→            const enabledAgents = projectConfig.getEnabledAgents();\n   283→            broadcast({ type: 'agents:update', payload: { enabledAgents } });\n   284→            break;\n   285→          case 'plan:generate':\n   286→            try {\n   287→              // Read PRD context if requested\n   288→              let prdContext = '';\n   289→              if (message.payload.usePrdContext) {\n   290→                try {\n   291→                  const prdContent = await projectConfig.readFile('PRD.md');\n   292→                  const audienceContent = await projectConfig.readFile('AUDIENCE_JTBD.md');\n   293→                  prdContext = `\n   294→## Context: PRD.md\n   295→${prdContent}\n   296→\n   297→## Context: AUDIENCE_JTBD.md\n   298→${audienceContent}\n   299→`;\n   300→                } catch (err) {\n   301→                  logger.warn('Could not read PRD files', { error: err instanceof Error ? err.message : 'Unknown error' });\n   302→                }\n   303→              }\n   304→              await planGenerator.generatePlan({ ...message.payload, prdContext });\n   305→            } catch (err) {\n   306→              logger.error('Error generating plan', { error: err instanceof Error ? err.message : 'Unknown error' });\n   307→              captureError(err instanceof Error ? err : new Error(String(err)), { context: 'plan_generation' });\n   308→              ws.send(JSON.stringify({\n   309→                type: 'plan:error',\n   310→                payload: { error: err instanceof Error ? err.message : 'Failed to start plan generation' }\n   311→              }));\n   312→            }\n   313→            break;\n   314→          case 'plan:cancel':\n   315→            planGenerator.cancel();\n   316→            break;\n   317→          case 'prd:generate':\n   318→            prdGenerator.generatePRD(message.payload);\n   319→            break;\n   320→          case 'prd:cancel':\n   321→            prdGenerator.cancel();\n   322→            break;\n   323→          case 'project:scan':\n   324→            const scanResult = await projectScanner.scan();\n   325→            ws.send(JSON.stringify({ type: 'project:scan-result', payload: scanResult }));\n   326→            break;\n   327→          case 'project:info':\n   328→            ws.send(JSON.stringify({ type: 'project:info', payload: projectRoot }));\n   329→            break;\n   330→          case 'agents:list':\n   331→            const agents = await projectConfig.listAvailableAgents();\n   332→            ws.send(JSON.stringify({ type: 'agents:list-result', payload: agents }));\n   333→            break;\n   334→          case 'rules:list':\n   335→            const rules = await projectConfig.listCursorRulesDetailed();\n   336→            ws.send(JSON.stringify({ type: 'rules:list-result', payload: rules }));\n   337→            break;\n   338→          case 'rules:toggle':\n   339→            const updatedRules = await projectConfig.toggleCursorRule(message.payload.ruleId, message.payload.enabled);\n   340→            broadcast({ type: 'rules:update', payload: updatedRules });\n   341→            break;\n   342→          case 'docs:read':\n   343→            try {\n   344→              const docPath = message.payload.docPath;\n   345→              // Validate path to prevent directory traversal\n   346→              // Use path.resolve to get canonical path and verify it's within project\n   347→              if (path.isAbsolute(docPath)) {\n   348→                ws.send(JSON.stringify({ type: 'docs:error', payload: { error: 'Invalid path' } }));\n   349→                break;\n   350→              }\n   351→              const fullPath = path.resolve(TARGET_PROJECT_PATH, docPath);\n   352→              const projectRoot = path.resolve(TARGET_PROJECT_PATH);\n   353→              // Ensure resolved path starts with project root (prevents ../../../etc/passwd attacks)\n   354→              if (!fullPath.startsWith(projectRoot + path.sep) && fullPath !== projectRoot) {\n   355→                ws.send(JSON.stringify({ type: 'docs:error', payload: { error: 'Invalid path' } }));\n   356→                break;\n   357→              }\n   358→              const docContent = await fs.readFile(fullPath, 'utf-8');\n   359→              ws.send(JSON.stringify({ type: 'docs:content', payload: { path: docPath, content: docContent } }));\n   360→            } catch (err) {\n   361→              ws.send(JSON.stringify({ type: 'docs:error', payload: { error: 'Failed to read document' } }));\n   362→            }\n   363→            break;\n   364→          case 'claude:list':\n   365→            try {\n   366→              const claudeFiles = await projectConfig.listClaudeMdFiles();\n   367→              ws.send(JSON.stringify({ type: 'claude:list-result', payload: claudeFiles }));\n   368→            } catch (err) {\n   369→              ws.send(JSON.stringify({ type: 'claude:error', payload: { error: 'Failed to list CLAUDE.md files' } }));\n   370→            }\n   371→            break;\n   372→          case 'claude:read':\n   373→            try {\n   374→              const claudeContent = await projectConfig.readClaudeMdFile(message.payload.path);\n   375→              ws.send(JSON.stringify({ type: 'claude:content', payload: { path: message.payload.path, content: claudeContent } }));\n   376→            } catch (err) {\n   377→              ws.send(JSON.stringify({ type: 'claude:error', payload: { error: 'Failed to read CLAUDE.md' } }));\n   378→            }\n   379→            break;\n   380→          case 'claude:apply':\n   381→            try {\n   382→              await projectConfig.applyRalphClaudeMd();\n   383→              ws.send(JSON.stringify({ type: 'claude:applied' }));\n   384→              // Refresh and broadcast config update\n   385→              const updatedConfig = await projectConfig.refresh();\n   386→              broadcast({ type: 'config:update', payload: updatedConfig });\n   387→            } catch (err) {\n   388→              ws.send(JSON.stringify({ type: 'claude:error', payload: { error: 'Failed to apply CLAUDE.md' } }));\n   389→            }\n   390→            break;\n   391→          case 'dependencies:check':\n   392→            try {\n   393→              const depResults = await checkAllDependencies();\n   394→              ws.send(JSON.stringify({ type: 'dependencies:result', payload: depResults }));\n   395→            } catch (err) {\n   396→              ws.send(JSON.stringify({ type: 'dependencies:error', payload: { error: 'Failed to check dependencies' } }));\n   397→            }\n   398→            break;\n   399→          case 'agents:list-repo':\n   400→            try {\n   401→              const repoAgents = await projectConfig.listRepoAgents();\n   402→              ws.send(JSON.stringify({ type: 'agents:repo-result', payload: repoAgents }));\n   403→            } catch (err) {\n   404→              ws.send(JSON.stringify({ type: 'agents:error', payload: { error: 'Failed to list repo agents' } }));\n   405→            }\n   406→            break;\n   407→          case 'agents:install-global':\n   408→            try {\n   409→              await projectConfig.installAgentGlobal(message.payload.agentId);\n   410→              ws.send(JSON.stringify({ type: 'agents:installed', payload: { agentId: message.payload.agentId, scope: 'global' } }));\n   411→              // Send updated repo agents list\n   412→              const updatedRepoAgents = await projectConfig.listRepoAgents();\n   413→              ws.send(JSON.stringify({ type: 'agents:repo-result', payload: updatedRepoAgents }));\n   414→            } catch (err) {\n   415→              ws.send(JSON.stringify({ type: 'agents:error', payload: { error: `Failed to install agent globally: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n   416→            }\n   417→            break;\n   418→          case 'agents:install-project':\n   419→            try {\n   420→              await projectConfig.installAgentProject(message.payload.agentId);\n   421→              ws.send(JSON.stringify({ type: 'agents:installed', payload: { agentId: message.payload.agentId, scope: 'project' } }));\n   422→              // Send updated repo agents list\n   423→              const updatedRepoAgentsAfterProject = await projectConfig.listRepoAgents();\n   424→              ws.send(JSON.stringify({ type: 'agents:repo-result', payload: updatedRepoAgentsAfterProject }));\n   425→            } catch (err) {\n   426→              ws.send(JSON.stringify({ type: 'agents:error', payload: { error: `Failed to install agent to project: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n   427→            }\n   428→            break;\n   429→          case 'agents:install-all-global':\n   430→            try {\n   431→              await projectConfig.installAllAgentsGlobal();\n   432→              ws.send(JSON.stringify({ type: 'agents:installed', payload: { agentId: 'all', scope: 'global' } }));\n   433→              // Send updated repo agents list\n   434→              const updatedRepoAgentsAll = await projectConfig.listRepoAgents();\n   435→              ws.send(JSON.stringify({ type: 'agents:repo-result', payload: updatedRepoAgentsAll }));\n   436→            } catch (err) {\n   437→              ws.send(JSON.stringify({ type: 'agents:error', payload: { error: `Failed to install all agents: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n   438→            }\n   439→            break;\n   440→\n   441→          // ============================================\n   442→          // Launcher WebSocket Handlers\n   443→          // ============================================\n   444→          case 'launcher:projects:list':\n   445→            try {\n   446→              const projects = await projectRegistry.listProjects();\n   447→              ws.send(JSON.stringify({ type: 'launcher:projects:list', payload: projects }));\n   448→            } catch (err) {\n   449→              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to list projects: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n   450→            }\n   451→            break;\n   452→\n   453→          case 'launcher:projects:add':\n   454→            try {\n   455→              const newProject = await projectRegistry.addProject(message.payload.path);\n   456→              ws.send(JSON.stringify({ type: 'launcher:project:added', payload: newProject }));\n   457→              // Broadcast updated list to all clients\n   458→              const updatedProjects = await projectRegistry.listProjects();\n   459→              broadcast({ type: 'launcher:projects:list', payload: updatedProjects });\n   460→            } catch (err) {\n   461→              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to add project: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n   462→            }\n   463→            break;\n   464→\n   465→          case 'launcher:projects:remove':\n   466→            try {\n   467→              // Stop instance if running\n   468→              if (instanceSpawner.isRunning(message.payload.projectId)) {\n   469→                await instanceSpawner.stopInstance(message.payload.projectId);\n   470→              }\n   471→              await projectRegistry.removeProject(message.payload.projectId);\n   472→              ws.send(JSON.stringify({ type: 'launcher:project:removed', payload: { projectId: message.payload.projectId } }));\n   473→              // Broadcast updated list to all clients\n   474→              const projectsAfterRemove = await projectRegistry.listProjects();\n   475→              broadcast({ type: 'launcher:projects:list', payload: projectsAfterRemove });\n   476→            } catch (err) {\n   477→              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to remove project: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n   478→            }\n   479→            break;\n   480→\n   481→          case 'launcher:instance:spawn':\n   482→            try {\n   483→              const project = await projectRegistry.getProject(message.payload.projectId);\n   484→              if (!project) {\n   485→                throw new Error('Project not found');\n   486→              }\n   487→              const instance = await instanceSpawner.spawnInstance(project.id, project.path);\n   488→              await projectRegistry.updateLastOpened(project.id);\n   489→              ws.send(JSON.stringify({ type: 'launcher:instance:spawned', payload: instance }));\n   490→              // Broadcast updated instances list to all clients\n   491→              const instances = instanceSpawner.listInstances();\n   492→              broadcast({ type: 'launcher:instances:list', payload: instances });\n   493→            } catch (err) {\n   494→              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to spawn instance: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n   495→            }\n   496→            break;\n   497→\n   498→          case 'launcher:instance:stop':\n   499→            try {\n   500→              await instanceSpawner.stopInstance(message.payload.projectId);\n   501→              ws.send(JSON.stringify({ type: 'launcher:instance:stopped', payload: { projectId: message.payload.projectId } }));\n   502→              // Broadcast updated instances list to all clients\n   503→              const instancesAfterStop = instanceSpawner.listInstances();\n   504→              broadcast({ type: 'launcher:instances:list', payload: instancesAfterStop });\n   505→            } catch (err) {\n   506→              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to stop instance: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n   507→            }\n   508→            break;\n   509→\n   510→          case 'launcher:instances:list':\n   511→            try {\n   512→              const runningInstances = instanceSpawner.listInstances();\n   513→              ws.send(JSON.stringify({ type: 'launcher:instances:list', payload: runningInstances }));\n   514→            } catch (err) {\n   515→              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to list instances: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n   516→            }\n   517→            break;\n   518→\n   519→          case 'launcher:discover':\n   520→            try {\n   521→              // Update discovery with current registered projects\n   522→              const registeredProjects = await projectRegistry.listProjects();\n   523→              projectDiscovery.updateRegistered(registeredProjects);\n   524→              const discoveredProjects = await projectDiscovery.discover();\n   525→              ws.send(JSON.stringify({ type: 'launcher:discover:result', payload: discoveredProjects }));\n   526→            } catch (err) {\n   527→              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to discover projects: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n   528→            }\n   529→            break;\n   530→\n   531→          case 'launcher:browse':\n   532→            try {\n   533→              const requestedPath = message.payload?.path || '';\n   534→              const isWindows = process.platform === 'win32';\n   535→\n   536→              // Handle root/drives listing for Windows\n   537→              if (requestedPath === '' || requestedPath === '/' || requestedPath === '\\\\') {\n   538→                if (isWindows) {\n   539→                  // On Windows, list available drives\n   540→                  const drives: string[] = [];\n   541→                  // Check common drive letters\n   542→                  for (const letter of 'CDEFGHIJKLMNOPQRSTUVWXYZ') {\n   543→                    const drivePath = `${letter}:\\\\`;\n   544→                    try {\n   545→                      await fs.access(drivePath);\n   546→                      drives.push(drivePath);\n   547→                    } catch {\n   548→                      // Drive not available\n   549→                    }\n   550→                  }\n   551→                  ws.send(JSON.stringify({\n   552→                    type: 'launcher:browse:result',\n   553→                    payload: {\n   554→                      currentPath: '',\n   555→                      parentPath: null,\n   556→                      entries: [],\n   557→                      drives,\n   558→                    }\n   559→                  }));\n   560→                } else {\n   561→                  // On Unix, browse root\n   562→                  const entries = await browseDirectory('/');\n   563→                  ws.send(JSON.stringify({\n   564→                    type: 'launcher:browse:result',\n   565→                    payload: {\n   566→                      currentPath: '/',\n   567→                      parentPath: null,\n   568→                      entries,\n   569→                    }\n   570→                  }));\n   571→                }\n   572→              } else {\n   573→                // Browse the specified directory\n   574→                const normalizedPath = path.normalize(requestedPath);\n   575→                const entries = await browseDirectory(normalizedPath);\n   576→\n   577→                // Calculate parent path\n   578→                let parentPath: string | null = path.dirname(normalizedPath);\n   579→                if (isWindows) {\n   580→                  // On Windows, check if we're at drive root (e.g., C:\\)\n   581→                  if (normalizedPath.match(/^[A-Z]:\\\\$/i)) {\n   582→                    parentPath = '';  // Go back to drives list\n   583→                  } else if (parentPath === normalizedPath) {\n   584→                    parentPath = null;\n   585→                  }\n   586→                } else {\n   587→                  if (parentPath === normalizedPath || normalizedPath === '/') {\n   588→                    parentPath = null;\n   589→                  }\n   590→                }\n   591→\n   592→                ws.send(JSON.stringify({\n   593→                  type: 'launcher:browse:result',\n   594→                  payload: {\n   595→                    currentPath: normalizedPath,\n   596→                    parentPath,\n   597→                    entries,\n   598→                  }\n   599→                }));\n   600→              }\n   601→            } catch (err) {\n   602→              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to browse directory: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n   603→            }\n   604→            break;\n   605→\n   606→          case 'project:init':\n   607→            try {\n   608→              const projectId = message.payload?.projectId;\n   609→              const templates = message.payload?.templates as TemplateName[] | undefined;\n   610→\n   611→              if (!projectId) {\n   612→                throw new Error('projectId is required');\n   613→              }\n   614→\n   615→              const project = await projectRegistry.getProject(projectId);\n   616→              if (!project) {\n   617→                throw new Error('Project not found');\n   618→              }\n   619→\n   620→              // Initialize with specified templates or default (AGENTS.md, CLAUDE.md)\n   621→              const result = await templateManager.initializeProject(\n   622→                project.path,\n   623→                templates || ['AGENTS.md', 'CLAUDE.md']\n   624→              );\n   625→\n   626→              // Refresh Ralph-ready status after initialization\n   627→              await projectRegistry.refreshRalphStatus(projectId);\n   628→\n   629→              ws.send(JSON.stringify({\n   630→                type: 'project:init:result',\n   631→                payload: {\n   632→                  projectId,\n   633→                  created: result.created,\n   634→                  skipped: result.skipped\n   635→                }\n   636→              }));\n   637→\n   638→              // Broadcast updated project list\n   639→              const updatedProjects = await projectRegistry.listProjects();\n   640→              broadcast({ type: 'launcher:projects:list', payload: updatedProjects });\n   641→            } catch (err) {\n   642→              ws.send(JSON.stringify({\n   643→                type: 'project:init:error',\n   644→                payload: { error: `Failed to initialize project: ${err instanceof Error ? err.message : 'Unknown error'}` }\n   645→              }));\n   646→            }\n   647→            break;\n   648→\n   649→          // ============================================\n   650→          // Review WebSocket Handlers\n   651→          // ============================================\n   652→          case 'review:run':\n   653→            try {\n   654→              await reviewRunner.runReview(message.payload);\n   655→            } catch (err) {\n   656→              ws.send(JSON.stringify({ type: 'review:error', payload: { error: err instanceof Error ? err.message : 'Unknown error' } }));\n   657→            }\n   658→            break;\n   659→\n   660→          case 'review:cancel':\n   661→            reviewRunner.cancel();\n   662→            break;\n   663→\n   664→          // ============================================\n   665→          // Review Generator WebSocket Handlers (Feature Set 14)\n   666→          // ============================================\n   667→          case 'review-generator:generate':\n   668→            try {\n   669→              await reviewGenerator.generateReview(message.payload);\n   670→            } catch (err) {\n   671→              ws.send(JSON.stringify({ type: 'review-generator:error', payload: { error: err instanceof Error ? err.message : 'Unknown error' } }));\n   672→            }\n   673→            break;\n   674→\n   675→          case 'review-generator:cancel':\n   676→            reviewGenerator.cancel();\n   677→            break;\n   678→\n   679→          // ============================================\n   680→          // Workflow Mode WebSocket Handlers\n   681→          // ============================================\n   682→          case 'mode:get': {\n   683→            const modePath = path.join(TARGET_PROJECT_PATH, '.ralph-mode');\n   684→            let mode = 'simple';\n   685→            try {\n   686→              const exists = await fs.access(modePath).then(() => true).catch(() => false);\n   687→              if (exists) {\n   688→                const content = await fs.readFile(modePath, 'utf-8');\n   689→                mode = content.trim();\n   690→                if (mode !== 'simple' && mode !== 'advanced') {\n   691→                  mode = 'simple';\n   692→                }\n   693→              }\n   694→            } catch {\n   695→              mode = 'simple';\n   696→            }\n   697→            ws.send(JSON.stringify({\n   698→              type: 'mode:current',\n   699→              payload: { mode },\n   700→            }));\n   701→            break;\n   702→          }\n   703→\n   704→          case 'mode:set': {\n   705→            const { mode } = message.payload as { mode: 'simple' | 'advanced' };\n   706→            const filesCreated: string[] = [];\n   707→            \n   708→            try {\n   709→              // Write the mode file\n   710→              const modePath = path.join(TARGET_PROJECT_PATH, '.ralph-mode');\n   711→              await fs.writeFile(modePath, mode);\n   712→              filesCreated.push('.ralph-mode');\n   713→              \n   714→              // Auto-generate missing files for the new mode\n   715→              if (mode === 'simple') {\n   716→                // Create prd.json if missing\n   717→                const prdPath = path.join(TARGET_PROJECT_PATH, 'prd.json');\n   718→                const prdExists = await fs.access(prdPath).then(() => true).catch(() => false);\n   719→                if (!prdExists) {\n   720→                  const result = await templateManager.initializeProject(TARGET_PROJECT_PATH, ['prd.json']);\n   721→                  if (result.created.includes('prd.json')) {\n   722→                    filesCreated.push('prd.json');\n   723→                  }\n   724→                }\n   725→                \n   726→                // Create progress.txt if missing\n   727→                const progressPath = path.join(TARGET_PROJECT_PATH, 'progress.txt');\n   728→                const progressExists = await fs.access(progressPath).then(() => true).catch(() => false);\n   729→                if (!progressExists) {\n   730→                  // Create with current date\n   731→                  const date = new Date().toISOString().split('T')[0];\n   732→                  const content = (templateManager.getTemplate('progress.txt') as string).replace('[DATE]', date);\n   733→                  await fs.writeFile(progressPath, content);\n   734→                  filesCreated.push('progress.txt');\n   735→                }\n   736→              } else {\n   737→                // Create IMPLEMENTATION_PLAN.md if missing\n   738→                const planPath = path.join(TARGET_PROJECT_PATH, 'IMPLEMENTATION_PLAN.md');\n   739→                const planExists = await fs.access(planPath).then(() => true).catch(() => false);\n   740→                if (!planExists) {\n   741→                  const result = await templateManager.initializeProject(TARGET_PROJECT_PATH, ['IMPLEMENTATION_PLAN.md']);\n   742→                  if (result.created.includes('IMPLEMENTATION_PLAN.md')) {\n   743→                    filesCreated.push('IMPLEMENTATION_PLAN.md');\n   744→                  }\n   745→                }\n   746→              }\n   747→              \n   748→              ws.send(JSON.stringify({\n   749→                type: 'mode:updated',\n   750→                payload: { success: true, mode, filesCreated },\n   751→              }));\n   752→              \n   753→              // Refresh config and broadcast\n   754→              const updatedConfig = await projectConfig.refresh();\n   755→              broadcast({ type: 'config:update', payload: updatedConfig });\n   756→            } catch (error) {\n   757→              ws.send(JSON.stringify({\n   758→                type: 'mode:updated',\n   759→                payload: {\n   760→                  success: false,\n   761→                  message: error instanceof Error ? error.message : 'Unknown error',\n   762→                },\n   763→              }));\n   764→            }\n   765→            break;\n   766→          }\n   767→        }\n   768→      } catch (err) {\n   769→        logger.error('Error handling WebSocket message', { error: err instanceof Error ? err.message : 'Unknown error' });\n   770→        metrics.incCounter(METRICS.WS_MESSAGES_TOTAL, { status: 'error' });\n   771→        captureError(err instanceof Error ? err : new Error(String(err)), { context: 'websocket_message' });\n   772→      }\n   773→    });\n   774→\n   775→    ws.on('close', () => {\n   776→      clients.delete(ws);\n   777→      metrics.setGauge(METRICS.WS_CONNECTIONS_ACTIVE, clients.size);\n   778→      logger.info('Client disconnected', { totalClients: clients.size });\n   779→    });\n   780→  });\n   781→\n   782→  // File watcher events\n   783→  fileWatcher.on('tasks', (tasks) => {\n   784→    broadcast({ type: 'tasks:update', payload: tasks });\n   785→  });\n   786→\n   787→  fileWatcher.on('log', (entry) => {\n   788→    broadcast({ type: 'loop:log', payload: entry });\n   789→  });\n   790→\n   791→  fileWatcher.on('git', (status) => {\n   792→    broadcast({ type: 'git:update', payload: status });\n   793→  });\n   794→\n   795→  // File watcher config refresh events (when PRD.md or AUDIENCE_JTBD.md change)\n   796→  fileWatcher.on('config:refresh', async () => {\n   797→    try {\n   798→      const updatedConfig = await projectConfig.refresh();\n   799→      broadcast({ type: 'config:update', payload: updatedConfig });\n   800→    } catch (err) {\n   801→      logger.error('Error refreshing config', { error: err instanceof Error ? err.message : 'Unknown error' });\n   802→    }\n   803→  });\n   804→\n   805→  // Loop controller events\n   806→  loopController.on('status', (status) => {\n   807→    broadcast({ type: 'loop:status', payload: status });\n   808→  });\n   809→\n   810→  loopController.on('log', (entry) => {\n   811→    broadcast({ type: 'loop:log', payload: entry });\n   812→  });\n   813→\n   814→  // Plan generator events\n   815→  planGenerator.on('status', (status) => {\n   816→    broadcast({ type: 'plan:status', payload: status });\n   817→  });\n   818→\n   819→  planGenerator.on('output', (text) => {\n   820→    broadcast({ type: 'plan:output', payload: { text } });\n   821→  });\n   822→\n   823→  planGenerator.on('log', (text) => {\n   824→    broadcast({ type: 'plan:log', payload: { text } });\n   825→  });\n   826→\n   827→  planGenerator.on('complete', (result) => {\n   828→    broadcast({ type: 'plan:complete', payload: result });\n   829→  });\n   830→\n   831→  planGenerator.on('error', (error) => {\n   832→    broadcast({ type: 'plan:error', payload: { error } });\n   833→  });\n   834→\n   835→  planGenerator.on('cancelled', () => {\n   836→    broadcast({ type: 'plan:error', payload: { error: 'Plan generation cancelled' } });\n   837→  });\n   838→\n   839→  // PRD generator events\n   840→  prdGenerator.on('status', (status) => {\n   841→    broadcast({ type: 'prd:status', payload: status });\n   842→  });\n   843→\n   844→  prdGenerator.on('output', (text) => {\n   845→    broadcast({ type: 'prd:output', payload: { text } });\n   846→  });\n   847→\n   848→  prdGenerator.on('log', (text) => {\n   849→    broadcast({ type: 'prd:log', payload: { text } });\n   850→  });\n   851→\n   852→  prdGenerator.on('complete', (result) => {\n   853→    broadcast({ type: 'prd:complete', payload: result });\n   854→  });\n   855→\n   856→  prdGenerator.on('error', (error) => {\n   857→    broadcast({ type: 'prd:error', payload: { error } });\n   858→  });\n   859→\n   860→  prdGenerator.on('cancelled', () => {\n   861→    broadcast({ type: 'prd:error', payload: { error: 'PRD generation cancelled' } });\n   862→  });\n   863→\n   864→  // Instance spawner events\n   865→  instanceSpawner.on('stopped', (data: { projectId: string }) => {\n   866→    broadcast({ type: 'launcher:instance:stopped', payload: data });\n   867→    const instances = instanceSpawner.listInstances();\n   868→    broadcast({ type: 'launcher:instances:list', payload: instances });\n   869→  });\n   870→\n   871→  instanceSpawner.on('crashed', (data: { projectId: string; error: string }) => {\n   872→    broadcast({ type: 'launcher:instance:crashed', payload: data });\n   873→    const instances = instanceSpawner.listInstances();\n   874→    broadcast({ type: 'launcher:instances:list', payload: instances });\n   875→  });\n   876→\n   877→  instanceSpawner.on('initialized', async (data: { projectId: string; created: string[] }) => {\n   878→    // Refresh Ralph-ready status and broadcast the update\n   879→    await projectRegistry.refreshRalphStatus(data.projectId);\n   880→    broadcast({ type: 'project:init:result', payload: data });\n   881→    const projects = await projectRegistry.listProjects();\n   882→    broadcast({ type: 'launcher:projects:list', payload: projects });\n   883→  });\n   884→\n   885→  // Review runner events\n   886→  reviewRunner.on('status', (status) => {\n   887→    broadcast({ type: 'review:status', payload: status });\n   888→  });\n   889→\n   890→  reviewRunner.on('output', (text) => {\n   891→    broadcast({ type: 'review:output', payload: { text } });\n   892→  });\n   893→\n   894→  reviewRunner.on('complete', (result) => {\n   895→    broadcast({ type: 'review:complete', payload: result });\n   896→  });\n   897→\n   898→  reviewRunner.on('error', (error) => {\n   899→    broadcast({ type: 'review:error', payload: { error } });\n   900→  });\n   901→\n   902→  reviewRunner.on('cancelled', () => {\n   903→    broadcast({ type: 'review:error', payload: { error: 'Review cancelled' } });\n   904→  });\n   905→\n   906→  // Review generator events (Feature Set 14)\n   907→  reviewGenerator.on('status', (status) => {\n   908→    broadcast({ type: 'review-generator:status', payload: status });\n   909→  });\n   910→\n   911→  reviewGenerator.on('output', (text) => {\n   912→    broadcast({ type: 'review-generator:output', payload: { text } });\n   913→  });\n   914→\n   915→  reviewGenerator.on('log', (text) => {\n   916→    broadcast({ type: 'review-generator:log', payload: { text } });\n   917→  });\n   918→\n   919→  reviewGenerator.on('complete', (result) => {\n   920→    broadcast({ type: 'review-generator:complete', payload: result });\n   921→  });\n   922→\n   923→  reviewGenerator.on('error', (error) => {\n   924→    broadcast({ type: 'review-generator:error', payload: { error } });\n   925→  });\n   926→\n   927→  reviewGenerator.on('cancelled', () => {\n   928→    broadcast({ type: 'review-generator:error', payload: { error: 'Review generation cancelled' } });\n   929→  });\n   930→\n   931→  // REST API endpoints\n   932→  app.get('/api/status', (req, res) => {\n   933→    res.json({\n   934→      loop: loopController.getStatus(),\n   935→      tasks: fileWatcher.getTasks(),\n   936→      git: fileWatcher.getGitStatus(),\n   937→      config: projectConfig.getConfig(),\n   938→    });\n   939→  });\n   940→\n   941→  // New endpoint to get project info\n   942→  app.get('/api/project-info', (req, res) => {\n   943→    res.json(projectRoot);\n   944→  });\n   945→\n   946→  app.get('/api/config/:file', async (req, res) => {\n   947→    try {\n   948→      const content = await projectConfig.readFile(req.params.file);\n   949→      res.json({ content });\n   950→    } catch (err) {\n   951→      res.status(404).json({ error: 'File not found' });\n   952→    }\n   953→  });\n   954→\n   955→  app.post('/api/config/:file', async (req, res) => {\n   956→    try {\n   957→      await projectConfig.writeFile(req.params.file, req.body.content);\n   958→      res.json({ success: true });\n   959→    } catch (err) {\n   960→      res.status(500).json({ error: 'Failed to save file' });\n   961→    }\n   962→  });\n   963→\n   964→  app.post('/api/loop/start', (req, res) => {\n   965→    loopController.start(req.body);\n   966→    res.json({ success: true });\n   967→  });\n   968→\n   969→  app.post('/api/loop/stop', (req, res) => {\n   970→    loopController.stop();\n   971→    res.json({ success: true });\n   972→  });\n   973→\n   974→  // Start file watchers\n   975→  fileWatcher.start();\n   976→\n   977→  // Start server\n   978→  const PORT = process.env.PORT || 3001;\n   979→  server.listen(PORT, () => {\n   980→    logger.info('Ralph Dashboard server started', {\n   981→      port: PORT,\n   982→      targetProject: TARGET_PROJECT_PATH,\n   983→      ralphDirectory: projectRoot.mode === 'embedded' ? RALPH_PATH : undefined,\n   984→      mode: projectRoot.mode,\n   985→    });\n   986→  });\n   987→\n   988→  // Cleanup on exit\n   989→  process.on('SIGINT', async () => {\n   990→    logger.info('Shutting down server...');\n   991→    fileWatcher.stop();\n   992→    loopController.stop();\n   993→    // Stop health monitor\n   994→    healthMonitor.stop();\n   995→    // Stop all spawned instances\n   996→    await instanceSpawner.stopAll();\n   997→    // Flush Sentry events\n   998→    await flushSentry();\n   999→    // Close database\n  1000→    RalphDatabase.close();\n  1001→    server.close();\n  1002→    logger.info('Server shutdown complete');\n  1003→    process.exit(0);\n  1004→  });\n  1005→}\n  1006→\n  1007→// Start the server\n  1008→startServer().catch((err) => {\n  1009→  logger.fatal('Failed to start server', { error: err instanceof Error ? err.message : 'Unknown error' });\n  1010→  sendAlert('Server Startup Failed', err instanceof Error ? err.message : 'Unknown error', 'critical', 'server');\n  1011→  process.exit(1);\n  1012→});\n  1013→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"130e55cd-d481-4dd7-b33f-e0bdbfb691b6","uuid":"fc926b95-5949-4064-b40c-35c4efd6d050","tool_use_result":{"type":"text","file":{"filePath":"/Users/samueledwards/RalphWiggumV3/dashboard/server/index.ts","content":"import express from 'express';\nimport { createServer } from 'http';\nimport { WebSocketServer, WebSocket } from 'ws';\nimport cors from 'cors';\nimport path from 'path';\nimport { fileURLToPath } from 'url';\nimport fs from 'fs/promises';\nimport { FileWatcher } from './fileWatcher.js';\nimport { LoopController } from './loopController.js';\nimport { ProjectConfigManager } from './projectConfig.js';\nimport { PlanGenerator } from './planGenerator.js';\nimport { PRDGenerator } from './prdGenerator.js';\nimport { ProjectScanner } from './projectScanner.js';\nimport { detectProjectRoot, formatProjectInfo, type ProjectRootResult } from './projectRootDetector.js';\nimport { checkAllDependencies } from './dependencyChecker.js';\nimport { ProjectRegistry } from './projectRegistry.js';\nimport { InstanceSpawner } from './instanceSpawner.js';\nimport { ProjectDiscovery } from './projectDiscovery.js';\nimport { ReviewRunner } from './reviewRunner.js';\nimport { ReviewGenerator } from './reviewGenerator.js';\nimport { TemplateManager, type TemplateName } from './templateManager.js';\nimport { RalphDatabase } from './database/index.js';\nimport { getSessionRepository } from './database/repositories/SessionRepository.js';\nimport { getHealthMonitor } from './healthMonitor.js';\nimport { logger } from './lib/logger.js';\nimport { metrics, METRICS } from './lib/metrics.js';\nimport { sendAlert } from './lib/alerts.js';\nimport { initSentry, captureError, flush as flushSentry } from './lib/sentry.js';\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\n\n// Detect project root (async initialization)\nconst RALPH_DEFAULT_PATH = path.resolve(__dirname, '../..');\n\n// Browse directory helper - returns directory entries with metadata\ninterface BrowseEntry {\n  name: string;\n  path: string;\n  isDirectory: boolean;\n  isGitRepo: boolean;\n  isRalphReady: boolean;\n}\n\nasync function browseDirectory(dirPath: string): Promise<BrowseEntry[]> {\n  const entries: BrowseEntry[] = [];\n\n  try {\n    const items = await fs.readdir(dirPath, { withFileTypes: true });\n\n    for (const item of items) {\n      // Skip hidden files/folders (starting with .)\n      if (item.name.startsWith('.')) continue;\n\n      // Only include directories (Task 88: Filter to show only directories)\n      if (!item.isDirectory()) continue;\n\n      const fullPath = path.join(dirPath, item.name);\n\n      // Check if it's a git repo\n      let isGitRepo = false;\n      try {\n        await fs.access(path.join(fullPath, '.git'));\n        isGitRepo = true;\n      } catch {\n        // Not a git repo\n      }\n\n      // Check if it's Ralph-ready (has AGENTS.md and/or CLAUDE.md)\n      let isRalphReady = false;\n      try {\n        const [hasAgents, hasClaude] = await Promise.all([\n          fs.access(path.join(fullPath, 'AGENTS.md')).then(() => true).catch(() => false),\n          fs.access(path.join(fullPath, 'CLAUDE.md')).then(() => true).catch(() => false),\n        ]);\n        isRalphReady = hasAgents || hasClaude;\n      } catch {\n        // Error checking, not Ralph-ready\n      }\n\n      entries.push({\n        name: item.name,\n        path: fullPath,\n        isDirectory: true,\n        isGitRepo,\n        isRalphReady,\n      });\n    }\n\n    // Sort: Ralph-ready first, then git repos, then alphabetically\n    entries.sort((a, b) => {\n      if (a.isRalphReady !== b.isRalphReady) return a.isRalphReady ? -1 : 1;\n      if (a.isGitRepo !== b.isGitRepo) return a.isGitRepo ? -1 : 1;\n      return a.name.localeCompare(b.name);\n    });\n\n  } catch (err) {\n    logger.error(`Error reading directory ${dirPath}`, { error: err instanceof Error ? err.message : 'Unknown error' });\n    throw err;\n  }\n\n  return entries;\n}\n\n// Initialize project detection and return paths\nasync function initializeProjectPaths(): Promise<ProjectRootResult> {\n  // Allow explicit override via environment\n  if (process.env.PROJECT_PATH) {\n    return {\n      targetProjectPath: process.env.PROJECT_PATH,\n      ralphPath: RALPH_DEFAULT_PATH,\n      mode: 'embedded',\n      detectionReason: 'Explicitly set via PROJECT_PATH environment variable',\n    };\n  }\n  return detectProjectRoot(RALPH_DEFAULT_PATH);\n}\n\n// Start server after initialization\nasync function startServer() {\n  // Initialize Sentry early\n  initSentry();\n\n  const projectRoot = await initializeProjectPaths();\n  const TARGET_PROJECT_PATH = projectRoot.targetProjectPath;\n  const RALPH_PATH = projectRoot.ralphPath;\n\n  logger.info('Project paths initialized', { projectRoot: formatProjectInfo(projectRoot) });\n\n  // Initialize SQLite database\n  logger.info('Initializing database...');\n  RalphDatabase.getInstance();\n  logger.info('Database initialized', { path: RalphDatabase.getDatabasePath() });\n\n  const app = express();\n  const server = createServer(app);\n  const wss = new WebSocketServer({ server, path: '/ws' });\n\n  app.use(cors());\n  app.use(express.json());\n\n  // Initialize services with appropriate paths\n  const projectConfig = new ProjectConfigManager(TARGET_PROJECT_PATH, RALPH_PATH);\n  const fileWatcher = new FileWatcher(TARGET_PROJECT_PATH);\n  const loopController = new LoopController(TARGET_PROJECT_PATH, RALPH_PATH);\n  const planGenerator = new PlanGenerator(TARGET_PROJECT_PATH, RALPH_PATH);\n  const prdGenerator = new PRDGenerator(TARGET_PROJECT_PATH, RALPH_PATH);\n  const projectScanner = new ProjectScanner(TARGET_PROJECT_PATH);\n\n  // Initialize launcher services\n  const projectRegistry = new ProjectRegistry();\n  const instanceSpawner = new InstanceSpawner(RALPH_PATH);\n  const projectDiscovery = new ProjectDiscovery();\n  const templateManager = new TemplateManager();\n\n  // Initialize review runner (LLM-as-Judge - Feature Set 13)\n  const reviewRunner = new ReviewRunner(TARGET_PROJECT_PATH);\n\n  // Initialize review generator (Code vs Docs analysis - Feature Set 14)\n  const reviewGenerator = new ReviewGenerator(TARGET_PROJECT_PATH, RALPH_PATH);\n\n  // Initialize health monitor for session management\n  const healthMonitor = getHealthMonitor();\n  healthMonitor.start();\n\n  // Track connected clients\n  const clients = new Set<WebSocket>();\n\n  // Broadcast to all connected clients\n  function broadcast(message: object) {\n    const data = JSON.stringify(message);\n    clients.forEach((client) => {\n      if (client.readyState === WebSocket.OPEN) {\n        client.send(data);\n      }\n    });\n  }\n\n  // WebSocket connection handler\n  wss.on('connection', (ws) => {\n    clients.add(ws);\n    metrics.setGauge(METRICS.WS_CONNECTIONS_ACTIVE, clients.size);\n    logger.info('Client connected', { totalClients: clients.size });\n\n    // Send initial state\n    ws.send(JSON.stringify({ type: 'loop:status', payload: loopController.getStatus() }));\n    ws.send(JSON.stringify({ type: 'tasks:update', payload: fileWatcher.getTasks() }));\n    ws.send(JSON.stringify({ type: 'git:update', payload: fileWatcher.getGitStatus() }));\n    ws.send(JSON.stringify({ type: 'config:update', payload: projectConfig.getConfig() }));\n    ws.send(JSON.stringify({ type: 'project:info', payload: projectRoot }));\n\n    // Handle messages from client\n    ws.on('message', async (data) => {\n      const messageStart = Date.now();\n      metrics.incCounter(METRICS.WS_MESSAGES_TOTAL);\n\n      try {\n        const message = JSON.parse(data.toString());\n        logger.debug('WebSocket message received', { type: message.type });\n\n        switch (message.type) {\n          case 'loop:start':\n            loopController.start(message.payload);\n            break;\n          case 'loop:stop':\n            loopController.stop();\n            break;\n          case 'session:current':\n            // Return current active session for browser refresh resilience\n            try {\n              const sessionRepo = getSessionRepository();\n              const activeSessions = sessionRepo.getActiveSessions();\n              // Find session for current project path\n              const projectId = message.payload?.projectId;\n              let currentSession = null;\n\n              if (projectId) {\n                currentSession = sessionRepo.getActiveSessionForProject(projectId);\n              } else if (activeSessions.length > 0) {\n                // Return the most recent active session\n                currentSession = activeSessions[0];\n              }\n\n              if (currentSession) {\n                // Check if the process is still alive\n                try {\n                  process.kill(currentSession.pid, 0);\n                  // Process alive - recover the session\n                  loopController.recoverSession(currentSession);\n                  ws.send(JSON.stringify({\n                    type: 'session:recovered',\n                    payload: {\n                      sessionId: currentSession.id,\n                      status: loopController.getStatus(),\n                    }\n                  }));\n                } catch {\n                  // Process is dead - mark as crashed\n                  sessionRepo.markSessionCrashed(currentSession.id);\n                  ws.send(JSON.stringify({\n                    type: 'session:none',\n                    payload: { reason: 'process_dead' }\n                  }));\n                }\n              } else {\n                ws.send(JSON.stringify({\n                  type: 'session:none',\n                  payload: { reason: 'no_active_session' }\n                }));\n              }\n            } catch (err) {\n              ws.send(JSON.stringify({\n                type: 'session:error',\n                payload: { error: `Failed to recover session: ${err instanceof Error ? err.message : 'Unknown error'}` }\n              }));\n            }\n            break;\n          case 'config:read':\n            const content = await projectConfig.readFile(message.payload.file);\n            ws.send(JSON.stringify({ type: 'config:content', payload: { file: message.payload.file, content } }));\n            break;\n          case 'config:write':\n            await projectConfig.writeFile(message.payload.file, message.payload.content);\n            ws.send(JSON.stringify({ type: 'config:saved', payload: { file: message.payload.file } }));\n            // Refresh config if PRD.md or AUDIENCE_JTBD.md was written\n            if (message.payload.file === 'PRD.md' || message.payload.file === 'AUDIENCE_JTBD.md') {\n              const updatedConfig = await projectConfig.refresh();\n              broadcast({ type: 'config:update', payload: updatedConfig });\n            }\n            break;\n          case 'config:refresh':\n            try {\n              const updatedConfig = await projectConfig.refresh();\n              broadcast({ type: 'config:update', payload: updatedConfig });\n              ws.send(JSON.stringify({ type: 'config:refreshed' }));\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'config:error', payload: { error: 'Failed to refresh config' } }));\n            }\n            break;\n          case 'agents:toggle':\n            await projectConfig.toggleAgent(message.payload.agentId, message.payload.enabled);\n            const enabledAgents = projectConfig.getEnabledAgents();\n            broadcast({ type: 'agents:update', payload: { enabledAgents } });\n            break;\n          case 'plan:generate':\n            try {\n              // Read PRD context if requested\n              let prdContext = '';\n              if (message.payload.usePrdContext) {\n                try {\n                  const prdContent = await projectConfig.readFile('PRD.md');\n                  const audienceContent = await projectConfig.readFile('AUDIENCE_JTBD.md');\n                  prdContext = `\n## Context: PRD.md\n${prdContent}\n\n## Context: AUDIENCE_JTBD.md\n${audienceContent}\n`;\n                } catch (err) {\n                  logger.warn('Could not read PRD files', { error: err instanceof Error ? err.message : 'Unknown error' });\n                }\n              }\n              await planGenerator.generatePlan({ ...message.payload, prdContext });\n            } catch (err) {\n              logger.error('Error generating plan', { error: err instanceof Error ? err.message : 'Unknown error' });\n              captureError(err instanceof Error ? err : new Error(String(err)), { context: 'plan_generation' });\n              ws.send(JSON.stringify({\n                type: 'plan:error',\n                payload: { error: err instanceof Error ? err.message : 'Failed to start plan generation' }\n              }));\n            }\n            break;\n          case 'plan:cancel':\n            planGenerator.cancel();\n            break;\n          case 'prd:generate':\n            prdGenerator.generatePRD(message.payload);\n            break;\n          case 'prd:cancel':\n            prdGenerator.cancel();\n            break;\n          case 'project:scan':\n            const scanResult = await projectScanner.scan();\n            ws.send(JSON.stringify({ type: 'project:scan-result', payload: scanResult }));\n            break;\n          case 'project:info':\n            ws.send(JSON.stringify({ type: 'project:info', payload: projectRoot }));\n            break;\n          case 'agents:list':\n            const agents = await projectConfig.listAvailableAgents();\n            ws.send(JSON.stringify({ type: 'agents:list-result', payload: agents }));\n            break;\n          case 'rules:list':\n            const rules = await projectConfig.listCursorRulesDetailed();\n            ws.send(JSON.stringify({ type: 'rules:list-result', payload: rules }));\n            break;\n          case 'rules:toggle':\n            const updatedRules = await projectConfig.toggleCursorRule(message.payload.ruleId, message.payload.enabled);\n            broadcast({ type: 'rules:update', payload: updatedRules });\n            break;\n          case 'docs:read':\n            try {\n              const docPath = message.payload.docPath;\n              // Validate path to prevent directory traversal\n              // Use path.resolve to get canonical path and verify it's within project\n              if (path.isAbsolute(docPath)) {\n                ws.send(JSON.stringify({ type: 'docs:error', payload: { error: 'Invalid path' } }));\n                break;\n              }\n              const fullPath = path.resolve(TARGET_PROJECT_PATH, docPath);\n              const projectRoot = path.resolve(TARGET_PROJECT_PATH);\n              // Ensure resolved path starts with project root (prevents ../../../etc/passwd attacks)\n              if (!fullPath.startsWith(projectRoot + path.sep) && fullPath !== projectRoot) {\n                ws.send(JSON.stringify({ type: 'docs:error', payload: { error: 'Invalid path' } }));\n                break;\n              }\n              const docContent = await fs.readFile(fullPath, 'utf-8');\n              ws.send(JSON.stringify({ type: 'docs:content', payload: { path: docPath, content: docContent } }));\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'docs:error', payload: { error: 'Failed to read document' } }));\n            }\n            break;\n          case 'claude:list':\n            try {\n              const claudeFiles = await projectConfig.listClaudeMdFiles();\n              ws.send(JSON.stringify({ type: 'claude:list-result', payload: claudeFiles }));\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'claude:error', payload: { error: 'Failed to list CLAUDE.md files' } }));\n            }\n            break;\n          case 'claude:read':\n            try {\n              const claudeContent = await projectConfig.readClaudeMdFile(message.payload.path);\n              ws.send(JSON.stringify({ type: 'claude:content', payload: { path: message.payload.path, content: claudeContent } }));\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'claude:error', payload: { error: 'Failed to read CLAUDE.md' } }));\n            }\n            break;\n          case 'claude:apply':\n            try {\n              await projectConfig.applyRalphClaudeMd();\n              ws.send(JSON.stringify({ type: 'claude:applied' }));\n              // Refresh and broadcast config update\n              const updatedConfig = await projectConfig.refresh();\n              broadcast({ type: 'config:update', payload: updatedConfig });\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'claude:error', payload: { error: 'Failed to apply CLAUDE.md' } }));\n            }\n            break;\n          case 'dependencies:check':\n            try {\n              const depResults = await checkAllDependencies();\n              ws.send(JSON.stringify({ type: 'dependencies:result', payload: depResults }));\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'dependencies:error', payload: { error: 'Failed to check dependencies' } }));\n            }\n            break;\n          case 'agents:list-repo':\n            try {\n              const repoAgents = await projectConfig.listRepoAgents();\n              ws.send(JSON.stringify({ type: 'agents:repo-result', payload: repoAgents }));\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'agents:error', payload: { error: 'Failed to list repo agents' } }));\n            }\n            break;\n          case 'agents:install-global':\n            try {\n              await projectConfig.installAgentGlobal(message.payload.agentId);\n              ws.send(JSON.stringify({ type: 'agents:installed', payload: { agentId: message.payload.agentId, scope: 'global' } }));\n              // Send updated repo agents list\n              const updatedRepoAgents = await projectConfig.listRepoAgents();\n              ws.send(JSON.stringify({ type: 'agents:repo-result', payload: updatedRepoAgents }));\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'agents:error', payload: { error: `Failed to install agent globally: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n            }\n            break;\n          case 'agents:install-project':\n            try {\n              await projectConfig.installAgentProject(message.payload.agentId);\n              ws.send(JSON.stringify({ type: 'agents:installed', payload: { agentId: message.payload.agentId, scope: 'project' } }));\n              // Send updated repo agents list\n              const updatedRepoAgentsAfterProject = await projectConfig.listRepoAgents();\n              ws.send(JSON.stringify({ type: 'agents:repo-result', payload: updatedRepoAgentsAfterProject }));\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'agents:error', payload: { error: `Failed to install agent to project: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n            }\n            break;\n          case 'agents:install-all-global':\n            try {\n              await projectConfig.installAllAgentsGlobal();\n              ws.send(JSON.stringify({ type: 'agents:installed', payload: { agentId: 'all', scope: 'global' } }));\n              // Send updated repo agents list\n              const updatedRepoAgentsAll = await projectConfig.listRepoAgents();\n              ws.send(JSON.stringify({ type: 'agents:repo-result', payload: updatedRepoAgentsAll }));\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'agents:error', payload: { error: `Failed to install all agents: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n            }\n            break;\n\n          // ============================================\n          // Launcher WebSocket Handlers\n          // ============================================\n          case 'launcher:projects:list':\n            try {\n              const projects = await projectRegistry.listProjects();\n              ws.send(JSON.stringify({ type: 'launcher:projects:list', payload: projects }));\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to list projects: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n            }\n            break;\n\n          case 'launcher:projects:add':\n            try {\n              const newProject = await projectRegistry.addProject(message.payload.path);\n              ws.send(JSON.stringify({ type: 'launcher:project:added', payload: newProject }));\n              // Broadcast updated list to all clients\n              const updatedProjects = await projectRegistry.listProjects();\n              broadcast({ type: 'launcher:projects:list', payload: updatedProjects });\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to add project: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n            }\n            break;\n\n          case 'launcher:projects:remove':\n            try {\n              // Stop instance if running\n              if (instanceSpawner.isRunning(message.payload.projectId)) {\n                await instanceSpawner.stopInstance(message.payload.projectId);\n              }\n              await projectRegistry.removeProject(message.payload.projectId);\n              ws.send(JSON.stringify({ type: 'launcher:project:removed', payload: { projectId: message.payload.projectId } }));\n              // Broadcast updated list to all clients\n              const projectsAfterRemove = await projectRegistry.listProjects();\n              broadcast({ type: 'launcher:projects:list', payload: projectsAfterRemove });\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to remove project: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n            }\n            break;\n\n          case 'launcher:instance:spawn':\n            try {\n              const project = await projectRegistry.getProject(message.payload.projectId);\n              if (!project) {\n                throw new Error('Project not found');\n              }\n              const instance = await instanceSpawner.spawnInstance(project.id, project.path);\n              await projectRegistry.updateLastOpened(project.id);\n              ws.send(JSON.stringify({ type: 'launcher:instance:spawned', payload: instance }));\n              // Broadcast updated instances list to all clients\n              const instances = instanceSpawner.listInstances();\n              broadcast({ type: 'launcher:instances:list', payload: instances });\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to spawn instance: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n            }\n            break;\n\n          case 'launcher:instance:stop':\n            try {\n              await instanceSpawner.stopInstance(message.payload.projectId);\n              ws.send(JSON.stringify({ type: 'launcher:instance:stopped', payload: { projectId: message.payload.projectId } }));\n              // Broadcast updated instances list to all clients\n              const instancesAfterStop = instanceSpawner.listInstances();\n              broadcast({ type: 'launcher:instances:list', payload: instancesAfterStop });\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to stop instance: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n            }\n            break;\n\n          case 'launcher:instances:list':\n            try {\n              const runningInstances = instanceSpawner.listInstances();\n              ws.send(JSON.stringify({ type: 'launcher:instances:list', payload: runningInstances }));\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to list instances: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n            }\n            break;\n\n          case 'launcher:discover':\n            try {\n              // Update discovery with current registered projects\n              const registeredProjects = await projectRegistry.listProjects();\n              projectDiscovery.updateRegistered(registeredProjects);\n              const discoveredProjects = await projectDiscovery.discover();\n              ws.send(JSON.stringify({ type: 'launcher:discover:result', payload: discoveredProjects }));\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to discover projects: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n            }\n            break;\n\n          case 'launcher:browse':\n            try {\n              const requestedPath = message.payload?.path || '';\n              const isWindows = process.platform === 'win32';\n\n              // Handle root/drives listing for Windows\n              if (requestedPath === '' || requestedPath === '/' || requestedPath === '\\\\') {\n                if (isWindows) {\n                  // On Windows, list available drives\n                  const drives: string[] = [];\n                  // Check common drive letters\n                  for (const letter of 'CDEFGHIJKLMNOPQRSTUVWXYZ') {\n                    const drivePath = `${letter}:\\\\`;\n                    try {\n                      await fs.access(drivePath);\n                      drives.push(drivePath);\n                    } catch {\n                      // Drive not available\n                    }\n                  }\n                  ws.send(JSON.stringify({\n                    type: 'launcher:browse:result',\n                    payload: {\n                      currentPath: '',\n                      parentPath: null,\n                      entries: [],\n                      drives,\n                    }\n                  }));\n                } else {\n                  // On Unix, browse root\n                  const entries = await browseDirectory('/');\n                  ws.send(JSON.stringify({\n                    type: 'launcher:browse:result',\n                    payload: {\n                      currentPath: '/',\n                      parentPath: null,\n                      entries,\n                    }\n                  }));\n                }\n              } else {\n                // Browse the specified directory\n                const normalizedPath = path.normalize(requestedPath);\n                const entries = await browseDirectory(normalizedPath);\n\n                // Calculate parent path\n                let parentPath: string | null = path.dirname(normalizedPath);\n                if (isWindows) {\n                  // On Windows, check if we're at drive root (e.g., C:\\)\n                  if (normalizedPath.match(/^[A-Z]:\\\\$/i)) {\n                    parentPath = '';  // Go back to drives list\n                  } else if (parentPath === normalizedPath) {\n                    parentPath = null;\n                  }\n                } else {\n                  if (parentPath === normalizedPath || normalizedPath === '/') {\n                    parentPath = null;\n                  }\n                }\n\n                ws.send(JSON.stringify({\n                  type: 'launcher:browse:result',\n                  payload: {\n                    currentPath: normalizedPath,\n                    parentPath,\n                    entries,\n                  }\n                }));\n              }\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'launcher:error', payload: { error: `Failed to browse directory: ${err instanceof Error ? err.message : 'Unknown error'}` } }));\n            }\n            break;\n\n          case 'project:init':\n            try {\n              const projectId = message.payload?.projectId;\n              const templates = message.payload?.templates as TemplateName[] | undefined;\n\n              if (!projectId) {\n                throw new Error('projectId is required');\n              }\n\n              const project = await projectRegistry.getProject(projectId);\n              if (!project) {\n                throw new Error('Project not found');\n              }\n\n              // Initialize with specified templates or default (AGENTS.md, CLAUDE.md)\n              const result = await templateManager.initializeProject(\n                project.path,\n                templates || ['AGENTS.md', 'CLAUDE.md']\n              );\n\n              // Refresh Ralph-ready status after initialization\n              await projectRegistry.refreshRalphStatus(projectId);\n\n              ws.send(JSON.stringify({\n                type: 'project:init:result',\n                payload: {\n                  projectId,\n                  created: result.created,\n                  skipped: result.skipped\n                }\n              }));\n\n              // Broadcast updated project list\n              const updatedProjects = await projectRegistry.listProjects();\n              broadcast({ type: 'launcher:projects:list', payload: updatedProjects });\n            } catch (err) {\n              ws.send(JSON.stringify({\n                type: 'project:init:error',\n                payload: { error: `Failed to initialize project: ${err instanceof Error ? err.message : 'Unknown error'}` }\n              }));\n            }\n            break;\n\n          // ============================================\n          // Review WebSocket Handlers\n          // ============================================\n          case 'review:run':\n            try {\n              await reviewRunner.runReview(message.payload);\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'review:error', payload: { error: err instanceof Error ? err.message : 'Unknown error' } }));\n            }\n            break;\n\n          case 'review:cancel':\n            reviewRunner.cancel();\n            break;\n\n          // ============================================\n          // Review Generator WebSocket Handlers (Feature Set 14)\n          // ============================================\n          case 'review-generator:generate':\n            try {\n              await reviewGenerator.generateReview(message.payload);\n            } catch (err) {\n              ws.send(JSON.stringify({ type: 'review-generator:error', payload: { error: err instanceof Error ? err.message : 'Unknown error' } }));\n            }\n            break;\n\n          case 'review-generator:cancel':\n            reviewGenerator.cancel();\n            break;\n\n          // ============================================\n          // Workflow Mode WebSocket Handlers\n          // ============================================\n          case 'mode:get': {\n            const modePath = path.join(TARGET_PROJECT_PATH, '.ralph-mode');\n            let mode = 'simple';\n            try {\n              const exists = await fs.access(modePath).then(() => true).catch(() => false);\n              if (exists) {\n                const content = await fs.readFile(modePath, 'utf-8');\n                mode = content.trim();\n                if (mode !== 'simple' && mode !== 'advanced') {\n                  mode = 'simple';\n                }\n              }\n            } catch {\n              mode = 'simple';\n            }\n            ws.send(JSON.stringify({\n              type: 'mode:current',\n              payload: { mode },\n            }));\n            break;\n          }\n\n          case 'mode:set': {\n            const { mode } = message.payload as { mode: 'simple' | 'advanced' };\n            const filesCreated: string[] = [];\n            \n            try {\n              // Write the mode file\n              const modePath = path.join(TARGET_PROJECT_PATH, '.ralph-mode');\n              await fs.writeFile(modePath, mode);\n              filesCreated.push('.ralph-mode');\n              \n              // Auto-generate missing files for the new mode\n              if (mode === 'simple') {\n                // Create prd.json if missing\n                const prdPath = path.join(TARGET_PROJECT_PATH, 'prd.json');\n                const prdExists = await fs.access(prdPath).then(() => true).catch(() => false);\n                if (!prdExists) {\n                  const result = await templateManager.initializeProject(TARGET_PROJECT_PATH, ['prd.json']);\n                  if (result.created.includes('prd.json')) {\n                    filesCreated.push('prd.json');\n                  }\n                }\n                \n                // Create progress.txt if missing\n                const progressPath = path.join(TARGET_PROJECT_PATH, 'progress.txt');\n                const progressExists = await fs.access(progressPath).then(() => true).catch(() => false);\n                if (!progressExists) {\n                  // Create with current date\n                  const date = new Date().toISOString().split('T')[0];\n                  const content = (templateManager.getTemplate('progress.txt') as string).replace('[DATE]', date);\n                  await fs.writeFile(progressPath, content);\n                  filesCreated.push('progress.txt');\n                }\n              } else {\n                // Create IMPLEMENTATION_PLAN.md if missing\n                const planPath = path.join(TARGET_PROJECT_PATH, 'IMPLEMENTATION_PLAN.md');\n                const planExists = await fs.access(planPath).then(() => true).catch(() => false);\n                if (!planExists) {\n                  const result = await templateManager.initializeProject(TARGET_PROJECT_PATH, ['IMPLEMENTATION_PLAN.md']);\n                  if (result.created.includes('IMPLEMENTATION_PLAN.md')) {\n                    filesCreated.push('IMPLEMENTATION_PLAN.md');\n                  }\n                }\n              }\n              \n              ws.send(JSON.stringify({\n                type: 'mode:updated',\n                payload: { success: true, mode, filesCreated },\n              }));\n              \n              // Refresh config and broadcast\n              const updatedConfig = await projectConfig.refresh();\n              broadcast({ type: 'config:update', payload: updatedConfig });\n            } catch (error) {\n              ws.send(JSON.stringify({\n                type: 'mode:updated',\n                payload: {\n                  success: false,\n                  message: error instanceof Error ? error.message : 'Unknown error',\n                },\n              }));\n            }\n            break;\n          }\n        }\n      } catch (err) {\n        logger.error('Error handling WebSocket message', { error: err instanceof Error ? err.message : 'Unknown error' });\n        metrics.incCounter(METRICS.WS_MESSAGES_TOTAL, { status: 'error' });\n        captureError(err instanceof Error ? err : new Error(String(err)), { context: 'websocket_message' });\n      }\n    });\n\n    ws.on('close', () => {\n      clients.delete(ws);\n      metrics.setGauge(METRICS.WS_CONNECTIONS_ACTIVE, clients.size);\n      logger.info('Client disconnected', { totalClients: clients.size });\n    });\n  });\n\n  // File watcher events\n  fileWatcher.on('tasks', (tasks) => {\n    broadcast({ type: 'tasks:update', payload: tasks });\n  });\n\n  fileWatcher.on('log', (entry) => {\n    broadcast({ type: 'loop:log', payload: entry });\n  });\n\n  fileWatcher.on('git', (status) => {\n    broadcast({ type: 'git:update', payload: status });\n  });\n\n  // File watcher config refresh events (when PRD.md or AUDIENCE_JTBD.md change)\n  fileWatcher.on('config:refresh', async () => {\n    try {\n      const updatedConfig = await projectConfig.refresh();\n      broadcast({ type: 'config:update', payload: updatedConfig });\n    } catch (err) {\n      logger.error('Error refreshing config', { error: err instanceof Error ? err.message : 'Unknown error' });\n    }\n  });\n\n  // Loop controller events\n  loopController.on('status', (status) => {\n    broadcast({ type: 'loop:status', payload: status });\n  });\n\n  loopController.on('log', (entry) => {\n    broadcast({ type: 'loop:log', payload: entry });\n  });\n\n  // Plan generator events\n  planGenerator.on('status', (status) => {\n    broadcast({ type: 'plan:status', payload: status });\n  });\n\n  planGenerator.on('output', (text) => {\n    broadcast({ type: 'plan:output', payload: { text } });\n  });\n\n  planGenerator.on('log', (text) => {\n    broadcast({ type: 'plan:log', payload: { text } });\n  });\n\n  planGenerator.on('complete', (result) => {\n    broadcast({ type: 'plan:complete', payload: result });\n  });\n\n  planGenerator.on('error', (error) => {\n    broadcast({ type: 'plan:error', payload: { error } });\n  });\n\n  planGenerator.on('cancelled', () => {\n    broadcast({ type: 'plan:error', payload: { error: 'Plan generation cancelled' } });\n  });\n\n  // PRD generator events\n  prdGenerator.on('status', (status) => {\n    broadcast({ type: 'prd:status', payload: status });\n  });\n\n  prdGenerator.on('output', (text) => {\n    broadcast({ type: 'prd:output', payload: { text } });\n  });\n\n  prdGenerator.on('log', (text) => {\n    broadcast({ type: 'prd:log', payload: { text } });\n  });\n\n  prdGenerator.on('complete', (result) => {\n    broadcast({ type: 'prd:complete', payload: result });\n  });\n\n  prdGenerator.on('error', (error) => {\n    broadcast({ type: 'prd:error', payload: { error } });\n  });\n\n  prdGenerator.on('cancelled', () => {\n    broadcast({ type: 'prd:error', payload: { error: 'PRD generation cancelled' } });\n  });\n\n  // Instance spawner events\n  instanceSpawner.on('stopped', (data: { projectId: string }) => {\n    broadcast({ type: 'launcher:instance:stopped', payload: data });\n    const instances = instanceSpawner.listInstances();\n    broadcast({ type: 'launcher:instances:list', payload: instances });\n  });\n\n  instanceSpawner.on('crashed', (data: { projectId: string; error: string }) => {\n    broadcast({ type: 'launcher:instance:crashed', payload: data });\n    const instances = instanceSpawner.listInstances();\n    broadcast({ type: 'launcher:instances:list', payload: instances });\n  });\n\n  instanceSpawner.on('initialized', async (data: { projectId: string; created: string[] }) => {\n    // Refresh Ralph-ready status and broadcast the update\n    await projectRegistry.refreshRalphStatus(data.projectId);\n    broadcast({ type: 'project:init:result', payload: data });\n    const projects = await projectRegistry.listProjects();\n    broadcast({ type: 'launcher:projects:list', payload: projects });\n  });\n\n  // Review runner events\n  reviewRunner.on('status', (status) => {\n    broadcast({ type: 'review:status', payload: status });\n  });\n\n  reviewRunner.on('output', (text) => {\n    broadcast({ type: 'review:output', payload: { text } });\n  });\n\n  reviewRunner.on('complete', (result) => {\n    broadcast({ type: 'review:complete', payload: result });\n  });\n\n  reviewRunner.on('error', (error) => {\n    broadcast({ type: 'review:error', payload: { error } });\n  });\n\n  reviewRunner.on('cancelled', () => {\n    broadcast({ type: 'review:error', payload: { error: 'Review cancelled' } });\n  });\n\n  // Review generator events (Feature Set 14)\n  reviewGenerator.on('status', (status) => {\n    broadcast({ type: 'review-generator:status', payload: status });\n  });\n\n  reviewGenerator.on('output', (text) => {\n    broadcast({ type: 'review-generator:output', payload: { text } });\n  });\n\n  reviewGenerator.on('log', (text) => {\n    broadcast({ type: 'review-generator:log', payload: { text } });\n  });\n\n  reviewGenerator.on('complete', (result) => {\n    broadcast({ type: 'review-generator:complete', payload: result });\n  });\n\n  reviewGenerator.on('error', (error) => {\n    broadcast({ type: 'review-generator:error', payload: { error } });\n  });\n\n  reviewGenerator.on('cancelled', () => {\n    broadcast({ type: 'review-generator:error', payload: { error: 'Review generation cancelled' } });\n  });\n\n  // REST API endpoints\n  app.get('/api/status', (req, res) => {\n    res.json({\n      loop: loopController.getStatus(),\n      tasks: fileWatcher.getTasks(),\n      git: fileWatcher.getGitStatus(),\n      config: projectConfig.getConfig(),\n    });\n  });\n\n  // New endpoint to get project info\n  app.get('/api/project-info', (req, res) => {\n    res.json(projectRoot);\n  });\n\n  app.get('/api/config/:file', async (req, res) => {\n    try {\n      const content = await projectConfig.readFile(req.params.file);\n      res.json({ content });\n    } catch (err) {\n      res.status(404).json({ error: 'File not found' });\n    }\n  });\n\n  app.post('/api/config/:file', async (req, res) => {\n    try {\n      await projectConfig.writeFile(req.params.file, req.body.content);\n      res.json({ success: true });\n    } catch (err) {\n      res.status(500).json({ error: 'Failed to save file' });\n    }\n  });\n\n  app.post('/api/loop/start', (req, res) => {\n    loopController.start(req.body);\n    res.json({ success: true });\n  });\n\n  app.post('/api/loop/stop', (req, res) => {\n    loopController.stop();\n    res.json({ success: true });\n  });\n\n  // Start file watchers\n  fileWatcher.start();\n\n  // Start server\n  const PORT = process.env.PORT || 3001;\n  server.listen(PORT, () => {\n    logger.info('Ralph Dashboard server started', {\n      port: PORT,\n      targetProject: TARGET_PROJECT_PATH,\n      ralphDirectory: projectRoot.mode === 'embedded' ? RALPH_PATH : undefined,\n      mode: projectRoot.mode,\n    });\n  });\n\n  // Cleanup on exit\n  process.on('SIGINT', async () => {\n    logger.info('Shutting down server...');\n    fileWatcher.stop();\n    loopController.stop();\n    // Stop health monitor\n    healthMonitor.stop();\n    // Stop all spawned instances\n    await instanceSpawner.stopAll();\n    // Flush Sentry events\n    await flushSentry();\n    // Close database\n    RalphDatabase.close();\n    server.close();\n    logger.info('Server shutdown complete');\n    process.exit(0);\n  });\n}\n\n// Start the server\nstartServer().catch((err) => {\n  logger.fatal('Failed to start server', { error: err instanceof Error ? err.message : 'Unknown error' });\n  sendAlert('Server Startup Failed', err instanceof Error ? err.message : 'Unknown error', 'critical', 'server');\n  process.exit(1);\n});\n","numLines":1013,"startLine":1,"totalLines":1013}}}
