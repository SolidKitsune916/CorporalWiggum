ing implementation]\n    61→`;\n    62→\n    63→// Simple mode prd.json template\n    64→const PRD_JSON_TEMPLATE = JSON.stringify({\n    65→  branchName: \"ralph/feature\",\n    66→  userStories: [\n    67→    {\n    68→      id: \"US-001\",\n    69→      title: \"[Your first user story]\",\n    70→      acceptanceCriteria: [\n    71→        \"[Criterion 1]\",\n    72→        \"[Criterion 2]\",\n    73→        \"typecheck passes\"\n    74→      ],\n    75→      priority: 1,\n    76→      passes: false,\n    77→      notes: \"\"\n    78→    }\n    79→  ]\n    80→}, null, 2);\n    81→\n    82→// Simple mode progress.txt template\n    83→const PROGRESS_TXT_TEMPLATE = `# Ralph Progress Log\n    84→Started: [DATE]\n    85→\n    86→## Codebase Patterns\n    87→[Add reusable patterns discovered during development here]\n    88→- Example: Migrations use IF NOT EXISTS\n    89→- Example: Types exported from actions.ts\n    90→\n    91→## Key Files\n    92→[Important files for this project]\n    93→- Example: db/schema.ts\n    94→- Example: app/auth/actions.ts\n    95→\n    96→---\n    97→\n    98→## [Date] - [Story ID]\n    99→- What was implemented: [Brief description]\n   100→- Files changed: [List of files]\n   101→- **Learnings:**\n   102→  - [Pattern or gotcha discovered]\n   103→  - [Another learning]\n   104→\n   105→---\n   106→`;\n   107→\n   108→// Workflow mode file template\n   109→const RALPH_MODE_TEMPLATE = 'simple';\n   110→\n   111→export type TemplateName = 'AGENTS.md' | 'CLAUDE.md' | 'IMPLEMENTATION_PLAN.md' | 'prd.json' | 'progress.txt' | '.ralph-mode';\n   112→\n   113→const TEMPLATES: Record<TemplateName, string> = {\n   114→  'AGENTS.md': AGENTS_TEMPLATE,\n   115→  'CLAUDE.md': CLAUDE_TEMPLATE,\n   116→  'IMPLEMENTATION_PLAN.md': IMPLEMENTATION_PLAN_TEMPLATE,\n   117→  'prd.json': PRD_JSON_TEMPLATE,\n   118→  'progress.txt': PROGRESS_TXT_TEMPLATE,\n   119→  '.ralph-mode': RALPH_MODE_TEMPLATE,\n   120→};\n   121→\n   122→export class TemplateManager {\n   123→  /**\n   124→   * Get template content by name\n   125→   */\n   126→  getTemplate(name: TemplateName): string {\n   127→    const template = TEMPLATES[name];\n   128→    if (!template) {\n   129→      throw new Error(`Unknown template: ${name}`);\n   130→    }\n   131→    return template;\n   132→  }\n   133→\n   134→  /**\n   135→   * Get all available template names\n   136→   */\n   137→  getAvailableTemplates(): TemplateName[] {\n   138→    return Object.keys(TEMPLATES) as TemplateName[];\n   139→  }\n   140→\n   141→  /**\n   142→   * Check if a file exists at the given path\n   143→   */\n   144→  private async fileExists(filePath: string): Promise<boolean> {\n   145→    try {\n   146→      await fs.access(filePath);\n   147→      return true;\n   148→    } catch {\n   149→      return false;\n   150→    }\n   151→  }\n   152→\n   153→  /**\n   154→   * Initialize a project with specified templates\n   155→   * Only creates files that don't already exist\n   156→   * @param projectPath - The project directory path\n   157→   * @param templates - Array of template names to create (defaults to AGENTS.md and CLAUDE.md)\n   158→   * @returns Object with created files and skipped files\n   159→   */\n   160→  async initializeProject(\n   161→    projectPath: string,\n   162→    templates: TemplateName[] = ['AGENTS.md', 'CLAUDE.md']\n   163→  ): Promise<{ created: string[]; skipped: string[] }> {\n   164→    const created: string[] = [];\n   165→    const skipped: string[] = [];\n   166→\n   167→    for (const templateName of templates) {\n   168→      const filePath = path.join(projectPath, templateName);\n   169→      const exists = await this.fileExists(filePath);\n   170→\n   171→      if (exists) {\n   172→        skipped.push(templateName);\n   173→        continue;\n   174→      }\n   175→\n   176→      const content = this.getTemplate(templateName);\n   177→      await fs.writeFile(filePath, content, 'utf-8');\n   178→      created.push(templateName);\n   179→    }\n   180→\n   181→    return { created, skipped };\n   182→  }\n   183→\n   184→  /**\n   185→   * Check which Ralph files exist in a project\n   186→   */\n   187→  async checkProjectFiles(projectPath: string): Promise<Record<TemplateName, boolean>> {\n   188→    const result: Record<TemplateName, boolean> = {\n   189→      'AGENTS.md': false,\n   190→      'CLAUDE.md': false,\n   191→      'IMPLEMENTATION_PLAN.md': false,\n   192→      'prd.json': false,\n   193→      'progress.txt': false,\n   194→      '.ralph-mode': false,\n   195→    };\n   196→\n   197→    for (const templateName of this.getAvailableTemplates()) {\n   198→      const filePath = path.join(projectPath, templateName);\n   199→      result[templateName] = await this.fileExists(filePath);\n   200→    }\n   201→\n   202→    return result;\n   203→  }\n   204→\n   205→  /**\n   206→   * Check if a project needs initialization (missing both AGENTS.md and CLAUDE.md)\n   207→   */\n   208→  async needsInitialization(projectPath: string): Promise<boolean> {\n   209→    const hasAgents = await this.fileExists(path.join(projectPath, 'AGENTS.md'));\n   210→    const hasClaude = await this.fileExists(path.join(projectPath, 'CLAUDE.md'));\n   211→    return !hasAgents && !hasClaude;\n   212→  }\n   213→}\n   214→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"6f0bf378-6db9-4f0d-94d4-53d6793fc6db","uuid":"dbb25686-736b-43e6-be28-8f8a6b698a06","tool_use_result":{"type":"text","file":{"filePath":"/Users/samueledwards/RalphWiggumV3/dashboard/server/templateManager.ts","content":"/**\n * Template Manager - Provides default templates for Ralph configuration files\n * Used to initialize projects that are missing Ralph files\n */\n\nimport fs from 'fs/promises';\nimport path from 'path';\n\n// Default AGENTS.md template\nconst AGENTS_TEMPLATE = `# Project Configuration\n\n## Build Commands\n- Build: \\`npm run build\\`\n- Test: \\`npm test\\`\n- Lint: \\`npm run lint\\`\n\n## Project Notes\n[Add your project-specific notes here]\n`;\n\n// Default CLAUDE.md template\nconst CLAUDE_TEMPLATE = `# Project Instructions\n\n## Phase 0: Orient\n\n1. Read \\`AGENTS.md\\` for build/test commands\n2. Read \\`IMPLEMENTATION_PLAN.md\\` for current tasks\n\n## Phase 1: Execute\n\n1. Pick highest-priority incomplete task\n2. Search codebase first - don't assume functionality is missing\n3. Implement completely - no placeholders, no TODOs\n4. Run validation commands\n5. If tests pass: \\`git add -A && git commit -m \"feat: [task]\"\\`\n6. Update \\`IMPLEMENTATION_PLAN.md\\`\n\n## Completion Signal\n\nOutput \\`ALL_TASKS_COMPLETE\\` when all tasks are done.\n`;\n\n// Default IMPLEMENTATION_PLAN.md template\nconst IMPLEMENTATION_PLAN_TEMPLATE = `# Implementation Plan\n\n## Current Tasks\n\n### Priority 1 - Critical\n- [ ] [Add your first task here]\n\n### Priority 2 - Important\n- [ ] [Add secondary tasks here]\n\n## Completed Tasks\n\n[Completed tasks will be moved here]\n\n## Notes & Discoveries\n\n[Document findings during implementation]\n`;\n\n// Simple mode prd.json template\nconst PRD_JSON_TEMPLATE = JSON.stringify({\n  branchName: \"ralph/feature\",\n  userStories: [\n    {\n      id: \"US-001\",\n      title: \"[Your first user story]\",\n      acceptanceCriteria: [\n        \"[Criterion 1]\",\n        \"[Criterion 2]\",\n        \"typecheck passes\"\n      ],\n      priority: 1,\n      passes: false,\n      notes: \"\"\n    }\n  ]\n}, null, 2);\n\n// Simple mode progress.txt template\nconst PROGRESS_TXT_TEMPLATE = `# Ralph Progress Log\nStarted: [DATE]\n\n## Codebase Patterns\n[Add reusable patterns discovered during development here]\n- Example: Migrations use IF NOT EXISTS\n- Example: Types exported from actions.ts\n\n## Key Files\n[Important files for this project]\n- Example: db/schema.ts\n- Example: app/auth/actions.ts\n\n---\n\n## [Date] - [Story ID]\n- What was implemented: [Brief description]\n- Files changed: [List of files]\n- **Learnings:**\n  - [Pattern or gotcha discovered]\n  - [Another learning]\n\n---\n`;\n\n// Workflow mode file template\nconst RALPH_MODE_TEMPLATE = 'simple';\n\nexport type TemplateName = 'AGENTS.md' | 'CLAUDE.md' | 'IMPLEMENTATION_PLAN.md' | 'prd.json' | 'progress.txt' | '.ralph-mode';\n\nconst TEMPLATES: Record<TemplateName, string> = {\n  'AGENTS.md': AGENTS_TEMPLATE,\n  'CLAUDE.md': CLAUDE_TEMPLATE,\n  'IMPLEMENTATION_PLAN.md': IMPLEMENTATION_PLAN_TEMPLATE,\n  'prd.json': PRD_JSON_TEMPLATE,\n  'progress.txt': PROGRESS_TXT_TEMPLATE,\n  '.ralph-mode': RALPH_MODE_TEMPLATE,\n};\n\nexport class TemplateManager {\n  /**\n   * Get template content by name\n   */\n  getTemplate(name: TemplateName): string {\n    const template = TEMPLATES[name];\n    if (!template) {\n      throw new Error(`Unknown template: ${name}`);\n    }\n    return template;\n  }\n\n  /**\n   * Get all available template names\n   */\n  getAvailableTemplates(): TemplateName[] {\n    return Object.keys(TEMPLATES) as TemplateName[];\n  }\n\n  /**\n   * Check if a file exists at the given path\n   */\n  private async fileExists(filePath: string): Promise<boolean> {\n    try {\n      await fs.access(filePath);\n      return true;\n    } catch {\n      return false;\n    }\n  }\n\n  /**\n   * Initialize a project with specified templates\n   * Only creates files that don't already exist\n   * @param projectPath - The project directory path\n   * @param templates - Array of template names to create (defaults to AGENTS.md and CLAUDE.md)\n   * @returns Object with created files and skipped files\n   */\n  async initializeProject(\n    projectPath: string,\n    templates: TemplateName[] = ['AGENTS.md', 'CLAUDE.md']\n  ): Promise<{ created: string[]; skipped: string[] }> {\n    const created: string[] = [];\n    const skipped: string[] = [];\n\n    for (const templateName of templates) {\n      const filePath = path.join(projectPath, templateName);\n      const exists = await this.fileExists(filePath);\n\n      if (exists) {\n        skipped.push(templateName);\n        continue;\n      }\n\n      const content = this.getTemplate(templateName);\n      await fs.writeFile(filePath, content, 'utf-8');\n      created.push(templateName);\n    }\n\n    return { created, skipped };\n  }\n\n  /**\n   * Check which Ralph files exist in a project\n   */\n  async checkProjectFiles(projectPath: string): Promise<Record<TemplateName, boolean>> {\n    const result: Record<TemplateName, boolean> = {\n      'AGENTS.md': false,\n      'CLAUDE.md': false,\n      'IMPLEMENTATION_PLAN.md': false,\n      'prd.json': false,\n      'progress.txt': false,\n      '.ralph-mode': false,\n    };\n\n    for (const templateName of this.getAvailableTemplates()) {\n      const filePath = path.join(projectPath, templateName);\n      result[templateName] = await this.fileExists(filePath);\n    }\n\n    return result;\n  }\n\n  /**\n   * Check if a project needs initialization (missing both AGENTS.md and CLAUDE.md)\n   */\n  async needsInitialization(projectPath: string): Promise<boolean> {\n    const hasAgents = await this.fileExists(path.join(projectPath, 'AGENTS.md'));\n    const hasClaude = await this.fileExists(path.join(projectPath, 'CLAUDE.md'));\n    return !hasAgents && !hasClaude;\n  }\n}\n","numLines":214,"startLine":1,"totalLines":214}}}
