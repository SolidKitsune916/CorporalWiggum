→  };\n   108→\n   109→  const breadcrumbs = getBreadcrumbs();\n   110→\n   111→  return (\n   112→    <div className=\"space-y-3\">\n   113→      {/* Breadcrumb Navigation */}\n   114→      <div className=\"flex items-center gap-1 text-sm overflow-x-auto pb-1\">\n   115→        {/* Home/Drives button */}\n   116→        <Button\n   117→          variant=\"ghost\"\n   118→          size=\"sm\"\n   119→          className=\"h-7 px-2 shrink-0\"\n   120→          onClick={() => handleNavigate('')}\n   121→          disabled={browsing}\n   122→        >\n   123→          <Home className=\"h-4 w-4\" />\n   124→        </Button>\n   125→\n   126→        {breadcrumbs.map((segment, index) => (\n   127→          <div key={segment.path} className=\"flex items-center shrink-0\">\n   128→            <ChevronRight className=\"h-3 w-3 text-muted-foreground\" />\n   129→            <Button\n   130→              variant=\"ghost\"\n   131→              size=\"sm\"\n   132→              className=\"h-7 px-2 max-w-[150px]\"\n   133→              onClick={() => handleNavigate(segment.path)}\n   134→              disabled={browsing || index === breadcrumbs.length - 1}\n   135→            >\n   136→              <span className=\"truncate\">{segment.name}</span>\n   137→            </Button>\n   138→          </div>\n   139→        ))}\n   140→\n   141→        {browsing && (\n   142→          <Loader2 className=\"h-4 w-4 animate-spin ml-2\" />\n   143→        )}\n   144→      </div>\n   145→\n   146→      {/* Directory Contents */}\n   147→      <ScrollArea className=\"h-[200px] rounded-md border\">\n   148→        <div className=\"p-2\">\n   149→          {/* Show drives on Windows at root */}\n   150→          {browseResult?.drives && browseResult.drives.length > 0 && (\n   151→            <div className=\"space-y-1\">\n   152→              <p className=\"text-xs text-muted-foreground px-2 py-1\">Drives</p>\n   153→              {browseResult.drives.map((drive) => (\n   154→           