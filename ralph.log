{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015T43nqd6Bdh5bbccweDjYB","type":"tool_result","content":"     1→import { EventEmitter } from 'events';\n     2→import { spawn, ChildProcess, exec } from 'child_process';\n     3→import fs from 'fs/promises';\n     4→import path from 'path';\n     5→import readline from 'readline';\n     6→\n     7→export type ReviewMode = 'review' | 'review-quick' | 'review-spec';\n     8→\n     9→interface ReviewGeneratorStatus {\n    10→  generating: boolean;\n    11→  mode: ReviewMode | null;\n    12→  startedAt: Date | null;\n    13→}\n    14→\n    15→const PROMPT_FILES: Record<ReviewMode, string> = {\n    16→  review: 'PROMPT_review.md',\n    17→  'review-quick': 'PROMPT_review.md',  // Uses same prompt with different instructions\n    18→  'review-spec': 'PROMPT_review.md',   // Uses same prompt with spec focus\n    19→};\n    20→\n    21→export class ReviewGenerator extends EventEmitter {\n    22→  private projectPath: string;\n    23→  private ralphPath: string;\n    24→  private process: ChildProcess | null = null;\n    25→  private status: ReviewGeneratorStatus = {\n    26→    generating: false,\n    27→    mode: null,\n    28→    startedAt: null,\n    29→  };\n    30→  private accumulatedOutput: string = '';\n    31→  private accumulatedReport: string = '';\n    32→\n    33→  constructor(projectPath: string, ralphPath?: string) {\n    34→    super();\n    35→    this.projectPath = projectPath;\n    36→    this.ralphPath = ralphPath || projectPath;\n    37→  }\n    38→\n    39→  getStatus(): ReviewGeneratorStatus {\n    40→    return { ...this.status };\n    41→  }\n    42→\n    43→  async generateReview(options: {\n    44→    mode: ReviewMode;\n    45→    focusArea?: string;     // e.g., \"Feature Set 5\" or \"authentication\"\n    46→    specFile?: string;      // For review-spec mode: specific spec to verify\n    47→  }): Promise<void> {\n    48→    if (this.status.generating) {\n    49→      thro