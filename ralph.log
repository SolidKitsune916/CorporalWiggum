: string; specFile?: string }) => void;\n    84→  cancelReviewGenerator: () => void;\n    85→  clearReviewGeneratorOutput: () => void;\n    86→  // Workflow mode state and handlers\n    87→  workflowMode: WorkflowMode;\n    88→  setWorkflowMode: (mode: WorkflowMode) => void;\n    89→  getWorkflowMode: () => void;\n    90→}\n    91→\n    92→const DEFAULT_LOOP_STATUS: LoopStatus = {\n    93→  running: false,\n    94→  mode: null,\n    95→  iteration: 0,\n    96→  maxIterations: 0,\n    97→};\n    98→\n    99→const DEFAULT_TASKS: TasksState = {\n   100→  tasks: [],\n   101→  completed: 0,\n   102→  total: 0,\n   103→};\n   104→\n   105→const DEFAULT_GIT_STATUS: GitStatus = {\n   106→  branch: 'main',\n   107→  uncommittedCount: 0,\n   108→  commits: [],\n   109→};\n   110→\n   111→const DEFAULT_ENABLED_AGENTS = ['react-typescript-expert', 'accessibility-expert', 'qol-ux-expert'];\n   112→\n   113→const DEFAULT_PLAN_STATUS: PlanGeneratorStatus = {\n   114→  generating: false,\n   115→  mode: null,\n   116→  startedAt: null,\n   117→};\n   118→\n   119→const DEFAULT_PRD_STATUS: PRDGeneratorStatus = {\n   120→  generating: false,\n   121→  startedAt: null,\n   122→};\n   123→\n   124→const DEFAULT_REVIEW_GENERATOR_STATUS: ReviewGeneratorStatus = {\n   125→  generating: false,\n   126→  mode: null,\n   127→  startedAt: null,\n   128→};\n   129→\n   130→// Allow WebSocket port to be configured via environment variable for multi-instance support\n   131→const DEFAULT_WS_PORT = import.meta.env.VITE_WS_PORT || '3001';\n   132→\n   133→export function useWebSocket(url: string = `ws://localhost:${DEFAULT_WS_PORT}/ws`): UseWebSocketReturn {\n   134→  const [connected, setConnected] = useState(false);\n   135→  const [loopStatus, setLoopStatus] = useState<LoopStatus>(DEFAULT_LOOP_STATUS);\n   136→  const [tasks, setTasks] = useState<TasksState>(DEFAULT_TASKS);\n   137→  const [gitStatus, setGitStatus] = useState<GitStatus>(DEFAULT_GIT_STATUS);\n   138→  const [logs, setLogs] = useState<LogEntry[]>([]);\n   139→  const [projectConfig, setProjectConfig] = useState<ProjectConfig | null>(null);\n   140→  const [enabledAgents, setEnabledAgents] = useState<string[]>(DEFAULT_ENABLED_AGENTS);\n   141→  // Plan generation state\n   142→  const [planStatus, setPlanStatus] = useState<PlanGeneratorStatus>(DEFAULT_PLAN_STATUS);\n   143→  const [planOutput, setPlanOutput] = useState('');\n   144→  const [planComplete, setPlanComplete] = useState<{ plan: string; output: string } | null>(null);\n   145→  const [planError, setPlanError] = useState<string | null>(null);\n   146→  // PRD generation state\n   147→  const [prdStatus, setPrdStatus] = useState<PRDGeneratorStatus>(DEFAULT_PRD_STATUS);\n   148→  const [prdOutput, setPrdOutput] = useState('');\n   149→  const [prdComplete, setPrdComplete] = useState<{ prd: string; audience: string } | null>(null);\n   150→  const [prdError, setPrdError] = useState<string | null>(null);\n   151→  // Project scanning state\n   152→  const [projectScan, setProjectScan] = useState<ProjectScan | null>(null);\n   153→  const [scanLoading, setScanLoading] = useState(false);\n   154→  // Project info (from server)\n   155→  const [projectInfo, setProjectInfo] = useState<ProjectInfo | null>(null);\n   156→  // Agent and rules state\n   157→  const [availableAgents, setAvailableAgents] = useState<AgentInfo[]>([]);\n   158→  const [cursorRules, setCursorRules] = useState<CursorRuleInfo[]>([]);\n   159→  const [agentsLoading, setAgentsLoading] = useState(false);\n   160→  const [rulesLoading, setRulesLoading] = useState(false);\n   161→  // Document selection state (for PRD context)\n   162→  const [selectedDocPaths, setSelectedDocPaths] = useState<string[]>([]);\n   163→  const [previewDoc, setPreviewDoc] = useState<{ path: string; content: string } | null>(null);\n   164→  const [isLoadingPreview, setIsLoadingPreview] = useState(false);\n   165→  // CLAUDE.md state\n   166→  const [claudeMdFiles, setClaudeMdFiles] = useState<ClaudeMdFile[]>([]);\n   167→  const [claudeMdContent, setClaudeMdContent] = useState<{ path: string; content: string } | null>(null);\n   168→  const [claudeMdLoading, setClaudeMdLoading] = useState(false);\n   169→  const [claudeMdApplying, setClaudeMdApplying] = useState(false);\n   170→  // Dependency check state\n   171→  const [dependencyStatus, setDependencyStatus] = useState<DependencyCheckResult[]>([]);\n   172→  const [dependencyLoading, setDependencyLoading] = useState(false);\n   173→  // Config file preview state (for ExistingDocsViewer)\n   174→  const [configPreviewDoc, setConfigPreviewDoc] = useState<{ file: string; content: string } | null>(null);\n   175→  const [configPreviewLoading, setConfigPreviewLoading] = useState(false);\n   176→  // Repo agent installation state\n   177→  const [repoAgents, setRepoAgents] = useState<RepoAgentInfo[]>([]);\n   178→  const [repoAgentsLoading, setRepoAgentsLoading] = useState(false);\n   179→  const [agentInstalling, setAgentInstalling] = useState<string | null>(null);\n   180→  // Review generator state (Feature Set 14)\n   181→  const [reviewGeneratorStatus, setReviewGeneratorStatus] = useState<ReviewGeneratorStatus>(DEFAULT_REVIEW_GENERATOR_STATUS);\n   182→  const [reviewGeneratorOutput, setReviewGeneratorOutput] = useState('');\n   183→  const [reviewGeneratorComplete, setReviewGeneratorComplete] = useState<{ report: string; output: string } | null>(null);\n   184→  const [reviewGeneratorError, setReviewGeneratorError] = useState<string | null>(null);\n   185→  // Workflow mode state\n   186→  const [workflowMode, setWorkflowModeState] = useState<WorkflowMode>('simple');\n   187→\n   188→  const wsRef = useRef<WebSocket | null>(null);\n   189→  const reconnectTimeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null);\n   190→  const isCleaningUpRef = useRef(false);\n   191→\n   192→  const connect = useCallback(() => {\n   193→    if (isCleaningUpRef.current) {\n   194→      return;\n   195→    }\n   196→    \n   197→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   198→      return;\n   199→    }\n   200→\n   201→    // Close existing connection if it exists\n   202→    if (wsRef.current) {\n   203→      wsRef.current.close();\n   204→    }\n   205→\n   206→    const ws = new WebSocket(url);\n   207→\n   208→    ws.onopen = () => {\n   209→      if (!isCleaningUpRef.current) {\n   210→        setConnected(true);\n   211→        if (reconnectTimeoutRef.current) {\n   212→          clearTimeout(reconnectTimeoutRef.current);\n   213→          reconnectTimeoutRef.current = null;\n   214→        }\n   215→        // Request current session state for browser refresh resilience\n   216→        ws.send(JSON.stringify({ type: 'session:current', payload: {} }));\n   217→      }\n   218→    };\n   219→\n   220→    ws.onclose = () => {\n   221→      if (!isCleaningUpRef.current) {\n   222→        setConnected(false);\n   223→        // Attempt to reconnect after 2 seconds\n   224→        reconnectTimeoutRef.current = setTimeout(() => {\n   225→          if (!isCleaningUpRef.current) {\n   226→            connect();\n   227→          }\n   228→        }, 2000);\n   229→      }\n   230→    };\n   231→\n   232→    ws.onerror = (error) => {\n   233→      // Only log errors if not cleaning up (React StrictMode causes intentional errors)\n   234→      if (!isCleaningUpRef.current && ws.readyState !== WebSocket.CLOSING && ws.readyState !== WebSocket.CLOSED) {\n   235→        console.error('WebSocket error:', error);\n   236→      }\n   237→      if (!isCleaningUpRef.current) {\n   238→        ws.close();\n   239→      }\n   240→    };\n   241→\n   242→    ws.onmessage = (event) => {\n   243→      try {\n   244→        const message: ServerMessage = JSON.parse(event.data);\n   245→\n   246→        switch (message.type) {\n   247→          case 'loop:status':\n   248→            setLoopStatus(message.payload);\n   249→            break;\n   250→          case 'session:recovered':\n   251→            // Session recovered after browser refresh\n   252→            console.log('Session recovered:', message.payload.sessionId);\n   253→            if (message.payload.status) {\n   254→              setLoopStatus(message.payload.status);\n   255→            }\n   256→            break;\n   257→          case 'session:none':\n   258→            // No active session to recover - this is normal\n   259→            console.log('No active session:', message.payload.reason);\n   260→            break;\n   261→          case 'session:error':\n   262→            console.error('Session recovery error:', message.payload.error);\n   263→            break;\n   264→          case 'loop:log':\n   265→            setLogs((prev) => [...prev.slice(-500), message.payload]); // Keep last 500 logs\n   266→            break;\n   267→          case 'tasks:update':\n   268→            setTasks(message.payload);\n   269→            break;\n   270→          case 'git:update':\n   271→            setGitStatus(message.payload);\n   272→            break;\n   273→          case 'config:update':\n   274→            setProjectConfig(message.payload);\n   275→            if (message.payload.enabledAgents) {\n   276→              setEnabledAgents(message.payload.enabledAgents);\n   277→            }\n   278→            break;\n   279→          case 'config:saved':\n   280→            // File was saved successfully - could track this for UI feedback\n   281→            console.log('File saved:', message.payload.file);\n   282→            break;\n   283→          case 'agents:update':\n   284→            setEnabledAgents(message.payload.enabledAgents);\n   285→            break;\n   286→          // Plan generation messages\n   287→          case 'plan:status':\n   288→            setPlanStatus(message.payload);\n   289→            if (message.payload.generating) {\n   290→              // Clear previous results when starting new generation\n   291→              setPlanOutput('');\n   292→              setPlanComplete(null);\n   293→              setPlanError(null);\n   294→            }\n   295→            break;\n   296→          case 'plan:output':\n   297→            setPlanOutput((prev) => prev + message.payload.text);\n   298→            break;\n   299→          case 'plan:log':\n   300→            // Could add to a separate log stream if needed\n   301→            break;\n   302→          case 'plan:complete':\n   303→            setPlanComplete(message.payload);\n   304→            break;\n   305→          case 'plan:error':\n   306→            setPlanError(message.payload.error);\n   307→            break;\n   308→          // PRD generation messages\n   309→          case 'prd:status':\n   310→            setPrdStatus(message.payload);\n   311→            if (message.payload.generating) {\n   312→              // Clear previous results when starting new generation\n   313→              setPrdOutput('');\n   314→              setPrdComplete(null);\n   315→              setPrdError(null);\n   316→            }\n   317→            break;\n   318→          case 'prd:output':\n   319→            setPrdOutput((prev) => prev + message.payload.text);\n   320→            break;\n   321→          case 'prd:complete':\n   322→            setPrdComplete(message.payload);\n   323→            break;\n   324→          case 'prd:error':\n   325→            setPrdError(message.payload.error);\n   326→            break;\n   327→          // Project scanning messages\n   328→          case 'project:scan-result':\n   329→            setProjectScan(message.payload);\n   330→            setScanLoading(false);\n   331→            break;\n   332→          case 'project:info':\n   333→            setProjectInfo(message.payload);\n   334→            break;\n   335→          // Agent and rules messages\n   336→          case 'agents:list-result':\n   337→            setAvailableAgents(message.payload);\n   338→            setAgentsLoading(false);\n   339→            break;\n   340→          case 'rules:list-result':\n   341→          case 'rules:update':\n   342→            setCursorRules(message.payload);\n   343→            setRulesLoading(false);\n   344→            break;\n   345→          // Document preview messages\n   346→          case 'docs:content':\n   347→            setPreviewDoc({\n   348→              path: message.payload.path,\n   349→              content: message.payload.content,\n   350→            });\n   351→            setIsLoadingPreview(false);\n   352→            break;\n   353→          case 'docs:error':\n   354→            console.error('Doc read error:', message.payload.error);\n   355→            setIsLoadingPreview(false);\n   356→            break;\n   357→          // CLAUDE.md messages\n   358→          case 'claude:list-result':\n   359→            setClaudeMdFiles(message.payload);\n   360→            setClaudeMdLoading(false);\n   361→            break;\n   362→          case 'claude:content':\n   363→            setClaudeMdContent({\n   364→              path: message.payload.path,\n   365→              content: message.payload.content,\n   366→            });\n   367→            setClaudeMdLoading(false);\n   368→            break;\n   369→          case 'claude:applied':\n   370→            setClaudeMdApplying(false);\n   371→            break;\n   372→          case 'claude:error':\n   373→            console.error('CLAUDE.md error:', message.payload.error);\n   374→            setClaudeMdLoading(false);\n   375→            setClaudeMdApplying(false);\n   376→            break;\n   377→          // Dependency check messages\n   378→          case 'dependencies:result':\n   379→            setDependencyStatus(message.payload);\n   380→            setDependencyLoading(false);\n   381→            break;\n   382→          case 'dependencies:error':\n   383→            console.error('Dependency check error:', message.payload.error);\n   384→            setDependencyLoading(false);\n   385→            break;\n   386→          // Config file preview messages (for ExistingDocsViewer)\n   387→          case 'config:content':\n   388→            setConfigPreviewDoc({\n   389→              file: message.payload.file,\n   390→              content: message.payload.content,\n   391→            });\n   392→            setConfigPreviewLoading(false);\n   393→            break;\n   394→          // Repo agent messages\n   395→          case 'agents:repo-result':\n   396→            setRepoAgents(message.payload);\n   397→            setRepoAgentsLoading(false);\n   398→            break;\n   399→          case 'agents:installed':\n   400→            setAgentInstalling(null);\n   401→            break;\n   402→          case 'agents:error':\n   403→            console.error('Agent error:', message.payload.error);\n   404→            setAgentInstalling(null);\n   405→            setRepoAgentsLoading(false);\n   406→            break;\n   407→          // Review generator messages (Feature Set 14)\n   408→          case 'review-generator:status':\n   409→            setReviewGeneratorStatus(message.payload);\n   410→            if (message.payload.generating) {\n   411→              // Clear previous results when starting new generation\n   412→              setReviewGeneratorOutput('');\n   413→              setReviewGeneratorComplete(null);\n   414→              setReviewGeneratorError(null);\n   415→            }\n   416→            break;\n   417→          case 'review-generator:output':\n   418→            setReviewGeneratorOutput((prev) => prev + message.payload.text);\n   419→            break;\n   420→          case 'review-generator:complete':\n   421→            setReviewGeneratorComplete(message.payload);\n   422→            break;\n   423→          case 'review-generator:error':\n   424→            setReviewGeneratorError(message.payload.error);\n   425→            break;\n   426→          // Workflow mode messages\n   427→          case 'mode:current':\n   428→            if (message.payload?.mode) {\n   429→              setWorkflowModeState(message.payload.mode as WorkflowMode);\n   430→            }\n   431→            break;\n   432→          case 'mode:updated':\n   433→            if (message.payload?.success && message.payload?.mode) {\n   434→              setWorkflowModeState(message.payload.mode as WorkflowMode);\n   435→            }\n   436→            break;\n   437→        }\n   438→      } catch {\n   439→        console.error('Failed to parse WebSocket message');\n   440→      }\n   441→    };\n   442→\n   443→    wsRef.current = ws;\n   444→  }, [url]);\n   445→\n   446→  useEffect(() => {\n   447→    isCleaningUpRef.current = false;\n   448→    connect();\n   449→\n   450→    return () => {\n   451→      isCleaningUpRef.current = true;\n   452→      if (reconnectTimeoutRef.current) {\n   453→        clearTimeout(reconnectTimeoutRef.current);\n   454→        reconnectTimeoutRef.current = null;\n   455→      }\n   456→      if (wsRef.current) {\n   457→        // Remove event listeners to prevent errors during cleanup\n   458→        wsRef.current.onerror = null;\n   459→        wsRef.current.onclose = null;\n   460→        wsRef.current.close();\n   461→        wsRef.current = null;\n   462→      }\n   463→    };\n   464→  }, [connect]);\n   465→\n   466→  const sendCommand = useCallback((command: ClientCommand) => {\n   467→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   468→      wsRef.current.send(JSON.stringify(command));\n   469→    }\n   470→  }, []);\n   471→\n   472→  const clearLogs = useCallback(() => {\n   473→    setLogs([]);\n   474→  }, []);\n   475→\n   476→  const clearPlanOutput = useCallback(() => {\n   477→    setPlanOutput('');\n   478→    setPlanComplete(null);\n   479→    setPlanError(null);\n   480→  }, []);\n   481→\n   482→  const clearPrdOutput = useCallback(() => {\n   483→    setPrdOutput('');\n   484→    setPrdComplete(null);\n   485→    setPrdError(null);\n   486→  }, []);\n   487→\n   488→  // Review generator handlers (Feature Set 14)\n   489→  const generateReview = useCallback((options: { mode: ReviewGeneratorMode; focusArea?: string; specFile?: string }) => {\n   490→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   491→      wsRef.current.send(JSON.stringify({\n   492→        type: 'review-generator:generate',\n   493→        payload: options,\n   494→      }));\n   495→    }\n   496→  }, []);\n   497→\n   498→  const cancelReviewGenerator = useCallback(() => {\n   499→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   500→      wsRef.current.send(JSON.stringify({ type: 'review-generator:cancel' }));\n   501→    }\n   502→  }, []);\n   503→\n   504→  const clearReviewGeneratorOutput = useCallback(() => {\n   505→    setReviewGeneratorOutput('');\n   506→    setReviewGeneratorComplete(null);\n   507→    setReviewGeneratorError(null);\n   508→  }, []);\n   509→\n   510→  const scanProject = useCallback(() => {\n   511→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   512→      setScanLoading(true);\n   513→      wsRef.current.send(JSON.stringify({ type: 'project:scan' }));\n   514→    }\n   515→  }, []);\n   516→\n   517→  const listAgents = useCallback(() => {\n   518→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   519→      setAgentsLoading(true);\n   520→      wsRef.current.send(JSON.stringify({ type: 'agents:list' }));\n   521→    }\n   522→  }, []);\n   523→\n   524→  const listRules = useCallback(() => {\n   525→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   526→      setRulesLoading(true);\n   527→      wsRef.current.send(JSON.stringify({ type: 'rules:list' }));\n   528→    }\n   529→  }, []);\n   530→\n   531→  const readDoc = useCallback((docPath: string) => {\n   532→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   533→      setIsLoadingPreview(true);\n   534→      setPreviewDoc(null);\n   535→      wsRef.current.send(JSON.stringify({ type: 'docs:read', payload: { docPath } }));\n   536→    }\n   537→  }, []);\n   538→\n   539→  const closeDocPreview = useCallback(() => {\n   540→    setPreviewDoc(null);\n   541→    setIsLoadingPreview(false);\n   542→  }, []);\n   543→\n   544→  const listClaudeMdFiles = useCallback(() => {\n   545→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   546→      setClaudeMdLoading(true);\n   547→      wsRef.current.send(JSON.stringify({ type: 'claude:list' }));\n   548→    }\n   549→  }, []);\n   550→\n   551→  const readClaudeMdFile = useCallback((filePath: string) => {\n   552→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   553→      setClaudeMdLoading(true);\n   554→      setClaudeMdContent(null);\n   555→      wsRef.current.send(JSON.stringify({ type: 'claude:read', payload: { path: filePath } }));\n   556→    }\n   557→  }, []);\n   558→\n   559→  const applyRalphClaudeMd = useCallback(() => {\n   560→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   561→      setClaudeMdApplying(true);\n   562→      wsRef.current.send(JSON.stringify({ type: 'claude:apply' }));\n   563→    }\n   564→  }, []);\n   565→\n   566→  const closeClaudeMdPreview = useCallback(() => {\n   567→    setClaudeMdContent(null);\n   568→    setClaudeMdLoading(false);\n   569→  }, []);\n   570→\n   571→  const checkDependencies = useCallback(() => {\n   572→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   573→      setDependencyLoading(true);\n   574→      wsRef.current.send(JSON.stringify({ type: 'dependencies:check' }));\n   575→    }\n   576→  }, []);\n   577→\n   578→  const readConfigFile = useCallback((filename: string) => {\n   579→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   580→      setConfigPreviewLoading(true);\n   581→      setConfigPreviewDoc(null);\n   582→      wsRef.current.send(JSON.stringify({ type: 'config:read', payload: { file: filename } }));\n   583→    }\n   584→  }, []);\n   585→\n   586→  const clo