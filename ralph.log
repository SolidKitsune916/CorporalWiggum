{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VHU8vV7NQwaHrLnmxqJrVa","type":"tool_result","content":"     1→/**\n     2→ * useLauncher Hook - State management for Project Launcher\n     3→ * Manages projects, instances, and discovery operations\n     4→ */\n     5→\n     6→import { useEffect, useRef, useState, useCallback } from 'react';\n     7→import type {\n     8→  LauncherProject,\n     9→  LauncherInstance,\n    10→  DiscoveredProject,\n    11→  BrowseResult,\n    12→} from '@/types';\n    13→\n    14→interface ProjectInitResult {\n    15→  projectId: string;\n    16→  created: string[];\n    17→  skipped: string[];\n    18→}\n    19→\n    20→interface UseLauncherReturn {\n    21→  connected: boolean;\n    22→  // Project state\n    23→  projects: LauncherProject[];\n    24→  projectsLoading: boolean;\n    25→  // Instance state\n    26→  instances: LauncherInstance[];\n    27→  instancesLoading: boolean;\n    28→  // Discovery state\n    29→  discoveredProjects: DiscoveredProject[];\n    30→  discovering: boolean;\n    31→  // Browse state\n    32→  browseResult: BrowseResult | null;\n    33→  browsing: boolean;\n    34→  // Init state\n    35→  lastInitResult: ProjectInitResult | null;\n    36→  initializing: boolean;\n    37→  // Error state\n    38→  error: string | null;\n    39→  // Project operations\n    40→  listProjects: () => void;\n    41→  addProject: (path: string) => void;\n    42→  removeProject: (projectId: string) => void;\n    43→  initializeProject: (projectId: string, templates?: string[]) => void;\n    44→  // Instance operations\n    45→  listInstances: () => void;\n    46→  spawnInstance: (projectId: string) => void;\n    47→  stopInstance: (projectId: string) => void;\n    48→  // Discovery operations\n    49→  discoverProjects: () => void;\n    50→  // Browse operations\n    51→  browseDirectory: (path: string) => void;\n    52→  // Error handling\n    53→  clearError: () => void;\n    54→  clearInitResult: () => void;\n    55→  // Utility functions\n    56→  getInstanceForProject: (projectId: string) => LauncherInstance | undefined;\n    57→  isInstanceRunning: (projectId: string) => boolean;\n    58→}\n    59→\n    60→const DEFAULT_WS_PORT = import.meta.env.VITE_WS_PORT || '3001';\n    61→\n    62→export function useLauncher(url: string = `ws://localhost:${DEFAULT_WS_PORT}/ws`): UseLauncherReturn {\n    63→  // Connection state\n    64→  const [connected, setConnected] = useState(false);\n    65→\n    66→  // Project state\n    67→  const [projects, setProjects] = useState<LauncherProject[]>([]);\n    68→  const [projectsLoading, setProjectsLoading] = useState(false);\n    69→\n    70→  // Instance state\n    71→  const [instances, setInstances] = useState<LauncherInstance[]>([]);\n    72→  const [instancesLoading, setInstancesLoading] = useState(false);\n    73→\n    74→  // Discovery state\n    75→  const [discoveredProjects, setDiscoveredProjects] = useState<DiscoveredProject[]>([]);\n    76→  const [discovering, setDiscovering] = useState(false);\n    77→\n    78→  // Browse state\n    79→  const [browseResult, setBrowseResult] = useState<BrowseResult | null>(null);\n    80→  const [browsing, setBrowsing] = useState(false);\n    81→\n    82→  // Init state\n    83→  const [lastInitResult, setLastInitResult] = useState<ProjectInitResult | null>(null);\n    84→  const [initializing, setInitializing] = useState(false);\n    85→\n    86→  // Error state\n    87→  const [error, setError] = useState<string | null>(null);\n    88→\n    89→  // Refs\n    90→  const wsRef = useRef<WebSocket | null>(null);\n    91→  const reconnectTimeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null);\n    92→  const isCleaningUpRef = useRef(false);\n    93→\n    94→  const connect = useCallback(() => {\n    95→    if (isCleaningUpRef.current) {\n    96→      return;\n    97→    }\n    98→\n    99→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   100→      return;\n   101→    }\n   102→\n   103→    // Close existing connection if it exists\n   104→    if (wsRef.current) {\n   105→      wsRef.current.close();\n   106→    }\n   107→\n   108→    const ws = new WebSocket(url);\n   109→\n   110→    ws.onopen = () => {\n   111→      if (!isCleaningUpRef.current) {\n   112→        setConnected(true);\n   113→        if (reconnectTimeoutRef.current) {\n   114→          clearTimeout(reconnectTimeoutRef.current);\n   115→          reconnectTimeoutRef.current = null;\n   116→        }\n   117→        // Request initial data\n   118→        ws.send(JSON.stringify({ type: 'launcher:projects:list' }));\n   119→        ws.send(JSON.stringify({ type: 'launcher:instances:list' }));\n   120→      }\n   121→    };\n   122→\n   123→    ws.onclose = () => {\n   124→      if (!isCleaningUpRef.current) {\n   125→        setConnected(false);\n   126→        // Attempt to reconnect after 2 seconds\n   127→        reconnectTimeoutRef.current = setTimeout(() => {\n   128→          if (!isCleaningUpRef.current) {\n   129→            connect();\n   130→          }\n   131→        }, 2000);\n   132→      }\n   133→    };\n   134→\n   135→    ws.onerror = (wsError) => {\n   136→      if (!isCleaningUpRef.current && ws.readyState !== WebSocket.CLOSING && ws.readyState !== WebSocket.CLOSED) {\n   137→        console.error('WebSocket error:', wsError);\n   138→      }\n   139→      if (!isCleaningUpRef.current) {\n   140→        ws.close();\n   141→      }\n   142→    };\n   143→\n   144→    ws.onmessage = (event) => {\n   145→      try {\n   146→        const message = JSON.parse(event.data);\n   147→\n   148→        switch (message.type) {\n   149→          case 'launcher:projects:list':\n   150→            setProjects(message.payload);\n   151→            setProjectsLoading(false);\n   152→            break;\n   153→\n   154→          case 'launcher:project:added':\n   155→            // Project added, will receive full list via broadcast\n   156→            setProjectsLoading(false);\n   157→            break;\n   158→\n   159→          case 'launcher:project:removed':\n   160→            // Project removed, will receive full list via broadcast\n   161→            setProjectsLoading(false);\n   162→            break;\n   163→\n   164→          case 'launcher:instances:list':\n   165→            setInstances(message.payload);\n   166→            setInstancesLoading(false);\n   167→            break;\n   168→\n   169→          case 'launcher:instance:spawned':\n   170→            // Instance spawned, will receive full list via broadcast\n   171→            setInstancesLoading(false);\n   172→            break;\n   173→\n   174→          case 'launcher:instance:stopped':\n   175→            // Instance stopped, will receive full list via broadcast\n   176→            setInstancesLoading(false);\n   177→            break;\n   178→\n   179→          case 'launcher:instance:crashed':\n   180→            setError(`Instance crashed: ${message.payload.error}`);\n   181→            setInstancesLoading(false);\n   182→            break;\n   183→\n   184→          case 'launcher:discover:result':\n   185→            setDiscoveredProjects(message.payload);\n   186→            setDiscovering(false);\n   187→            break;\n   188→\n   189→          case 'launcher:browse:result':\n   190→            setBrowseResult(message.payload);\n   191→            setBrowsing(false);\n   192→            break;\n   193→\n   194→          case 'launcher:error':\n   195→            setError(message.payload.error);\n   196→            setProjectsLoading(false);\n   197→            setInstancesLoading(false);\n   198→            setDiscovering(false);\n   199→            setBrowsing(false);\n   200→            setInitializing(false);\n   201→            break;\n   202→\n   203→          case 'project:init:result':\n   204→            setLastInitResult(message.payload);\n   205→            setInitializing(false);\n   206→            break;\n   207→\n   208→          case 'project:init:error':\n   209→            setError(message.payload.error);\n   210→            setInitializing(false);\n   211→            break;\n   212→        }\n   213→      } catch {\n   214→        console.error('Failed to parse WebSocket message');\n   215→      }\n   216→    };\n   217→\n   218→    wsRef.current = ws;\n   219→  }, [url]);\n   220→\n   221→  useEffect(() => {\n   222→    isCleaningUpRef.current = false;\n   223→    connect();\n   224→\n   225→    return () => {\n   226→      isCleaningUpRef.current = true;\n   227→      if (reconnectTimeoutRef.current) {\n   228→        clearTimeout(reconnectTimeoutRef.current);\n   229→        reconnectTimeoutRef.current = null;\n   230→      }\n   231→      if (wsRef.current) {\n   232→        wsRef.current.onerror = null;\n   233→        wsRef.current.onclose = null;\n   234→        wsRef.current.close();\n   235→        wsRef.current = null;\n   236→      }\n   237→    };\n   238→  }, [connect]);\n   239→\n   240→  // Project operations\n   241→  const listProjects = useCallback(() => {\n   242→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   243→      setProjectsLoading(true);\n   244→      wsRef.current.send(JSON.stringify({ type: 'launcher:projects:list' }));\n   245→    }\n   246→  }, []);\n   247→\n   248→  const addProject = useCallback((path: string) => {\n   249→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   250→      setProjectsLoading(true);\n   251→      setError(null);\n   252→      wsRef.current.send(JSON.stringify({\n   253→        type: 'launcher:projects:add',\n   254→        payload: { path }\n   255→      }));\n   256→    }\n   257→  }, []);\n   258→\n   259→  const removeProject = useCallback((projectId: string) => {\n   260→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   261→      setProjectsLoading(true);\n   262→      setError(null);\n   263→      wsRef.current.send(JSON.stringify({\n   264→        type: 'launcher:projects:remove',\n   265→        payload: { projectId }\n   266→      }));\n   267→    }\n   268→  }, []);\n   269→\n   270→  // Instance operations\n   271→  const listInstances = useCallback(() => {\n   272→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   273→      setInstancesLoading(true);\n   274→      wsRef.current.send(JSON.stringify({ type: 'launcher:instances:list' }));\n   275→    }\n   276→  }, []);\n   277→\n   278→  const spawnInstance = useCallback((projectId: string) => {\n   279→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   280→      setInstancesLoading(true);\n   281→      setError(null);\n   282→      wsRef.current.send(JSON.stringify({\n   283→        type: 'launcher:instance:spawn',\n   284→        payload: { projectId }\n   285→      }));\n   286→    }\n   287→  }, []);\n   288→\n   289→  const stopInstance = useCallback((projectId: string) => {\n   290→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   291→      setInstancesLoading(true);\n   292→      setError(null);\n   293→      wsRef.current.send(JSON.stringify({\n   294→        type: 'launcher:instance:stop',\n   295→        payload: { projectId }\n   296→      }));\n   297→    }\n   298→  }, []);\n   299→\n   300→  // Discovery operations\n   301→  const discoverProjects = useCallback(() => {\n   302→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   303→      setDiscovering(true);\n   304→      setError(null);\n   305→      wsRef.current.send(JSON.stringify({ type: 'launcher:discover' }));\n   306→    }\n   307→  }, []);\n   308→\n   309→  // Browse operations\n   310→  const browseDirectory = useCallback((path: string) => {\n   311→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   312→      setBrowsing(true);\n   313→      setError(null);\n   314→      wsRef.current.send(JSON.stringify({\n   315→        type: 'launcher:browse',\n   316→        payload: { path }\n   317→      }));\n   318→    }\n   319→  }, []);\n   320→\n   321→  // Initialize project with Ralph files\n   322→  const initializeProject = useCallback((projectId: string, templates?: string[]) => {\n   323→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   324→      setInitializing(true);\n   325→      setError(null);\n   326→      wsRef.current.send(JSON.stringify({\n   327→        type: 'project:init',\n   328→        payload: { projectId, templates }\n   329→      }));\n   330→    }\n   331→  }, []);\n   332→\n   333→  // Error handling\n   334→  const clearError = useCallback(() => {\n   335→    setError(null);\n   336→  }, []);\n   337→\n   338→  const clearInitResult = useCallback(() => {\n   339→    setLastInitResult(null);\n   340→  }, []);\n   341→\n   342→  // Utility functions\n   343→  const getInstanceForProject = useCallback((projectId: string) => {\n   344→    return instances.find(i => i.projectId === projectId);\n   345→  }, [instances]);\n   346→\n   347→  const isInstanceRunning = useCallback((projectId: string) => {\n   348→    return instances.some(i => i.projectId === projectId);\n   349→  }, [instances]);\n   350→\n   351→  return {\n   352→    connected,\n   353→    projects,\n   354→    projectsLoading,\n   355→    instances,\n   356→    instancesLoading,\n   357→    discoveredProjects,\n   358→    discovering,\n   359→    browseResult,\n   360→    browsing,\n   361→    lastInitResult,\n   362→    initializing,\n   363→    error,\n   364→    listProjects,\n   365→    addProject,\n   366→    removeProject,\n   367→    initializeProject,\n   368→    listInstances,\n   369→    spawnInstance,\n   370→    stopInstance,\n   371→    discoverProjects,\n   372→    browseDirectory,\n   373→    clearError,\n   374→    clearInitResult,\n   375→    getInstanceForProject,\n   376→    isInstanceRunning,\n   377→  };\n   378→}\n   379→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST re