{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PzzuLRRUs54SwENk9MDGQS","type":"tool_result","content":"     1→import fs from 'fs/promises';\n     2→import path from 'path';\n     3→import os from 'os';\n     4→import type { ProjectConfig, AgentInfo, CursorRuleInfo } from '../src/types';\n     5→\n     6→const CONFIG_FILES = {\n     7→  'AGENTS.md': 'AGENTS.md',\n     8→  'CLAUDE.md': 'CLAUDE.md',\n     9→  'IMPLEMENTATION_PLAN.md': 'IMPLEMENTATION_PLAN.md',\n    10→  'PROMPT_build.md': 'PROMPT_build.md',\n    11→  'PROMPT_plan.md': 'PROMPT_plan.md',\n    12→  'PROMPT_plan_slc.md': 'PROMPT_plan_slc.md',\n    13→  'PROMPT_plan_work.md': 'PROMPT_plan_work.md',\n    14→  'AUDIENCE_JTBD.md': 'AUDIENCE_JTBD.md',\n    15→};\n    16→\n    17→const ALL_AGENT_IDS = ['react-typescript-expert', 'accessibility-expert', 'qol-ux-expert'];\n    18→\n    19→export class ProjectConfigManager {\n    20→  private projectPath: string;  // Target project to analyze\n    21→  private ralphPath: string;    // RalphWiggumV2's directory (for templates/prompts)\n    22→  private config: ProjectConfig;\n    23→  private enabledAgents: string[];\n    24→\n    25→  constructor(projectPath: string, ralphPath?: string) {\n    26→    this.projectPath = projectPath;\n    27→    this.ralphPath = ralphPath || projectPath;\n    28→    this.enabledAgents = [...ALL_AGENT_IDS];\n    29→    this.config = {\n    30→      projectPath,\n    31→      hasAgentsMd: false,\n    32→      hasClaudeMd: false,\n    33→      hasImplementationPlan: false,\n    34→      hasPRD: false,\n    35→      hasAudienceJTBD: false,\n    36→      hasSpecs: false,\n    37→      hasCursorRules: false,\n    38→      hasLoopSh: false,\n    39→      enabledAgents: this.enabledAgents,\n    40→    };\n    41→    this.refresh();\n    42→  }\n    43→\n    44→  // Get the path where Ralph config files should be stored/read\n    45→  // In embedded mode, these go in the target project\n    46→  getRalphConfigPath(): string {\n    47→    return this.projectPath;\n    48→  }\n    49→\n    50→  // Get the path to RalphWiggumV2's own directory (for templates)\n    51→  getRalphTemplatePath(): string {\n    52→    return this.ralphPath;\n    53→  }\n    54→\n    55→  // Get the target project path being analyzed\n    56→  getTargetProjectPath(): string {\n    57→    return this.projectPath;\n    58→  }\n    59→\n    60→  async refresh() {\n    61→    const checks = await Promise.all([\n    62→      this.fileExists('AGENTS.md'),\n    63→      this.fileExists('IMPLEMENTATION_PLAN.md'),\n    64→      this.fileExists('PRD.md'),\n    65→      this.fileExists('AUDIENCE_JTBD.md'),\n    66→      this.dirExists('specs'),\n    67→      this.dirExists('.cursor/rules'),\n    68→      this.fileExists('loop.sh'),\n    69→    ]);\n    70→\n    71→    // Check for CLAUDE.md in both possible locations\n    72→    const hasClaudeMdRoot = await this.fileExists('CLAUDE.md');\n    73→    const hasClaudeMdDir = await this.fileExists('.claude/CLAUDE.md');\n    74→    const hasClaudeMd = hasClaudeMdRoot || hasClaudeMdDir;\n    75→\n    76→    // Parse enabled agents from CLAUDE.md\n    77→    this.enabledAgents = await this.parseEnabledAgents();\n    78→\n    79→    this.config = {\n    80→      projectPath: this.projectPath,\n    81→      hasAgentsMd: checks[0],\n    82→      hasClaudeMd,\n    83→      hasImplementationPlan: checks[1],\n    84→      hasPRD: checks[2],\n    85→      hasAudienceJTBD: checks[3],\n    86→      hasSpecs: checks[4],\n    87→      hasCursorRules: checks[5],\n    88→      hasLoopSh: checks[6],\n    89→      enabledAgents: this.enabledAgents,\n    90→    };\n    91→\n    92→    return this.config;\n    93→  }\n    94→\n    95→  getConfig(): ProjectConfig {\n    96→    return { ...this.config };\n    97→  }\n    98→\n    99→  async readFile(filename: string): Promise<string> {\n   100→    // Validate filename to prevent path traversal\n   101→    if (filename.includes('..') || path.isAbsolute(filename)) {\n   102→      throw new Error('Invalid filename');\n   103→    }\n   104→\n   105→    const filePath = path.join(this.projectPath, filename);\n   106→    return fs.readFile(filePath, 'utf-8');\n   107→  }\n   108→\n   109→  async writeFile(filename: string, content: string): Promise<void> {\n   110→    // Validate filename to prevent path traversal\n   111→    if (filename.includes('..') || path.isAbsolute(filename)) {\n   112→      throw new Error('Invalid filename');\n   113→    }\n   114→\n   115→    const filePath = path.join(this.projectPath, filename);\n   116→    console.log(`Writing ${filename} to: ${filePath}`);\n   117→\n   118→    // Ensure directory exists\n   119→    const dir = path.dirname(filePath);\n   120→    await fs.mkdir(dir, { recursive: true });\n   121→\n   122→    await fs.writeFile(filePath, content, 'utf-8');\n   123→    console.log(`Successfully wrote ${filename} to ${filePath}`);\n   124→    await this.refresh();\n   125→  }\n   126→\n   127→  async listSpecs(): Promise<string[]> {\n   128→    try {\n   129→      const specsDir = path.join(this.projectPath, 'specs');\n   130→      const files = await fs.readdir(specsDir);\n   131→      return files.filter((f) => f.endsWith('.md'));\n   132→    } catch {\n   133→      return [];\n   134→    }\n   135→  }\n   136→\n   137→  async listCursorRules(): Promise<string[]> {\n   138→    try {\n   139→      const rulesDir = path.join(this.projectPath, '.cursor', 'rules');\n   140→      const files = await fs.readdir(rulesDir);\n   141→      return files.filter((f) => f.endsWith('.mdc'));\n   142→    } catch {\n   143→      return [];\n   144→    }\n   145→  }\n   146→\n   147→  private async fileExists(filename: string): Promise<boolean> {\n   148→    try {\n   149→      await fs.access(path.join(this.projectPath, filename));\n   150→      return true;\n   151→    } catch {\n   152→      return false;\n   153→    }\n   154→  }\n   155→\n   156→  private async dirExists(dirname: string): Promise<boolean> {\n   157→    try {\n   158→      const stat = await fs.stat(path.join(this.projectPath, dirname));\n   159→      return stat.isDirectory();\n   160→    } catch {\n   161→      return false;\n   162→    }\n   163→  }\n   164→\n   165→  // Parse CLAUDE.md to determine which agents are enabled\n   166→  private async parseEnabledAgents(): Promise<string[]> {\n   167→    try {\n   168→      const content = await this.readClaudeMd();\n   169→      const enabled: string[] = [];\n   170→\n   171→      for (const agentId of ALL_AGENT_IDS) {\n   172→        // An agent is enabled if its ID appears in the file without being wrapped in DISABLED comment\n   173→        const disabledPattern = new RegExp(`<!-- DISABLED: ${agentId}[\\\\s\\\\S]*?-->`, 'g');\n   174→        const enabledPattern = new RegExp(`\\`${agentId}\\``, 'g');\n   175→\n   176→        // Check if agent appears in the file (not disabled)\n   177→        const contentWithoutDisabled = content.replace(disabledPattern, '');\n   178→        if (enabledPattern.test(contentWithoutDisabled)) {\n   179→          enabled.push(agentId);\n   180→        }\n   181→      }\n   182→\n   183→      return enabled;\n   184→    } catch {\n   185→      // If CLAUDE.md doesn't exist, return all agents as enabled by default\n   186→      return [...ALL_AGENT_IDS];\n   187→    }\n   188→  }\n   189→\n   190→  // Read CLAUDE.md from either possible location\n   191→  private async readClaudeMd(): Promise<string> {\n   192→    // Try .claude/CLAUDE.md first (newer location)\n   193→    try {\n   194→      return await fs.readFile(path.join(this.projectPath, '.claude', 'CLAUDE.md'), 'utf-8');\n   195→    } catch {\n   196→      // Fall back to root CLAUDE.md\n   197→      return await fs.readFile(path.join(this.projectPath, 'CLAUDE.md'), 'utf-8');\n   198→    }\n   199→  }\n   200→\n   201→  // Get CLAUDE.md path (whichever exists)\n   202→  private async getClaudeMdPath(): Promise<string | null> {\n   203→    const dirPath = path.join(this.projectPath, '.claude', 'CLAUDE.md');\n   204→    const rootPath = path.join(this.projectPath, 'CLAUDE.md');\n   205→\n   206→    try {\n   207→      await fs.access(dirPath);\n   208→      return dirPath;\n   209→    } catch {\n   210→      try {\n   211→        await fs.access(rootPath);\n   212→        return rootPath;\n   213→      } catch {\n   214→        return null;\n   215→      }\n   216→    }\n   217→  }\n   218→\n   219→  getEnabledAgents(): string[] {\n   220→    return [...this.enabledAgents];\n   221→  }\n   222→\n   223→  async toggleAgent(agentId: string, enabled: boolean): Promise<string[]> {\n   224→    if (!ALL_AGENT_IDS.includes(agentId)) {\n   225→      throw new Error(`Unknown agent: ${agentId}`);\n   226→    }\n   227→\n   228→    try {\n   229→      let content = await this.readFile('CLAUDE.md');\n   230→\n   231→      if (enabled) {\n   232→        // Remove DISABLED comments for this agent\n   233→        const disabledPattern = new RegExp(\n   234→          `<!-- DISABLED: ${agentId}\\\\n([\\\\s\\\\S]*?)-->\\\\n?`,\n   235→          'g'\n   236→        );\n   237→        content = content.replace(disabledPattern, '$1');\n   238→      } else {\n   239→        // Wrap agent sections in DISABLED comments\n   240→        content = this.disableAgentInContent(content, agentId);\n   241→      }\n   242→\n   243→      await this.writeFile('CLAUDE.md', content);\n   244→      return this.enabledAgents;\n   245→    } catch (err) {\n   246→      console.error('Error toggling agent:', err);\n   247→      throw err;\n   248→    }\n   249→  }\n   250→\n   251→  private disableAgentInContent(content: string, agentId: string): string {\n   252→    // Pattern to match table row for this agent\n   253→    const tableRowPattern = new RegExp(\n   254→      `(\\\\| [^|]+ \\\\| \\`${agentId}\\` \\\\|)`,\n   255→      'g'\n   256→    );\n   257→\n   258→    // Pattern to match \"Delegate to X when:\" section\n   259→    const delegatePattern = new RegExp(\n   260→      `(\\\\*\\\\*Delegate to \\`${agentId}\\` when:\\\\*\\\\*\\\\n(?:- [^\\\\n]+\\\\n)+)`,\n   261→      'g'\n   262→    );\n   263→\n   264→    // Wrap table row in comment\n   265→    content = content.replace(tableRowPattern, `<!-- DISABLED: ${agentId}\\n$1\\n-->`);\n   266→\n   267→    // Wrap delegate section in comment\n   268→    content = content.replace(delegatePattern, `<!-- DISABLED: ${agentId}\\n$1-->\\n`);\n   269→\n   270→    return content;\n   271→  }\n   272→\n   273→  // List all available agents from global (~/.claude/agents/) and project (.claude/agents/)\n   274→  async listAvailableAgents(): Promise<AgentInfo[]> {\n   275→    const agents: AgentInfo[] = [];\n   276→\n   277→    // Global agents directory\n   278→    const globalAgentsDir = path.join(os.homedir(), '.claude', 'agents');\n   279→    // Project agents directory\n   280→    const projectAgentsDir = path.join(this.projectPath, '.claude', 'agents');\n   281→\n   282→    // Parse agent file to extract name and description from YAML frontmatter\n   283→    const parseAgentFile = async (filePath: string, source: 'global' | 'project'): Promise<AgentInfo | null> => {\n   284→      try {\n   285→        const content = await fs.readFile(filePath, 'utf-8');\n   286→        const filename = path.basename(filePath, '.md');\n   287→\n   288→        // Parse YAML frontmatter\n   289→        const frontmatterMatch = content.match(/^---\\n([\\s\\S]*?)\\n---/);\n   290→        if (!frontmatterMatch) {\n   291→          return null;\n   292→        }\n   293→\n   294→        const frontmatter = frontmatterMatch[1];\n   295→\n   296→        // Extract name and description\n   297→        const nameMatch = frontmatter.match(/^name:\\s*(.+)$/m);\n   298→        const descMatch = frontmatter.match(/^description:\\s*(.+)$/m);\n   299→\n   300→        const id = nameMatch ? nameMatch[1].trim() : filename;\n   301→        const description = descMatch ? descMatch[1].trim() : '';\n   302→\n   303→        // Check if agent is enabled (appears in CLAUDE.md)\n   304→        const enabled = this.enabledAgents.includes(id);\n   305→\n   306→        return {\n   307→          id,\n   308→          name: id.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' '),\n   309→          description,\n   310→          source,\n   311→          enabled,\n   312→          filePath,\n   313→        };\n   314→      } catch {\n   315→        return null;\n   316→      }\n   317→    };\n   318→\n   319→    // Scan global agents\n   320→    try {\n   321→      const globalFiles = await fs.readdir(globalAgentsDir);\n   322→      for (const file of globalFiles) {\n   323→        if (file.endsWith('.md')) {\n   324→          const agent = await parseAgentFile(path.join(globalAgentsDir, file), 'global');\n   325→          if (agent) {\n   326→            agents.push(agent);\n   327→          }\n   328→        }\n   329→      }\n   330→    } catch {\n   331→      // Global agents directory doesn't exist\n   332→    }\n   333→\n   334→    // Scan project agents\n   335→    try {\n   336→      const projectFiles = await fs.readdir(projectAgentsDir);\n   337→      for (const file of projectFiles) {\n   338→        if (file.endsWith('.md')) {\n   339→          const agent = await parseAgentFile(path.join(projectAgentsDir, file), 'project');\n   340→          if (agent) {\n   341→            // Don't add duplicates (project overrides global)\n   342→            const existingIndex = agents.findIndex(a => a.id === agent.id);\n   343→            if (existingIndex >= 0) {\n   344→              agents[existingIndex] = agent;\n   345→            } else {\n   346→              agents.push(agent);\n   347→            }\n   348→          }\n   349→        }\n   350→      }\n   351→    } catch {\n   352→      // Project agents directory doesn't exist\n   353→    }\n   354→\n   355→    return agents;\n   356→  }\n   357→\n   358→  // List cursor rules with detailed info from frontmatter\n   359→  async listCursorRulesDetailed(): Promise<CursorRuleInfo[]> {\n   360→    const rules: CursorRuleInfo[] = [];\n   361→    const rulesDir = path.join(this.projectPath, '.cursor', 'rules');\n   362→\n   363→    try {\n   364→      const files = await fs.readdir(rulesDir);\n   365→\n   366→      for (const file of files) {\n   367→        // Include both .mdc (enabled) and .mdc.disabled (disabled) files\n   368→        const isDisabled = file.endsWith('.mdc.disabled');\n   369→        const isMdc = file.endsWith('.mdc') || isDisabled;\n   370→\n   371→        if (!isMdc) continue;\n   372→\n   373→        const filePath = path.join(rulesDir, file);\n   374→\n   375→        try {\n   376→          const content = await fs.readFile(filePath, 'utf-8');\n   377→\n   378→          // Parse MDC frontmatter\n   379→          const frontmatterMatch = content.match(/^---\\n([\\s\\S]*?)\\n---/);\n   380→\n   381→          let description = '';\n   382→          let globs: string[] = [];\n   383→\n   384→          if (frontmatterMatch) {\n   385→            const frontmatter = frontmatterMatch[1];\n   386→\n   387→            // Extract description\n   388→            const descMatch = frontmatter.match(/^description:\\s*(.+)$/m);\n   389→            if (descMatch) {\n   390→              description = descMatch[1].trim();\n   391→            }\n   392→\n   393→            // Extract globs (can be array or single value)\n   394→            const globsMatch = frontmatter.match(/^globs:\\s*\\[([^\\]]+)\\]/m);\n   395→            if (globsMatch) {\n   396→              globs = globsMatch[1]\n   397→                .split(',')\n   398→                .map(g => g.trim().replace(/['\"]/g, ''));\n   399→            }\n   400→          }\n   401→\n   402→          // Get the base filename without .disabled extension\n   403→          const baseFile = isDisabled ? file.replace('.disabled', '') : file;\n   404→          const id = baseFile.replace('.mdc', '');\n   405→\n   406→          rules.push({\n   407→            id,\n   408→            name: baseFile,\n   409→            description,\n   410→            globs,\n   411→            enabled: !isDisabled,\n   412→            filePath,\n   413→          });\n   414→        } catch {\n   415→          // Skip files that can't be read\n   416→        }\n   417→      }\n   418→    } catch {\n   419→      // Rules directory doesn't exist\n   420→    }\n   421→\n   422→    // Sort by filename\n   423→    return rules.sort((a, b) => a.name.localeCompare(b.name));\n   424→  }\n   425→\n   426→  // Toggle cursor rule by renaming file (.mdc ↔ .mdc.disabled)\n   427→  async toggleCursorRule(ruleId: string, enabled: boolean): Promise<CursorRuleInfo[]> {\n   428→    const rulesDir = path.join(this.projectPath, '.cursor', 'rules');\n   429→\n   430→    const enabledPath = path.join(rulesDir, `${ruleId}.mdc`);\n   431→    const disabledPath = path.join(rulesDir, `${ruleId}.mdc.disabled`);\n   432→\n   433→    try {\n   434→      if (enabled) {\n   435→        // Enable: rename .mdc.disabled to .mdc\n   436→        await fs.rename(disabledPath, enabledPath);\n   437→      } else {\n   438→        // Disable: rename .mdc to .mdc.disabled\n   439→        await fs.rename(enabledPath, disabledPath);\n   440→      }\n   441→    } catch (err) {\n   442→      console.error('Error toggling cursor rule:', err);\n   443→      throw err;\n   444→    }\n   445→\n   446→    return this.listCursorRulesDetailed();\n   447→  }\n   448→\n   449→  // List CLAUDE.md files in parent project and Ralph directory\n   450→  async listClaudeMdFiles(): Promise<ClaudeMdFile[]> {\n   451→    const files: ClaudeMdFile[] = [];\n   452→\n   453→    // Helper to get file info\n   454→    const getFileInfo = async (filePath: string, location: string): Promise<ClaudeMdFile | null> => {\n   455→      try {\n   456→        const content = await fs.readFile(filePath, 'utf-8');\n   457→        const lines = content.split('\\n').length;\n   458→        return {\n   459→          path: filePath,\n   460→          location,\n   461→          exists: true,\n   462→          lineCount: lines,\n   463→        };\n   464→      } catch {\n   465→        return {\n   466→          path: filePath,\n   467→          location,\n   468→          exists: false,\n   469→          lineCount: 0,\n   470→        };\n   471→      }\n   472→    };\n   473→\n   474→    // Check parent project's CLAUDE.md locations\n   475→    const parentClaudeDir = path.join(this.projectPath, '.claude', 'CLAUDE.md');\n   476→    const parentClaudeRoot = path.join(this.projectPath, 'CLAUDE.md');\n   477→\n   478→    const parentDirInfo = await getFileInfo(parentClaudeDir, 'parent (.claude/CLAUDE.md)');\n   479→    if (parentDirInfo) files.push(parentDirInfo);\n   480→\n   481→    const parentRootInfo = await getFileInfo(parentClaudeRoot, 'parent (CLAUDE.md)');\n   482→    if (parentRootInfo) files.push(parentRootInfo);\n   483→\n   484→    // Check Ralph's own CLAUDE.md\n   485→    const ralphClaudeRoot = path.join(this.ralphPath, 'CLAUDE.md');\n   486→    const ralphInfo = await getFileInfo(ralphClaudeRoot, 'ralph (CLAUDE.md)');\n   487→    if (ralphInfo) files.push(ralphInfo);\n   488→\n   489→    return files;\n   490→  }\n   491→\n   492→  // Read a specific CLAUDE.md file by path\n   493→  async readClaudeMdFile(filePath: string): Promise<string> {\n   494→    // Security: only allow reading from known locations\n   495→    const allowedPaths = [\n   496→      path.join(this.projectPath, '.claude', 'CLAUDE.md'),\n   497→      path.join(this.projectPath, 'CLAUDE.md'),\n   498→      path.join(this.ralphPath, 'CLAUDE.md'),\n   499→    ];\n   500→\n   501→    const normalizedPath = path.normalize(filePath);\n   502→    if (!allowedPaths.includes(normalizedPath)) {\n   503→      throw new Error('Invalid CLAUDE.md path');\n   504→    }\n   505→\n   506→    return await fs.readFile(normalizedPath, 'utf-8');\n   507→  }\n   508→\n   509→  // Apply Ralph's CLAUDE.md to the parent project\n   510→  async applyRalphClaudeMd(): Promise<void> {\n   511→    const ralphClaudePath = path.join(this.ralphPath, 'CLAUDE.md');\n   512→    const targetPath = path.join(this.projectPath, '.claude', 'CLAUDE.md');\n   513→\n   514→    // Read Ralph's CLAUDE.md\n   515→    const content = await fs.readFile(ralphClaudePath, 'utf-8');\n   516→\n   517→    // Ensure .claude directory exists\n   518→    await fs.mkdir(path.join(this.projectPath, '.claude'), { recursive: true });\n   519→\n   520→    // Write to parent project\n   521→    await fs.writeFile(targetPath, content, 'utf-8');\n   522→\n   523→    // Refresh config\n   524→    await this.refresh();\n   525→  }\n   526→}\n   527→\n   528→// Type for CLAUDE.md file info\n   529→export interface ClaudeMdFile {\n   530→  path: string;\n   531→  location: string;\n   532→  exists: boolean;\n   533→  lineCount: number;\n   534→}\n   535→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"427b9edd-afbb-48fa-af22-bb40ea7675f8","uuid":"b7cc21ba-4807-403a-bed4-fce2d0f85f77","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\xsams\\RalphWiggumV3\\RalphWiggumV2\\dashboard\\server\\projectConfig.ts","content":"import fs from 'fs/promises';\nimport path from 'path';\nimport os from 'os';\nimport type { ProjectConfig, AgentInfo, CursorRuleInfo } from '../src/types';\n\nconst CONFIG_FILES = {\n  'AGENTS.md': 'AGENTS.md',\n  'CLAUDE.md': 'CLAUDE.md',\n  'IMPLEMENTATION_PLAN.md': 'IMPLEMENTATION_PLAN.md',\n  'PROMPT_build.md': 'PROMPT_build.md',\n  'PROMPT_plan.md': 'PROMPT_plan.md',\n  'PROMPT_plan_slc.md': 'PROMPT_plan_slc.md',\n  'PROMPT_plan_work.md': 'PROMPT_plan_work.md',\n  'AUDIENCE_JTBD.md': 'AUDIENCE_JTBD.md',\n};\n\nconst ALL_AGENT_IDS = ['react-typescript-expert', 'accessibility-expert', 'qol-ux-expert'];\n\nexport class ProjectConfigManager {\n  private projectPath: string;  // Target project to analyze\n  private ralphPath: string;    // RalphWiggumV2's directory (for templates/prompts)\n  private config: ProjectConfig;\n  private enabledAgents: string[];\n\n  constructor(projectPath: string, ralphPath?: string) {\n    this.projectPath = projectPath;\n    this.ralphPath = ralphPath || projectPath;\n    this.enabledAgents = [...ALL_AGENT_IDS];\n    this.config = {\n      projectPath,\n      hasAgentsMd: false,\n      hasClaudeMd: false,\n      hasImplementationPlan: false,\n      hasPRD: false,\n      hasAudienceJTBD: false,\n      hasSpecs: false,\n      hasCursorRules: false,\n      hasLoopSh: false,\n      enabledAgents: this.enabledAgents,\n    };\n    this.refresh();\n  }\n\n  // Get the path where Ralph config files should be stored/read\n  // In embedded mode, these go in the target project\n  getRalphConfigPath(): string {\n    return this.projectPath;\n  }\n\n  // Get the path to RalphWiggumV2's own directory (for templates)\n  getRalphTemplatePath(): string {\n    return this.ralphPath;\n  }\n\n  // Get the target project path being analyzed\n  getTargetProjectPath(): string {\n    return this.projectPath;\n  }\n\n  async refresh() {\n    const checks = await Promise.all([\n      this.fileExists('AGENTS.md'),\n      this.fileExists('IMPLEMENTATION_PLAN.md'),\n      this.fileExists('PRD.md'),\n      this.fileExists('AUDIENCE_JTBD.md'),\n      this.dirExists('specs'),\n      this.dirExists('.cursor/rules'),\n      this.fileExists('loop.sh'),\n    ]);\n\n    // Check for CLAUDE.md in both possible locations\n    const hasClaudeMdRoot = await this.fileExists('CLAUDE.md');\n    const hasClaudeMdDir = await this.fileExists('.claude/CLAUDE.md');\n    const hasClaudeMd = hasClaudeMdRoot || hasClaudeMdDir;\n\n    // Parse enabled agents from CLAUDE.md\n    this.enabledAgents = await this.parseEnabledAgents();\n\n    this.config = {\n      projectPath: this.projectPath,\n      hasAgentsMd: checks[0],\n      hasClaudeMd,\n      hasImplementationPlan: checks[1],\n      hasPRD: checks[2],\n      hasAudienceJTBD: checks[3],\n      hasSpecs: checks[4],\n      hasCursorRules: checks[5],\n      hasLoopSh: checks[6],\n      enabledAgents: this.enabledAgents,\n    };\n\n    return this.config;\n  }\n\n  getConfig(): ProjectConfig {\n    return { ...this.config };\n  }\n\n  async readFile(filename: string): Promise<string> {\n    // Validate filename to prevent path traversal\n    if (filename.includes('..') || path.isAbsolute(filename)) {\n      throw new Error('Invalid filename');\n    }\n\n    const filePath = path.join(this.projectPath, filename);\n    return fs.readFile(filePath, 'utf-8');\n  }\n\n  async writeFile(filename: string, content: string): Promise<void> {\n    // Validate filename to prevent path traversal\n    if (filename.includes('..') || path.isAbsolute(filename)) {\n      throw new Error('Invalid filename');\n    }\n\n    const filePath = path.join(this.projectPath, filename);\n    console.log(`Writing ${filename} to: ${filePath}`);\n\n    // Ensure directory exists\n    const dir = path.dirname(filePath);\n    await fs.mkdir(dir, { recursive: true });\n\n    await fs.writeFile(filePath, content, 'utf-8');\n    console.log(`Successfully wrote ${filename} to ${filePath}`);\n    await this.refresh();\n  }\n\n  async listSpecs(): Promise<string[]> {\n    try {\n      const specsDir = path.join(this.projectPath, 'specs');\n      const files = await fs.readdir(specsDir);\n      return files.filter((f) => f.endsWith('.md'));\n    } catch {\n      return [];\n    }\n  }\n\n  async listCursorRules(): Promise<string[]> {\n    try {\n      const rulesDir = path.join(this.projectPath, '.cursor', 'rules');\n      const files = await fs.readdir(rulesDir);\n      return files.filter((f) => f.endsWith('.mdc'));\n    } catch {\n      return [];\n    }\n  }\n\n  private async fileExists(filename: string): Promise<boolean> {\n    try {\n      await fs.access(path.join(this.projectPath, filename));\n      return true;\n    } catch {\n      return false;\n    }\n  }\n\n  private async dirExists(dirname: string): Promise<boolean> {\n    try {\n      const stat = await fs.stat(path.join(this.projectPath, dirname));\n      return stat.isDirectory();\n    } catch {\n      return false;\n    }\n  }\n\n  // Parse CLAUDE.md to determine which agents are enabled\n  private async parseEnabledAgents(): Promise<string[]> {\n    try {\n      const content = await this.readClaudeMd();\n      const enabled: string[] = [];\n\n      for (const agentId of ALL_AGENT_IDS) {\n        // An agent is enabled if its ID appears in the file without being wrapped in DISABLED comment\n        const disabledPattern = new RegExp(`<!-- DISABLED: ${agentId}[\\\\s\\\\S]*?-->`, 'g');\n        const enabledPattern = new RegExp(`\\`${agentId}\\``, 'g');\n\n        // Check if agent appears in the file (not disabled)\n        const contentWithoutDisabled = content.replace(disabledPattern, '');\n        if (enabledPattern.test(contentWithoutDisabled)) {\n          enabled.push(agentId);\n        }\n      }\n\n      return enabled;\n    } catch {\n      // If CLAUDE.md doesn't exist, return all agents as enabled by default\n      return [...ALL_AGENT_IDS];\n    }\n  }\n\n  // Read CLAUDE.md from either possible location\n  private async readClaudeMd(): Promise<string> {\n    // Try .claude/CLAUDE.md first (newer location)\n    try {\n      return await fs.readFile(path.join(this.projectPath, '.claude', 'CLAUDE.md'), 'utf-8');\n    } catch {\n      // Fall back to root CLAUDE.md\n      return await fs.readFile(path.join(this.projectPath, 'CLAUDE.md'), 'utf-8');\n    }\n  }\n\n  // Get CLAUDE.md path (whichever exists)\n  private async getClaudeMdPath(): Promise<string | null> {\n    const dirPath = path.join(this.projectPath, '.claude', 'CLAUDE.md');\n    const rootPath = path.join(this.projectPath, 'CLAUDE.md');\n\n    try {\n      await fs.access(dirPath);\n      return dirPath;\n    } catch {\n      try {\n        await fs.access(rootPath);\n        return rootPath;\n      } catch {\n        return null;\n      }\n    }\n  }\n\n  getEnabledAgents(): string[] {\n    return [...this.enabledAgents];\n  }\n\n  async toggleAgent(agentId: string, enabled: boolean): Promise<string[]> {\n    if (!ALL_AGENT_IDS.includes(agentId)) {\n      throw new Error(`Unknown agent: ${agentId}`);\n    }\n\n    try {\n      let content = await this.readFile('CLAUDE.md');\n\n      if (enabled) {\n        // Remove DISABLED comments for this agent\n        const disabledPattern = new RegExp(\n          `<!-- DISABLED: ${agentId}\\\\n([\\\\s\\\\S]*?)-->\\\\n?`,\n          'g'\n        );\n        content = content.replace(disabledPattern, '$1');\n      } else {\n        // Wrap agent sections in DISABLED comments\n        content = this.disableAgentInContent(content, agentId);\n      }\n\n      await this.writeFile('CLAUDE.md', content);\n      return this.enabledAgents;\n    } catch (err) {\n      console.error('Error toggling agent:', err);\n      throw err;\n    }\n  }\n\n  private disableAgentInContent(content: string, agentId: string): string {\n    // Pattern to match table row for this agent\n    const tableRowPattern = new RegExp(\n      `(\\\\| [^|]+ \\\\| \\`${agentId}\\` \\\\|)`,\n      'g'\n    );\n\n    // Pattern to match \"Delegate to X when:\" section\n    const delegatePattern = new RegExp(\n      `(\\\\*\\\\*Delegate to \\`${agentId}\\` when:\\\\*\\\\*\\\\n(?:- [^\\\\n]+\\\\n)+)`,\n      'g'\n    );\n\n    // Wrap table row in comment\n    content = content.replace(tableRowPattern, `<!-- DISABLED: ${agentId}\\n$1\\n-->`);\n\n    // Wrap delegate section in comment\n    content = content.replace(delegatePattern, `<!-- DISABLED: ${agentId}\\n$1-->\\n`);\n\n    return content;\n  }\n\n  // List all available agents from global (~/.claude/agents/) and project (.claude/agents/)\n  async listAvailableAgents(): Promise<AgentInfo[]> {\n    const agents: AgentInfo[] = [];\n\n    // Global agents directory\n    const globalAgentsDir = path.join(os.homedir(), '.claude', 'agents');\n    // Project agents directory\n    const projectAgentsDir = path.join(this.projectPath, '.claude', 'agents');\n\n    // Parse agent file to extract name and description from YAML frontmatter\n    const parseAgentFile = async (filePath: string, source: 'global' | 'project'): Promise<AgentInfo | null> => {\n      try {\n        const content = await fs.readFile(filePath, 'utf-8');\n        const filename = path.basename(filePath, '.md');\n\n        // Parse YAML frontmatter\n        const frontmatterMatch = content.match(/^---\\n([\\s\\S]*?)\\n---/);\n        if (!frontmatterMatch) {\n          return null;\n        }\n\n        const frontmatter = frontmatterMatch[1];\n\n        // Extract name and description\n        const nameMatch = frontmatter.match(/^name:\\s*(.+)$/m);\n        const descMatch = frontmatter.match(/^description:\\s*(.+)$/m);\n\n        const id = nameMatch ? nameMatch[1].trim() : filename;\n        const description = descMatch ? descMatch[1].trim() : '';\n\n        // Check if agent is enabled (appears in CLAUDE.md)\n        const enabled = this.enabledAgents.includes(id);\n\n        return {\n          id,\n          name: id.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' '),\n          description,\n          source,\n          enabled,\n          filePath,\n        };\n      } catch {\n        return null;\n      }\n    };\n\n    // Scan global agents\n    try {\n      const globalFiles = await fs.readdir(globalAgentsDir);\n      for (const file of globalFiles) {\n        if (file.endsWith('.md')) {\n          const agent = await parseAgentFile(path.join(globalAgentsDir, file), 'global');\n          if (agent) {\n            agents.push(agent);\n          }\n        }\n      }\n    } catch {\n      // Global agents directory doesn't exist\n    }\n\n    // Scan project agents\n    try {\n      const projectFiles = await fs.readdir(projectAgentsDir);\n      for (const file of projectFiles) {\n        if (file.endsWith('.md')) {\n          const agent = await parseAgentFile(path.join(projectAgentsDir, file), 'project');\n          if (agent) {\n            // Don't add duplicates (project overrides global)\n            const existingIndex = agents.findIndex(a => a.id === agent.id);\n            if (existingIndex >= 0) {\n              agents[existingIndex] = agent;\n            } else {\n              agents.push(agent);\n            }\n          }\n        }\n      }\n    } catch {\n      // Project agents directory doesn't exist\n    }\n\n    return agents;\n  }\n\n  // List cursor rules with detailed info from frontmatter\n  async listCursorRulesDetailed(): Promise<CursorRuleInfo[]> {\n    const rules: CursorRuleInfo[] = [];\n    const rulesDir = path.join(this.projectPath, '.cursor', 'rules');\n\n    try {\n      const files = await fs.readdir(rulesDir);\n\n      for (const file of files) {\n        // Include both .mdc (enabled) and .mdc.disabled (disabled) files\n        const isDisabled = file.endsWith('.mdc.disabled');\n        const isMdc = file.endsWith('.mdc') || isDisabled;\n\n        if (!isMdc) continue;\n\n        const filePath = path.join(rulesDir, file);\n\n        try {\n          const content = await fs.readFile(filePath, 'utf-8');\n\n          // Parse MDC frontmatter\n          const frontmatterMatch = content.match(/^---\\n([\\s\\S]*?)\\n---/);\n\n          let description = '';\n          let globs: string[] = [];\n\n          if (frontmatterMatch) {\n            const frontmatter = frontmatterMatch[1];\n\n            // Extract description\n            const descMatch = frontmatter.match(/^description:\\s*(.+)$/m);\n            if (descMatch) {\n              description = descMatch[1].trim();\n            }\n\n            // Extract globs (can be array or single value)\n            const globsMatch = frontmatter.match(/^globs:\\s*\\[([^\\]]+)\\]/m);\n            if (globsMatch) {\n              globs = globsMatch[1]\n                .split(',')\n                .map(g => g.trim().replace(/['\"]/g, ''));\n            }\n          }\n\n          // Get the base filename without .disabled extension\n          const baseFile = isDisabled ? file.replace('.disabled', '') : file;\n          const id = baseFile.replace('.mdc', '');\n\n          rules.push({\n            id,\n            name: baseFile,\n            description,\n            globs,\n            enabled: !isDisabled,\n            filePath,\n          });\n        } catch {\n          // Skip files that can't be read\n        }\n      }\n    } catch {\n      // Rules directory doesn't exist\n    }\n\n    // Sort by filename\n    return rules.sort((a, b) => a.name.localeCompare(b.name));\n  }\n\n  // Toggle cursor rule by renaming file (.mdc ↔ .mdc.disabled)\n  async toggleCursorRule(ruleId: string, enabled: boolean): Promise<CursorRuleInfo[]> {\n    const rulesDir = path.join(this.projectPath, '.cursor', 'rules');\n\n    const enabledPath = path.join(rulesDir, `${ruleId}.mdc`);\n    const disabledPath = path.join(rulesDir, `${ruleId}.mdc.disabled`);\n\n    try {\n      if (enabled) {\n        // Enable: rename .mdc.disabled to .mdc\n        await fs.rename(disabledPath, enabledPath);\n      } else {\n        // Disable: rename .mdc to .mdc.disabled\n        await fs.rename(enabledPath, disabledPath);\n      }\n    } catch (err) {\n      console.error('Error toggling cursor rule:', err);\n      throw err;\n    }\n\n    return this.listCursorRulesDetailed();\n  }\n\n  // List CLAUDE.md files in parent project and Ralph directory\n  async listClaudeMdFiles(): Promise<ClaudeMdFile[]> {\n    const files: ClaudeMdFile[] = [];\n\n    // Helper to get file info\n    const getFileInfo = async (filePath: string, location: string): Promise<ClaudeMdFile | null> => {\n      try {\n        const content = await fs.readFile(filePath, 'utf-8');\n        const lines = content.split('\\n').length;\n        return {\n          path: filePath,\n          location,\n          exists: true,\n          lineCount: lines,\n        };\n      } catch {\n        return {\n          path: filePath,\n          location,\n          exists: false,\n          lineCount: 0,\n        };\n      }\n    };\n\n    // Check parent project's CLAUDE.md locations\n    const parentClaudeDir = path.join(this.projectPath, '.claude', 'CLAUDE.md');\n    const parentClaudeRoot = path.join(this.projectPath, 'CLAUDE.md');\n\n    const parentDirInfo = await getFileInfo(parentClaudeDir, 'parent (.claude/CLAUDE.md)');\n    if (parentDirInfo) files.push(parentDirInfo);\n\n    const parentRootInfo = await getFileInfo(parentClaudeRoot, 'parent (CLAUDE.md)');\n    if (parentRootInfo) files.push(parentRootInfo);\n\n    // Check Ralph's own CLAUDE.md\n    const ralphClaudeRoot = path.join(this.ralphPath, 'CLAUDE.md');\n    const ralphInfo = await getFileInfo(ralphClaudeRoot, 'ralph (CLAUDE.md)');\n    if (ralphInfo) files.push(ralphInfo);\n\n    return files;\n  }\n\n  // Read a specific CLAUDE.md file by path\n  async readClaudeMdFile(filePath: string): Promise<string> {\n    // Security: only allow reading from known locations\n    const allowedPaths = [\n      path.join(this.projectPath, '.claude', 'CLAUDE.md'),\n      path.join(this.projectPath, 'CLAUDE.md'),\n      path.join(this.ralphPath, 'CLAUDE.md'),\n    ];\n\n    const normalizedPath = path.normalize(filePath);\n    if (!allowedPaths.includes(normalizedPath)) {\n      throw new Error('Invalid CLAUDE.md path');\n    }\n\n    return await fs.readFile(normalizedPath, 'utf-8');\n  }\n\n  // Apply Ralph's CLAUDE.md to the parent project\n  async applyRalphClaudeMd(): Promise<void> {\n    const ralphClaudePath = path.join(this.ralphPath, 'CLAUDE.md');\n    const targetPath = path.join(this.projectPath, '.claude', 'CLAUDE.md');\n\n    // Read Ralph's CLAUDE.md\n    const content = await fs.readFile(ralphClaudePath, 'utf-8');\n\n    // Ensure .claude directory exists\n    await fs.mkdir(path.join(this.projectPath, '.claude'), { recursive: true });\n\n    // Write to parent project\n    await fs.writeFile(targetPath, content, 'utf-8');\n\n    // Refresh config\n    await this.refresh();\n  }\n}\n\n// Type for CLAUDE.md file info\nexport interface ClaudeMdFile {\n  path: string;\n  location: string;\n  exists: boolean;\n  lineCount: number;\n}\n","numLines":535,"startLine":1,"totalLines":535}}}
