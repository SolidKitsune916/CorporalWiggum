{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BWXQv1he2D8QQBjupRBJuU","type":"tool_result","content":"     1→/**\n     2→ * Backend Sentry Integration for WIGGUM\n     3→ *\n     4→ * Initializes Sentry for error tracking and performance monitoring\n     5→ * in the Node.js backend.\n     6→ */\n     7→\n     8→import * as Sentry from '@sentry/node';\n     9→import { logger } from './logger.js';\n    10→\n    11→interface SentryConfig {\n    12→  dsn?: string;\n    13→  environment?: string;\n    14→  release?: string;\n    15→  tracesSampleRate?: number;\n    16→  enabled?: boolean;\n    17→}\n    18→\n    19→let isInitialized = false;\n    20→\n    21→/**\n    22→ * Initialize Sentry for the backend\n    23→ */\n    24→export function initSentry(config: SentryConfig = {}): void {\n    25→  if (isInitialized) {\n    26→    logger.warn('Sentry is already initialized');\n    27→    return;\n    28→  }\n    29→\n    30→  const dsn = config.dsn || process.env.SENTRY_DSN;\n    31→\n    32→  // Skip initialization if no DSN is configured\n    33→  if (!dsn) {\n    34→    logger.info('Sentry DSN not configured, skipping initialization');\n    35→    return;\n    36→  }\n    37→\n    38→  const enabled = config.enabled ?? process.env.NODE_ENV === 'production';\n    39→\n    40→  if (!enabled) {\n    41→    logger.info('Sentry is disabled in development');\n    42→    return;\n    43→  }\n    44→\n    45→  Sentry.init({\n    46→    dsn,\n    47→    environment: config.environment || process.env.NODE_ENV || 'development',\n    48→    release: config.release || process.env.APP_VERSION || '0.0.0',\n    49→    tracesSampleRate: config.tracesSampleRate ?? 0.1,\n    50→    integrations: [\n    51→      Sentry.httpIntegration(),\n    52→      Sentry.expressIntegration(),\n    53→    ],\n    54→  });\n    55→\n    56→  isInitialized = true;\n    57→  logger.info('Sentry initialized');\n    58→}\n    59→\n    60→/**\n    61→ * Capture an error in Sentry\n    62→ */\n    63→export function captureError(error: Error, context?: Record<string, unknown>): string {\n    64→  if (context) {\n    65→    Sentry.setContext('additional', context);\n    66→  }\n    67→  return Sentry.captureException(error);\n    68→}\n    69→\n    70→/**\n    71→ * Capture a message in Sentry\n    72→ */\n    73→export function captureMessage(\n    74→  message: string,\n    75→  level: Sentry.SeverityLevel = 'info'\n    76→): string {\n    77→  return Sentry.captureMessage(message, level);\n    78→}\n    79→\n    80→/**\n    81→ * Set user context for Sentry\n    82→ */\n    83→export function setUser(user: { id?: string; email?: string; username?: string } | null): void {\n    84→  Sentry.setUser(user);\n    85→}\n    86→\n    87→/**\n    88→ * Add breadcrumb for debugging\n    89→ */\n    90→export function addBreadcrumb(breadcrumb: Sentry.Breadcrumb): void {\n    91→  Sentry.addBreadcrumb(breadcrumb);\n    92→}\n    93→\n    94→/**\n    95→ * Set a tag for all events\n    96→ */\n    97→export function setTag(key: string, value: string): void {\n    98→  Sentry.setTag(key, value);\n    99→}\n   100→\n   101→/**\n   102→ * Express error handler middleware\n   103→ */\n   104→export function sentryErrorHandler(): ReturnType<typeof Sentry.expressErrorHandler> {\n   105→  return Sentry.expressErrorHandler();\n   106→}\n   107→\n   108→/**\n   109→ * Express request handler middleware\n   110→ */\n   111→export function sentryRequestHandler(): ReturnType<typeof Sentry.expressIntegration> {\n   112→  return Sentry.expressIntegration();\n   113→}\n   114→\n   115→/**\n   116→ * Flush pending events before shutdown\n   117→ */\n   118→export async function flush(timeout: number = 2000): Promise<boolean> {\n   119→  return Sentry.flush(timeout);\n   120→}\n   121→\n   122→export default {\n   123→  init: initSentry,\n   124→  captureError,\n   125→  captureMessage,\n   126→  setUser,\n   127→  addBreadcrumb,\n   128→  setTag,\n   129→  sentryErrorHandler,\n   130→  sentryRequestHandler,\n   131→  flush,\n   132→};\n   133→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"e963dfad-ac1f-43fb-a8da-b2590f97a0fb","uuid":"37fb482c-d667-408d-b328-d4c8c42cd5e6","tool_use_result":{"type":"text","file":{"filePath":"/Users/samueledwards/RalphWiggumV3/dashboard/server/lib/sentry.ts","content":"/**\n * Backend Sentry Integration for WIGGUM\n *\n * Initializes Sentry for error tracking and performance monitoring\n * in the Node.js backend.\n */\n\nimport * as Sentry from '@sentry/node';\nimport { logger } from './logger.js';\n\ninterface SentryConfig {\n  dsn?: string;\n  environment?: string;\n  release?: string;\n  tracesSampleRate?: number;\n  enabled?: boolean;\n}\n\nlet isInitialized = false;\n\n/**\n * Initialize Sentry for the backend\n */\nexport function initSentry(config: SentryConfig = {}): void {\n  if (isInitialized) {\n    logger.warn('Sentry is already initialized');\n    return;\n  }\n\n  const dsn = config.dsn || process.env.SENTRY_DSN;\n\n  // Skip initialization if no DSN is configured\n  if (!dsn) {\n    logger.info('Sentry DSN not configured, skipping initialization');\n    return;\n  }\n\n  const enabled = config.enabled ?? process.env.NODE_ENV === 'production';\n\n  if (!enabled) {\n    logger.info('Sentry is disabled in development');\n    return;\n  }\n\n  Sentry.init({\n    dsn,\n    environment: config.environment || process.env.NODE_ENV || 'development',\n    release: config.release || process.env.APP_VERSION || '0.0.0',\n    tracesSampleRate: config.tracesSampleRate ?? 0.1,\n    integrations: [\n      Sentry.httpIntegration(),\n      Sentry.expressIntegration(),\n    ],\n  });\n\n  isInitialized = true;\n  logger.info('Sentry initialized');\n}\n\n/**\n * Capture an error in Sentry\n */\nexport function captureError(error: Error, context?: Record<string, unknown>): string {\n  if (context) {\n    Sentry.setContext('additional', context);\n  }\n  return Sentry.captureException(error);\n}\n\n/**\n * Capture a message in Sentry\n */\nexport function captureMessage(\n  message: string,\n  level: Sentry.SeverityLevel = 'info'\n): string {\n  return Sentry.captureMessage(message, level);\n}\n\n/**\n * Set user context for Sentry\n */\nexport function setUser(user: { id?: string; email?: string; username?: string } | null): void {\n  Sentry.setUser(user);\n}\n\n/**\n * Add breadcrumb for debugging\n */\nexport function addBreadcrumb(breadcrumb: Sentry.Breadcrumb): void {\n  Sentry.addBreadcrumb(breadcrumb);\n}\n\n/**\n * Set a tag for all events\n */\nexport function setTag(key: string, value: string): void {\n  Sentry.setTag(key, value);\n}\n\n/**\n * Express error handler middleware\n */\nexport function sentryErrorHandler(): ReturnType<typeof Sentry.expressErrorHandler> {\n  return Sentry.expressErrorHandler();\n}\n\n/**\n * Express request handler middleware\n */\nexport function sentryRequestHandler(): ReturnType<typeof Sentry.expressIntegration> {\n  return Sentry.expressIntegration();\n}\n\n/**\n * Flush pending events before shutdown\n */\nexport async function flush(timeout: number = 2000): Promise<boolean> {\n  return Sentry.flush(timeout);\n}\n\nexport default {\n  init: initSentry,\n  captureError,\n  captureMessage,\n  setUser,\n  addBreadcrumb,\n  setTag,\n  sentryErrorHandler,\n  sentryRequestHandler,\n  flush,\n};\n","numLines":133,"startLine":1,"totalLines":133}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RFsuqDqqWWeYG5Ha9tdwt6","type":"tool_result","content":"     1→/**\n     2→ * Frontend Sentry Integration for WIGGUM\n     3→ *\n     4→ * Initializes Sentry for error tracking and performance monitoring\n     5→ * in the React frontend.\n     6→ */\n     7→\n     8→import * as Sentry from '@sentry/react';\n     9→\n    10→interface SentryConfig {\n    11→  dsn?: string;\n    12→  environment?: string;\n    13→  release?: string;\n    14→  tracesSampleRate?: number;\n    15→  enabled?: boolean;\n    16→}\n    17→\n    18→let isInitialized = false;\n    19→\n    20→/**\n    21→ * Initialize Sentry for the frontend\n    22→ */\n    23→export function initSentry(config: SentryConfig = {}): void {\n    24→  if (isInitialized) {\n    25→    console.warn('Sentry is already initialized');\n    26→    return;\n    27→  }\n    28→\n    29→  const dsn = config.dsn || import.meta.env.VITE_SENTRY_DSN;\n    30→\n    31→  // Skip initialization if no DSN is configured\n    32→  if (!dsn) {\n    33→    console.info('Sentry DSN not configured, skipping initialization');\n    34→    return;\n    35→  }\n    36→\n    37→  const enabled = config.enabled ?? import.meta.env.PROD;\n    38→\n    39→  if (!enabled) {\n    40→    console.info('Sentry is disabled in development');\n    41→    return;\n    42→  }\n    43→\n    44→  Sentry.init({\n    45→    dsn,\n    46→    environment: config.environment || import.meta.env.MODE || 'development',\n    47→    release: config.release || import.meta.env.VITE_APP_VERSION || '0.0.0',\n    48→    tracesSampleRate: config.tracesSampleRate ?? 0.1,\n    49→    integrations: [\n    50→      Sentry.browserTracingIntegration(),\n    51→      Sentry.replayIntegration({\n    52→        maskAllText: false,\n    53→        blockAllMedia: false,\n    54→      }),\n    55→    ],\n    56→    replaysSessionSampleRate: 0.1,\n    57→    replaysOnErrorSampleRate: 1.0,\n    58→  });\n    59→\n    60→  isInitialized = true;\n    61→  console.info('Sentry initialized');\n    62→}\n    63→\n    64→/**\n    65→ * Capture an error in Sentry\n    66→ */\n    67→export function captureError(error: Error, context?: Record<string, unknown>): string {\n    68→  if (context) {\n    69→    Sentry.setContext('additional', context);\n    70→  }\n    71→  return Sentry.captureException(error);\n    72→}\n    73→\n    74→/**\n    75→ * Capture a message in Sentry\n    76→ */\n    77→export function captureMessage(\n    78→  message: string,\n    79→  level: Sentry.SeverityLevel = 'info'\n    80→): string {\n    81→  return Sentry.captureMessage(message, level);\n    82→}\n    83→\n    84→/**\n    85→ * Set user context for Sentry\n    86→ */\n    87→export function setUser(user: { id?: string; email?: string; username?: string } | null): void {\n    88→  Sentry.setUser(user);\n    89→}\n    90→\n    91→/**\n    92→ * Add breadcrumb for debugging\n    93→ */\n    94→export function addBreadcrumb(breadcrumb: Sentry.Breadcrumb): void {\n    95→  Sentry.addBreadcrumb(breadcrumb);\n    96→}\n    97→\n    98→/**\n    99→ * Set a tag for all events\n   100→ */\n   101→export function setTag(key: string, value: string): void {\n   102→  Sentry.setTag(key, value);\n   103→}\n   104→\n   105→/**\n   106→ * Start a performance transaction\n   107→ */\n   108→export function startTransaction(name: string, op: string): Sentry.Span | undefined {\n   109→  return Sentry.startInactiveSpan({ name, op });\n   110→}\n   111→\n   112→/**\n   113→ * Get the Sentry error boundary component for React\n   114→ */\n   115→export const ErrorBoundary = Sentry.ErrorBoundary;\n   116→\n   117→/**\n   118→ * HOC to wrap components with Sentry error boundary\n   119→ */\n   120→export const withErrorBoundary = Sentry.withErrorBoundary;\n   121→\n   122→export default {\n   123→  init: initSentry,\n   124→  captureError,\n   125→  captureMessage,\n   126→  setUser,\n   127→  addBreadcrumb,\n   128→  setTag,\n   129→  startTransaction,\n   130→  ErrorBoundary,\n   131→  withErrorBoundary,\n   132→};\n   133→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"e963dfad-ac1f-43fb-a8da-b2590f97a0fb","uuid":"9fb82894-8cc7-4767-abe0-c28da46ab1db","tool_use_result":{"type":"text","file":{"filePath":"/Users/samueledwards/RalphWiggumV3/dashboard/src/lib/monitoring/sentry.ts","content":"/**\n * Frontend Sentry Integration for WIGGUM\n *\n * Initializes Sentry for error tracking and performance monitoring\n * in the React frontend.\n */\n\nimport * as Sentry from '@sentry/react';\n\ninterface SentryConfig {\n  dsn?: string;\n  environment?: string;\n  release?: string;\n  tracesSampleRate?: number;\n  enabled?: boolean;\n}\n\nlet isInitialized = false;\n\n/**\n * Initialize Sentry for the frontend\n */\nexport function initSentry(config: SentryConfig = {}): void {\n  if (isInitialized) {\n    console.warn('Sentry is already initialized');\n    return;\n  }\n\n  const dsn = config.dsn || import.meta.env.VITE_SENTRY_DSN;\n\n  // Skip initialization if no DSN is configured\n  if (!dsn) {\n    console.info('Sentry DSN not configured, skipping initialization');\n    return;\n  }\n\n  const enabled = config.enabled ?? import.meta.env.PROD;\n\n  if (!enabled) {\n    console.info('Sentry is disabled in development');\n    return;\n  }\n\n  Sentry.init({\n    dsn,\n    environment: config.environment || import.meta.env.MODE || 'development',\n    release: config.release || import.meta.env.VITE_APP_VERSION || '0.0.0',\n    tracesSampleRate: config.tracesSampleRate ?? 0.1,\n    integrations: [\n      Sentry.browserTracingIntegration(),\n      Sentry.replayIntegration({\n        maskAllText: false,\n        blockAllMedia: false,\n      }),\n    ],\n    replaysSessionSampleRate: 0.1,\n    replaysOnErrorSampleRate: 1.0,\n  });\n\n  isInitialized = true;\n  console.info('Sentry initialized');\n}\n\n/**\n * Capture an error in Sentry\n */\nexport function captureError(error: Error, context?: Record<string, unknown>): string {\n  if (context) {\n    Sentry.setContext('additional', context);\n  }\n  return Sentry.captureException(error);\n}\n\n/**\n * Capture a message in Sentry\n */\nexport function captureMessage(\n  message: string,\n  level: Sentry.SeverityLevel = 'info'\n): string {\n  return Sentry.captureMessage(message, level);\n}\n\n/**\n * Set user context for Sentry\n */\nexport function setUser(user: { id?: string; email?: string; username?: string } | null): void {\n  Sentry.setUser(user);\n}\n\n/**\n * Add breadcrumb for debugging\n */\nexport function addBreadcrumb(breadcrumb: Sentry.Breadcrumb): void {\n  Sentry.addBreadcrumb(breadcrumb);\n}\n\n/**\n * Set a tag for all events\n */\nexport function setTag(key: string, value: string): void {\n  Sentry.setTag(key, value);\n}\n\n/**\n * Start a performance transaction\n */\nexport function startTransaction(name: string, op: string): Sentry.Span | undefined {\n  return Sentry.startInactiveSpan({ name, op });\n}\n\n/**\n * Get the Sentry error boundary component for React\n */\nexport const ErrorBoundary = Sentry.ErrorBoundary;\n\n/**\n * HOC to wrap components with Sentry error boundary\n */\nexport const withErrorBoundary = Sentry.withErrorBoundary;\n\nexport default {\n  init: initSentry,\n  captureError,\n  captureMessage,\n  setUser,\n  addBreadcrumb,\n  setTag,\n  startTransaction,\n  ErrorBoundary,\n  withErrorBoundary,\n};\n","numLines":133,"startLine":1,"totalLines":133}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ve1SfseRbDqDPDeesThBE5","type":"tool_result","content":"     1→/**\n     2→ * Structured Logger for WIGGUM\n     3→ *\n     4→ * A simple structured logging implementation that follows pino-like patterns.\n     5→ * Can be easily upgraded to pino by changing the transport.\n     6→ *\n     7→ * Usage:\n     8→ *   import { logger } from './lib/logger.js';\n     9→ *   logger.info('Server started', { port: 3001 });\n    10→ *   logger.error('Failed to connect', { error: err.message });\n    11→ */\n    12→\n    13→export type LogLevel = 'trace' | 'debug' | 'info' | 'warn' | 'error' | 'fatal';\n    14→\n    15→interface LogEntry {\n    16→  level: LogLevel;\n    17→  time: string;\n    18→  msg: string;\n    19→  [key: string]: unknown;\n    20→}\n    21→\n    22→interface LoggerOptions {\n    23→  level?: LogLevel;\n    24→  name?: string;\n    25→  prettyPrint?: boolean;\n    26→}\n    27→\n    28→const LOG_LEVELS: Record<LogLevel, number> = {\n    29→  trace: 10,\n    30→  debug: 20,\n    31→  info: 30,\n    32→  warn: 40,\n    33→  error: 50,\n    34→  fatal: 60,\n    35→};\n    36→\n    37→const LEVEL_COLORS: Record<LogLevel, string> = {\n    38→  trace: '\\x1b[90m',    // gray\n    39→  debug: '\\x1b[36m',    // cyan\n    40→  info: '\\x1b[32m',     // green\n    41→  warn: '\\x1b[33m',     // yellow\n    42→  error: '\\x1b[31m',    // red\n    43→  fatal: '\\x1b[35m',    // magenta\n    44→};\n    45→\n    46→const RESET = '\\x1b[0m';\n    47→\n    48→class Logger {\n    49→  private minLevel: number;\n    50→  private name: string;\n    51→  private prettyPrint: boolean;\n    52→\n    53→  constructor(options: LoggerOptions = {}) {\n    54→    this.minLevel = LOG_LEVELS[options.level || 'info'];\n    55→    this.name = options.name || 'wiggum';\n    56→    this.prettyPrint = options.prettyPrint ?? (process.env.NODE_ENV !== 'production');\n    57→  }\n    58→\n    59→  private shouldLog(level: LogLevel): boolean {\n    60→    return LOG_LEVELS[level] >= this.minLevel;\n    61→  }\n    62→\n    63→  private formatEntry(entry: LogEntry): string {\n    64→    if (this.prettyPrint) {\n    65→      const color = LEVEL_COLORS[entry.level];\n    66→      const { level, time, msg, ...rest } = entry;\n    67→      const timestamp = new Date(time).toLocaleTimeString();\n    68→      const extras = Object.keys(rest).length > 0 ? ` ${JSON.stringify(rest)}` : '';\n    69→      return `${color}[${timestamp}] ${level.toUpperCase().padEnd(5)}${RESET} ${msg}${extras}`;\n    70→    }\n    71→    return JSON.stringify(entry);\n    72→  }\n    73→\n    74→  private log(level: LogLevel, msg: string, data?: Record<string, unknown>): void {\n    75→    if (!this.shouldLog(level)) return;\n    76→\n    77→    const entry: LogEntry = {\n    78→      level,\n    79→      time: new Date().toISOString(),\n    80→      msg,\n    81→      name: this.name,\n    82→      ...data,\n    83→    };\n    84→\n    85→    const output = this.formatEntry(entry);\n    86→\n    87→    if (level === 'error' || level === 'fatal') {\n    88→      console.error(output);\n    89→    } else if (level === 'warn') {\n    90→      console.warn(output);\n    91→    } else {\n    92→      console.log(output);\n    93→    }\n    94→  }\n    95→\n    96→  trace(msg: string, data?: Record<string, unknown>): void {\n    97→    this.log('trace', msg, data);\n    98→  }\n    99→\n   100→  debug(msg: string, data?: Record<string, unknown>): void {\n   101→    this.log('debug', msg, data);\n   102→  }\n   103→\n   104→  info(msg: string, data?: Record<string, unknown>): void {\n   105→    this.log('info', msg, data);\n   106→  }\n   107→\n   108→  warn(msg: string, data?: Record<string, unknown>): void {\n   109→    this.log('warn', msg, data);\n   110→  }\n   111→\n   112→  error(msg: string, data?: Record<string, unknown>): void {\n   113→    this.log('error', msg, data);\n   114→  }\n   115→\n   116→  fatal(msg: string, data?: Record<string, unknown>): void {\n   117→    this.log('fatal', msg, data);\n   118→  }\n   119→\n   120→  child(bindings: Record<string, unknown>): Logger {\n   121→    const child = new Logger({\n   122→      level: Object.keys(LOG_LEVELS).find(\n   123→        (k) => LOG_LEVELS[k as LogLevel] === this.minLevel\n   124→      ) as LogLevel,\n   125→      name: this.name,\n   126→      prettyPrint: this.prettyPrint,\n   127→    });\n   128→    // Store bindings for child logger (would be added to each log entry in full implementation)\n   129→    return child;\n   130→  }\n   131→}\n   132→\n   133→// Default logger instance\n   134→export const logger = new Logger({\n   135→  level: (process.env.LOG_LEVEL as LogLevel) || 'info',\n   136→  name: 'wiggum',\n   137→});\n   138→\n   139→// Factory function for creating child loggers\n   140→export function createLogger(options: LoggerOptions): Logger {\n   141→  return new Logger(options);\n   142→}\n   143→\n   144→export default logger;\n   145→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"e963dfad-ac1f-43fb-a8da-b2590f97a0fb","uuid":"04fca4a4-be6f-42c4-bf74-5a138b28cf8d","tool_use_result":{"type":"text","file":{"filePath":"/Users/samueledwards/RalphWiggumV3/dashboard/server/lib/logger.ts","content":"/**\n * Structured Logger for WIGGUM\n *\n * A simple structured logging implementation that follows pino-like patterns.\n * Can be easily upgraded to pino by changing the transport.\n *\n * Usage:\n *   import { logger } from './lib/logger.js';\n *   logger.info('Server started', { port: 3001 });\n *   logger.error('Failed to connect', { error: err.message });\n */\n\nexport type LogLevel = 'trace' | 'debug' | 'info' | 'warn' | 'error' | 'fatal';\n\ninterface LogEntry {\n  level: LogLevel;\n  time: string;\n  msg: string;\n  [key: string]: unknown;\n}\n\ninterface LoggerOptions {\n  level?: LogLevel;\n  name?: string;\n  prettyPrint?: boolean;\n}\n\nconst LOG_LEVELS: Record<LogLevel, number> = {\n  trace: 10,\n  debug: 20,\n  info: 30,\n  warn: 40,\n  error: 50,\n  fatal: 60,\n};\n\nconst LEVEL_COLORS: Record<LogLevel, string> = {\n  trace: '\\x1b[90m',    // gray\n  debug: '\\x1b[36m',    // cyan\n  info: '\\x1b[32m',     // green\n  warn: '\\x1b[33m',     // yellow\n  error: '\\x1b[31m',    // red\n  fatal: '\\x1b[35m',    // magenta\n};\n\nconst RESET = '\\x1b[0m';\n\nclass Logger {\n  private minLevel: number;\n  private name: string;\n  private prettyPrint: boolean;\n\n  constructor(options: LoggerOptions = {}) {\n    this.minLevel = LOG_LEVELS[options.level || 'info'];\n    this.name = options.name || 'wiggum';\n    this.prettyPrint = options.prettyPrint ?? (process.env.NODE_ENV !== 'production');\n  }\n\n  private shouldLog(level: LogLevel): boolean {\n    return LOG_LEVELS[level] >= this.minLevel;\n  }\n\n  private formatEntry(entry: LogEntry): string {\n    if (this.prettyPrint) {\n      const color = LEVEL_COLORS[entry.level];\n      const { level, time, msg, ...rest } = entry;\n      const timestamp = new Date(time).toLocaleTimeString();\n      const extras = Object.keys(rest).length > 0 ? ` ${JSON.stringify(rest)}` : '';\n      return `${color}[${timestamp}] ${level.toUpperCase().padEnd(5)}${RESET} ${msg}${extras}`;\n    }\n    return JSON.stringify(entry);\n  }\n\n  private log(level: LogLevel, msg: string, data?: Record<string, unknown>): void {\n    if (!this.shouldLog(level)) return;\n\n    const entry: LogEntry = {\n      level,\n      time: new Date().toISOString(),\n      msg,\n      name: this.name,\n      ...data,\n    };\n\n    const output = this.formatEntry(entry);\n\n    if (level === 'error' || level === 'fatal') {\n      console.error(output);\n    } else if (level === 'warn') {\n      console.warn(output);\n    } else {\n      console.log(output);\n    }\n  }\n\n  trace(msg: string, data?: Record<string, unknown>): void {\n    this.log('trace', msg, data);\n  }\n\n  debug(msg: string, data?: Record<string, unknown>): void {\n    this.log('debug', msg, data);\n  }\n\n  info(msg: string, data?: Record<string, unknown>): void {\n    this.log('info', msg, data);\n  }\n\n  warn(msg: string, data?: Record<string, unknown>): void {\n    this.log('warn', msg, data);\n  }\n\n  error(msg: string, data?: Record<string, unknown>): void {\n    this.log('error', msg, data);\n  }\n\n  fatal(msg: string, data?: Record<string, unknown>): void {\n    this.log('fatal', msg, data);\n  }\n\n  child(bindings: Record<string, unknown>): Logger {\n    const child = new Logger({\n      level: Object.keys(LOG_LEVELS).find(\n        (k) => LOG_LEVELS[k as LogLevel] === this.minLevel\n      ) as LogLevel,\n      name: this.name,\n      prettyPrint: this.prettyPrint,\n    });\n    // Store bindings for child logger (would be added to each log entry in full implementation)\n    return child;\n  }\n}\n\n// Default logger instance\nexport const logger = new Logger({\n  level: (process.env.LOG_LEVEL as LogLevel) || 'info',\n  name: 'wiggum',\n});\n\n// Factory function for creating child loggers\nexport function createLogger(options: LoggerOptions): Logger {\n  return new Logger(options);\n}\n\nexport default logger;\n","numLines":145,"startLine":1,"totalLines":145}}}
