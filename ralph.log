ntinue;\n   111→        }\n   112→\n   113→        const projectPath = path.join(dirPath, entry.name);\n   114→        const project = await this.analyzeProject(projectPath);\n   115→\n   116→        if (project) {\n   117→          discovered.push(project);\n   118→        }\n   119→      }\n   120→    } catch {\n   121→      // Directory not accessible\n   122→    }\n   123→\n   124→    return discovered;\n   125→  }\n   126→\n   127→  /**\n   128→   * Analyze a single directory to determine if it's a project\n   129→   */\n   130→  private async analyzeProject(projectPath: string): Promise<DiscoveredProject | null> {\n   131→    const normalizedPath = path.resolve(projectPath).toLowerCase();\n   132→    const name = path.basename(projectPath);\n   133→\n   134→    // Check if it's a git repo\n   135→    const isGitRepo = await this.hasDirectory(projectPath, '.git');\n   136→\n   137→    // Only consider git repos as projects\n   138→    if (!isGitRepo) {\n   139→      return null;\n   140→    }\n   141→\n   142→    // Check if Ralph-ready\n   143→    const isRalphReady = await this.checkRalphReady(projectPath);\n   144→\n   145→    // Check if already registered\n   146→    const alreadyRegistered = this.registeredPaths.has(normalizedPath);\n   147→\n   148→    return {\n   149→      path: projectPath,\n   150→      name,\n   151→      isGitRepo,\n   152→      isRalphReady,\n   153→      alreadyRegistered,\n   154→    };\n   155→  }\n   156→\n   157→  /**\n   158→   * Check if a project is Ralph-ready\n   159→   */\n   160→  private async checkRalphReady(projectPath: string): Promise<boolean> {\n   161→    const checks = await Promise.all([\n   162→      this.hasFile(projectPath, 'AGENTS.md'),\n   163→      this.hasFile(projectPath, 'CLAUDE.md'),\n   164→      this.hasFile(projectPath, 'IMPLEMENTATION_PLAN.md'),\n   165→    ]);\n   166→\n   167→    return checks.some(exists => exists);\n   168→  }\n   169→\n   170→  /**\n   171→   * Check if a file exists in a directory\n   172→   */\n   173→  private async hasFile(dir: string, filename: string): Promise<boolean> {\n   174→    try {\n   175→      const stat = await fs.stat(path.join(dir, filename));\n   176→      return stat.isFile();\n   177→    } catch {\n   178→      return false;\n   179→    }\n   180→  }\n   181→\n   182→  /**\n   183→   * Check if a subdirectory exists\n   184→   */\n   185→  private async hasDirectory(dir: string, subdir: string): Promise<boolean> {\n   186→    try {\n   187→      const stat = await fs.stat(path.join(dir, subdir));\n   188→      return stat.isDirectory();\n   189→    } catch {\n   190→      return false;\n   191→    }\n   192→  }\n   193→\n   194→  /**\n   195→   * Scan a custom path provided by the user\n   196→   */\n   197→  async scanCustomPath(customPath: string): Promise<DiscoveredProject[]> {\n   198→    const discovered: DiscoveredProject[] = [];\n   199→\n   200→    try {\n   201→      const stat = await fs.stat(customPath);\n   202→\n   203→      if (stat.isDirectory()) {\n   204→        // Check if the path itself is a project\n   205→        const project = await this.analyzeProject(customPath);\n   206→        if (project) {\n   207→          discovered.push(project);\n   208→        }\n   209→\n   210→        // Also scan subdirectories\n   211→        const subProjects = await this.scanDirectory(customPath);\n   212→        discovered.push(...subProjects);\n   213→      }\n   214→    } catch {\n   215→      // Path not accessible\n   216→    }\n   217→\n   218→    return discovered;\n   219→  }\n   220→}\n   221→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_013TXrJkt1L15SQKMWfvCxez","session_id":"2114ed30-b19e-4096-a327-936d9cd9d573","uuid":"108d3eb2-8b62-4c18-87cd-81dee9644309","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\xsams\\RalphWiggumV3\\RalphWiggumV2\\dashboard\\server\\projectDiscovery.ts","content":"/**\n * Project Discovery - Scans directories for potential projects to add\n * Looks for git repositories and Ralph-ready projects\n */\n\nimport fs from 'fs/promises';\nimport path from 'path';\nimport os from 'os';\nimport type { DiscoveredProject, LauncherProject } from '../src/types/index.js';\n\n// Common directories where developers keep projects\nconst COMMON_PROJECT_DIRS = [\n  'Projects',\n  'projects',\n  'Code',\n  'code',\n  'Development',\n  'development',\n  'dev',\n  'Dev',\n  'work',\n  'Work',\n  'repos',\n  'Repos',\n  'src',\n  'GitHub',\n  'github',\n];\n\nexport class ProjectDiscovery {\n  private registeredPaths: Set<string>;\n\n  constructor(registeredProjects: LauncherProject[] = []) {\n    // Pre-populate registered paths for quick lookup\n    this.registeredPaths = new Set(\n      registeredProjects.map(p => path.resolve(p.path).toLowerCase())\n    );\n  }\n\n  /**\n   * Update the list of registered projects\n   */\n  updateRegistered(registeredProjects: LauncherProject[]): void {\n    this.registeredPaths = new Set(\n      registeredProjects.map(p => path.resolve(p.path).toLowerCase())\n    );\n  }\n\n  /**\n   * Discover projects in common directories\n   */\n  async discover(): Promise<DiscoveredProject[]> {\n    const homeDir = os.homedir();\n    const discovered: DiscoveredProject[] = [];\n\n    // Scan each common directory\n    for (const dir of COMMON_PROJECT_DIRS) {\n      const fullPath = path.join(homeDir, dir);\n      try {\n        const projects = await this.scanDirectory(fullPath);\n        discovered.push(...projects);\n      } catch {\n        // Directory doesn't exist or isn't readable - skip it\n      }\n    }\n\n    // Also scan root of common drive locations on Windows\n    if (process.platform === 'win32') {\n      const windowsDirs = ['C:\\\\Projects', 'C:\\\\Code', 'D:\\\\Projects', 'D:\\\\Code'];\n      for (const dir of windowsDirs) {\n        try {\n          const projects = await this.scanDirectory(dir);\n          discovered.push(...projects);\n        } catch {\n          // Skip inaccessible directories\n        }\n      }\n    }\n\n    // Deduplicate by path\n    const seen = new Set<string>();\n    return discovered.filter(project => {\n      const normalizedPath = path.resolve(project.path).toLowerCase();\n      if (seen.has(normalizedPath)) {\n        return false;\n      }\n      seen.add(normalizedPath);\n      return true;\n    });\n  }\n\n  /**\n   * Scan a specific directory for projects\n   */\n  async scanDirectory(dirPath: string): Promise<DiscoveredProject[]> {\n    const discovered: DiscoveredProject[] = [];\n\n    try {\n      const entries = await fs.readdir(dirPath, { withFileTypes: true });\n\n      for (const entry of entries) {\n        if (!entry.isDirectory()) continue;\n\n        // Skip hidden directories and common non-project directories\n        if (entry.name.startsWith('.') ||\n            entry.name === 'node_modules' ||\n            entry.name === '__pycache__' ||\n            entry.name === 'venv' ||\n            entry.name === '.venv') {\n          continue;\n        }\n\n        const projectPath = path.join(dirPath, entry.name);\n        const project = await this.analyzeProject(projectPath);\n\n        if (project) {\n          discovered.push(project);\n        }\n      }\n    } catch {\n      // Directory not accessible\n    }\n\n    return discovered;\n  }\n\n  /**\n   * Analyze a single directory to determine if it's a project\n   */\n  private async analyzeProject(projectPath: string): Promise<DiscoveredProject | null> {\n    const normalizedPath = path.resolve(projectPath).toLowerCase();\n    const name = path.basename(projectPath);\n\n    // Check if it's a git repo\n    const isGitRepo = await this.hasDirectory(projectPath, '.git');\n\n    // Only consider git repos as projects\n    if (!isGitRepo) {\n      return null;\n    }\n\n    // Check if Ralph-ready\n    const isRalphReady = await this.checkRalphReady(projectPath);\n\n    // Check if already registered\n    const alreadyRegistered = this.registeredPaths.has(normalizedPath);\n\n    return {\n      path: projectPath,\n      name,\n      isGitRepo,\n      isRalphReady,\n      alreadyRegistered,\n    };\n  }\n\n  /**\n   * Check if a project is Ralph-ready\n   */\n  private async checkRalphReady(projectPath: string): Promise<boolean> {\n    const checks = await Promise.all([\n      this.hasFile(projectPath, 'AGENTS.md'),\n      this.hasFile(projectPath, 'CLAUDE.md'),\n      this.hasFile(projectPath, 'IMPLEMENTATION_PLAN.md'),\n    ]);\n\n    return checks.some(exists => exists);\n  }\n\n  /**\n   * Check if a file exists in a directory\n   */\n  private async hasFile(dir: string, filename: string): Promise<boolean> {\n    try {\n      const stat = await fs.stat(path.join(dir, filename));\n      return stat.isFile();\n    } catch {\n      return false;\n    }\n  }\n\n  /**\n   * Check if a subdirectory exists\n   */\n  private async hasDirectory(dir: string, subdir: string): Promise<boolean> {\n    try {\n      const stat = await fs.stat(path.join(dir, subdir));\n      return stat.isDirectory();\n    } catch {\n      return false;\n    }\n  }\n\n  /**\n   * Scan a custom path provided by the user\n   */\n  async scanCustomPath(customPath: string): Promise<DiscoveredProject[]> {\n    const discovered: DiscoveredProject[] = [];\n\n    try {\n      const stat = await fs.stat(customPath);\n\n      if (stat.isDirectory()) {\n        // Check if the path itself is a project\n        const project = await this.analyzeProject(customPath);\n        if (project) {\n          discovered.push(project);\n        }\n\n        // Also scan subdirectories\n        const subProjects = await this.scanDirectory(customPath);\n        discovered.push(...subProjects);\n      }\n    } catch {\n      // Path not accessible\n    }\n\n    return discovered;\n  }\n}\n","numLines":221,"startLine":1,"totalLines":221}}}
