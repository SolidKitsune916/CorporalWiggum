ngify({ type: 'mode:get' }));\n   632→    }\n   633→  }, []);\n   634→\n   635→  return {\n   636→    connected,\n   637→    loopStatus,\n   638→    tasks,\n   639→    gitStatus,\n   640→    logs,\n   641→    projectConfig,\n   642→    enabledAgents,\n   643→    planStatus,\n   644→    planOutput,\n   645→    planComplete,\n   646→    planError,\n   647→    prdStatus,\n   648→    prdOutput,\n   649→    prdComplete,\n   650→    prdError,\n   651→    projectScan,\n   652→    scanLoading,\n   653→    projectInfo,\n   654→    availableAgents,\n   655→    cursorRules,\n   656→    agentsLoading,\n   657→    rulesLoading,\n   658→    selectedDocPaths,\n   659→    previewDoc,\n   660→    isLoadingPreview,\n   661→    sendCommand,\n   662→    clearLogs,\n   663→    clearPlanOutput,\n   664→    clearPrdOutput,\n   665→    scanProject,\n   666→    listAgents,\n   667→    listRules,\n   668→    setSelectedDocPaths,\n   669→    readDoc,\n   670→    closeDocPreview,\n   671→    // CLAUDE.md\n   672→    claudeMdFiles,\n   673→    claudeMdContent,\n   674→    claudeMdLoading,\n   675→    claudeMdApplying,\n   676→    listClaudeMdFiles,\n   677→    readClaudeMdFile,\n   678→    applyRalphClaudeMd,\n   679→    closeClaudeMdPreview,\n   680→    // Dependencies\n   681→    dependencyStatus,\n   682→    dependencyLoading,\n   683→    checkDependencies,\n   684→    // Config file preview (for ExistingDocsViewer)\n   685→    configPreviewDoc,\n   686→    configPreviewLoading,\n   687→    readConfigFile,\n   688→    closeConfigPreview,\n   689→    // Repo agent installation\n   690→    repoAgents,\n   691→    repoAgentsLoading,\n   692→    agentInstalling,\n   693→    listRepoAgents,\n   694→    installAgentGlobal,\n   695→    installAgentProject,\n   696→    installAllAgentsGlobal,\n   697→    // Review generator (Feature Set 14)\n   698→    reviewGeneratorStatus,\n   699→    reviewGeneratorOutput,\n   700→    reviewGeneratorComplete,\n   701→    reviewGeneratorError,\n   702→    generate