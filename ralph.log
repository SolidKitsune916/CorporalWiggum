{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PyPMeSntuUWoC56jHZbc7a","type":"tool_result","content":"     1→import { EventEmitter } from 'events';\n     2→import chokidar from 'chokidar';\n     3→import fs from 'fs/promises';\n     4→import path from 'path';\n     5→import simpleGit from 'simple-git';\n     6→import type { Task, TasksState, GitStatus, GitCommit, LogEntry } from '../src/types';\n     7→\n     8→export class FileWatcher extends EventEmitter {\n     9→  private projectPath: string;\n    10→  private watcher: chokidar.FSWatcher | null = null;\n    11→  private logWatcher: chokidar.FSWatcher | null = null;\n    12→  private prdWatcher: chokidar.FSWatcher | null = null;\n    13→  private audienceWatcher: chokidar.FSWatcher | null = null;\n    14→  private progressWatcher: chokidar.FSWatcher | null = null;\n    15→  private tasksJsonWatcher: chokidar.FSWatcher | null = null;\n    16→  private prdJsonWatcher: chokidar.FSWatcher | null = null;\n    17→  private modeWatcher: chokidar.FSWatcher | null = null;\n    18→  private tasks: TasksState = { tasks: [], completed: 0, total: 0 };\n    19→  private gitStatus: GitStatus = { branch: 'main', uncommittedCount: 0, commits: [] };\n    20→  private lastLogPosition = 0;\n    21→  private workflowMode: 'simple' | 'advanced' = 'simple';\n    22→\n    23→  constructor(projectPath: string) {\n    24→    super();\n    25→    this.projectPath = projectPath;\n    26→  }\n    27→\n    28→  start() {\n    29→    // Watch IMPLEMENTATION_PLAN.md\n    30→    const planPath = path.join(this.projectPath, 'IMPLEMENTATION_PLAN.md');\n    31→    this.watcher = chokidar.watch(planPath, {\n    32→      persistent: true,\n    33→      ignoreInitial: false,\n    34→    });\n    35→\n    36→    this.watcher.on('add', () => this.parseTasks());\n    37→    this.watcher.on('change', () => this.parseTasks());\n    38→\n    39→    // Watch ralph.log\n    40→    const logPath = path.join(this.projectPath, 'ralph.log');\n    41→    this.logWatcher = chokidar.watch(logPath, {\n    42→      persistent: true,\n    43→      ignoreInitial: false,\n    44→    });\n    45→\n    46→    this.logWatcher.on('add', () => this.tailLog());\n    47→    this.logWatcher.on('change', () => this.tailLog());\n    48→\n    49→    // Watch PRD.md\n    50→    const prdPath = path.join(this.projectPath, 'PRD.md');\n    51→    this.prdWatcher = chokidar.watch(prdPath, {\n    52→      persistent: true,\n    53→      ignoreInitial: false,\n    54→    });\n    55→\n    56→    this.prdWatcher.on('add', () => this.emit('config:refresh'));\n    57→    this.prdWatcher.on('change', () => this.emit('config:refresh'));\n    58→\n    59→    // Watch AUDIENCE_JTBD.md\n    60→    const audiencePath = path.join(this.projectPath, 'AUDIENCE_JTBD.md');\n    61→    this.audienceWatcher = chokidar.watch(audiencePath, {\n    62→      persistent: true,\n    63→      ignoreInitial: false,\n    64→    });\n    65→\n    66→    this.audienceWatcher.on('add', () => this.emit('config:refresh'));\n    67→    this.audienceWatcher.on('change', () => this.emit('config:refresh'));\n    68→\n    69→    // Watch progress.txt for learnings\n    70→    const progressPath = path.join(this.projectPath, 'progress.txt');\n    71→    this.progressWatcher = chokidar.watch(progressPath, {\n    72→      persistent: true,\n    73→      ignoreInitial: false,\n    74→    });\n    75→\n    76→    this.progressWatcher.on('add', () => this.emitProgress());\n    77→    this.progressWatcher.on('change', () => this.emitProgress());\n    78→\n    79→    // Watch tasks.json for structured task status\n    80→    const tasksJsonPath = path.join(this.projectPath, 'tasks.json');\n    81→    this.tasksJsonWatcher = chokidar.watch(tasksJsonPath, {\n    82→      persistent: true,\n    83→      ignoreInitial: false,\n    84→    });\n    85→\n    86→    this.tasksJsonWatcher.on('add', () => this.emitTasksJson());\n    87→    this.tasksJsonWatcher.on('change', () => this.emitTasksJson());\n    88→\n    89→    // Watch prd.json for simple mode user stories\n    90→    const prdJsonPath = path.join(this.projectPath, 'prd.json');\n    91→    this.prdJsonWatcher = chokidar.watch(prdJsonPath, {\n    92→      persistent: true,\n    93→      ignoreInitial: false,\n    94→    });\n    95→\n    96→    this.prdJsonWatcher.on('add', () => this.parseTasks());\n    97→    this.prdJsonWatcher.on('change', () => this.parseTasks());\n    98→\n    99→    // Watch .ralph-mode for workflow mode changes\n   100→    const modePath = path.join(this.projectPath, '.ralph-mode');\n   101→    this.modeWatcher = chokidar.watch(modePath, {\n   102→      persistent: true,\n   103→      ignoreInitial: false,\n   104→    });\n   105→\n   106→    this.modeWatcher.on('add', () => this.updateMode());\n   107→    this.modeWatcher.on('change', () => this.updateMode());\n   108→\n   109→    // Initialize workflow mode\n   110→    this.updateMode();\n   111→\n   112→    // Initial git status and periodic refresh\n   113→    this.updateGitStatus();\n   114→    setInterval(() => this.updateGitStatus(), 10000);\n   115→  }\n   116→\n   117→  stop() {\n   118→    this.watcher?.close();\n   119→    this.logWatcher?.close();\n   120→    this.prdWatcher?.close();\n   121→    this.audienceWatcher?.close();\n   122→    this.progressWatcher?.close();\n   123→    this.tasksJsonWatcher?.close();\n   124→    this.prdJsonWatcher?.close();\n   125→    this.modeWatcher?.close();\n   126→  }\n   127→\n   128→  getTasks(): TasksState {\n   129→    return this.tasks;\n   130→  }\n   131→\n   132→  getGitStatus(): GitStatus {\n   133→    return this.gitStatus;\n   134→  }\n   135→\n   136→  getWorkflowMode(): 'simple' | 'advanced' {\n   137→    return this.workflowMode;\n   138→  }\n   139→\n   140→  private async updateMode() {\n   141→    try {\n   142→      const modePath = path.join(this.projectPath, '.ralph-mode');\n   143→      const content = await fs.readFile(modePath, 'utf-8');\n   144→      const mode = content.trim();\n   145→      if (mode === 'simple' || mode === 'advanced') {\n   146→        const modeChanged = this.workflowMode !== mode;\n   147→        this.workflowMode = mode;\n   148→        if (modeChanged) {\n   149→          // Re-parse tasks when mode changes\n   150→          this.parseTasks();\n   151→        }\n   152→      }\n   153→    } catch {\n   154→      // Default to simple mode if file doesn't exist\n   155→      this.workflowMode = 'simple';\n   156→    }\n   157→  }\n   158→\n   159→  private async parseTasks() {\n   160→    try {\n   161→      // Route to the appropriate parser based on workflow mode\n   162→      if (this.workflowMode === 'simple') {\n   163→        await this.parsePrdJsonTasks();\n   164→      } else {\n   165→        await this.parseImplementationPlanTasks();\n   166→      }\n   167→    } catch (error) {\n   168→      console.error('Error parsing tasks:', error);\n   169→    }\n   170→  }\n   171→\n   172→  private async parsePrdJsonTasks() {\n   173→    try {\n   174→      const prdPath = path.join(this.projectPath, 'prd.json');\n   175→      const content = await fs.readFile(prdPath, 'utf-8');\n   176→      const prd = JSON.parse(content);\n   177→\n   178→      const tasks: Task[] = [];\n   179→\n   180→      if (prd.userStories && Array.isArray(prd.userStories)) {\n   181→        prd.userStories.forEach((story: { id: string; title: string; passes: boolean; priority?: number }) => {\n   182→          tasks.push({\n   183→            id: story.id,\n   184→            content: `${story.id}: ${story.title}`,\n   185→            completed: story.passes === true,\n   186→            priority: story.priority,\n   187→          });\n   188→        });\n   189→      }\n   190→\n   191→      // Sort by priority (lower number = higher priority)\n   192→      tasks.sort((a, b) => (a.priority || 999) - (b.priority || 999));\n   193→\n   194→      this.tasks = {\n   195→        tasks,\n   196→        completed: tasks.filter((t) => t.completed).length,\n   197→        total: tasks.length,\n   198→        lastUpdated: new Date(),\n   199→      };\n   200→\n   201→      this.emit('tasks', this.tasks);\n   202→    } catch (error) {\n   203→      // prd.json doesn't exist or is invalid - emit empty tasks\n   204→      this.tasks = { tasks: [], completed: 0, total: 0, lastUpdated: new Date() };\n   205→      this.emit('tasks', this.tasks);\n   206→    }\n   207→  }\n   208→\n   209→  private async parseImplementationPlanTasks() {\n   210→    try {\n   211→      const planPath = path.join(this.projectPath, 'IMPLEMENTATION_PLAN.md');\n   212→      const content = await fs.readFile(planPath, 'utf-8');\n   213→\n   214→      const tasks: Task[] = [];\n   215→      const lines = content.split('\\n');\n   216→      const seenUserStories = new Set<string>();\n   217→\n   218→      lines.forEach((line, index) => {\n   219→        // Pattern 1: Markdown checkboxes - [ ] or - [x]\n   220→        const checkboxMatch = line.match(/^-\\s*\\[([ xX])\\]\\s*(.+)$/);\n   221→        if (checkboxMatch) {\n   222→          tasks.push({\n   223→            id: `task-${index}`,\n   224→            content: checkboxMatch[2].trim(),\n   225→            completed: checkboxMatch[1].toLowerCase() === 'x',\n   226→          });\n   227→          return;\n   228→        }\n   229→\n   230→        // Pattern 2: User Stories (US-XXX format)\n   231→        // Matches: \"US-035\", \"| US-035 |\", \"- US-035:\", etc.\n   232→        const usMatch = line.match(/US-(\\d+)/);\n   233→        if (usMatch) {\n   234→          const usId = usMatch[1];\n   235→          // Avoid duplicates (same US mentioned multiple times)\n   236→          if (seenUserStories.has(usId)) return;\n   237→          seenUserStories.add(usId);\n   238→\n   239→          // Check for completion markers\n   240→          const isComplete = /✅|DONE|COMPLETE|completed/i.test(line);\n   241→\n   242→          // Extract description: everything after \"US-XXX\" up to status marker or end\n   243→          let description = line\n   244→            .replace(/^[|\\s-]*/, '') // Remove leading pipes, spaces, dashes\n   245→            .replace(/US-\\d+[:\\s|]*/i, '') // Remove the US-XXX part\n   246→            .replace(/[|].*$/, '') // Remove everything after pipe (table cell)\n   247→            .replace(/✅|⬜|🔲|DONE|TODO|COMPLETE|PENDING/gi, '') // Remove status markers\n   248→            .trim();\n   249→\n   250→          // If description is too short, use a generic one\n   251→          if (description.length < 3) {\n   252→            description = `User Story ${usId}`;\n   253→          }\n   254→\n   255→          tasks.push({\n   256→            id: `us-${usId}`,\n   257→            content: `US-${usId}: ${description}`,\n   258→            completed: isComplete,\n   259→          });\n   260→          return;\n   261→        }\n   262→\n   263→        // Pattern 3: Numbered checkboxes - 1. [ ] or 1. [x]\n   264→        const numberedMatch = line.match(/^\\d+\\.\\s*\\[([ xX])\\]\\s*(.+)$/);\n   265→        if (numberedMatch) {\n   266→          tasks.push({\n   267→            id: `task-${index}`,\n   268→            content: numberedMatch[2].trim(),\n   269→            completed: numberedMatch[1].toLowerCase() === 'x',\n   270→          });\n   271→          return;\n   272→        }\n   273→\n   274→        // Pattern 4: Emoji status markers at start of line\n   275→        const emojiMatch = line.match(/^[-*]\\s*(✅|⬜|🔲)\\s*(.+)$/);\n   276→        if (emojiMatch) {\n   277→          tasks.push({\n   278→            id: `task-${index}`,\n   279→            content: emojiMatch[2].trim(),\n   280→            completed: emojiMatch[1] === '✅',\n   281→          });\n   282→        }\n   283→      });\n   284→\n   285→      const completed = tasks.filter((t) => t.completed).length;\n   286→\n   287→      this.tasks = {\n   288→        tasks,\n   289→        completed,\n   290→        total: tasks.length,\n   291→        lastUpdated: new Date(),\n   292→      };\n   293→\n   294→      this.emit('tasks', this.tasks);\n   295→    } catch {\n   296→      // File doesn't exist yet, that's OK\n   297→    }\n   298→  }\n   299→\n   300→  private async tailLog() {\n   301→    try {\n   302→      const logPath = path.join(this.projectPath, 'ralph.log');\n   303→      const stat = await fs.stat(logPath);\n   304→\n   305→      if (stat.size > this.lastLogPosition) {\n   306→        const handle = await fs.open(logPath, 'r');\n   307→        const buffer = Buffer.alloc(stat.size - this.lastLogPosition);\n   308→        await handle.read(buffer, 0, buffer.length, this.lastLogPosition);\n   309→        await handle.close();\n   310→\n   311→        const newContent = buffer.toString('utf-8');\n   312→        const lines = newContent.split('\\n').filter((line) => line.trim());\n   313→\n   314→        lines.forEach((line) => {\n   315→          const entry: LogEntry = {\n   316→            id: `log-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`,\n   317→            timestamp: new Date(),\n   318→            content: line,\n   319→            type: this.classifyLogLine(line),\n   320→          };\n   321→          this.emit('log', entry);\n   322→        });\n   323→\n   324→        this.lastLogPosition = stat.size;\n   325→      }\n   326→    } catch {\n   327→      // Log file doesn't exist yet\n   328→      this.lastLogPosition = 0;\n   329→    }\n   330→  }\n   331→\n   332→  private classifyLogLine(line: string): LogEntry['type'] {\n   333→    const lower = line.toLowerCase();\n   334→    if (lower.includes('error') || lower.includes('fail') || lower.includes('exception')) {\n   335→      return 'error';\n   336→    }\n   337→    if (lower.includes('warning') || lower.includes('warn')) {\n   338→      return 'warning';\n   339→    }\n   340→    if (lower.includes('success') || lower.includes('complete') || lower.includes('pass')) {\n   341→      return 'success';\n   342→    }\n   343→    return 'info';\n   344→  }\n   345→\n   346→  private async updateGitStatus() {\n   347→    try {\n   348→      const git = simpleGit(this.projectPath);\n   349→\n   350→      // Get current branch\n   351→      const branchSummary = await git.branch();\n   352→      const branch = branchSummary.current;\n   353→\n   354→      // Get status\n   355→      const status = await git.status();\n   356→      const uncommittedCount = status.files.length;\n   357→\n   358→      // Get recent commits\n   359→      const log = await git.log({ maxCount: 10 });\n   360→      const commits: GitCommit[] = log.all.map((commit) => ({\n   361→        hash: commit.hash.substring(0, 7),\n   362→        message: commit.message,\n   363→        author: commit.author_name,\n   364→        date: new Date(commit.date),\n   365→      }));\n   366→\n   367→      // Get remote URL\n   368→      const remotes = await git.getRemotes(true);\n   369→      const origin = remotes.find((r) => r.name === 'origin');\n   370→      const remoteUrl = origin?.refs?.fetch || origin?.refs?.push;\n   371→\n   372→      // Parse GitHub URL to get repo name\n   373→      let repoName: string | undefined;\n   374→      if (remoteUrl) {\n   375→        // Handle SSH (git@github.com:user/repo.git) and HTTPS (https://github.com/user/repo.git)\n   376→        const match = remoteUrl.match(/github\\.com[:/](.+?)(?:\\.git)?$/);\n   377→        repoName = match?.[1];\n   378→      }\n   379→\n   380→      this.gitStatus = {\n   381→        branch,\n   382→        uncommittedCount,\n   383→        commits,\n   384→        lastUpdated: new Date(),\n   385→        remoteUrl,\n   386→        repoName,\n   387→      };\n   388→\n   389→      this.emit('git', this.gitStatus);\n   390→    } catch {\n   391→      // Git not initialized or error, keep default status\n   392→    }\n   393→  }\n   394→\n   395→  private async emitProgress() {\n   396→    try {\n   397→      const progressPath = path.join(this.projectPath, 'progress.txt');\n   398→      const content = await fs.readFile(progressPath, 'utf-8');\n   399→      this.emit('progress', { content, lastUpdated: new Date() });\n   400→    } catch {\n   401→      // File doesn't exist yet, that's OK\n   402→    }\n   403→  }\n   404→\n   405→  private async emitTasksJson() {\n   406→    try {\n   407→      const tasksJsonPath = path.join(this.projectPath, 'tasks.json');\n   408→      const content = await fs.readFile(tasksJsonPath, 'utf-8');\n   409→      const tasksData = JSON.parse(content);\n   410→      this.emit('tasks:json', tasksData);\n   411→    } catch {\n   412→      // File doesn't exist or invalid JSON, that's OK\n   413→    }\n   414→  }\n   415→}\n   416→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"130e55cd-d481-4dd7-b33f-e0bdbfb691b6","uuid":"6a33e770-bea4-4293-bb92-8f8d8835e160","tool_use_result":{"type":"text","file":{"filePath":"/Users/samueledwards/RalphWiggumV3/dashboard/server/fileWatcher.ts","content":"import { EventEmitter } from 'events';\nimport chokidar from 'chokidar';\nimport fs from 'fs/promises';\nimport path from 'path';\nimport simpleGit from 'simple-git';\nimport type { Task, TasksState, GitStatus, GitCommit, LogEntry } from '../src/types';\n\nexport class FileWatcher extends EventEmitter {\n  private projectPath: string;\n  private watcher: chokidar.FSWatcher | null = null;\n  private logWatcher: chokidar.FSWatcher | null = null;\n  private prdWatcher: chokidar.FSWatcher | null = null;\n  private audienceWatcher: chokidar.FSWatcher | null = null;\n  private progressWatcher: chokidar.FSWatcher | null = null;\n  private tasksJsonWatcher: chokidar.FSWatcher | null = null;\n  private prdJsonWatcher: chokidar.FSWatcher | null = null;\n  private modeWatcher: chokidar.FSWatcher | null = null;\n  private tasks: TasksState = { tasks: [], completed: 0, total: 0 };\n  private gitStatus: GitStatus = { branch: 'main', uncommittedCount: 0, commits: [] };\n  private lastLogPosition = 0;\n  private workflowMode: 'simple' | 'advanced' = 'simple';\n\n  constructor(projectPath: string) {\n    super();\n    this.projectPath = projectPath;\n  }\n\n  start() {\n    // Watch IMPLEMENTATION_PLAN.md\n    const planPath = path.join(this.projectPath, 'IMPLEMENTATION_PLAN.md');\n    this.watcher = chokidar.watch(planPath, {\n      persistent: true,\n      ignoreInitial: false,\n    });\n\n    this.watcher.on('add', () => this.parseTasks());\n    this.watcher.on('change', () => this.parseTasks());\n\n    // Watch ralph.log\n    const logPath = path.join(this.projectPath, 'ralph.log');\n    this.logWatcher = chokidar.watch(logPath, {\n      persistent: true,\n      ignoreInitial: false,\n    });\n\n    this.logWatcher.on('add', () => this.tailLog());\n    this.logWatcher.on('change', () => this.tailLog());\n\n    // Watch PRD.md\n    const prdPath = path.join(this.projectPath, 'PRD.md');\n    this.prdWatcher = chokidar.watch(prdPath, {\n      persistent: true,\n      ignoreInitial: false,\n    });\n\n    this.prdWatcher.on('add', () => this.emit('config:refresh'));\n    this.prdWatcher.on('change', () => this.emit('config:refresh'));\n\n    // Watch AUDIENCE_JTBD.md\n    const audiencePath = path.join(this.projectPath, 'AUDIENCE_JTBD.md');\n    this.audienceWatcher = chokidar.watch(audiencePath, {\n      persistent: true,\n      ignoreInitial: false,\n    });\n\n    this.audienceWatcher.on('add', () => this.emit('config:refresh'));\n    this.audienceWatcher.on('change', () => this.emit('config:refresh'));\n\n    // Watch progress.txt for learnings\n    const progressPath = path.join(this.projectPath, 'progress.txt');\n    this.progressWatcher = chokidar.watch(progressPath, {\n      persistent: true,\n      ignoreInitial: false,\n    });\n\n    this.progressWatcher.on('add', () => this.emitProgress());\n    this.progressWatcher.on('change', () => this.emitProgress());\n\n    // Watch tasks.json for structured task status\n    const tasksJsonPath = path.join(this.projectPath, 'tasks.json');\n    this.tasksJsonWatcher = chokidar.watch(tasksJsonPath, {\n      persistent: true,\n      ignoreInitial: false,\n    });\n\n    this.tasksJsonWatcher.on('add', () => this.emitTasksJson());\n    this.tasksJsonWatcher.on('change', () => this.emitTasksJson());\n\n    // Watch prd.json for simple mode user stories\n    const prdJsonPath = path.join(this.projectPath, 'prd.json');\n    this.prdJsonWatcher = chokidar.watch(prdJsonPath, {\n      persistent: true,\n      ignoreInitial: false,\n    });\n\n    this.prdJsonWatcher.on('add', () => this.parseTasks());\n    this.prdJsonWatcher.on('change', () => this.parseTasks());\n\n    // Watch .ralph-mode for workflow mode changes\n    const modePath = path.join(this.projectPath, '.ralph-mode');\n    this.modeWatcher = chokidar.watch(modePath, {\n      persistent: true,\n      ignoreInitial: false,\n    });\n\n    this.modeWatcher.on('add', () => this.updateMode());\n    this.modeWatcher.on('change', () => this.updateMode());\n\n    // Initialize workflow mode\n    this.updateMode();\n\n    // Initial git status and periodic refresh\n    this.updateGitStatus();\n    setInterval(() => this.updateGitStatus(), 10000);\n  }\n\n  stop() {\n    this.watcher?.close();\n    this.logWatcher?.close();\n    this.prdWatcher?.close();\n    this.audienceWatcher?.close();\n    this.progressWatcher?.close();\n    this.tasksJsonWatcher?.close();\n    this.prdJsonWatcher?.close();\n    this.modeWatcher?.close();\n  }\n\n  getTasks(): TasksState {\n    return this.tasks;\n  }\n\n  getGitStatus(): GitStatus {\n    return this.gitStatus;\n  }\n\n  getWorkflowMode(): 'simple' | 'advanced' {\n    return this.workflowMode;\n  }\n\n  private async updateMode() {\n    try {\n      const modePath = path.join(this.projectPath, '.ralph-mode');\n      const content = await fs.readFile(modePath, 'utf-8');\n      const mode = content.trim();\n      if (mode === 'simple' || mode === 'advanced') {\n        const modeChanged = this.workflowMode !== mode;\n        this.workflowMode = mode;\n        if (modeChanged) {\n          // Re-parse tasks when mode changes\n          this.parseTasks();\n        }\n      }\n    } catch {\n      // Default to simple mode if file doesn't exist\n      this.workflowMode = 'simple';\n    }\n  }\n\n  private async parseTasks() {\n    try {\n      // Route to the appropriate parser based on workflow mode\n      if (this.workflowMode === 'simple') {\n        await this.parsePrdJsonTasks();\n      } else {\n        await this.parseImplementationPlanTasks();\n      }\n    } catch (error) {\n      console.error('Error parsing tasks:', error);\n    }\n  }\n\n  private async parsePrdJsonTasks() {\n    try {\n      const prdPath = path.join(this.projectPath, 'prd.json');\n      const content = await fs.readFile(prdPath, 'utf-8');\n      const prd = JSON.parse(content);\n\n      const tasks: Task[] = [];\n\n      if (prd.userStories && Array.isArray(prd.userStories)) {\n        prd.userStories.forEach((story: { id: string; title: string; passes: boolean; priority?: number }) => {\n          tasks.push({\n            id: story.id,\n            content: `${story.id}: ${story.title}`,\n            completed: story.passes === true,\n            priority: story.priority,\n          });\n        });\n      }\n\n      // Sort by priority (lower number = higher priority)\n      tasks.sort((a, b) => (a.priority || 999) - (b.priority || 999));\n\n      this.tasks = {\n        tasks,\n        completed: tasks.filter((t) => t.completed).length,\n        total: tasks.length,\n        lastUpdated: new Date(),\n      };\n\n      this.emit('tasks', this.tasks);\n    } catch (error) {\n      // prd.json doesn't exist or is invalid - emit empty tasks\n      this.tasks = { tasks: [], completed: 0, total: 0, lastUpdated: new Date() };\n      this.emit('tasks', this.tasks);\n    }\n  }\n\n  private async parseImplementationPlanTasks() {\n    try {\n      const planPath = path.join(this.projectPath, 'IMPLEMENTATION_PLAN.md');\n      const content = await fs.readFile(planPath, 'utf-8');\n\n      const tasks: Task[] = [];\n      const lines = content.split('\\n');\n      const seenUserStories = new Set<string>();\n\n      lines.forEach((line, index) => {\n        // Pattern 1: Markdown checkboxes - [ ] or - [x]\n        const checkboxMatch = line.match(/^-\\s*\\[([ xX])\\]\\s*(.+)$/);\n        if (checkboxMatch) {\n          tasks.push({\n            id: `task-${index}`,\n            content: checkboxMatch[2].trim(),\n            completed: checkboxMatch[1].toLowerCase() === 'x',\n          });\n          return;\n        }\n\n        // Pattern 2: User Stories (US-XXX format)\n        // Matches: \"US-035\", \"| US-035 |\", \"- US-035:\", etc.\n        const usMatch = line.match(/US-(\\d+)/);\n        if (usMatch) {\n          const usId = usMatch[1];\n          // Avoid duplicates (same US mentioned multiple times)\n          if (seenUserStories.has(usId)) return;\n          seenUserStories.add(usId);\n\n          // Check for completion markers\n          const isComplete = /✅|DONE|COMPLETE|completed/i.test(line);\n\n          // Extract description: everything after \"US-XXX\" up to status marker or end\n          let description = line\n            .replace(/^[|\\s-]*/, '') // Remove leading pipes, spaces, dashes\n            .replace(/US-\\d+[:\\s|]*/i, '') // Remove the US-XXX part\n            .replace(/[|].*$/, '') // Remove everything after pipe (table cell)\n            .replace(/✅|⬜|🔲|DONE|TODO|COMPLETE|PENDING/gi, '') // Remove status markers\n            .trim();\n\n          // If description is too short, use a generic one\n          if (description.length < 3) {\n            description = `User Story ${usId}`;\n          }\n\n          tasks.push({\n            id: `us-${usId}`,\n            content: `US-${usId}: ${description}`,\n            completed: isComplete,\n          });\n          return;\n        }\n\n        // Pattern 3: Numbered checkboxes - 1. [ ] or 1. [x]\n        const numberedMatch = line.match(/^\\d+\\.\\s*\\[([ xX])\\]\\s*(.+)$/);\n        if (numberedMatch) {\n          tasks.push({\n            id: `task-${index}`,\n            content: numberedMatch[2].trim(),\n            completed: numberedMatch[1].toLowerCase() === 'x',\n          });\n          return;\n        }\n\n        // Pattern 4: Emoji status markers at start of line\n        const emojiMatch = line.match(/^[-*]\\s*(✅|⬜|🔲)\\s*(.+)$/);\n        if (emojiMatch) {\n          tasks.push({\n            id: `task-${index}`,\n            content: emojiMatch[2].trim(),\n            completed: emojiMatch[1] === '✅',\n          });\n        }\n      });\n\n      const completed = tasks.filter((t) => t.completed).length;\n\n      this.tasks = {\n        tasks,\n        completed,\n        total: tasks.length,\n        lastUpdated: new Date(),\n      };\n\n      this.emit('tasks', this.tasks);\n    } catch {\n      // File doesn't exist yet, that's OK\n    }\n  }\n\n  private async tailLog() {\n    try {\n      const logPath = path.join(this.projectPath, 'ralph.log');\n      const stat = await fs.stat(logPath);\n\n      if (stat.size > this.lastLogPosition) {\n        const handle = await fs.open(logPath, 'r');\n        const buffer = Buffer.alloc(stat.size - this.lastLogPosition);\n        await handle.read(buffer, 0, buffer.length, this.lastLogPosition);\n        await handle.close();\n\n        const newContent = buffer.toString('utf-8');\n        const lines = newContent.split('\\n').filter((line) => line.trim());\n\n        lines.forEach((line) => {\n          const entry: LogEntry = {\n            id: `log-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`,\n            timestamp: new Date(),\n            content: line,\n            type: this.classifyLogLine(line),\n          };\n          this.emit('log', entry);\n        });\n\n        this.lastLogPosition = stat.size;\n      }\n    } catch {\n      // Log file doesn't exist yet\n      this.lastLogPosition = 0;\n    }\n  }\n\n  private classifyLogLine(line: string): LogEntry['type'] {\n    const lower = line.toLowerCase();\n    if (lower.includes('error') || lower.includes('fail') || lower.includes('exception')) {\n      return 'error';\n    }\n    if (lower.includes('warning') || lower.includes('warn')) {\n      return 'warning';\n    }\n    if (lower.includes('success') || lower.includes('complete') || lower.includes('pass')) {\n      return 'success';\n    }\n    return 'info';\n  }\n\n  private async updateGitStatus() {\n    try {\n      const git = simpleGit(this.projectPath);\n\n      // Get current branch\n      const branchSummary = await git.branch();\n      const branch = branchSummary.current;\n\n      // Get status\n      const status = await git.status();\n      const uncommittedCount = status.files.length;\n\n      // Get recent commits\n      const log = await git.log({ maxCount: 10 });\n      const commits: GitCommit[] = log.all.map((commit) => ({\n        hash: commit.hash.substring(0, 7),\n        message: commit.message,\n        author: commit.author_name,\n        date: new Date(commit.date),\n      }));\n\n      // Get remote URL\n      const remotes = await git.getRemotes(true);\n      const origin = remotes.find((r) => r.name === 'origin');\n      const remoteUrl = origin?.refs?.fetch || origin?.refs?.push;\n\n      // Parse GitHub URL to get repo name\n      let repoName: string | undefined;\n      if (remoteUrl) {\n        // Handle SSH (git@github.com:user/repo.git) and HTTPS (https://github.com/user/repo.git)\n        const match = remoteUrl.match(/github\\.com[:/](.+?)(?:\\.git)?$/);\n        repoName = match?.[1];\n      }\n\n      this.gitStatus = {\n        branch,\n        uncommittedCount,\n        commits,\n        lastUpdated: new Date(),\n        remoteUrl,\n        repoName,\n      };\n\n      this.emit('git', this.gitStatus);\n    } catch {\n      // Git not initialized or error, keep default status\n    }\n  }\n\n  private async emitProgress() {\n    try {\n      const progressPath = path.join(this.projectPath, 'progress.txt');\n      const content = await fs.readFile(progressPath, 'utf-8');\n      this.emit('progress', { content, lastUpdated: new Date() });\n    } catch {\n      // File doesn't exist yet, that's OK\n    }\n  }\n\n  private async emitTasksJson() {\n    try {\n      const tasksJsonPath = path.join(this.projectPath, 'tasks.json');\n      const content = await fs.readFile(tasksJsonPath, 'utf-8');\n      const tasksData = JSON.parse(content);\n      this.emit('tasks:json', tasksData);\n    } catch {\n      // File doesn't exist or invalid JSON, that's OK\n    }\n  }\n}\n","numLines":416,"startLine":1,"totalLines":416}}}
