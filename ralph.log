{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012d9CEWgBrubua88haRRE9D","type":"tool_result","content":"     1→/**\n     2→ * Database singleton for Corporal WIGGUM, R.A.L.P.H.\n     3→ *\n     4→ * Uses better-sqlite3 for synchronous, fast local SQLite operations.\n     5→ * Database file is stored at ~/.ralph/ralph.db\n     6→ */\n     7→\n     8→import Database from 'better-sqlite3';\n     9→import path from 'path';\n    10→import os from 'os';\n    11→import fs from 'fs';\n    12→\n    13→const RALPH_DIR = path.join(os.homedir(), '.ralph');\n    14→const DB_FILE = path.join(RALPH_DIR, 'ralph.db');\n    15→\n    16→export class RalphDatabase {\n    17→  private static instance: Database.Database | null = null;\n    18→  private static currentVersion = 1;\n    19→\n    20→  /**\n    21→   * Get the database instance, creating it if necessary\n    22→   */\n    23→  static getInstance(): Database.Database {\n    24→    if (!this.instance) {\n    25→      // Ensure directory exists\n    26→      fs.mkdirSync(RALPH_DIR, { recursive: true });\n    27→\n    28→      this.instance = new Database(DB_FILE);\n    29→\n    30→      // Enable WAL mode for better concurrency\n    31→      this.instance.pragma('journal_mode = WAL');\n    32→\n    33→      // Enable foreign keys\n    34→      this.instance.pragma('foreign_keys = ON');\n    35→\n    36→      // Run migrations\n    37→      this.runMigrations();\n    38→    }\n    39→    return this.instance;\n    40→  }\n    41→\n    42→  /**\n    43→   * Get the path to the database file\n    44→   */\n    45→  static getDatabasePath(): string {\n    46→    return DB_FILE;\n    47→  }\n    48→\n    49→  /**\n    50→   * Get the path to the ralph directory\n    51→   */\n    52→  static getRalphDir(): string {\n    53→    return RALPH_DIR;\n    54→  }\n    55→\n    56→  /**\n    57→   * Run database migrations\n    58→   */\n    59→  private static runMigrations(): void {\n    60→    const db = this.in