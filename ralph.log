INTEGER,\n   113→        exit_reason TEXT,\n   114→        tokens_input INTEGER,\n   115→        tokens_output INTEGER,\n   116→        cost_usd REAL,\n   117→        trigger_reason TEXT,\n   118→        output_preview TEXT,\n   119→        error_message TEXT,\n   120→        validation_results_json TEXT,\n   121→        FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE\n   122→      );\n   123→\n   124→      -- Active sessions table (for browser refresh resilience)\n   125→      CREATE TABLE IF NOT EXISTS active_sessions (\n   126→        id TEXT PRIMARY KEY,\n   127→        project_id TEXT NOT NULL,\n   128→        pid INTEGER NOT NULL,\n   129→        mode TEXT NOT NULL,\n   130→        started_at TEXT NOT NULL,\n   131→        current_iteration INTEGER DEFAULT 0,\n   132→        max_iterations INTEGER,\n   133→        max_runtime_seconds INTEGER,\n   134→        cost_limit REAL,\n   135→        cost_spent REAL DEFAULT 0,\n   136→        tokens_input_total INTEGER DEFAULT 0,\n   137→        tokens_output_total INTEGER DEFAULT 0,\n   138→        state TEXT DEFAULT 'running',\n   139→        last_heartbeat TEXT NOT NULL,\n   140→        work_scope TEXT,\n   141→        completion_promise TEXT DEFAULT 'ALL_TASKS_COMPLETE',\n   142→        consecutive_failures INTEGER DEFAULT 0,\n   143→        loop_detected INTEGER DEFAULT 0,\n   144→        backoff_seconds INTEGER DEFAULT 0,\n   145→        metadata_json TEXT,\n   146→        FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE\n   147→      );\n   148→\n   149→      -- User preferences table\n   150→      CREATE TABLE IF NOT EXISTS user_preferences (\n   151→        key TEXT PRIMARY KEY,\n   152→        value TEXT NOT NULL,\n   153→        updated_at TEXT NOT NULL DEFAULT (datetime('now'))\n   154→      );\n   155→\n   156→      -- Iteration telemetry (detailed per-iteration data)\n   157→      CREATE TABLE IF NOT EXISTS iteration_telemetry (\n   158→        id INTEGER PRIMARY KEY AU