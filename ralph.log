{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018xLzV6AsKd6moRdxgQ7bY7","type":"tool_result","content":"     1→/**\n     2→ * LauncherHome - Main launcher view for managing multiple projects\n     3→ * Displays project cards and provides actions for managing projects/instances\n     4→ */\n     5→\n     6→import { useState, useRef, useEffect } from 'react';\n     7→import { useLauncher } from '@/hooks/useLauncher';\n     8→import { ProjectCard } from './ProjectCard';\n     9→import { AddProjectDialog } from './AddProjectDialog';\n    10→import { Button } from '@/components/ui/button';\n    11→import { Badge } from '@/components/ui/badge';\n    12→import {\n    13→  Rocket,\n    14→  Plus,\n    15→  RefreshCw,\n    16→  Wifi,\n    17→  WifiOff,\n    18→  AlertCircle,\n    19→  FolderOpen,\n    20→  Loader2,\n    21→  LayoutDashboard,\n    22→  CheckCircle,\n    23→  X,\n    24→} from 'lucide-react';\n    25→\n    26→export function LauncherHome() {\n    27→  const {\n    28→    connected,\n    29→    projects,\n    30→    projectsLoading,\n    31→    instances,\n    32→    discoveredProjects,\n    33→    discovering,\n    34→    browseResult,\n    35→    browsing,\n    36→    lastInitResult,\n    37→    error,\n    38→    listProjects,\n    39→    addProject,\n    40→    removeProject,\n    41→    initializeProject,\n    42→    spawnInstance,\n    43→    stopInstance,\n    44→    discoverProjects,\n    45→    browseDirectory,\n    46→    clearError,\n    47→    clearInitResult,\n    48→    getInstanceForProject,\n    49→    isInstanceRunning,\n    50→  } = useLauncher();\n    51→\n    52→  const [isAddDialogOpen, setIsAddDialogOpen] = useState(false);\n    53→  const [spawningProjectId, setSpawningProjectId] = useState<string | null>(null);\n    54→  const [initializingProjectId, setInitializingProjectId] = useState<string | null>(null);\n    55→  const [successMessage, setSuccessMessage] = useState<string | null>(null);\n    56→  // Track spawning state per project to prevent double-spawns\n    57→  const spawningRef = useRef<Set<string>>(new Set());\n    58→\n    59→  // Handle init result\n    60→  useEffect(() => {\n    61→    if (lastInitResult && lastInitResult.created.length > 0) {\n    62→      const project = projects.find(p => p.id === lastInitResult.projectId);\n    63→      const projectName = project?.name || 'Project';\n    64→      setSuccessMessage(`Created ${lastInitResult.created.join(', ')} in ${projectName}`);\n    65→      setInitializingProjectId(null);\n    66→      clearInitResult();\n    67→      // Auto-hide after 5 seconds\n    68→      const timer = setTimeout(() => setSuccessMessage(null), 5000);\n    69→      return () => clearTimeout(timer);\n    70→    }\n    71→  }, [lastInitResult, projects, clearInitResult]);\n    72→\n    73→  const handleOpenDashboard = async (projectId: string) => {\n    74→    // Prevent double-spawns\n    75→    if (spawningRef.current.has(projectId) || isInstanceRunning(projectId)) {\n    76→      return;\n    77→    }\n    78→\n    79→    spawningRef.current.add(projectId);\n    80→    setSpawningProjectId(projectId);\n    81→    \n    82→    try {\n    83→      spawnInstance(projectId);\n    84→      // The instance spawner will open the browser tab when ready\n    85→      // We wait a bit and then clear the spawning state\n    86→      setTimeout(() => {\n    87→        setSpawningProjectId(null);\n    88→        spawningRef.current.delete(projectId);\n    89→        const instance = getInstanceForProject(projectId);\n    90→        if (instance) {\n    91→          window.open(`http://localhost:${instance.backendPort}`, '_blank');\n    92→        }\n    93→      }, 3000);\n    94→    } catch (err) {\n    95→      spawningRef.current.delete(projectId);\n    96→      setSpawningProjectId(null);\n    97→    }\n    98→  };\n    99→\n   100→  const handleStartInstance = async (projectId: string) => {\n   101→    // Prevent double-spawns - check if already spawning or running\n   102→    if (spawningRef.current.has(projectId) || isInstanceRunning(projectId)) {\n   103→      console.log(`[Launcher] Skipping spawn for ${projectId} - already spawning or running`);\n   104→      return;\n   105→    }\n   106→\n   107→    spawningRef.current.add(projectId);\n   108→    setSpawningProjectId(projectId);\n   109→    \n   110→    try {\n   111→      spawnInstance(projectId);\n   112→      // Clear spawning state after a delay (will be cleared earlier if instance spawns successfully)\n   113→      setTimeout(() => {\n   114→        setSpawningProjectId(null);\n   115→        spawningRef.current.delete(projectId);\n   116→      }, 5000);\n   117→    } catch (err) {\n   118→      spawningRef.current.delete(projectId);\n   119→      setSpawningProjectId(null);\n   120→    }\n   121→  };\n   122→\n   123→  const handleStopInstance = (projectId: string) => {\n   124→    stopInstance(projectId);\n   125→  };\n   126→\n   127→  const handleRemoveProject = (projectId: string) => {\n   128→    if (confirm('Are you sure you want to remove this project from the launcher?')) {\n   129→      removeProject(projectId);\n   130→    }\n   131→  };\n   132→\n   133→  const handleAddProject = (path: string) => {\n   134→    addProject(path);\n   135→    setIsAddDialogOpen(false);\n   136→  };\n   137→\n   138→  const handleInitialize = (projectId: string) => {\n   139→    setInitializingProjectId(projectId);\n   140→    initializeProject(projectId);\n   141→  };\n   142→\n   143→  const runningCount = instances.length;\n   144→  const totalCount = projects.length;\n   145→\n   146→  return (\n   147→    <div className=\"min-h-screen bg-background\">\n   148→      {/* Header */}\n   149→      <header className=\"border-b\">\n   150→        <div className=\"container mx-auto px-4 py-4\">\n   151→          <div className=\"flex items-center justify-between\">\n   152→            <div className=\"flex items-center gap-3\">\n   153→              <Rocket className=\"h-8 w-8 text-primary\" />\n   154→              <div>\n   155→                <h1 className=\"text-2xl font-bold\">\n   156→                  <span className=\"text-primary\">WIGGUM</span> Launcher\n   157→                </h1>\n   158→                <p className=\"text-sm text-muted-foreground\">\n   159→                  Manage your R.A.L.P.H. projects\n   160→                </p>\n   161→              </div>\n   162→            </div>\n   163→\n   164→            <div className=\"flex items-center gap-4\">\n   165→              <Button\n   166→                variant=\"outline\"\n   167→                size=\"sm\"\n   168→                onClick={() => window.location.href = '/'}\n   169→                className=\"gap-2\"\n   170→              >\n   171→                <LayoutDashboard className=\"h-4 w-4\" />\n   172→                Dashboard\n   173→              </Button>\n   174→\n   175→              <Badge variant={connected ? 'success' : 'destructive'}>\n   176→                {connected ? (\n   177→                  <><Wifi className=\"h-3 w-3 mr-1\" /> Connected</>\n   178→                ) : (\n   179→                  <><WifiOff className=\"h-3 w-3 mr-1\" /> Disconnected</>\n   180→                )}\n   181→              </Badge>\n   182→\n   183→              {runningCount > 0 && (\n   184→                <Badge variant=\"secondary\">\n   185→                  {runningCount} Running\n   186→                </Badge>\n   187→              )}\n   188→\n   189→              <Button\n   190→                variant=\"outline\"\n   191→                size=\"sm\"\n   192→                onClick={listProjects}\n   193→                disabled={projectsLoading}\n   194→              >\n   195→                {projectsLoading ? (\n   196→                  <Loader2 className=\"h-4 w-4 animate-spin\" />\n   197→                ) : (\n   198→                  <RefreshCw className=\"h-4 w-4\" />\n   199→                )}\n   200→              </Button>\n   201→\n   202→              <Button onClick={() => setIsAddDialogOpen(true)}>\n   203→                <Plus className=\"h-4 w-4 mr-2\" />\n   204→                Add Project\n   205→              </Button>\n   206→            </div>\n   207→          </div>\n   208→        </div>\n   209→      </header>\n   210→\n   211→      {/* Error Banner */}\n   212→      {error && (\n   213→        <div className=\"bg-destructive/15 border-b border-destructive/30\">\n   214→          <div className=\"container mx-auto px-4 py-3\">\n   215→            <div className=\"flex items-center justify-between\">\n   216→              <div className=\"flex items-center gap-2 text-destructive\">\n   217→                <AlertCircle className=\"h-4 w-4\" />\n   218→                <span className=\"text-sm\">{error}</span>\n   219→              </div>\n   220→              <Button variant=\"ghost\" size=\"sm\" onClick={clearError}>\n   221→                Dismiss\n   222→              </Button>\n   223→            </div>\n   224→          </div>\n   225→        </div>\n   226→      )}\n   227→\n   228→      {/* Success Banner (for init results) */}\n   229→      {successMessage && (\n   230→        <div className=\"bg-green-500/15 border-b border-green-500/30\">\n   231→          <div className=\"container mx-auto px-4 py-3\">\n   232→            <div className=\"flex items-center justify-between\">\n   233→              <div className=\"flex items-center gap-2 text-green-600 dark:text-green-400\">\n   234→                <CheckCircle className=\"h-4 w-4\" />\n   235→                <span className=\"text-sm\">{successMessage}</span>\n   236→              </div>\n   237→              <Button variant=\"ghost\" size=\"sm\" onClick={() => setSuccessMessage(null)}>\n   238→                <X className=\"h-4 w-4\" />\n   239→              </Button>\n   240→            </div>\n   241→          </div>\n   242→        </div>\n   243→      )}\n   244→\n   245→      {/* Main Content */}\n   246→      <main className=\"container mx-auto px-4 py-8\">\n   247→        {totalCount === 0 ? (\n   248→          /* Empty State */\n   249→          <div className=\"flex flex-col items-center justify-center py-16 text-center\">\n   250→            <FolderOpen className=\"h-16 w-16 text-muted-foreground mb-4\" />\n   251→            <h2 className=\"text-xl font-semibold mb-2\">No Projects Yet</h2>\n   252→            <p className=\"text-muted-foreground mb-6 max-w-md\">\n   253→              Add your first project to start managing WIGGUM loops across\n   254→              multiple codebases.\n   255→            </p>\n   256→            <Button onClick={() => setIsAddDialogOpen(true)}>\n   257→              <Plus className=\"h-4 w-4 mr-2\" />\n   258→              Add Your First Project\n   259→            </Button>\n   260→          </div>\n   261→        ) : (\n   262→          /* Project Grid */\n   263→          <div className=\"grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4\">\n   264→            {projects.map((project) => {\n   265→              const instance = getInstanceForProject(project.id);\n   266→              const isSpawning = spawningProjectId === project.id;\n   267→              const isProjectInitializing = initializingProjectId === project.id;\n   268→\n   269→              return (\n   270→                <ProjectCard\n   271→                  key={project.id}\n   272→                  project={project}\n   273→                  instance={instance}\n   274→                  isSpawning={isSpawning}\n   275→                  isInitializing={isProjectInitializing}\n   276→                  onOpenDashboard={handleOpenDashboard}\n   277→                  onStartInstance={handleStartInstance}\n   278→                  onStopInstance={handleStopInstance}\n   279→                  onRemoveProject={handleRemoveProject}\n   280→                  onInitialize={handleInitialize}\n   281→                />\n   282→              );\n   283→            })}\n   284→          </div>\n   285→        )}\n   286→      </main>\n   287→\n   288→      {/* Add Project Dialog */}\n   289→      <AddProjectDialog\n   290→        isOpen={isAddDialogOpen}\n   291→        onClose={() => setIsAddDialogOpen(false)}\n   292→        onAddProject={handleAddProject}\n   293→        discoveredProjects={discoveredProjects}\n   294→        isDiscovering={discovering}\n   295→        onDiscover={discoverProjects}\n   296→        browseResult={browseResult}\n   297→        isBrowsing={browsing}\n   298→        onBrowse={browseDirectory}\n   299→      />\n   300→    </div>\n   301→  );\n   302→}\n   303→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"6f0bf378-6db9-4f0d-94d4-53d6793fc6db","uuid":"eb8d8ec2-b92a-4509-960d-405cd1bf451d","tool_use_result":{"type":"text","file":{"filePath":"/Users/samueledwards/RalphWiggumV3/dashboard/src/components/launcher/LauncherHome.tsx","content":"/**\n * LauncherHome - Main launcher view for managing multiple projects\n * Displays project cards and provides actions for managing projects/instances\n */\n\nimport { useState, useRef, useEffect } from 'react';\nimport { useLauncher } from '@/hooks/useLauncher';\nimport { ProjectCard } from './ProjectCard';\nimport { AddProjectDialog } from './AddProjectDialog';\nimport { Button } from '@/components/ui/button';\nimport { Badge } from '@/components/ui/badge';\nimport {\n  Rocket,\n  Plus,\n  RefreshCw,\n  Wifi,\n  WifiOff,\n  AlertCircle,\n  FolderOpen,\n  Loader2,\n  LayoutDashboard,\n  CheckCircle,\n  X,\n} from 'lucide-react';\n\nexport function LauncherHome() {\n  const {\n    connected,\n    projects,\n    projectsLoading,\n    instances,\n    discoveredProjects,\n    discovering,\n    browseResult,\n    browsing,\n    lastInitResult,\n    error,\n    listProjects,\n    addProject,\n    removeProject,\n    initializeProject,\n    spawnInstance,\n    stopInstance,\n    discoverProjects,\n    browseDirectory,\n    clearError,\n    clearInitResult,\n    getInstanceForProject,\n    isInstanceRunning,\n  } = useLauncher();\n\n  const [isAddDialogOpen, setIsAddDialogOpen] = useState(false);\n  const [spawningProjectId, setSpawningProjectId] = useState<string | null>(null);\n  const [initializingProjectId, setInitializingProjectId] = useState<string | null>(null);\n  const [successMessage, setSuccessMessage] = useState<string | null>(null);\n  // Track spawning state per project to prevent double-spawns\n  const spawningRef = useRef<Set<string>>(new Set());\n\n  // Handle init result\n  useEffect(() => {\n    if (lastInitResult && lastInitResult.created.length > 0) {\n      const project = projects.find(p => p.id === lastInitResult.projectId);\n      const projectName = project?.name || 'Project';\n      setSuccessMessage(`Created ${lastInitResult.created.join(', ')} in ${projectName}`);\n      setInitializingProjectId(null);\n      clearInitResult();\n      // Auto-hide after 5 seconds\n      const timer = setTimeout(() => setSuccessMessage(null), 5000);\n      return () => clearTimeout(timer);\n    }\n  }, [lastInitResult, projects, clearInitResult]);\n\n  const handleOpenDashboard = async (projectId: string) => {\n    // Prevent double-spawns\n    if (spawningRef.current.has(projectId) || isInstanceRunning(projectId)) {\n      return;\n    }\n\n    spawningRef.current.add(projectId);\n    setSpawningProjectId(projectId);\n    \n    try {\n      spawnInstance(projectId);\n      // The instance spawner will open the browser tab when ready\n      // We wait a bit and then clear the spawning state\n      setTimeout(() => {\n        setSpawningProjectId(null);\n        spawningRef.current.delete(projectId);\n        const instance = getInstanceForProject(projectId);\n        if (instance) {\n          window.open(`http://localhost:${instance.backendPort}`, '_blank');\n        }\n      }, 3000);\n    } catch (err) {\n      spawningRef.current.delete(projectId);\n      setSpawningProjectId(null);\n    }\n  };\n\n  const handleStartInstance = async (projectId: string) => {\n    // Prevent double-spawns - check if already spawning or running\n    if (spawningRef.current.has(projectId) || isInstanceRunning(projectId)) {\n      console.log(`[Launcher] Skipping spawn for ${projectId} - already spawning or running`);\n      return;\n    }\n\n    spawningRef.current.add(projectId);\n    setSpawningProjectId(projectId);\n    \n    try {\n      spawnInstance(projectId);\n      // Clear spawning state after a delay (will be cleared earlier if instance spawns successfully)\n      setTimeout(() => {\n        setSpawningProjectId(null);\n        spawningRef.current.delete(projectId);\n      }, 5000);\n    } catch (err) {\n      spawningRef.current.delete(projectId);\n      setSpawningProjectId(null);\n    }\n  };\n\n  const handleStopInstance = (projectId: string) => {\n    stopInstance(projectId);\n  };\n\n  const handleRemoveProject = (projectId: string) => {\n    if (confirm('Are you sure you want to remove this project from the launcher?')) {\n      removeProject(projectId);\n    }\n  };\n\n  const handleAddProject = (path: string) => {\n    addProject(path);\n    setIsAddDialogOpen(false);\n  };\n\n  const handleInitialize = (projectId: string) => {\n    setInitializingProjectId(projectId);\n    initializeProject(projectId);\n  };\n\n  const runningCount = instances.length;\n  const totalCount = projects.length;\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      {/* Header */}\n      <header className=\"border-b\">\n        <div className=\"container mx-auto px-4 py-4\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-3\">\n              <Rocket className=\"h-8 w-8 text-primary\" />\n              <div>\n                <h1 className=\"text-2xl font-bold\">\n                  <span className=\"text-primary\">WIGGUM</span> Launcher\n                </h1>\n                <p className=\"text-sm text-muted-foreground\">\n                  Manage your R.A.L.P.H. projects\n                </p>\n              </div>\n            </div>\n\n            <div className=\"flex items-center gap-4\">\n              <Button\n                variant=\"outline\"\n                size=\"sm\"\n                onClick={() => window.location.href = '/'}\n                className=\"gap-2\"\n              >\n                <LayoutDashboard className=\"h-4 w-4\" />\n                Dashboard\n              </Button>\n\n              <Badge variant={connected ? 'success' : 'destructive'}>\n                {connected ? (\n                  <><Wifi className=\"h-3 w-3 mr-1\" /> Connected</>\n                ) : (\n                  <><WifiOff className=\"h-3 w-3 mr-1\" /> Disconnected</>\n                )}\n              </Badge>\n\n              {runningCount > 0 && (\n                <Badge variant=\"secondary\">\n                  {runningCount} Running\n                </Badge>\n              )}\n\n              <Button\n                variant=\"outline\"\n                size=\"sm\"\n                onClick={listProjects}\n                disabled={projectsLoading}\n              >\n                {projectsLoading ? (\n                  <Loader2 className=\"h-4 w-4 animate-spin\" />\n                ) : (\n                  <RefreshCw className=\"h-4 w-4\" />\n                )}\n              </Button>\n\n              <Button onClick={() => setIsAddDialogOpen(true)}>\n                <Plus className=\"h-4 w-4 mr-2\" />\n                Add Project\n              </Button>\n            </div>\n          </div>\n        </div>\n      </header>\n\n      {/* Error Banner */}\n      {error && (\n        <div className=\"bg-destructive/15 border-b border-destructive/30\">\n          <div className=\"container mx-auto px-4 py-3\">\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-2 text-destructive\">\n                <AlertCircle className=\"h-4 w-4\" />\n                <span className=\"text-sm\">{error}</span>\n              </div>\n              <Button variant=\"ghost\" size=\"sm\" onClick={clearError}>\n                Dismiss\n              </Button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Success Banner (for init results) */}\n      {successMessage && (\n        <div className=\"bg-green-500/15 border-b border-green-500/30\">\n          <div className=\"container mx-auto px-4 py-3\">\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-2 text-green-600 dark:text-green-400\">\n                <CheckCircle className=\"h-4 w-4\" />\n                <span className=\"text-sm\">{successMessage}</span>\n              </div>\n              <Button variant=\"ghost\" size=\"sm\" onClick={() => setSuccessMessage(null)}>\n                <X className=\"h-4 w-4\" />\n              </Button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Main Content */}\n      <main className=\"container mx-auto px-4 py-8\">\n        {totalCount === 0 ? (\n          /* Empty State */\n          <div className=\"flex flex-col items-center justify-center py-16 text-center\">\n            <FolderOpen className=\"h-16 w-16 text-muted-foreground mb-4\" />\n            <h2 className=\"text-xl font-semibold mb-2\">No Projects Yet</h2>\n            <p className=\"text-muted-foreground mb-6 max-w-md\">\n              Add your first project to start managing WIGGUM loops across\n              multiple codebases.\n            </p>\n            <Button onClick={() => setIsAddDialogOpen(true)}>\n              <Plus className=\"h-4 w-4 mr-2\" />\n              Add Your First Project\n            </Button>\n          </div>\n        ) : (\n          /* Project Grid */\n          <div className=\"grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4\">\n            {projects.map((project) => {\n              const instance = getInstanceForProject(project.id);\n              const isSpawning = spawningProjectId === project.id;\n              const isProjectInitializing = initializingProjectId === project.id;\n\n              return (\n                <ProjectCard\n                  key={project.id}\n                  project={project}\n                  instance={instance}\n                  isSpawning={isSpawning}\n                  isInitializing={isProjectInitializing}\n                  onOpenDashboard={handleOpenDashboard}\n                  onStartInstance={handleStartInstance}\n                  onStopInstance={handleStopInstance}\n                  onRemoveProject={handleRemoveProject}\n                  onInitialize={handleInitialize}\n                />\n              );\n            })}\n          </div>\n        )}\n      </main>\n\n      {/* Add Project Dialog */}\n      <AddProjectDialog\n        isOpen={isAddDialogOpen}\n        onClose={() => setIsAddDialogOpen(false)}\n        onAddProject={handleAddProject}\n        discoveredProjects={discoveredProjects}\n        isDiscovering={discovering}\n        onDiscover={discoverProjects}\n        browseResult={browseResult}\n        isBrowsing={browsing}\n        onBrowse={browseDirectory}\n      />\n    </div>\n  );\n}\n","numLines":303,"startLine":1,"totalLines":303}}}
