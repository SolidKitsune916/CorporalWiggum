{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F64WJ2CjbqW9WQaM2pbK8A","type":"tool_result","content":"     1→import { Button } from '@/components/ui/button';\n     2→import { ScrollArea } from '@/components/ui/scroll-area';\n     3→import { Badge } from '@/components/ui/badge';\n     4→import {\n     5→  X,\n     6→  FileText,\n     7→  CheckSquare,\n     8→  Square,\n     9→  Loader2,\n    10→  Copy,\n    11→  Check,\n    12→} from 'lucide-react';\n    13→import { useState } from 'react';\n    14→\n    15→interface DocumentPreviewProps {\n    16→  doc: { path: string; content: string } | null;\n    17→  isLoading: boolean;\n    18→  isOpen: boolean;\n    19→  isSelected: boolean;\n    20→  onClose: () => void;\n    21→  onToggleSelect: (path: string) => void;\n    22→}\n    23→\n    24→export function DocumentPreview({\n    25→  doc,\n    26→  isLoading,\n    27→  isOpen,\n    28→  isSelected,\n    29→  onClose,\n    30→  onToggleSelect,\n    31→}: DocumentPreviewProps) {\n    32→  const [copied, setCopied] = useState(false);\n    33→\n    34→  if (!isOpen) return null;\n    35→\n    36→  const handleCopy = async () => {\n    37→    if (doc?.content) {\n    38→      await navigator.clipboard.writeText(doc.content);\n    39→      setCopied(true);\n    40→      setTimeout(() => setCopied(false), 2000);\n    41→    }\n    42→  };\n    43→\n    44→  const handleBackdropClick = (e: React.MouseEvent) => {\n    45→    if (e.target === e.currentTarget) {\n    46→      onClose();\n    47→    }\n    48→  };\n    49→\n    50→  return (\n    51→    <div\n    52→      className=\"fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4\"\n    53→      onClick={handleBackdropClick}\n    54→    >\n    55→      <div className=\"bg-background rounded-lg shadow-xl w-full max-w-3xl max-h-[80vh] flex flex-col\">\n    56→        {/* Header */}\n    57→        <div className=\"flex items-center justify-between p-4 border-b\">\n    58→          <div className=\"flex items-center gap-3\">\n    59→            <FileText className=\"h-5 w-5 text-muted-foreground\" />\n    60→            <div>\n    61→              <h2 className=\"font-semibold\">{doc?.path || 'Loading...'}</h2>\n    62→              {doc && (\n    63→                <p className=\"text-xs text-muted-foreground\">\n    64→                  {(doc.content.length / 1024).toFixed(1)} KB\n    65→                </p>\n    66→              )}\n    67→            </div>\n    68→          </div>\n    69→          <div className=\"flex items-center gap-2\">\n    70→            {doc && (\n    71→              <>\n    72→                <Button\n    73→                  variant=\"outline\"\n    74→                  size=\"sm\"\n    75→                  onClick={handleCopy}\n    76→                  className=\"gap-2\"\n    77→                >\n    78→                  {copied ? (\n    79→                    <Check className=\"h-4 w-4\" />\n    80→                  ) : (\n    81→                    <Copy className=\"h-4 w-4\" />\n    82→                  )}\n    83→                  {copied ? 'Copied!' : 'Copy'}\n    84→                </Button>\n    85→                <Button\n    86→                  variant={isSelected ? 'default' : 'outline'}\n    87→                  size=\"sm\"\n    88→                  onClick={() => onToggleSelect(doc.path)}\n    89→                  className=\"gap-2\"\n    90→                >\n    91→                  {isSelected ? (\n    92→                    <CheckSquare className=\"h-4 w-4\" />\n    93→                  ) : (\n    94→                    <Square className=\"h-4 w-4\" />\n    95→                  )}\n    96→                  {isSelected ? 'Selected' : 'Select'}\n    97→                </Button>\n    98→              </>\n    99→            )}\n   100→            <Button variant=\"ghost\" size=\"icon\" onClick={onClose}>\n   101→              <X className=\"h-4 w-4\" />\n   102→            </Button>\n   103→          </div>\n   104→        </div>\n   105→\n   106→        {/* Content */}\n   107→        <ScrollArea className=\"flex-1 p-4\">\n   108→          {isLoading ? (\n   109→            <div className=\"flex items-center justify-center py-12\">\n   110→              <Loader2 className=\"h-8 w-8 animate-spin text-muted-foreground\" />\n   111→            </div>\n   112→          ) : doc ? (\n   113→            <pre className=\"text-sm font-mono whitespace-pre-wrap break-words\">\n   114→              {doc.content}\n   115→            </pre>\n   116→          ) : (\n   117→            <div className=\"text-center text-muted-foreground py-12\">\n   118→              Failed to load document\n   119→            </div>\n   120→          )}\n   121→        </ScrollArea>\n   122→\n   123→        {/* Footer */}\n   124→        <div className=\"flex items-center justify-between p-4 border-t bg-muted/30\">\n   125→          <div className=\"flex items-center gap-2\">\n   126→            {isSelected && (\n   127→              <Badge variant=\"success\">\n   128→                <Check className=\"h-3 w-3 mr-1\" />\n   129→                Selected for PRD context\n   130→              </Badge>\n   131→            )}\n   132→          </div>\n   133→          <Button variant=\"outline\" onClick={onClose}>\n   134→            Close\n   135→          </Button>\n   136→        </div>\n   137→      </div>\n   138→    </div>\n   139→  );\n   140→}\n   141→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01UL2WkT46SPJU2cfW9rfGT2","session_id":"6d9df9ce-f430-4def-aa62-de4fb0297909","uuid":"442d894c-27b7-4096-ab5c-ee356081c896","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\xsams\\RalphWiggumV3\\RalphWiggumV2\\dashboard\\src\\components\\DocumentPreview.tsx","content":"import { Button } from '@/components/ui/button';\nimport { ScrollArea } from '@/components/ui/scroll-area';\nimport { Badge } from '@/components/ui/badge';\nimport {\n  X,\n  FileText,\n  CheckSquare,\n  Square,\n  Loader2,\n  Copy,\n  Check,\n} from 'lucide-react';\nimport { useState } from 'react';\n\ninterface DocumentPreviewProps {\n  doc: { path: string; content: string } | null;\n  isLoading: boolean;\n  isOpen: boolean;\n  isSelected: boolean;\n  onClose: () => void;\n  onToggleSelect: (path: string) => void;\n}\n\nexport function DocumentPreview({\n  doc,\n  isLoading,\n  isOpen,\n  isSelected,\n  onClose,\n  onToggleSelect,\n}: DocumentPreviewProps) {\n  const [copied, setCopied] = useState(false);\n\n  if (!isOpen) return null;\n\n  const handleCopy = async () => {\n    if (doc?.content) {\n      await navigator.clipboard.writeText(doc.content);\n      setCopied(true);\n      setTimeout(() => setCopied(false), 2000);\n    }\n  };\n\n  const handleBackdropClick = (e: React.MouseEvent) => {\n    if (e.target === e.currentTarget) {\n      onClose();\n    }\n  };\n\n  return (\n    <div\n      className=\"fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4\"\n      onClick={handleBackdropClick}\n    >\n      <div className=\"bg-background rounded-lg shadow-xl w-full max-w-3xl max-h-[80vh] flex flex-col\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between p-4 border-b\">\n          <div className=\"flex items-center gap-3\">\n            <FileText className=\"h-5 w-5 text-muted-foreground\" />\n            <div>\n              <h2 className=\"font-semibold\">{doc?.path || 'Loading...'}</h2>\n              {doc && (\n                <p className=\"text-xs text-muted-foreground\">\n                  {(doc.content.length / 1024).toFixed(1)} KB\n                </p>\n              )}\n            </div>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            {doc && (\n              <>\n                <Button\n                  variant=\"outline\"\n                  size=\"sm\"\n                  onClick={handleCopy}\n                  className=\"gap-2\"\n                >\n                  {copied ? (\n                    <Check className=\"h-4 w-4\" />\n                  ) : (\n                    <Copy className=\"h-4 w-4\" />\n                  )}\n                  {copied ? 'Copied!' : 'Copy'}\n                </Button>\n                <Button\n                  variant={isSelected ? 'default' : 'outline'}\n                  size=\"sm\"\n                  onClick={() => onToggleSelect(doc.path)}\n                  className=\"gap-2\"\n                >\n                  {isSelected ? (\n                    <CheckSquare className=\"h-4 w-4\" />\n                  ) : (\n                    <Square className=\"h-4 w-4\" />\n                  )}\n                  {isSelected ? 'Selected' : 'Select'}\n                </Button>\n              </>\n            )}\n            <Button variant=\"ghost\" size=\"icon\" onClick={onClose}>\n              <X className=\"h-4 w-4\" />\n            </Button>\n          </div>\n        </div>\n\n        {/* Content */}\n        <ScrollArea className=\"flex-1 p-4\">\n          {isLoading ? (\n            <div className=\"flex items-center justify-center py-12\">\n              <Loader2 className=\"h-8 w-8 animate-spin text-muted-foreground\" />\n            </div>\n          ) : doc ? (\n            <pre className=\"text-sm font-mono whitespace-pre-wrap break-words\">\n              {doc.content}\n            </pre>\n          ) : (\n            <div className=\"text-center text-muted-foreground py-12\">\n              Failed to load document\n            </div>\n          )}\n        </ScrollArea>\n\n        {/* Footer */}\n        <div className=\"flex items-center justify-between p-4 border-t bg-muted/30\">\n          <div className=\"flex items-center gap-2\">\n            {isSelected && (\n              <Badge variant=\"success\">\n                <Check className=\"h-3 w-3 mr-1\" />\n                Selected for PRD context\n              </Badge>\n            )}\n          </div>\n          <Button variant=\"outline\" onClick={onClose}>\n            Close\n          </Button>\n        </div>\n      </div>\n    </div>\n  );\n}\n","numLines":141,"startLine":1,"totalLines":141}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Pse4yEmcbM5gP6pCz1TTHN","type":"tool_result","content":"     1→import { useEffect, useRef, useState, useCallback } from 'react';\n     2→import type { ServerMessage, ClientCommand, LoopStatus, TasksState, GitStatus, LogEntry, ProjectConfig, PlanGeneratorStatus, PRDGeneratorStatus, ProjectScan, AgentInfo, CursorRuleInfo, ProjectInfo, ClaudeMdFile, DependencyCheckResult, RepoAgentInfo } from '@/types';\n     3→\n     4→interface UseWebSocketReturn {\n     5→  connected: boolean;\n     6→  loopStatus: LoopStatus;\n     7→  tasks: TasksState;\n     8→  gitStatus: GitStatus;\n     9→  logs: LogEntry[];\n    10→  projectConfig: ProjectConfig | null;\n    11→  enabledAgents: string[];\n    12→  // Plan generation state\n    13→  planStatus: PlanGeneratorStatus;\n    14→  planOutput: string;\n    15→  planComplete: { plan: string; output: string } | null;\n    16→  planError: string | null;\n    17→  // PRD generation state\n    18→  prdStatus: PRDGeneratorStatus;\n    19→  prdOutput: string;\n    20→  prdComplete: { prd: string; audience: string } | null;\n    21→  prdError: string | null;\n    22→  // Project scanning state\n    23→  projectScan: ProjectScan | null;\n    24→  scanLoading: boolean;\n    25→  // Project info (from server)\n    26→  projectInfo: ProjectInfo | null;\n    27→  // Agent and rules state\n    28→  availableAgents: AgentInfo[];\n    29→  cursorRules: CursorRuleInfo[];\n    30→  agentsLoading: boolean;\n    31→  rulesLoading: boolean;\n    32→  // Document selection state (for PRD context)\n    33→  selectedDocPaths: string[];\n    34→  previewDoc: { path: string; content: string } | null;\n    35→  isLoadingPreview: boolean;\n    36→  // CLAUDE.md state\n    37→  claudeMdFiles: ClaudeMdFile[];\n    38→  claudeMdContent: { path: string; content: string } | null;\n    39→  claudeMdLoading: boolean;\n    40→  claudeMdApplying: boolean;\n    41→  // Dependency check state\n    42→  dependencyStatus: DependencyCheckResult[];\n    43→  dependencyLoading: boolean;\n    44→  // Config file preview state (for ExistingDocsViewer)\n    45→  configPreviewDoc: { file: string; content: string } | null;\n    46→  configPreviewLoading: boolean;\n    47→  sendCommand: (command: ClientCommand) => void;\n    48→  clearLogs: () => void;\n    49→  clearPlanOutput: () => void;\n    50→  clearPrdOutput: () => void;\n    51→  scanProject: () => void;\n    52→  listAgents: () => void;\n    53→  listRules: () => void;\n    54→  // Document selection handlers\n    55→  setSelectedDocPaths: (paths: string[]) => void;\n    56→  readDoc: (docPath: string) => void;\n    57→  closeDocPreview: () => void;\n    58→  // CLAUDE.md handlers\n    59→  listClaudeMdFiles: () => void;\n    60→  readClaudeMdFile: (filePath: string) => void;\n    61→  applyRalphClaudeMd: () => void;\n    62→  closeClaudeMdPreview: () => void;\n    63→  // Dependency check handler\n    64→  checkDependencies: () => void;\n    65→  // Config file preview handlers\n    66→  readConfigFile: (filename: string) => void;\n    67→  closeConfigPreview: () => void;\n    68→  // Repo agent installation state\n    69→  repoAgents: RepoAgentInfo[];\n    70→  repoAgentsLoading: boolean;\n    71→  agentInstalling: string | null;\n    72→  // Repo agent installation handlers\n    73→  listRepoAgents: () => void;\n    74→  installAgentGlobal: (agentId: string) => void;\n    75→  installAgentProject: (agentId: string) => void;\n    76→  installAllAgentsGlobal: () => void;\n    77→}\n    78→\n    79→const DEFAULT_LOOP_STATUS: LoopStatus = {\n    80→  running: false,\n    81→  mode: null,\n    82→  iteration: 0,\n    83→  maxIterations: 0,\n    84→};\n    85→\n    86→const DEFAULT_TASKS: TasksState = {\n    87→  tasks: [],\n    88→  completed: 0,\n    89→  total: 0,\n    90→};\n    91→\n    92→const DEFAULT_GIT_STATUS: GitStatus = {\n    93→  branch: 'main',\n    94→  uncommittedCount: 0,\n    95→  commits: [],\n    96→};\n    97→\n    98→const DEFAULT_ENABLED_AGENTS = ['react-typescript-expert', 'accessibility-expert', 'qol-ux-expert'];\n    99→\n   100→const DEFAULT_PLAN_STATUS: PlanGeneratorStatus = {\n   101→  generating: false,\n   102→  mode: null,\n   103→  startedAt: null,\n   104→};\n   105→\n   106→const DEFAULT_PRD_STATUS: PRDGeneratorStatus = {\n   107→  generating: false,\n   108→  startedAt: null,\n   109→};\n   110→\n   111→// Allow WebSocket port to be configured via environment variable for multi-instance support\n   112→const DEFAULT_WS_PORT = import.meta.env.VITE_WS_PORT || '3001';\n   113→\n   114→export function useWebSocket(url: string = `ws://localhost:${DEFAULT_WS_PORT}/ws`): UseWebSocketReturn {\n   115→  const [connected, setConnected] = useState(false);\n   116→  const [loopStatus, setLoopStatus] = useState<LoopStatus>(DEFAULT_LOOP_STATUS);\n   117→  const [tasks, setTasks] = useState<TasksState>(DEFAULT_TASKS);\n   118→  const [gitStatus, setGitStatus] = useState<GitStatus>(DEFAULT_GIT_STATUS);\n   119→  const [logs, setLogs] = useState<LogEntry[]>([]);\n   120→  const [projectConfig, setProjectConfig] = useState<ProjectConfig | null>(null);\n   121→  const [enabledAgents, setEnabledAgents] = useState<string[]>(DEFAULT_ENABLED_AGENTS);\n   122→  // Plan generation state\n   123→  const [planStatus, setPlanStatus] = useState<PlanGeneratorStatus>(DEFAULT_PLAN_STATUS);\n   124→  const [planOutput, setPlanOutput] = useState('');\n   125→  const [planComplete, setPlanComplete] = useState<{ plan: string; output: string } | null>(null);\n   126→  const [planError, setPlanError] = useState<string | null>(null);\n   127→  // PRD generation state\n   128→  const [prdStatus, setPrdStatus] = useState<PRDGeneratorStatus>(DEFAULT_PRD_STATUS);\n   129→  const [prdOutput, setPrdOutput] = useState('');\n   130→  const [prdComplete, setPrdComplete] = useState<{ prd: string; audience: string } | null>(null);\n   131→  const [prdError, setPrdError] = useState<string | null>(null);\n   132→  // Project scanning state\n   133→  const [projectScan, setProjectScan] = useState<ProjectScan | null>(null);\n   134→  const [scanLoading, setScanLoading] = useState(false);\n   135→  // Project info (from server)\n   136→  const [projectInfo, setProjectInfo] = useState<ProjectInfo | null>(null);\n   137→  // Agent and rules state\n   138→  const [availableAgents, setAvailableAgents] = useState<AgentInfo[]>([]);\n   139→  const [cursorRules, setCursorRules] = useState<CursorRuleInfo[]>([]);\n   140→  const [agentsLoading, setAgentsLoading] = useState(false);\n   141→  const [rulesLoading, setRulesLoading] = useState(false);\n   142→  // Document selection state (for PRD context)\n   143→  const [selectedDocPaths, setSelectedDocPaths] = useState<string[]>([]);\n   144→  const [previewDoc, setPreviewDoc] = useState<{ path: string; content: string } | null>(null);\n   145→  const [isLoadingPreview, setIsLoadingPreview] = useState(false);\n   146→  // CLAUDE.md state\n   147→  const [claudeMdFiles, setClaudeMdFiles] = useState<ClaudeMdFile[]>([]);\n   148→  const [claudeMdContent, setClaudeMdContent] = useState<{ path: string; content: string } | null>(null);\n   149→  const [claudeMdLoading, setClaudeMdLoading] = useState(false);\n   150→  const [claudeMdApplying, setClaudeMdApplying] = useState(false);\n   151→  // Dependency check state\n   152→  const [dependencyStatus, setDependencyStatus] = useState<DependencyCheckResult[]>([]);\n   153→  const [dependencyLoading, setDependencyLoading] = useState(false);\n   154→  // Config file preview state (for ExistingDocsViewer)\n   155→  const [configPreviewDoc, setConfigPreviewDoc] = useState<{ file: string; content: string } | null>(null);\n   156→  const [configPreviewLoading, setConfigPreviewLoading] = useState(false);\n   157→  // Repo agent installation state\n   158→  const [repoAgents, setRepoAgents] = useState<RepoAgentInfo[]>([]);\n   159→  const [repoAgentsLoading, setRepoAgentsLoading] = useState(false);\n   160→  const [agentInstalling, setAgentInstalling] = useState<string | null>(null);\n   161→\n   162→  const wsRef = useRef<WebSocket | null>(null);\n   163→  const reconnectTimeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null);\n   164→  const isCleaningUpRef = useRef(false);\n   165→\n   166→  const connect = useCallback(() => {\n   167→    if (isCleaningUpRef.current) {\n   168→      return;\n   169→    }\n   170→    \n   171→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   172→      return;\n   173→    }\n   174→\n   175→    // Close existing connection if it exists\n   176→    if (wsRef.current) {\n   177→      wsRef.current.close();\n   178→    }\n   179→\n   180→    const ws = new WebSocket(url);\n   181→\n   182→    ws.onopen = () => {\n   183→      if (!isCleaningUpRef.current) {\n   184→        setConnected(true);\n   185→        if (reconnectTimeoutRef.current) {\n   186→          clearTimeout(reconnectTimeoutRef.current);\n   187→          reconnectTimeoutRef.current = null;\n   188→        }\n   189→      }\n   190→    };\n   191→\n   192→    ws.onclose = () => {\n   193→      if (!isCleaningUpRef.current) {\n   194→        setConnected(false);\n   195→        // Attempt to reconnect after 2 seconds\n   196→        reconnectTimeoutRef.current = setTimeout(() => {\n   197→          if (!isCleaningUpRef.current) {\n   198→            connect();\n   199→          }\n   200→        }, 2000);\n   201→      }\n   202→    };\n   203→\n   204→    ws.onerror = (error) => {\n   205→      // Only log errors if not cleaning up (React StrictMode causes intentional errors)\n   206→      if (!isCleaningUpRef.current && ws.readyState !== WebSocket.CLOSING && ws.readyState !== WebSocket.CLOSED) {\n   207→        console.error('WebSocket error:', error);\n   208→      }\n   209→      if (!isCleaningUpRef.current) {\n   210→        ws.close();\n   211→      }\n   212→    };\n   213→\n   214→    ws.onmessage = (event) => {\n   215→      try {\n   216→        const message: ServerMessage = JSON.parse(event.data);\n   217→\n   218→        switch (message.type) {\n   219→          case 'loop:status':\n   220→            setLoopStatus(message.payload);\n   221→            break;\n   222→          case 'loop:log':\n   223→            setLogs((prev) => [...prev.slice(-500), message.payload]); // Keep last 500 logs\n   224→            break;\n   225→          case 'tasks:update':\n   226→            setTasks(message.payload);\n   227→            break;\n   228→          case 'git:update':\n   229→            setGitStatus(message.payload);\n   230→            break;\n   231→          case 'config:update':\n   232→            setProjectConfig(message.payload);\n   233→            if (message.payload.enabledAgents) {\n   234→              setEnabledAgents(message.payload.enabledAgents);\n   235→            }\n   236→            break;\n   237→          case 'config:saved':\n   238→            // File was saved successfully - could track this for UI feedback\n   239→            console.log('File saved:', message.payload.file);\n   240→            break;\n   241→          case 'agents:update':\n   242→            setEnabledAgents(message.payload.enabledAgents);\n   243→            break;\n   244→          // Plan generation messages\n   245→          case 'plan:status':\n   246→            setPlanStatus(message.payload);\n   247→            if (message.payload.generating) {\n   248→              // Clear previous results when starting new generation\n   249→              setPlanOutput('');\n   250→              setPlanComplete(null);\n   251→              setPlanError(null);\n   252→            }\n   253→            break;\n   254→          case 'plan:output':\n   255→            setPlanOutput((prev) => prev + message.payload.text);\n   256→            break;\n   257→          case 'plan:log':\n   258→            // Could add to a separate log stream if needed\n   259→            break;\n   260→          case 'plan:complete':\n   261→            setPlanComplete(message.payload);\n   262→            break;\n   263→          case 'plan:error':\n   264→            setPlanError(message.payload.error);\n   265→            break;\n   266→          // PRD generation messages\n   267→          case 'prd:status':\n   268→            setPrdStatus(message.payload);\n   269→            if (message.payload.generating) {\n   270→              // Clear previous results when starting new generation\n   271→              setPrdOutput('');\n   272→              setPrdComplete(null);\n   273→              setPrdError(null);\n   274→            }\n   275→            break;\n   276→          case 'prd:output':\n   277→            setPrdOutput((prev) => prev + message.payload.text);\n   278→            break;\n   279→          case 'prd:complete':\n   280→            setPrdComplete(message.payload);\n   281→            break;\n   282→          case 'prd:error':\n   283→            setPrdError(message.payload.error);\n   284→            break;\n   285→          // Project scanning messages\n   286→          case 'project:scan-result':\n   287→            setProjectScan(message.payload);\n   288→            setScanLoading(false);\n   289→            break;\n   290→          case 'project:info':\n   291→            setProjectInfo(message.payload);\n   292→            break;\n   293→          // Agent and rules messages\n   294→          case 'agents:list-result':\n   295→            setAvailableAgents(message.payload);\n   296→            setAgentsLoading(false);\n   297→            break;\n   298→          case 'rules:list-result':\n   299→          case 'rules:update':\n   300→            setCursorRules(message.payload);\n   301→            setRulesLoading(false);\n   302→            break;\n   303→          // Document preview messages\n   304→          case 'docs:content':\n   305→            setPreviewDoc({\n   306→              path: message.payload.path,\n   307→              content: message.payload.content,\n   308→            });\n   309→            setIsLoadingPreview(false);\n   310→            break;\n   311→          case 'docs:error':\n   312→            console.error('Doc read error:', message.payload.error);\n   313→            setIsLoadingPreview(false);\n   314→            break;\n   315→          // CLAUDE.md messages\n   316→          case 'claude:list-result':\n   317→            setClaudeMdFiles(message.payload);\n   318→            setClaudeMdLoading(false);\n   319→            break;\n   320→          case 'claude:content':\n   321→            setClaudeMdContent({\n   322→              path: message.payload.path,\n   323→              content: message.payload.content,\n   324→            });\n   325→            setClaudeMdLoading(false);\n   326→            break;\n   327→          case 'claude:applied':\n   328→            setClaudeMdApplying(false);\n   329→            break;\n   330→          case 'claude:error':\n   331→            console.error('CLAUDE.md error:', message.payload.error);\n   332→            setClaudeMdLoading(false);\n   333→            setClaudeMdApplying(false);\n   334→            break;\n   335→          // Dependency check messages\n   336→          case 'dependencies:result':\n   337→            setDependencyStatus(message.payload);\n   338→            setDependencyLoading(false);\n   339→            break;\n   340→          case 'dependencies:error':\n   341→            console.error('Dependency check error:', message.payload.error);\n   342→            setDependencyLoading(false);\n   343→            break;\n   344→          // Config file preview messages (for ExistingDocsViewer)\n   345→          case 'config:content':\n   346→            setConfigPreviewDoc({\n   347→              file: message.payload.file,\n   348→              content: message.payload.content,\n   349→            });\n   350→            setConfigPreviewLoading(false);\n   351→            break;\n   352→          // Repo agent messages\n   353→          case 'agents:repo-result':\n   354→            setRepoAgents(message.payload);\n   355→            setRepoAgentsLoading(false);\n   356→            break;\n   357→          case 'agents:installed':\n   358→            setAgentInstalling(null);\n   359→            break;\n   360→          case 'agents:error':\n   361→            console.error('Agent error:', message.payload.error);\n   362→            setAgentInstalling(null);\n   363→            setRepoAgentsLoading(false);\n   364→            break;\n   365→        }\n   366→      } catch {\n   367→        console.error('Failed to parse WebSocket message');\n   368→      }\n   369→    };\n   370→\n   371→    wsRef.current = ws;\n   372→  }, [url]);\n   373→\n   374→  useEffect(() => {\n   375→    isCleaningUpRef.current = false;\n   376→    connect();\n   377→\n   378→    return () => {\n   379→      isCleaningUpRef.current = true;\n   380→      if (reconnectTimeoutRef.current) {\n   381→        clearTimeout(reconnectTimeoutRef.current);\n   382→        reconnectTimeoutRef.current = null;\n   383→      }\n   384→      if (wsRef.current) {\n   385→        // Remove event listeners to prevent errors during cleanup\n   386→        wsRef.current.onerror = null;\n   387→        wsRef.current.onclose = null;\n   388→        wsRef.current.close();\n   389→        wsRef.current = null;\n   390→      }\n   391→    };\n   392→  }, [connect]);\n   393→\n   394→  const sendCommand = useCallback((command: ClientCommand) => {\n   395→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   396→      wsRef.current.send(JSON.stringify(command));\n   397→    }\n   398→  }, []);\n   399→\n   400→  const clearLogs = useCallback(() => {\n   401→    setLogs([]);\n   402→  }, []);\n   403→\n   404→  const clearPlanOutput = useCallback(() => {\n   405→    setPlanOutput('');\n   406→    setPlanComplete(null);\n   407→    setPlanError(null);\n   408→  }, []);\n   409→\n   410→  const clearPrdOutput = useCallback(() => {\n   411→    setPrdOutput('');\n   412→    setPrdComplete(null);\n   413→    setPrdError(null);\n   414→  }, []);\n   415→\n   416→  const scanProject = useCallback(() => {\n   417→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   418→      setScanLoading(true);\n   419→      wsRef.current.send(JSON.stringify({ type: 'project:scan' }));\n   420→    }\n   421→  }, []);\n   422→\n   423→  const listAgents = useCallback(() => {\n   424→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   425→      setAgentsLoading(true);\n   426→      wsRef.current.send(JSON.stringify({ type: 'agents:list' }));\n   427→    }\n   428→  }, []);\n   429→\n   430→  const listRules = useCallback(() => {\n   431→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   432→      setRulesLoading(true);\n   433→      wsRef.current.send(JSON.stringify({ type: 'rules:list' }));\n   434→    }\n   435→  }, []);\n   436→\n   437→  const readDoc = useCallback((docPath: string) => {\n   438→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   439→      setIsLoadingPreview(true);\n   440→      setPreviewDoc(null);\n   441→      wsRef.current.send(JSON.stringify({ type: 'docs:read', payload: { docPath } }));\n   442→    }\n   443→  }, []);\n   444→\n   445→  const closeDocPreview = useCallback(() => {\n   446→    setPreviewDoc(null);\n   447→    setIsLoadingPreview(false);\n   448→  }, []);\n   449→\n   450→  const listClaudeMdFiles = useCallback(() => {\n   451→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   452→      setClaudeMdLoading(true);\n   453→      wsRef.current.send(JSON.stringify({ type: 'claude:list' }));\n   454→    }\n   455→  }, []);\n   456→\n   457→  const readClaudeMdFile = useCallback((filePath: string) => {\n   458→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   459→      setClaudeMdLoading(true);\n   460→      setClaudeMdContent(null);\n   461→      wsRef.current.send(JSON.stringify({ type: 'claude:read', payload: { path: filePath } }));\n   462→    }\n   463→  }, []);\n   464→\n   465→  const applyRalphClaudeMd = useCallback(() => {\n   466→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   467→      setClaudeMdApplying(true);\n   468→      wsRef.current.send(JSON.stringify({ type: 'claude:apply' }));\n   469→    }\n   470→  }, []);\n   471→\n   472→  const closeClaudeMdPreview = useCallback(() => {\n   473→    setClaudeMdContent(null);\n   474→    setClaudeMdLoading(false);\n   475→  }, []);\n   476→\n   477→  const checkDependencies = useCallback(() => {\n   478→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   479→      setDependencyLoading(true);\n   480→      wsRef.current.send(JSON.stringify({ type: 'dependencies:check' }));\n   481→    }\n   482→  }, []);\n   483→\n   484→  const readConfigFile = useCallback((filename: string) => {\n   485→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   486→      setConfigPreviewLoading(true);\n   487→      setConfigPreviewDoc(null);\n   488→      wsRef.current.send(JSON.stringify({ type: 'config:read', payload: { file: filename } }));\n   489→    }\n   490→  }, []);\n   491→\n   492→  const closeConfigPreview = useCallback(() => {\n   493→    setConfigPreviewDoc(null);\n   494→    setConfigPreviewLoading(false);\n   495→  }, []);\n   496→\n   497→  // Repo agent installation callbacks\n   498→  const listRepoAgents = useCallback(() => {\n   499→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   500→      setRepoAgentsLoading(true);\n   501→      wsRef.current.send(JSON.stringify({ type: 'agents:list-repo' }));\n   502→    }\n   503→  }, []);\n   504→\n   505→  const installAgentGlobal = useCallback((agentId: string) => {\n   506→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   507→      setAgentInstalling(agentId);\n   508→      wsRef.current.send(JSON.stringify({ type: 'agents:install-global', payload: { agentId } }));\n   509→    }\n   510→  }, []);\n   511→\n   512→  const installAgentProject = useCallback((agentId: string) => {\n   513→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   514→      setAgentInstalling(agentId);\n   515→      wsRef.current.send(JSON.stringify({ type: 'agents:install-project', payload: { agentId } }));\n   516→    }\n   517→  }, []);\n   518→\n   519→  const installAllAgentsGlobal = useCallback(() => {\n   520→    if (wsRef.current?.readyState === WebSocket.OPEN) {\n   521→      setAgentInstalling('all');\n   522→      wsRef.current.send(JSON.stringify({ type: 'agents:install-all-global' }));\n   523→    }\n   524→  }, []);\n   525→\n   526→  return {\n   527→    connected,\n   528→    loopStatus,\n   529→    tasks,\n   530→    gitStatus,\n   531→    logs,\n   532→    projectConfig,\n   533→    enabledAgents,\n   534→    planStatus,\n   535→    planOutput,\n   536→    planComplete,\n   537→    planError,\n   538→    prdStatus,\n   539→    prdOutput,\n   540→    prdComplete,\n   541→    prdError,\n   542→    projectScan,\n   543→    scanLoading,\n   544→    projectInfo,\n   545→    availableAgents,\n   546→    cursorRules,\n   547→    agentsLoading,\n   548→    rulesLoading,\n   549→    selectedDocPaths,\n   550→    previewDoc,\n   551→    isLoadingPreview,\n   552→    sendCommand,\n   553→    clearLogs,\n   554→    clearPlanOutput,\n   555→    clearPrdOutput,\n   556→    scanProject,\n   557→    listAgents,\n   558→    listRules,\n   559→    setSelectedDocPaths,\n   560→    readDoc,\n   561→    closeDocPreview,\n   562→    // CLAUDE.md\n   563→    claudeMdFiles,\n   564→    claudeMdContent,\n   565→    claudeMdLoading,\n   566→    claudeMdApplying,\n   567→    listClaudeMdFiles,\n   568→    readClaudeMdFile,\n   569→    applyRalphClaudeMd,\n   570→    closeClaudeMdPreview,\n   571→    // Dependencies\n   572→    dependencyStatus,\n   573→    dependencyLoading,\n   574→    checkDependencies,\n   575→    // Config file preview (for ExistingDocsViewer)\n   576→    configPreviewDoc,\n   577→    configPreviewLoading,\n   578→    readConfigFile,\n   579→    closeConfigPreview,\n   580→    // Repo agent installation\n   581→    repoAgents,\n   582→    repoAgentsLoading,\n   583→    agentInstalling,\n   584→    listRepoAgents,\n   585→    installAgentGlobal,\n   586→    installAgentProject,\n   587→    installAllAgentsGlobal,\n   588→  };\n   589→}\n   590→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01XaPGNU3AB8Yu6pHDpw2dPP","session_id":"6d9df9ce-f430-4def-aa62-de4fb0297909","uuid":"913737e4-7843-4a47-a658-38ce3c39ade8","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\xsams\\RalphWiggumV3\\RalphWiggumV2\\dashboard\\src\\hooks\\useWebSocket.ts","content":"import { useEffect, useRef, useState, useCallback } from 'react';\nimport type { ServerMessage, ClientCommand, LoopStatus, TasksState, GitStatus, LogEntry, ProjectConfig, PlanGeneratorStatus, PRDGeneratorStatus, ProjectScan, AgentInfo, CursorRuleInfo, ProjectInfo, ClaudeMdFile, DependencyCheckResult, RepoAgentInfo } from '@/types';\n\ninterface UseWebSocketReturn {\n  connected: boolean;\n  loopStatus: LoopStatus;\n  tasks: TasksState;\n  gitStatus: GitStatus;\n  logs: LogEntry[];\n  projectConfig: ProjectConfig | null;\n  enabledAgents: string[];\n  // Plan generation state\n  planStatus: PlanGeneratorStatus;\n  planOutput: string;\n  planComplete: { plan: string; output: string } | null;\n  planError: string | null;\n  // PRD generation state\n  prdStatus: PRDGeneratorStatus;\n  prdOutput: string;\n  prdComplete: { prd: string; audience: string } | null;\n  prdError: string | null;\n  // Project scanning state\n  projectScan: ProjectScan | null;\n  scanLoading: boolean;\n  // Project info (from server)\n  projectInfo: ProjectInfo | null;\n  // Agent and rules state\n  availableAgents: AgentInfo[];\n  cursorRules: CursorRuleInfo[];\n  agentsLoading: boolean;\n  rulesLoading: boolean;\n  // Document selection state (for PRD context)\n  selectedDocPaths: string[];\n  previewDoc: { path: string; content: string } | null;\n  isLoadingPreview: boolean;\n  // CLAUDE.md state\n  claudeMdFiles: ClaudeMdFile[];\n  claudeMdContent: { path: string; content: string } | null;\n  claudeMdLoading: boolean;\n  claudeMdApplying: boolean;\n  // Dependency check state\n  dependencyStatus: DependencyCheckResult[];\n  dependencyLoading: boolean;\n  // Config file preview state (for ExistingDocsViewer)\n  configPreviewDoc: { file: string; content: string } | null;\n  configPreviewLoading: boolean;\n  sendCommand: (command: ClientCommand) => void;\n  clearLogs: () => void;\n  clearPlanOutput: () => void;\n  clearPrdOutput: () => void;\n  scanProject: () => void;\n  listAgents: () => void;\n  listRules: () => void;\n  // Document selection handlers\n  setSelectedDocPaths: (paths: string[]) => void;\n  readDoc: (docPath: string) => void;\n  closeDocPreview: () => void;\n  // CLAUDE.md handlers\n  listClaudeMdFiles: () => void;\n  readClaudeMdFile: (filePath: string) => void;\n  applyRalphClaudeMd: () => void;\n  closeClaudeMdPreview: () => void;\n  // Dependency check handler\n  checkDependencies: () => void;\n  // Config file preview handlers\n  readConfigFile: (filename: string) => void;\n  closeConfigPreview: () => void;\n  // Repo agent installation state\n  repoAgents: RepoAgentInfo[];\n  repoAgentsLoading: boolean;\n  agentInstalling: string | null;\n  // Repo agent installation handlers\n  listRepoAgents: () => void;\n  installAgentGlobal: (agentId: string) => void;\n  installAgentProject: (agentId: string) => void;\n  installAllAgentsGlobal: () => void;\n}\n\nconst DEFAULT_LOOP_STATUS: LoopStatus = {\n  running: false,\n  mode: null,\n  iteration: 0,\n  maxIterations: 0,\n};\n\nconst DEFAULT_TASKS: TasksState = {\n  tasks: [],\n  completed: 0,\n  total: 0,\n};\n\nconst DEFAULT_GIT_STATUS: GitStatus = {\n  branch: 'main',\n  uncommittedCount: 0,\n  commits: [],\n};\n\nconst DEFAULT_ENABLED_AGENTS = ['react-typescript-expert', 'accessibility-expert', 'qol-ux-expert'];\n\nconst DEFAULT_PLAN_STATUS: PlanGeneratorStatus = {\n  generating: false,\n  mode: null,\n  startedAt: null,\n};\n\nconst DEFAULT_PRD_STATUS: PRDGeneratorStatus = {\n  generating: false,\n  startedAt: null,\n};\n\n// Allow WebSocket port to be configured via environment variable for multi-instance support\nconst DEFAULT_WS_PORT = import.meta.env.VITE_WS_PORT || '3001';\n\nexport function useWebSocket(url: string = `ws://localhost:${DEFAULT_WS_PORT}/ws`): UseWebSocketReturn {\n  const [connected, setConnected] = useState(false);\n  const [loopStatus, setLoopStatus] = useState<LoopStatus>(DEFAULT_LOOP_STATUS);\n  const [tasks, setTasks] = useState<TasksState>(DEFAULT_TASKS);\n  const [gitStatus, setGitStatus] = useState<GitStatus>(DEFAULT_GIT_STATUS);\n  const [logs, setLogs] = useState<LogEntry[]>([]);\n  const [projectConfig, setProjectConfig] = useState<ProjectConfig | null>(null);\n  const [enabledAgents, setEnabledAgents] = useState<string[]>(DEFAULT_ENABLED_AGENTS);\n  // Plan generation state\n  const [planStatus, setPlanStatus] = useState<PlanGeneratorStatus>(DEFAULT_PLAN_STATUS);\n  const [planOutput, setPlanOutput] = useState('');\n  const [planComplete, setPlanComplete] = useState<{ plan: string; output: string } | null>(null);\n  const [planError, setPlanError] = useState<string | null>(null);\n  // PRD generation state\n  const [prdStatus, setPrdStatus] = useState<PRDGeneratorStatus>(DEFAULT_PRD_STATUS);\n  const [prdOutput, setPrdOutput] = useState('');\n  const [prdComplete, setPrdComplete] = useState<{ prd: string; audience: string } | null>(null);\n  const [prdError, setPrdError] = useState<string | null>(null);\n  // Project scanning state\n  const [projectScan, setProjectScan] = useState<ProjectScan | null>(null);\n  const [scanLoading, setScanLoading] = useState(false);\n  // Project info (from server)\n  const [projectInfo, setProjectInfo] = useState<ProjectInfo | null>(null);\n  // Agent and rules state\n  const [availableAgents, setAvailableAgents] = useState<AgentInfo[]>([]);\n  const [cursorRules, setCursorRules] = useState<CursorRuleInfo[]>([]);\n  const [agentsLoading, setAgentsLoading] = useState(false);\n  const [rulesLoading, setRulesLoading] = useState(false);\n  // Document selection state (for PRD context)\n  const [selectedDocPaths, setSelectedDocPaths] = useState<string[]>([]);\n  const [previewDoc, setPreviewDoc] = useState<{ path: string; content: string } | null>(null);\n  const [isLoadingPreview, setIsLoadingPreview] = useState(false);\n  // CLAUDE.md state\n  const [claudeMdFiles, setClaudeMdFiles] = useState<ClaudeMdFile[]>([]);\n  const [claudeMdContent, setClaudeMdContent] = useState<{ path: string; content: string } | null>(null);\n  const [claudeMdLoading, setClaudeMdLoading] = useState(false);\n  const [claudeMdApplying, setClaudeMdApplying] = useState(false);\n  // Dependency check state\n  const [dependencyStatus, setDependencyStatus] = useState<DependencyCheckResult[]>([]);\n  const [dependencyLoading, setDependencyLoading] = useState(false);\n  // Config file preview state (for ExistingDocsViewer)\n  const [configPreviewDoc, setConfigPreviewDoc] = useState<{ file: string; content: string } | null>(null);\n  const [configPreviewLoading, setConfigPreviewLoading] = useState(false);\n  // Repo agent installation state\n  const [repoAgents, setRepoAgents] = useState<RepoAgentInfo[]>([]);\n  const [repoAgentsLoading, setRepoAgentsLoading] = useState(false);\n  const [agentInstalling, setAgentInstalling] = useState<string | null>(null);\n\n  const wsRef = useRef<WebSocket | null>(null);\n  const reconnectTimeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null);\n  const isCleaningUpRef = useRef(false);\n\n  const connect = useCallback(() => {\n    if (isCleaningUpRef.current) {\n      return;\n    }\n    \n    if (wsRef.current?.readyState === WebSocket.OPEN) {\n      return;\n    }\n\n    // Close existing connection if it exists\n    if (wsRef.current) {\n      wsRef.current.close();\n    }\n\n    const ws = new WebSocket(url);\n\n    ws.onopen = () => {\n      if (!isCleaningUpRef.current) {\n        setConnected(true);\n        if (reconnectTimeoutRef.current) {\n          clearTimeout(reconnectTimeoutRef.current);\n          reconnectTimeoutRef.current = null;\n        }\n      }\n    };\n\n    ws.onclose = () => {\n      if (!isCleaningUpRef.current) {\n        setConnected(false);\n        // Attempt to reconnect after 2 seconds\n        reconnectTimeoutRef.current = setTimeout(() => {\n          if (!isCleaningUpRef.current) {\n            connect();\n          }\n        }, 2000);\n      }\n    };\n\n    ws.onerror = (error) => {\n      // Only log errors if not cleaning up (React StrictMode causes intentional errors)\n      if (!isCleaningUpRef.current && ws.readyState !== WebSocket.CLOSING && ws.readyState !== WebSocket.CLOSED) {\n        console.error('WebSocket error:', error);\n      }\n      if (!isCleaningUpRef.current) {\n        ws.close();\n      }\n    };\n\n    ws.onmessage = (event) => {\n      try {\n        const message: ServerMessage = JSON.parse(event.data);\n\n        switch (message.type) {\n          case 'loop:status':\n            setLoopStatus(message.payload);\n            break;\n          case 'loop:log':\n            setLogs((prev) => [...prev.slice(-500), message.payload]); // Keep last 500 logs\n            break;\n          case 'tasks:update':\n            setTasks(message.payload);\n            break;\n          case 'git:update':\n            setGitStatus(message.payload);\n            break;\n          case 'config:update':\n            setProjectConfig(message.payload);\n            if (message.payload.enabledAgents) {\n              setEnabledAgents(message.payload.enabledAgents);\n            }\n            break;\n          case 'config:saved':\n            // File was saved successfully - could track this for UI feedback\n            console.log('File saved:', message.payload.file);\n            break;\n          case 'agents:update':\n            setEnabledAgents(message.payload.enabledAgents);\n            break;\n          // Plan generation messages\n          case 'plan:status':\n            setPlanStatus(message.payload);\n            if (message.payload.generating) {\n              // Clear previous results when starting new generation\n              setPlanOutput('');\n              setPlanComplete(null);\n              setPlanError(null);\n            }\n            break;\n          case 'plan:output':\n            setPlanOutput((prev) => prev + message.payload.text);\n            break;\n          case 'plan:log':\n            // Could add to a separate log stream if needed\n            break;\n          case 'plan:complete':\n            setPlanComplete(message.payload);\n            break;\n          case 'plan:error':\n            setPlanError(message.payload.error);\n            break;\n          // PRD generation messages\n          case 'prd:status':\n            setPrdStatus(message.payload);\n            if (message.payload.generating) {\n              // Clear previous results when starting new generation\n              setPrdOutput('');\n              setPrdComplete(null);\n              setPrdError(null);\n            }\n            break;\n          case 'prd:output':\n            setPrdOutput((prev) => prev + message.payload.text);\n            break;\n          case 'prd:complete':\n            setPrdComplete(message.payload);\n            break;\n          case 'prd:error':\n            setPrdError(message.payload.error);\n            break;\n          // Project scanning messages\n          case 'project:scan-result':\n            setProjectScan(message.payload);\n            setScanLoading(false);\n            break;\n          case 'project:info':\n            setProjectInfo(message.payload);\n            break;\n          // Agent and rules messages\n          case 'agents:list-result':\n            setAvailableAgents(message.payload);\n            setAgentsLoading(false);\n            break;\n          case 'rules:list-result':\n          case 'rules:update':\n            setCursorRules(message.payload);\n            setRulesLoading(false);\n            break;\n          // Document preview messages\n          case 'docs:content':\n            setPreviewDoc({\n              path: message.payload.path,\n              content: message.payload.content,\n            });\n            setIsLoadingPreview(false);\n            break;\n          case 'docs:error':\n            console.error('Doc read error:', message.payload.error);\n            setIsLoadingPreview(false);\n            break;\n          // CLAUDE.md messages\n          case 'claude:list-result':\n            setClaudeMdFiles(message.payload);\n            setClaudeMdLoading(false);\n            break;\n          case 'claude:content':\n            setClaudeMdContent({\n              path: message.payload.path,\n              content: message.payload.content,\n            });\n            setClaudeMdLoading(false);\n            break;\n          case 'claude:applied':\n            setClaudeMdApplying(false);\n            break;\n          case 'claude:error':\n            console.error('CLAUDE.md error:', message.payload.error);\n            setClaudeMdLoading(false);\n            setClaudeMdApplying(false);\n            break;\n          // Dependency check messages\n          case 'dependencies:result':\n            setDependencyStatus(message.payload);\n            setDependencyLoading(false);\n            break;\n          case 'dependencies:error':\n            console.error('Dependency check error:', message.payload.error);\n            setDependencyLoading(false);\n            break;\n          // Config file preview messages (for ExistingDocsViewer)\n          case 'config:content':\n            setConfigPreviewDoc({\n              file: message.payload.file,\n              content: message.payload.content,\n            });\n            setConfigPreviewLoading(false);\n            break;\n          // Repo agent messages\n          case 'agents:repo-result':\n            setRepoAgents(message.payload);\n            setRepoAgentsLoading(false);\n            break;\n          case 'agents:installed':\n            setAgentInstalling(null);\n            break;\n          case 'agents:error':\n            console.error('Agent error:', message.payload.error);\n            setAgentInstalling(null);\n            setRepoAgentsLoading(false);\n            break;\n        }\n      } catch {\n        console.error('Failed to parse WebSocket message');\n      }\n    };\n\n    wsRef.current = ws;\n  }, [url]);\n\n  useEffect(() => {\n    isCleaningUpRef.current = false;\n    connect();\n\n    return () => {\n      isCleaningUpRef.current = true;\n      if (reconnectTimeoutRef.current) {\n        clearTimeout(reconnectTimeoutRef.current);\n        reconnectTimeoutRef.current = null;\n      }\n      if (wsRef.current) {\n        // Remove event listeners to prevent errors during cleanup\n        wsRef.current.onerror = null;\n        wsRef.current.onclose = null;\n        wsRef.current.close();\n        wsRef.current = null;\n      }\n    };\n  }, [connect]);\n\n  const sendCommand = useCallback((command: ClientCommand) => {\n    if (wsRef.current?.readyState === WebSocket.OPEN) {\n      wsRef.current.send(JSON.stringify(command));\n    }\n  }, []);\n\n  const clearLogs = useCallback(() => {\n    setLogs([]);\n  }, []);\n\n  const clearPlanOutput = useCallback(() => {\n    setPlanOutput('');\n    setPlanComplete(null);\n    setPlanError(null);\n  }, []);\n\n  const clearPrdOutput = use