{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X7DYMYmAtwJJUxBbPSVmcS","type":"tool_result","content":"     1→import { useState, useEffect } from 'react';\n     2→import { useWebSocket } from '@/hooks/useWebSocket';\n     3→import { LoopStatus } from './LoopStatus';\n     4→import { TaskList } from './TaskList';\n     5→import { LogViewer } from './LogViewer';\n     6→import { ContextMeter } from './ContextMeter';\n     7→import { GitHistory } from './GitHistory';\n     8→import { LoopControls } from './LoopControls';\n     9→import { SetupWizard } from './setup/SetupWizard';\n    10→import { OnboardingWizard } from './setup/OnboardingWizard';\n    11→import { PlanGenerator } from './PlanGenerator';\n    12→import { PRDGenerator } from './PRDGenerator';\n    13→import { ReviewGenerator } from './ReviewGenerator';\n    14→import { ExistingDocsViewer } from './ExistingDocsViewer';\n    15→import { WorkflowModeToggle } from './WorkflowModeToggle';\n    16→import { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';\n    17→import { Badge } from '@/components/ui/badge';\n    18→import {\n    19→  LayoutDashboard,\n    20→  Settings,\n    21→  Terminal,\n    22→  Wifi,\n    23→  WifiOff,\n    24→  Wand2,\n    25→  FileText,\n    26→  ListTodo,\n    27→  Github,\n    28→  FileSearch,\n    29→  Home,\n    30→} from 'lucide-react';\n    31→import { Button } from '@/components/ui/button';\n    32→\n    33→interface DashboardProps {\n    34→  backendPort?: number;\n    35→}\n    36→\n    37→export function Dashboard({ backendPort }: DashboardProps) {\n    38→  // Build WebSocket URL - use custom port if provided, otherwise use default\n    39→  const wsUrl = backendPort\n    40→    ? `ws://localhost:${backendPort}/ws`\n    41→    : undefined; // undefined uses the default from useWebSocket\n    42→\n    43→  const {\n    44→    connected,\n    45→    loopStatus,\n    46→    tasks,\n    47→    gitStatus,\n    48→    logs,\n    49→    projectConfig,\n    50→    enabledAgents,\n    51→    planStatus,\n    52→    planOutput,\n    53→    planComplete,\n    54→    planError,\n    55→    prdStatus,\n    56→    prdOutput,\n    57→    prdComplete,\n    58→    prdError,\n    59→    projectScan,\n    60→    scanLoading,\n    61→    projectInfo,\n    62→    availableAgents,\n    63→    cursorRules,\n    64→    agentsLoading,\n    65→    rulesLoading,\n    66→    selectedDocPaths,\n    67→    previewDoc,\n    68→    isLoadingPreview,\n    69→    claudeMdFiles,\n    70→    claudeMdContent,\n    71→    claudeMdLoading,\n    72→    claudeMdApplying,\n    73→    sendCommand,\n    74→    clearLogs,\n    75→    clearPlanOutput,\n    76→    clearPrdOutput,\n    77→    scanProject,\n    78→    listAgents,\n    79→    listRules,\n    80→    setSelectedDocPaths,\n    81→    readDoc,\n    82→    closeDocPreview,\n    83→    listClaudeMdFiles,\n    84→    readClaudeMdFile,\n    85→    applyRalphClaudeMd,\n    86→    closeClaudeMdPreview,\n    87→    dependencyStatus,\n    88→    dependencyLoading,\n    89→    checkDependencies,\n    90→    configPreviewDoc,\n    91→    configPreviewLoading,\n    92→    readConfigFile,\n    93→    closeConfigPreview,\n    94→    repoAgents,\n    95→    repoAgentsLoading,\n    96→    agentInstalling,\n    97→    listRepoAgents,\n    98→    installAgentGlobal,\n    99→    installAgentProject,\n   100→    installAllAgentsGlobal,\n   101→    // Review generator (Feature Set 14)\n   102→    reviewGeneratorStatus,\n   103→    reviewGeneratorOutput,\n   104→    reviewGeneratorComplete,\n   105→    reviewGeneratorError,\n   106→    generateReview,\n   107→    cancelReviewGenerator,\n   108→    clearReviewGeneratorOutput,\n   109→    // Workflow mode\n   110→    workflowMode,\n   111→    setWorkflowMode,\n   112→    getWorkflowMode,\n   113→  } = useWebSocket(wsUrl);\n   114→\n   115→  const [activeTab, setActiveTab] = useState('dashboard');\n   116→  const [generateSubTab, setGenerateSubTab] = useState<'plan' | 'review' | 'prd'>('plan');\n   117→  const [showOnboarding, setShowOnboarding] = useState(false);\n   118→  const [onboardingComplete, setOnboardingComplete] = useState(false);\n   119→\n   120→  // Check if we should show onboarding (AGENTS.md not configured)\n   121→  useEffect(() => {\n   122→    if (projectConfig && !onboardingComplete) {\n   123→      // Show onboarding if AGENTS.md doesn't exist or isn't configured\n   124→      const needsOnboarding = !projectConfig.hasAgentsMd;\n   125→      setShowOnboarding(needsOnboarding);\n   126→    }\n   127→  }, [projectConfig, onboardingComplete]);\n   128→\n   129→  // Get workflow mode when connected\n   130→  useEffect(() => {\n   131→    if (connected) {\n   132→      getWorkflowMode();\n   133→    }\n   134→  }, [connected, getWorkflowMode]);\n   135→\n   136→  // Trigger project scan when entering generate tab if not already scanned\n   137→  useEffect(() => {\n   138→    if (activeTab === 'generate' && !projectScan && !scanLoading && connected) {\n   139→      scanProject();\n   140→    }\n   141→  }, [activeTab, projectScan, scanLoading, connected, scanProject]);\n   142→\n   143→  const handleOnboardingComplete = () => {\n   144→    setShowOnboarding(false);\n   145→    setOnboardingComplete(true);\n   146→  };\n   147→\n   148→  const handleSaveAgentsMd = (content: string) => {\n   149→    sendCommand({ type: 'config:write', payload: { file: 'AGENTS.md', content } });\n   150→  };\n   151→\n   152→  const handleRunWizard = () => {\n   153→    setOnboardingComplete(false);\n   154→    setShowOnboarding(true);\n   155→  };\n   156→\n   157→  // Show onboarding wizard if needed\n   158→  if (showOnboarding) {\n   159→    return (\n   160→      <OnboardingWizard\n   161→        projectScan={projectScan}\n   162→        projectInfo={projectInfo}\n   163→        scanLoading={scanLoading}\n   164→        workflowMode={workflowMode}\n   165→        onWorkflowModeChange={setWorkflowMode}\n   166→        onScanProject={scanProject}\n   167→        onSaveAgentsMd={handleSaveAgentsMd}\n   168→        onComplete={handleOnboardingComplete}\n   169→        onSkip={handleOnboardingComplete}\n   170→      />\n   171→    );\n   172→  }\n   173→\n   174→  return (\n   175→    <div className=\"min-h-screen bg-background\" id=\"main-content\" role=\"main\">\n   176→      {/* Header */}\n   177→      <header className=\"border-b bg-card px-6 py-4\" role=\"banner\">\n   178→        <div className=\"flex items-center justify-between\">\n   179→          <div className=\"flex items-center gap-3\">\n   180→            <div className=\"flex h-10 w-10 items-center justify-center rounded-lg bg-primary text-primary-foreground font-bold text-lg\">\n   181→              W\n   182→            </div>\n   183→            <div>\n   184→              <h1 className=\"text-xl font-semibold\">\n   185→                <span className=\"text-primary\">WIGGUM</span>\n   186→                <span className=\"text-muted-foreground font-normal text-sm ml-2\">R.A.L.P.H.</span>\n   187→              </h1>\n   188→              <p className=\"text-sm text-muted-foreground\">\n   189→                Recursive Autonomous Loop for Programming Humans\n   190→              </p>\n   191→            </div>\n   192→          </div>\n   193→          <div className=\"flex items-center gap-4\">\n   194→            <WorkflowModeToggle\n   195→              mode={workflowMode}\n   196→              onToggle={setWorkflowMode}\n   197→            />\n   198→            <Button\n   199→              variant=\"outline\"\n   200→              size=\"sm\"\n   201→              onClick={() => window.location.href = '?mode=launcher'}\n   202→              className=\"gap-2\"\n   203→              aria-label=\"Go to project launcher\"\n   204→            >\n   205→              <Home className=\"h-4 w-4\" aria-hidden=\"true\" />\n   206→              Launcher\n   207→            </Button>\n   208→            {gitStatus.repoName && (\n   209→              <a\n   210→                href={`https://github.com/${gitStatus.repoName}`}\n   211→                target=\"_blank\"\n   212→                rel=\"noopener noreferrer\"\n   213→                className=\"flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors\"\n   214→              >\n   215→                <Github className=\"h-4 w-4\" />\n   216→                {gitStatus.repoName}\n   217→              </a>\n   218→            )}\n   219→            <Badge variant={connected ? 'success' : 'destructive'} className=\"gap-1\">\n   220→              {connected ? (\n   221→                <>\n   222→                  <Wifi className=\"h-3 w-3\" />\n   223→                  Connected\n   224→                </>\n   225→              ) : (\n   226→                <>\n   227→                  <WifiOff className=\"h-3 w-3\" />\n   228→                  Disconnected\n   229→                </>\n   230→              )}\n   231→            </Badge>\n   232→            <Badge variant={loopStatus.running ? 'default' : 'secondary'}>\n   233→              {loopStatus.running ? `Running: ${loopStatus.mode}` : 'Idle'}\n   234→            </Badge>\n   235→          </div>\n   236→        </div>\n   237→      </header>\n   238→\n   239→      {/* Main Content */}\n   240→      <div className=\"container mx-auto p-6\">\n   241→        <Tabs value={activeTab} onValueChange={setActiveTab} className=\"space-y-6\">\n   242→          <TabsList className=\"grid w-full grid-cols-4 lg:w-[500px]\">\n   243→            <TabsTrigger value=\"dashboard\" className=\"gap-2\">\n   244→              <LayoutDashboard className=\"h-4 w-4\" />\n   245→              Dashboard\n   246→            </TabsTrigger>\n   247→            <TabsTrigger value=\"generate\" className=\"gap-2\">\n   248→              <Wand2 className=\"h-4 w-4\" />\n   249→              Generate\n   250→            </TabsTrigger>\n   251→            <TabsTrigger value=\"logs\" className=\"gap-2\">\n   252→              <Terminal className=\"h-4 w-4\" />\n   253→              Logs\n   254→            </TabsTrigger>\n   255→            <TabsTrigger value=\"setup\" className=\"gap-2\">\n   256→              <Settings className=\"h-4 w-4\" />\n   257→              Setup\n   258→            </TabsTrigger>\n   259→          </TabsList>\n   260→\n   261→          {/* Dashboard Tab */}\n   262→          <TabsContent value=\"dashboard\" className=\"space-y-6\">\n   263→            {/* Loop Controls */}\n   264→            <LoopControls\n   265→              loopStatus={loopStatus}\n   266→              onStart={(options) => sendCommand({ type: 'loop:start', payload: options })}\n   267→              onStop={() => sendCommand({ type: 'loop:stop' })}\n   268→            />\n   269→\n   270→            {/* Existing Documents */}\n   271→            <ExistingDocsViewer\n   272→              projectConfig={projectConfig}\n   273→              onReadFile={readConfigFile}\n   274→              onNavigateToGenerate={(tab) => {\n   275→                setActiveTab('generate');\n   276→                setGenerateSubTab(tab);\n   277→              }}\n   278→              previewDoc={configPreviewDoc}\n   279→              isLoadingPreview={configPreviewLoading}\n   280→              onClosePreview={closeConfigPreview}\n   281→              onRefresh={() => sendCommand({ type: 'config:refresh' })}\n   282→            />\n   283→\n   284→            {/* Status Grid */}\n   285→            <div className=\"grid gap-6 md:grid-cols-2 lg:grid-cols-3\">\n   286→              {/* Loop Status */}\n   287→              <LoopStatus status={loopStatus} />\n   288→\n   289→              {/* Context Meter */}\n   290→              <ContextMeter iteration={loopStatus.iteration} />\n   291→\n   292→              {/* Git Status */}\n   293→              <GitHistory status={gitStatus} />\n   294→            </div>\n   295→\n   296→            {/*