-010\",\n      \"title\": \"Templates generate correct file content\",\n      \"acceptanceCriteria\": [\n        \"prd.json template creates valid JSON structure\",\n        \"progress.txt template includes date placeholder\",\n        \".ralph-mode template defaults to 'simple'\",\n        \"AGENTS.md template includes build commands section\",\n        \"TemplateManager.initializeProject creates files correctly\"\n      ],\n      \"priority\": 10,\n      \"passes\": false,\n      \"notes\": \"Verify template system works\"\n    },\n    {\n      \"id\": \"US-011\",\n      \"title\": \"FileWatcher parses tasks from both file types\",\n      \"acceptanceCriteria\": [\n        \"In simple mode: FileWatcher parses prd.json user stories\",\n        \"In advanced mode: FileWatcher parses IMPLEMENTATION_PLAN.md checkboxes\",\n        \"Task completion count is accurate\",\n        \"Tasks emit to dashboard via WebSocket\"\n      ],\n      \"priority\": 11,\n      \"passes\": false,\n      \"notes\": \"Verify FileWatcher handles both modes\"\n    },\n    {\n      \"id\": \"US-012\",\n      \"title\": \"Review and fix any remaining TypeScript errors\",\n      \"acceptanceCriteria\": [\n        \"npx tsc --noEmit in dashboard directory passes\",\n        \"No 'any' type warnings for core functionality\",\n        \"All imports have proper type definitions\",\n        \"No unused variable warnings in modified files\"\n      ],\n      \"priority\": 12,\n      \"passes\": false,\n      \"notes\": \"Final TypeScript cleanup\"\n    },\n    {\n      \"id\": \"US-013\",\n      \"title\": \"Documentation is accurate and complete\",\n      \"acceptanceCriteria\": [\n        \"RALPH_WIGGUM_README.md explains simple vs advanced modes\",\n        \"AGENTS.md has correct build/test commands\",\n        \"progress.txt has relevant learnings logged\",\n        \"README.md exists and describes the project\"\n      ],\n      \"priority\": 13,\n      \"passes\": false,\n      \"notes\": \"Ensure documentation matches implementation\"\n    },\n    {\n      \"id\": \"US-014\",\n      \"title\": \"End-to-end verification complete\",\n      \"acceptanceCriteria\": [\n        \"Can start dashboard: cd dashboard && npm run dev\",\n        \"Can switch between Simple and Advanced modes\",\n        \"Can view tasks in TaskList for current mode\",\n        \"Can access launcher at ?mode=launcher\",\n        \"loop.sh runs and displays correct mode\",\n        \"All previous stories pass\"\n      ],\n      \"priority\": 14,\n      \"passes\": false,\n      \"notes\": \"Final verification that everything works together\"\n    }\n  ]\n}\n","structuredPatch":[{"oldStart":65,"oldLines":8,"newStart":65,"newLines":8,"lines":["         \"Completed tasks show green checkmark\"","       ],","       \"priority\": 5,","-      \"passes\": false,","-      \"notes\": \"Verify TaskList adapts to workflow mode\"","+      \"passes\": true,","+      \"notes\": \"Verified: TaskList.tsx adapts title/icon, FileWatcher routes to correct parser\"","     },","     {","       \"id\": \"US-006\","]}],"userModified":false,"replaceAll":false}}
